type-uniq d0@(isty-TyU {f = f0} {g = g0} hf0 hg0) (isty-TyU {f = f1} {g = g1} hf1 hg1) e =
  tyeq-TyU hf0 hg0 (fst cs) (snd cs)
  where cs = opConv hf0 hf1 (term-uniq hf0 hf1 (fst (r-ucode e))) (term-uniq hg0 hg1 (snd (r-ucode e)))

type-uniq : {n : Num} {G : Ctx n} {A0 A1 : Expr n} ->
            IsType G A0 -> IsType G A1 -> Eq (er A0) (er A1) -> TyEq G A0 A1
elIm-uniq : {n : Num} {G : Ctx n} {a A A1 : Expr n} (k : Kind n) ->
            HasType G a A -> TyEq G A (KTy k) -> IsType G A1 -> Eq (er a) (er A1) ->
            TyEq G (ElV (KIm k a)) A1
elIm-dec  : {n : Num} {G : Ctx n} {a A A1 : Expr n} (k : Kind n) ->
            HasType G a A -> TyEq G A (KTy k) -> NonEl G A1 -> Eq (er a) (er A1) ->
            TyEq G (ElV (KIm k a)) A1
term-uniq : {n : Num} {G : Ctx n} {t0 A0 t1 A1 : Expr n} ->
            HasType G t0 A0 -> HasType G t1 A1 -> Eq (er t0) (er t1) -> Coh G t0 A0 t1 A1

type-uniq (isty-ElV h0) d1 e = elIm-uniq kV h0 (tyeq-refl (isty-V (wfTm h0))) d1 e
type-uniq (isty-ElU {f = f0} {g = g0} h0) d1 e =
  tyeq-trans (tyeq-ElU-That h0) (elIm-uniq (kU f0 g0) h0 (tyeq-refl (pTm h0)) d1 e)
type-uniq d0@(isty-V w0) (isty-ElV h1) e = tyeq-sym (elIm-uniq kV h1 (tyeq-refl (isty-V (wfTm h1))) d0 (Eq-sym e))
type-uniq d0@(isty-V w0) (isty-ElU {f = f1} {g = g1} h1) e =
  tyeq-sym (tyeq-trans (tyeq-ElU-That h1) (elIm-uniq (kU f1 g1) h1 (tyeq-refl (pTm h1)) d0 (Eq-sym e)))
type-uniq d0@(isty-V w0) (isty-V w1) e = tyeq-refl d0
type-uniq (isty-V w0) (isty-TyU {f = f1} {g = g1} hf1 hg1) ()
type-uniq (isty-V w0) (isty-Pi hA1 hB1) ()
type-uniq (isty-V w0) (isty-Sigma hA1 hB1) ()
type-uniq (isty-V w0) (isty-Nat w1) ()
type-uniq d0@(isty-TyU {f = f0} {g = g0} hf0 hg0) (isty-ElV h1) e = tyeq-sym (elIm-uniq kV h1 (tyeq-refl (isty-V (wfTm h1))) d0 (Eq-sym e))
type-uniq d0@(isty-TyU {f = f0} {g = g0} hf0 hg0) (isty-ElU {f = f1} {g = g1} h1) e =
  tyeq-sym (tyeq-trans (tyeq-ElU-That h1) (elIm-uniq (kU f1 g1) h1 (tyeq-refl (pTm h1)) d0 (Eq-sym e)))

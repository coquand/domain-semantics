private
  varCoh : {n : Num} {G : Ctx n} {i j : Fin n} -> WfCtx G -> Eq i j ->
           Coh G (Var i) (lookup G i) (Var j) (lookup G j)
  varCoh {i = i} w refl = same (tyeq-refl (lookupTy w i)) (conv-refl (ty-var w))

  sucCoh : {n : Num} {G : Ctx n} {k0 k1 : Expr n} -> HasType G k0 Nat ->
           Coh G k0 Nat k1 Nat -> Coh G (Suc k0) Nat (Suc k1) Nat
  sucCoh h c = same (tyeq-refl (isty-Nat (wfTm h))) (conv-Suc (extract c (tyeq-refl (isty-Nat (wfTm h)))))

  recCoh : {n : Num} {G : Ctx n} {C0 C1 : Expr (suc n)} {z0 z1 s0 s1 k0 k1 : Expr n} ->
           IsType (extend G Nat) C0 -> HasType G k0 Nat ->
           IsType (extend G Nat) C1 -> HasType G k1 Nat ->
           TyEq (extend G Nat) C0 C1 ->
           Coh G z0 (subst1 C0 Zero) z1 (subst1 C1 Zero) ->
           Coh G s0 (RecStep C0) s1 (RecStep C1) -> Coh G k0 Nat k1 Nat ->
           Coh G (Rec (Lam Nat C0) z0 s0 k0) (subst1 C0 k0) (Rec (Lam Nat C1) z1 s1 k1) (subst1 C1 k1)
  recCoh hC0 hk0 hC1 hk1 qC cz cs ck =
    same (tyeq-trans (s1fTy w (isty-Nat w) hk0 hk1 kc hC0) (s1TE w hk1 qC))
         (conv-Rec hC0 hC1 qC (extract cz (s1TE w (ty-Zero w) qC)) (extract cs (recStepEq w hC0 hC1 qC)) kc)
    where
      w = wfTm hk0
      kc = extract ck (tyeq-refl (isty-Nat w))

-- the non-El types
data NonEl {n : Num} (G : Ctx n) : Expr n -> Set where
  neV   : WfCtx G -> NonEl G V
  neU   : {f g : Expr n} -> HasType G f OpF -> HasType G g (OpG f) -> NonEl G (TyU f g)
  nePi  : {A : Expr n} {B : Expr (suc n)} -> IsType G A -> IsType (extend G A) B -> NonEl G (PiB A B)
  neSig : {A : Expr n} {B : Expr (suc n)} -> IsType G A -> IsType (extend G A) B -> NonEl G (SigmaB A B)
  neNat : WfCtx G -> NonEl G Nat


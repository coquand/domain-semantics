type-uniq d0@(isty-Pi hA0 hB0) (isty-ElV h1) e = tyeq-sym (elIm-uniq kV h1 (tyeq-refl (isty-V (wfTm h1))) d0 (Eq-sym e))
type-uniq d0@(isty-Pi hA0 hB0) (isty-ElU {f = f1} {g = g1} h1) e =

elIm-uniq k h qK (isty-ElV h1) e =
  tyeq-ElV (cohUp (term-uniq h h1 e) (upK k h qK) (upV (tyeq-refl (isty-V (wfTm h1))) h1 refl))
elIm-uniq k h qK (isty-ElU {f = f1} {g = g1} h1) e =
  tyeq-trans (tyeq-ElV (cohUp (term-uniq h h1 e) (upK k h qK) (upK' (kU f1 g1) h1))) (tyeq-sym (tyeq-ElU-That h1))
elIm-uniq k h qK (isty-V w1) e = elIm-dec k h qK (neV w1) e
elIm-uniq k h qK (isty-TyU hf1 hg1) e = elIm-dec k h qK (neU hf1 hg1) e
elIm-uniq k h qK (isty-Pi hA1 hB1) e = elIm-dec k h qK (nePi hA1 hB1) e
elIm-uniq k h qK (isty-Sigma hA1 hB1) e = elIm-dec k h qK (neSig hA1 hB1) e
elIm-uniq k h qK (isty-Nat w1) e = elIm-dec k h qK (neNat w1) e

elIm-dec k (ty-conv h q) qK ne e = elIm-dec k h (tyeq-trans q qK) ne e
elIm-dec kV (ty-That {f = f} {g = g} hy) qK ne e = elIm-dec (kU f g) hy (tyeq-refl (pTm hy)) ne e
elIm-dec (kU f g) (ty-That hy) qK ne e = Empty-elim (tV-U qK)

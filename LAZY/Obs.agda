{-# OPTIONS --without-K --exact-split --safe #-}

------------------------------------------------------------------------
-- LAZY/Obs.agda        (L3)
--
-- The finite observation relation
--
--      mu |- p , rho |-> u
--
-- "u is a finite semantic approximation to the value the memory mu
-- computes at location p, in the finite environment rho".
--
-- This REPLACES the paper's semantic memory  V : M -> S,
-- S = R -> (N -> V)  (henderson.pdf, section III, "The Semantic
-- Function V").  Reading their clauses as an INDUCTIVE relation instead
-- of a recursively defined function buys three things:
--
--   (1) The memory may be CIRCULAR (rule [L] creates circular structure)
--       yet the definition is well founded: induction is on the
--       DERIVATION, not on mu or on p.  A circular memory simply has no
--       finite derivation of the observations that would need infinite
--       unfolding.
--
--   (2) `data' is a LEAST fixed point, so  V mu = the ideal generated by
--       these observations  is the minimal solution the paper's rule [L]
--       argument needs, with no Y and no lim_i V_i constructed anywhere.
--       Their  V_i (cutting V's loop) and Y_i (cutting Y's loop) are two
--       nested limits forced on them by defining V as a FUNCTION; here
--       both collapse into derivation height.
--
--   (3) The environment is finite (a list), so p[x/xi] is concrete.
--
-- Deliberately ORDER-FREE: no LeCode, no Sup, no EvalFun.  The order
-- kernel (L1, the LeqStage port) is needed only for the ideal lemmas of
-- L4, not to state or use this relation.  Where the paper's clause would
-- read "some u' <= u", we instead observe the argument at exactly u'
-- (always possible), which is equivalent once L4 gives down-closure.
--
-- The relation is presented as the IDEAL it generates: the twelve
-- syntax clauses are the GENERATORS, and `obs-down' / `obs-sup' are the
-- two ideal closure rules.  That is what makes the object an element of
-- the domain rather than an arbitrary set of codes -- a Scott element,
-- presented by finite approximations, IS a downward-closed directed set.
-- Two consequences:
--
--   * the LABEL clause below is CORRECT only because the set is
--     directed; deriving directedness first would be circular, so it is
--     a generator, not a theorem.
--   * what remains to be proved is CONSISTENCY (any two observations at
--     the same cell are Comp), which is where the design can still fail.
--     It is isolated in LAZY/ObsIdeal.agda.
--
-- Coherence is carried explicitly: `obs-lam' records that its graph is a
-- genuine finite function and `obs-down' that it weakens to a genuine
-- element, so every observation is Coherent (ObsIdeal.Obs-Coherent) and
-- the Coherent-conditional order laws are always available.
--
-- The LABEL clause is the UNFOLD-ONCE rule.  The apparently simpler
--     Obs mu p' (ext rho x u) u  ->  Obs mu p rho u
-- would be a POST-fixed point, i.e. the GREATEST fixed point, and would
-- make the invariance theorem (L5) false.
------------------------------------------------------------------------

module LAZY.Obs where

open import LAZY.Domain.Basic
open import LAZY.Domain.Order
open import LAZY.Syntax.Heap

------------------------------------------------------------------------
-- Finite environments:  N = C -> V, but only finitely much of it.
-- An unbound variable denotes Bot -- the paper starts from the empty
-- environment, which it writes as the bottom element.
------------------------------------------------------------------------

FinEnv : Set
FinEnv = List (Pair Var FinEl)

emptyEnv : FinEnv
emptyEnv = nil

ext : FinEnv -> Var -> FinEl -> FinEnv
ext rho x u = cons (mkSigma x u) rho

-- bindings first, so the leftmost binding shadows
appendEnv : FinEnv -> FinEnv -> FinEnv
appendEnv nil         rho = rho
appendEnv (cons b bs) rho = cons b (appendEnv bs rho)

lookupEnv : FinEnv -> Var -> FinEl
lookupEnv nil         x = Bot
lookupEnv (cons b bs) x = ifNatEq (fst b) x (snd b) (lookupEnv bs x)

------------------------------------------------------------------------
-- The observation relation
------------------------------------------------------------------------

mutual
  data Obs (mu : Heap) : Addr -> FinEnv -> FinEl -> Set where

    -- Bot is an observation of everything.  ("V mu p rho = Bot" is the
    -- case where nothing at all has been observed.)
    obs-bot :
      {p : Addr} {rho : FinEnv} ->
      Obs mu p rho Bot

    -- if E in C then rho E
    obs-var :
      {p : Addr} {rho : FinEnv} {x : Var} ->
      Eq (mu p) (just (evar x)) ->
      Obs mu p rho (lookupEnv rho x)

    -- if E = (QUOTE a) then a
    obs-quote :
      {p : Addr} {rho : FinEnv} {a : Atom} ->
      Eq (mu p) (just (equote a)) ->
      Obs mu p rho (At a)

    -- if E = (CONS p1 p2) then < . , . >
    obs-cons :
      {p p1 p2 : Addr} {rho : FinEnv} {u v : FinEl} ->
      Eq (mu p) (just (econs p1 p2)) ->
      Obs mu p1 rho u -> Obs mu p2 rho v ->
      Obs mu p rho (Prd u v)

    -- if E = (CAR p') then ( . )_1
    obs-car :
      {p p' : Addr} {rho : FinEnv} {u v : FinEl} ->
      Eq (mu p) (just (ecar p')) ->
      Obs mu p' rho (Prd u v) ->
      Obs mu p rho u

    -- if E = (CDR p') then ( . )_2
    obs-cdr :
      {p p' : Addr} {rho : FinEnv} {u v : FinEl} ->
      Eq (mu p) (just (ecdr p')) ->
      Obs mu p' rho (Prd u v) ->
      Obs mu p rho v

    -- if E = (ATOM p') then [ if . in A then "T" else
    --                         if . in V x V then "NIL" else Bot ]
    obs-atom-T :
      {p p' : Addr} {rho : FinEnv} {a : Atom} ->
      Eq (mu p) (just (eatom p')) ->
      Obs mu p' rho (At a) ->
      Obs mu p rho (At T)

    obs-atom-NIL :
      {p p' : Addr} {rho : FinEnv} {u v : FinEl} ->
      Eq (mu p) (just (eatom p')) ->
      Obs mu p' rho (Prd u v) ->
      Obs mu p rho (At NIL)

    -- if E = (EQ p1 p2) then [ if both in A then T/NIL else Bot ]
    obs-eq-T :
      {p p1 p2 : Addr} {rho : FinEnv} {a1 a2 : Atom} ->
      Eq (mu p) (just (eeq p1 p2)) ->
      Obs mu p1 rho (At a1) -> Obs mu p2 rho (At a2) ->
      AtEq a1 a2 ->
      Obs mu p rho (At T)

    obs-eq-NIL :
      {p p1 p2 : Addr} {rho : FinEnv} {a1 a2 : Atom} ->
      Eq (mu p) (just (eeq p1 p2)) ->
      Obs mu p1 rho (At a1) -> Obs mu p2 rho (At a2) ->
      Neg (AtEq a1 a2) ->
      Obs mu p rho (At NIL)

    -- if E = (IF p0 p1 p2) then [ ... ]
    obs-if-T :
      {p p0 p1 p2 : Addr} {rho : FinEnv} {u : FinEl} ->
      Eq (mu p) (just (eif p0 p1 p2)) ->
      Obs mu p0 rho (At T) -> Obs mu p1 rho u ->
      Obs mu p rho u

    obs-if-NIL :
      {p p0 p1 p2 : Addr} {rho : FinEnv} {u : FinEl} ->
      Eq (mu p) (just (eif p0 p1 p2)) ->
      Obs mu p0 rho (At NIL) -> Obs mu p2 rho u ->
      Obs mu p rho u

    -- if E = (p0 p1) then (sigma p0 rho) (sigma p1 rho)
    --
    -- The finite reading of application: the function has been observed
    -- to contain the demand (u |-> v), and the argument has been
    -- observed to supply u.
    obs-app :
      {p p0 p1 : Addr} {rho : FinEnv} {g : FinFun} {u v : FinEl} ->
      Eq (mu p) (just (eapp p0 p1)) ->
      Obs mu p0 rho (Fn g) ->
      Obs mu p1 rho u ->
      InFun u v g ->
      Obs mu p rho v

    -- if E = (LAMBDA xi p') then \x . sigma p' rho[x/xi]
    --
    -- Fn g is an observation of the closure exactly when every recorded
    -- demand of g is realised by the body.  Note Fn nil IS derivable:
    -- in Reynolds's separated sum that is the observation "this is a
    -- function", which is what the answer (FUNARG(LAMBDA..)..) reveals.
    obs-lam :
      {p p' : Addr} {rho : FinEnv} {x : Var} {g : FinFun} ->
      Eq (mu p) (just (elam x p')) ->
      CoherentFun g ->
      ObsGraph mu p' x rho g ->
      Obs mu p rho (Fn g)

    -- if E = (LABEL xi p') then Y { \x . sigma p' rho[x/xi] }
    --
    -- UNFOLD ONCE.  Together with obs-bot this generates exactly the
    -- finite observations of the least fixed point: the base is
    -- F(Bot), and the derivation height IS the paper's index i.
    obs-label :
      {p p' : Addr} {rho : FinEnv} {x : Var} {u v : FinEl} ->
      Eq (mu p) (just (elabel x p')) ->
      Obs mu p rho u ->
      Obs mu p' (ext rho x u) v ->
      Obs mu p rho v

    -- if E = (FUNARG p0 xi1 p1 ... xin pn) then
    --        sigma p0 rho[ sigma pn rho / xin , ... , sigma p1 rho / xi1 ]
    --
    -- The paper notes this "involves a complete reversal of the list of
    -- bindings"; that is an artefact of their bracket notation, in which
    -- the rightmost update is applied last.  With environments as
    -- cons-lists and leftmost-wins lookup, the alist order is preserved.
    -- Each pi is observed in the OUTER environment rho.
    obs-funarg :
      {p p0 : Addr} {th : Alist} {rho bs : FinEnv} {u : FinEl} ->
      Eq (mu p) (just (efunarg p0 th)) ->
      ObsAlist mu rho th bs ->
      Obs mu p0 (appendEnv bs rho) u ->
      Obs mu p rho u

    ----------------------------------------------------------------
    -- the two IDEAL closure rules
    ----------------------------------------------------------------

    -- downward closure: less information is still an observation
    obs-down :
      {p : Addr} {rho : FinEnv} {u u' : FinEl} ->
      Obs mu p rho u -> Coherent u' -> LeCode u' u ->
      Obs mu p rho u'

    -- directedness: compatible observations combine
    obs-sup :
      {p : Addr} {rho : FinEnv} {u v : FinEl} ->
      Obs mu p rho u -> Obs mu p rho v -> Comp u v ->
      Obs mu p rho (Sup u v)

    ----------------------------------------------------------------

    -- the assumed primitive PLUS
    obs-plus :
      {p p1 p2 : Addr} {rho : FinEnv} {m n : Nat} ->
      Eq (mu p) (just (eplus p1 p2)) ->
      Obs mu p1 rho (At (num m)) -> Obs mu p2 rho (At (num n)) ->
      Obs mu p rho (At (num (add m n)))

  -- Every demand recorded in the graph is realised by the body.
  data ObsGraph (mu : Heap) (p' : Addr) (x : Var) (rho : FinEnv)
       : FinFun -> Set where
    og-nil  : ObsGraph mu p' x rho nil
    og-cons : {u v : FinEl} {g : FinFun} ->
              Obs mu p' (ext rho x u) v ->
              ObsGraph mu p' x rho g ->
              ObsGraph mu p' x rho (cons (mkSigma u v) g)

  -- The BINDINGS an alist contributes, each observed in the outer rho.
  -- (Only the bindings, not bindings-plus-rho: that keeps them fixed
  -- when the outer environment grows -- see ObsIdeal.obsalist-env-mono.)
  data ObsAlist (mu : Heap) (rho : FinEnv) : Alist -> FinEnv -> Set where
    oa-nil  : ObsAlist mu rho nil nil
    oa-cons : {x : Var} {q : Addr} {th : Alist} {bs : FinEnv} {u : FinEl} ->
              Obs mu q rho u ->
              ObsAlist mu rho th bs ->
              ObsAlist mu rho (cons (mkSigma x q) th) (cons (mkSigma x u) bs)

------------------------------------------------------------------------
-- The correctness statement of L5 will be about this relation at the
-- empty environment.  ("We use the empty environment in these
-- statements because it is assumed that the expression to be reduced
-- does not contain free variables at the outermost level.")
------------------------------------------------------------------------

Observes : Heap -> Addr -> FinEl -> Set
Observes mu p u = Obs mu p emptyEnv u

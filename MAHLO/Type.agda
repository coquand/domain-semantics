{-# OPTIONS --without-K --exact-split --safe #-}

------------------------------------------------------------------------
-- MAHLO/Type.agda
--
-- Large types over the fixed point V* (mahlo-plan.tex Sec. 6.3), as an
-- inductive relation with an interpretation (Abel--Coquand App. B):
--
--   TyR a b X   "a = b in Type, with interpretation X"
--
-- generated by  V = V  ([V] = V*),  a = b in V*  ([a] = [a]_{V*}),  and
-- Pi / Sigma over Type.  Results:
--   * V is not in |V*|                                   (Vnotin)
--   * Type end-extends V*, with the same interpretation  (eeL, eeR)
--   * Type is a PER, its interpretation depends on either endpoint
--     only, is a PER, and is safe                          (sym, trans,
--     funL, funR, per, lo, hi, safe)
--   * inversion for V, Pi, Sigma, and the construction of a Pi/Sigma
--     type from a family of types given pointwise          (piTy, sigTy)
------------------------------------------------------------------------

open import MAHLO.Basic
open import MAHLO.TermModel
import MAHLO.Model
import MAHLO.Fixpoint

module MAHLO.Type (TM : TermModel) (M : MAHLO.Model.Model TM)
                  (Fx : MAHLO.Fixpoint.Fixpoint TM) where

open TermModel TM
open MAHLO.Model.Model M
open import MAHLO.Candidate TM
open import MAHLO.Pre TM
open import MAHLO.Gamma TM
open import MAHLO.EndExt TM
open MAHLO.Fixpoint TM
open Fixpoint Fx
open Cand V

private
  module RV = IsPER R-per

Empty-elim1 : {A : Set1} -> Empty -> A
Empty-elim1 ()

~-refl : {P : Rel} -> P ~ P
~-refl = (\ x -> x) , (\ x -> x)

------------------------------------------------------------------------
-- Facts about V*
------------------------------------------------------------------------

Vnotin : {b : D} -> R Vd b -> Empty
Vnotin r = h (_<<_.inc unfold (RV.rl r))
  where
    h : GR V Vd Vd -> Empty
    h (gne n) = ne-V n
    h (gnat e _) = V-Nat e
    h (gpi p) = V-Pi (PiRel.ea p)
    h (gsig p) = V-Sig (SigRel.ea p)
    h (gU u) = V-U (URel.ea u)

piSmall2 : {a b A F A' F' : D} -> R a b -> a ~~ Pi A F -> b ~~ Pi A' F' ->
           R A A' * FamEq V A F F'
piSmall2 {a} {b} {A} {F} {A'} {F'} r e e' = h (_<<_.inc unfold r)
  where
    h : GR V a b -> R A A' * FamEq V A F F'
    h (gne n) = Empty-elim (ne-Pi (N-self e (IsPER.rl N-per n)))
    h (gnat e1 _) = Empty-elim (Pi-Nat (~~-trans (~~-sym e) e1))
    h (gpi (mkPi A0 A0' F0 F0' ea eb rA rF)) =
      let i1 = Pi-inj (~~-trans (~~-sym ea) e)
          i2 = Pi-inj (~~-trans (~~-sym eb) e') in
      CandCl.R-cl2 V (fst i1) (fst i2) rA , FamEq-tr V (fst i1) (snd i1) (snd i2) rF
    h (gsig p) = Empty-elim (Sig-Pi (~~-trans (~~-sym (SigRel.ea p)) e))
    h (gU u) = Empty-elim (Pi-U (~~-trans (~~-sym e) (URel.ea u)))

sigSmall2 : {a b A F A' F' : D} -> R a b -> a ~~ Sig A F -> b ~~ Sig A' F' ->
            R A A' * FamEq V A F F'
sigSmall2 {a} {b} {A} {F} {A'} {F'} r e e' = h (_<<_.inc unfold r)
  where
    h : GR V a b -> R A A' * FamEq V A F F'
    h (gne n) = Empty-elim (ne-Sig (N-self e (IsPER.rl N-per n)))
    h (gnat e1 _) = Empty-elim (Sig-Nat (~~-trans (~~-sym e) e1))
    h (gpi p) = Empty-elim (Sig-Pi (~~-trans (~~-sym e) (PiRel.ea p)))
    h (gsig (mkSig A0 A0' F0 F0' ea eb rA rF)) =
      let i1 = Sig-inj (~~-trans (~~-sym ea) e)
          i2 = Sig-inj (~~-trans (~~-sym eb) e') in
      CandCl.R-cl2 V (fst i1) (fst i2) rA , FamEq-tr V (fst i1) (snd i1) (snd i2) rF
    h (gU u) = Empty-elim (Sig-U (~~-trans (~~-sym e) (URel.ea u)))

piSmall : {a A F : D} -> R a a -> a ~~ Pi A F -> R A A * FamResp V A F
piSmall r e = piSmall2 r e e

sigSmall : {a A F : D} -> R a a -> a ~~ Sig A F -> R A A * FamResp V A F
sigSmall r e = sigSmall2 r e e

piIn : {A A' F F' : D} -> R A A' -> FamEq V A F F' -> R (Pi A F) (Pi A' F')
piIn rA rF = _<<_.inc fold (gpi (mkPi _ _ _ _ ~~-refl ~~-refl rA rF))

sigIn : {A A' F F' : D} -> R A A' -> FamEq V A F F' -> R (Sig A F) (Sig A' F')
sigIn rA rF = _<<_.inc fold (gsig (mkSig _ _ _ _ ~~-refl ~~-refl rA rF))

piInt : (a A F : D) -> a ~~ Pi A F -> R A A -> FamResp V A F ->
        I a ~ Fun (I A) (\ w -> I (app F w))
piInt a A F e rA rF =
  ~-trans (~-sym (_<<_.int fold a (gpi (mkPi A A F F e e rA rF)))) (GI-pi V a A F e)

sigInt : (a A F : D) -> a ~~ Sig A F -> R A A -> FamResp V A F ->
         I a ~ SigF (I A) (\ w -> I (app F w))
sigInt a A F e rA rF =
  ~-trans (~-sym (_<<_.int fold a (gsig (mkSig A A F F e e rA rF)))) (GI-sig V a A F e)

------------------------------------------------------------------------
-- The relation
------------------------------------------------------------------------

data TyR : D -> D -> Rel -> Set1 where
  tyV   : {a b : D} {X : Rel} -> a ~~ Vd -> b ~~ Vd -> X ~ R -> TyR a b X
  tySm  : {a b : D} {X : Rel} -> R a b -> X ~ I a -> TyR a b X
  tyPi  : {a b : D} {X : Rel} (A A' F F' : D) (XA : Rel) (XF : D -> Rel) ->
          a ~~ Pi A F -> b ~~ Pi A' F' -> TyR A A' XA ->
          ((v v' : D) -> XA v v' -> TyR (app F v) (app F' v') (XF v)) ->
          X ~ Fun XA XF -> TyR a b X
  tySig : {a b : D} {X : Rel} (A A' F F' : D) (XA : Rel) (XF : D -> Rel) ->
          a ~~ Sig A F -> b ~~ Sig A' F' -> TyR A A' XA ->
          ((v v' : D) -> XA v v' -> TyR (app F v) (app F' v') (XF v)) ->
          X ~ SigF XA XF -> TyR a b X

resp : {a b : D} {X Y : Rel} -> TyR a b X -> X ~ Y -> TyR a b Y
resp (tyV ea eb eX) e = tyV ea eb (~-trans (~-sym e) eX)
resp (tySm r eX) e = tySm r (~-trans (~-sym e) eX)
resp (tyPi A A' F F' XA XF ea eb dA dF eX) e =
  tyPi A A' F F' XA XF ea eb dA dF (~-trans (~-sym e) eX)
resp (tySig A A' F F' XA XF ea eb dA dF eX) e =
  tySig A A' F F' XA XF ea eb dA dF (~-trans (~-sym e) eX)

-- the endpoints may be replaced by equal elements of D
TyR-cl2 : {a a' b b' : D} {X : Rel} -> a ~~ a' -> b ~~ b' -> TyR a b X -> TyR a' b' X
TyR-cl2 e e' (tyV ea eb eX) = tyV (~~-trans (~~-sym e) ea) (~~-trans (~~-sym e') eb) eX
TyR-cl2 e e' (tySm r eX) = tySm (CandCl.R-cl2 V e e' r) (~-trans eX (I-idx e))
TyR-cl2 e e' (tyPi A A' F F' XA XF ea eb dA dF eX) =
  tyPi A A' F F' XA XF (~~-trans (~~-sym e) ea) (~~-trans (~~-sym e') eb) dA dF eX
TyR-cl2 e e' (tySig A A' F F' XA XF ea eb dA dF eX) =
  tySig A A' F F' XA XF (~~-trans (~~-sym e) ea) (~~-trans (~~-sym e') eb) dA dF eX

------------------------------------------------------------------------
-- End-extension: a small endpoint makes the pair small
------------------------------------------------------------------------

eeL : {a b : D} {X : Rel} -> R a a -> TyR a b X -> R a b * (X ~ I a)
eeL r (tyV ea eb eX) = Empty-elim (Vnotin (CandCl.R-self V r ea))
eeL r (tySm r' eX) = r' , eX
eeL {a} {b} {X} r (tyPi A A' F F' XA XF ea eb dA dF eX) = rab , intX
  where
    sm = piSmall r ea
    rAA = fst sm
    respF = snd sm
    hA = eeL rAA dA
    hF : (v v' : D) -> I A v v' -> R (app F v) (app F' v') * (XF v ~ I (app F v))
    hF v v' i = eeL (respF v v (IsPER.rl (I-per A rAA) i)) (dF v v' (snd (snd hA) i))
    rab : R a b
    rab = CandCl.R-cl2 V (~~-sym ea) (~~-sym eb) (piIn (fst hA) (\ v v' i -> fst (hF v v' i)))
    intX : X ~ I a
    intX = ~-trans eX
      (~-trans (Fun-cong XA (I A) XF (\ w -> I (app F w))
                 (per-~ (~-sym (snd hA)) (I-per A rAA)) (snd hA)
                 (\ v j -> snd (hF v v (fst (snd hA) j))))
               (~-sym (piInt a A F ea rAA respF)))
eeL {a} {b} {X} r (tySig A A' F F' XA XF ea eb dA dF eX) = rab , intX
  where
    sm = sigSmall r ea
    rAA = fst sm
    respF = snd sm
    hA = eeL rAA dA
    hF : (v v' : D) -> I A v v' -> R (app F v) (app F' v') * (XF v ~ I (app F v))
    hF v v' i = eeL (respF v v (IsPER.rl (I-per A rAA) i)) (dF v v' (snd (snd hA) i))
    rab : R a b
    rab = CandCl.R-cl2 V (~~-sym ea) (~~-sym eb) (sigIn (fst hA) (\ v v' i -> fst (hF v v' i)))
    intX : X ~ I a
    intX = ~-trans eX
      (~-trans (SigF-cong XA (I A) XF (\ w -> I (app F w))
                 (per-~ (~-sym (snd hA)) (I-per A rAA)) (snd hA)
                 (\ v j -> snd (hF v v (fst (snd hA) j))))
               (~-sym (sigInt a A F ea rAA respF)))

eeR : {a b : D} {X : Rel} -> R b b -> TyR a b X -> R a b * (X ~ I b)
eeR r (tyV ea eb eX) = Empty-elim (Vnotin (CandCl.R-self V r eb))
eeR r (tySm r' eX) = r' , ~-trans eX (I-resp r')
eeR {a} {b} {X} r (tyPi A A' F F' XA XF ea eb dA dF eX) = rab , intX
  where
    sm = piSmall r eb
    rAA = fst sm
    respF = snd sm
    hA = eeR rAA dA
    eAA = I-resp (fst hA)
    hF : (v v' : D) -> I A v v' -> R (app F v) (app F' v') * (XF v ~ I (app F' v'))
    hF v v' i = eeR (respF v' v' (IsPER.rr (I-per A' rAA) (fst eAA i)))
                    (dF v v' (snd (snd hA) (fst eAA i)))
    rab : R a b
    rab = CandCl.R-cl2 V (~~-sym ea) (~~-sym eb) (piIn (fst hA) (\ v v' i -> fst (hF v v' i)))
    intX : X ~ I b
    intX = ~-trans eX
      (~-trans (Fun-cong XA (I A') XF (\ w -> I (app F' w))
                 (per-~ (~-sym (snd hA)) (I-per A' rAA)) (snd hA)
                 (\ v j -> snd (hF v v (snd eAA (fst (snd hA) j)))))
               (~-sym (piInt b A' F' eb rAA respF)))
eeR {a} {b} {X} r (tySig A A' F F' XA XF ea eb dA dF eX) = rab , intX
  where
    sm = sigSmall r eb
    rAA = fst sm
    respF = snd sm
    hA = eeR rAA dA
    eAA = I-resp (fst hA)
    hF : (v v' : D) -> I A v v' -> R (app F v) (app F' v') * (XF v ~ I (app F' v'))
    hF v v' i = eeR (respF v' v' (IsPER.rr (I-per A' rAA) (fst eAA i)))
                    (dF v v' (snd (snd hA) (fst eAA i)))
    rab : R a b
    rab = CandCl.R-cl2 V (~~-sym ea) (~~-sym eb) (sigIn (fst hA) (\ v v' i -> fst (hF v v' i)))
    intX : X ~ I b
    intX = ~-trans eX
      (~-trans (SigF-cong XA (I A') XF (\ w -> I (app F' w))
                 (per-~ (~-sym (snd hA)) (I-per A' rAA)) (snd hA)
                 (\ v j -> snd (hF v v (snd eAA (fst (snd hA) j)))))
               (~-sym (sigInt b A' F' eb rAA respF)))

------------------------------------------------------------------------
-- The interpretation is a PER and depends on one endpoint only
------------------------------------------------------------------------

private
  VPi : {a A F : D} -> a ~~ Vd -> a ~~ Pi A F -> Empty
  VPi e e' = V-Pi (~~-trans (~~-sym e) e')
  VSig : {a A F : D} -> a ~~ Vd -> a ~~ Sig A F -> Empty
  VSig e e' = V-Sig (~~-trans (~~-sym e) e')
  PiSig : {a A F B G : D} -> a ~~ Pi A F -> a ~~ Sig B G -> Empty
  PiSig e e' = Sig-Pi (~~-trans (~~-sym e') e)
  VR : {a b : D} -> a ~~ Vd -> R a b -> Empty
  VR e r = Vnotin (R-cl e r)
  VRr : {a b : D} -> b ~~ Vd -> R a b -> Empty
  VRr e r = Vnotin (RV.sy (CandCl.R-cl2 V ~~-refl e r))

mutual
  per : {a b : D} {X : Rel} -> TyR a b X -> IsPER X
  per (tyV _ _ eX) = per-~ (~-sym eX) R-per
  per (tySm r eX) = per-~ (~-sym eX) (I-per _ (RV.rl r))
  per (tyPi A A' F F' XA XF ea eb dA dF eX) =
    per-~ (~-sym eX)
      (Fun-per XA XF (per dA)
         (\ {v} {v'} i -> funR (dF v v' i) (dF v' v' (IsPER.rr (per dA) i)))
         (\ v i -> per (dF v v i)))
  per (tySig A A' F F' XA XF ea eb dA dF eX) =
    per-~ (~-sym eX)
      (SigF-per XA XF (per dA)
         (\ {v} {v'} i -> funR (dF v v' i) (dF v' v' (IsPER.rr (per dA) i)))
         (\ v i -> per (dF v v i)))

  funL : {a b c : D} {X Y : Rel} -> TyR a b X -> TyR a c Y -> X ~ Y
  funL (tySm r eX) e = ~-trans eX (~-sym (snd (eeL (RV.rl r) e)))
  funL (tyV _ _ eX) (tyV _ _ eY) = ~-trans eX (~-sym eY)
  funL (tyV ea _ _) (tySm r _) = Empty-elim (VR ea r)
  funL (tyV ea _ _) (tyPi _ _ _ _ _ _ ea' _ _ _ _) = Empty-elim (VPi ea ea')
  funL (tyV ea _ _) (tySig _ _ _ _ _ _ ea' _ _ _ _) = Empty-elim (VSig ea ea')
  funL (tyPi _ _ _ _ _ _ ea _ _ _ _) (tyV ea' _ _) = Empty-elim (VPi ea' ea)
  funL d@(tyPi _ _ _ _ _ _ _ _ _ _ _) (tySm r eY) =
    ~-trans (snd (eeL (RV.rl r) d)) (~-sym eY)
  funL (tyPi _ _ _ _ _ _ ea _ _ _ _) (tySig _ _ _ _ _ _ ea' _ _ _ _) =
    Empty-elim (PiSig ea ea')
  funL (tyPi A A' F F' XA XF ea eb dA dF eX) (tyPi B B' G G' YA YF ea' eb' eA eF eY) =
    ~-trans eX (~-trans (Fun-cong XA YA XF YF (per dA) hA
                           (\ v j -> funL (dF v v j) (eF' v v (fst hA j))))
                        (~-sym eY))
    where
      ij = Pi-inj (~~-trans (~~-sym ea') ea)
      eA' : TyR A B' YA
      eA' = TyR-cl2 (fst ij) ~~-refl eA
      eF' : (v v' : D) -> YA v v' -> TyR (app F v) (app G' v') (YF v)
      eF' = \ v v' y -> TyR-cl2 (app-cong (snd ij) ~~-refl) ~~-refl (eF v v' y)
      hA = funL dA eA'
  funL (tySig _ _ _ _ _ _ ea _ _ _ _) (tyV ea' _ _) = Empty-elim (VSig ea' ea)
  funL d@(tySig _ _ _ _ _ _ _ _ _ _ _) (tySm r eY) =
    ~-trans (snd (eeL (RV.rl r) d)) (~-sym eY)
  funL (tySig _ _ _ _ _ _ ea _ _ _ _) (tyPi _ _ _ _ _ _ ea' _ _ _ _) =
    Empty-elim (PiSig ea' ea)
  funL (tySig A A' F F' XA XF ea eb dA dF eX) (tySig B B' G G' YA YF ea' eb' eA eF eY) =
    ~-trans eX (~-trans (SigF-cong XA YA XF YF (per dA) hA
                           (\ v j -> funL (dF v v j) (eF' v v (fst hA j))))
                        (~-sym eY))
    where
      ij = Sig-inj (~~-trans (~~-sym ea') ea)
      eA' : TyR A B' YA
      eA' = TyR-cl2 (fst ij) ~~-refl eA
      eF' : (v v' : D) -> YA v v' -> TyR (app F v) (app G' v') (YF v)
      eF' = \ v v' y -> TyR-cl2 (app-cong (snd ij) ~~-refl) ~~-refl (eF v v' y)
      hA = funL dA eA'

  funR : {a b c : D} {X Y : Rel} -> TyR a b X -> TyR c b Y -> X ~ Y
  funR (tySm r eX) e =
    ~-trans eX (~-trans (I-resp r) (~-sym (snd (eeR (RV.rr r) e))))
  funR (tyV _ _ eX) (tyV _ _ eY) = ~-trans eX (~-sym eY)
  funR (tyV _ eb _) (tySm r _) = Empty-elim (VRr eb r)
  funR (tyV _ eb _) (tyPi _ _ _ _ _ _ _ eb' _ _ _) = Empty-elim (VPi eb eb')
  funR (tyV _ eb _) (tySig _ _ _ _ _ _ _ eb' _ _ _) = Empty-elim (VSig eb eb')
  funR (tyPi _ _ _ _ _ _ _ eb _ _ _) (tyV _ eb' _) = Empty-elim (VPi eb' eb)
  funR d@(tyPi _ _ _ _ _ _ _ _ _ _ _) (tySm r eY) =
    ~-trans (snd (eeR (RV.rr r) d)) (~-sym (~-trans eY (I-resp r)))
  funR (tyPi _ _ _ _ _ _ _ eb _ _ _) (tySig _ _ _ _ _ _ _ eb' _ _ _) =
    Empty-elim (PiSig eb eb')
  funR (tyPi A A' F F' XA XF ea eb dA dF eX) (tyPi B B' G G' YA YF ea' eb' eA eF eY) =
    ~-trans eX (~-trans (Fun-cong XA YA XF YF (per dA) hA
                           (\ v j -> funR (dF v v j) (eF' v v (fst hA j))))
                        (~-sym eY))
    where
      ij = Pi-inj (~~-trans (~~-sym eb') eb)
      eA' : TyR B A' YA
      eA' = TyR-cl2 ~~-refl (fst ij) eA
      eF' : (v v' : D) -> YA v v' -> TyR (app G v) (app F' v') (YF v)
      eF' = \ v v' y -> TyR-cl2 ~~-refl (app-cong (snd ij) ~~-refl) (eF v v' y)
      hA = funR dA eA'
  funR (tySig _ _ _ _ _ _ _ eb _ _ _) (tyV _ eb' _) = Empty-elim (VSig eb' eb)
  funR d@(tySig _ _ _ _ _ _ _ _ _ _ _) (tySm r eY) =
    ~-trans (snd (eeR (RV.rr r) d)) (~-sym (~-trans eY (I-resp r)))
  funR (tySig _ _ _ _ _ _ _ eb _ _ _) (tyPi _ _ _ _ _ _ _ eb' _ _ _) =
    Empty-elim (PiSig eb' eb)
  funR (tySig A A' F F' XA XF ea eb dA dF eX) (tySig B B' G G' YA YF ea' eb' eA eF eY) =
    ~-trans eX (~-trans (SigF-cong XA YA XF YF (per dA) hA
                           (\ v j -> funR (dF v v j) (eF' v v (fst hA j))))
                        (~-sym eY))
    where
      ij = Sig-inj (~~-trans (~~-sym eb') eb)
      eA' : TyR B A' YA
      eA' = TyR-cl2 ~~-refl (fst ij) eA
      eF' : (v v' : D) -> YA v v' -> TyR (app G v) (app F' v') (YF v)
      eF' = \ v v' y -> TyR-cl2 ~~-refl (app-cong (snd ij) ~~-refl) (eF v v' y)
      hA = funR dA eA'

-- a family of types respects the equality of its domain
famR : {A A' F F' : D} {XA : Rel} {XF : D -> Rel} -> TyR A A' XA ->
       ((v v' : D) -> XA v v' -> TyR (app F v) (app F' v') (XF v)) ->
       {v v' : D} -> XA v v' -> XF v ~ XF v'
famR dA dF {v} {v'} i = funR (dF v v' i) (dF v' v' (IsPER.rr (per dA) i))

------------------------------------------------------------------------
-- Type is a PER
------------------------------------------------------------------------

sym : {a b : D} {X : Rel} -> TyR a b X -> TyR b a X
sym (tyV ea eb eX) = tyV eb ea eX
sym (tySm r eX) = tySm (RV.sy r) (~-trans eX (I-resp r))
sym (tyPi A A' F F' XA XF ea eb dA dF eX) = tyPi A' A F' F XA XF eb ea (sym dA) dF' eX
  where
    pA = per dA
    dF' : (v v' : D) -> XA v v' -> TyR (app F' v) (app F v') (XF v)
    dF' v v' i =
      let j = IsPER.sy pA i in
      resp (sym (dF v' v j)) (funR (dF v' v j) (dF v v (IsPER.rl pA i)))
sym (tySig A A' F F' XA XF ea eb dA dF eX) = tySig A' A F' F XA XF eb ea (sym dA) dF' eX
  where
    pA = per dA
    dF' : (v v' : D) -> XA v v' -> TyR (app F' v) (app F v') (XF v)
    dF' v v' i =
      let j = IsPER.sy pA i in
      resp (sym (dF v' v j)) (funR (dF v' v j) (dF v v (IsPER.rl pA i)))

trans : {a b c : D} {X Y : Rel} -> TyR a b X -> TyR b c Y -> TyR a c X
trans (tySm r eX) e = tySm (RV.tr r (fst (eeL (RV.rr r) e))) eX
trans (tyV ea _ eX) (tyV _ eb' _) = tyV ea eb' eX
trans (tyV _ eb _) (tySm r _) = Empty-elim1 (VR eb r)
trans (tyV _ eb _) (tyPi _ _ _ _ _ _ ea' _ _ _ _) = Empty-elim1 (VPi eb ea')
trans (tyV _ eb _) (tySig _ _ _ _ _ _ ea' _ _ _ _) = Empty-elim1 (VSig eb ea')
trans (tyPi _ _ _ _ _ _ _ eb _ _ _) (tyV ea' _ _) = Empty-elim1 (VPi ea' eb)
trans d@(tyPi _ _ _ _ _ _ _ _ _ _ _) (tySm r eY) =
  let h = eeR (RV.rl r) d in
  tySm (RV.tr (fst h) r) (~-trans (snd h) (~-sym (I-resp (fst h))))
trans (tyPi _ _ _ _ _ _ _ eb _ _ _) (tySig _ _ _ _ _ _ ea' _ _ _ _) =
  Empty-elim1 (PiSig eb ea')
trans (tyPi A A' F F' XA XF ea eb dA dF eX) (tyPi B B' G G' YA YF ea' eb' eA eF eY) =
  tyPi A B' F G' XA XF ea eb' (trans dA eA') fam eX
  where
    ij = Pi-inj (~~-trans (~~-sym ea') eb)
    eA' : TyR A' B' YA
    eA' = TyR-cl2 (fst ij) ~~-refl eA
    eF' : (v v' : D) -> YA v v' -> TyR (app F' v) (app G' v') (YF v)
    eF' = \ v v' y -> TyR-cl2 (app-cong (snd ij) ~~-refl) ~~-refl (eF v v' y)
    hA = funR dA (sym eA')
    fam : (v v' : D) -> XA v v' -> TyR (app F v) (app G' v') (XF v)
    fam v v' i = trans (dF v v' i) (eF' v' v' (fst hA (IsPER.rr (per dA) i)))
trans (tySig _ _ _ _ _ _ _ eb _ _ _) (tyV ea' _ _) = Empty-elim1 (VSig ea' eb)
trans d@(tySig _ _ _ _ _ _ _ _ _ _ _) (tySm r eY) =
  let h = eeR (RV.rl r) d in
  tySm (RV.tr (fst h) r) (~-trans (snd h) (~-sym (I-resp (fst h))))
trans (tySig _ _ _ _ _ _ _ eb _ _ _) (tyPi _ _ _ _ _ _ ea' _ _ _ _) =
  Empty-elim1 (PiSig ea' eb)
trans (tySig A A' F F' XA XF ea eb dA dF eX) (tySig B B' G G' YA YF ea' eb' eA eF eY) =
  tySig A B' F G' XA XF ea eb' (trans dA eA') fam eX
  where
    ij = Sig-inj (~~-trans (~~-sym ea') eb)
    eA' : TyR A' B' YA
    eA' = TyR-cl2 (fst ij) ~~-refl eA
    eF' : (v v' : D) -> YA v v' -> TyR (app F' v) (app G' v') (YF v)
    eF' = \ v v' y -> TyR-cl2 (app-cong (snd ij) ~~-refl) ~~-refl (eF v v' y)
    hA = funR dA (sym eA')
    fam : (v v' : D) -> XA v v' -> TyR (app F v) (app G' v') (XF v)
    fam v v' i = trans (dF v v' i) (eF' v' v' (fst hA (IsPER.rr (per dA) i)))

------------------------------------------------------------------------
-- Safety: N <= [A] <= S, and types themselves are safe
------------------------------------------------------------------------

mutual
  lo : {a b : D} {X : Rel} -> TyR a b X -> N <= X
  lo (tyV _ _ eX) n = snd eX (seed-ne n)
  lo (tySm r eX) n = snd eX (I-lo _ (RV.rl r) n)
  lo (tyPi A A' F F' XA XF ea eb dA dF eX) n =
    snd eX (Fun-lo XA XF (per dA) (famR dA dF) (\ v i -> per (dF v v i))
                   (hi dA) (\ v i -> lo (dF v v i)) n)
  lo (tySig A A' F F' XA XF ea eb dA dF eX) n =
    snd eX (SigF-lo XA XF (per dA) (famR dA dF) (\ v i -> per (dF v v i))
                    (lo dA) (\ v i -> lo (dF v v i)) n)

  hi : {a b : D} {X : Rel} -> TyR a b X -> X <= S
  hi (tyV _ _ eX) x = R-safe (fst eX x)
  hi (tySm r eX) x = I-hi _ (RV.rl r) (fst eX x)
  hi (tyPi A A' F F' XA XF ea eb dA dF eX) x =
    Fun-hi XA XF (per dA) (famR dA dF) (\ v i -> per (dF v v i))
           (lo dA) (\ v i -> hi (dF v v i)) (fst eX x)
  hi (tySig A A' F F' XA XF ea eb dA dF eX) x =
    SigF-hi XA XF (per dA) (famR dA dF) (\ v i -> per (dF v v i))
            (hi dA) (\ v i -> hi (dF v v i)) (fst eX x)

safe : {a b : D} {X : Rel} -> TyR a b X -> S a b
safe (tyV ea eb _) = S-back ea eb S-V
safe (tySm r _) = R-safe r
safe (tyPi A A' F F' XA XF ea eb dA dF eX) =
  S-back ea eb (S-Pi (safe dA) (k (safe (dF x x (lo dA nx)))))
  where
    x  = fst (ext F F')
    nx = fst (snd (ext F F'))
    k  = snd (snd (ext F F'))
safe (tySig A A' F F' XA XF ea eb dA dF eX) =
  S-back ea eb (S-Sig (safe dA) (k (safe (dF x x (lo dA nx)))))
  where
    x  = fst (ext F F')
    nx = fst (snd (ext F F'))
    k  = snd (snd (ext F F'))

------------------------------------------------------------------------
-- Inversion
------------------------------------------------------------------------

invV : {a b : D} {X : Rel} -> TyR a b X -> a ~~ Vd -> X ~ R
invV (tyV _ _ eX) e = eX
invV (tySm r _) e = Empty-elim (VR e r)
invV (tyPi _ _ _ _ _ _ ea _ _ _ _) e = Empty-elim (VPi e ea)
invV (tySig _ _ _ _ _ _ ea _ _ _ _) e = Empty-elim (VSig e ea)

-- the type V
tyVV : TyR Vd Vd R
tyVV = tyV ~~-refl ~~-refl ~-refl

record PiInv (A A' F F' : D) (X : Rel) : Set1 where
  constructor piinv
  field
    XA : Rel
    XF : D -> Rel
    dA : TyR A A' XA
    dF : (v v' : D) -> XA v v' -> TyR (app F v) (app F' v') (XF v)
    eX : X ~ Fun XA XF

record SigInv (A A' F F' : D) (X : Rel) : Set1 where
  constructor siginv
  field
    XA : Rel
    XF : D -> Rel
    dA : TyR A A' XA
    dF : (v v' : D) -> XA v v' -> TyR (app F v) (app F' v') (XF v)
    eX : X ~ SigF XA XF

private
  piinvTr : {A0 A0' F0 F0' A A' F F' : D} {X : Rel} ->
            A0 ~~ A -> F0 ~~ F -> A0' ~~ A' -> F0' ~~ F' ->
            PiInv A0 A0' F0 F0' X -> PiInv A A' F F' X
  piinvTr e1 e2 e3 e4 (piinv XA XF dA dF eX) =
    piinv XA XF (TyR-cl2 e1 e3 dA)
      (\ v v' i -> TyR-cl2 (app-cong e2 ~~-refl) (app-cong e4 ~~-refl) (dF v v' i)) eX

  siginvTr : {A0 A0' F0 F0' A A' F F' : D} {X : Rel} ->
             A0 ~~ A -> F0 ~~ F -> A0' ~~ A' -> F0' ~~ F' ->
             SigInv A0 A0' F0 F0' X -> SigInv A A' F F' X
  siginvTr e1 e2 e3 e4 (siginv XA XF dA dF eX) =
    siginv XA XF (TyR-cl2 e1 e3 dA)
      (\ v v' i -> TyR-cl2 (app-cong e2 ~~-refl) (app-cong e4 ~~-refl) (dF v v' i)) eX

invPi : {a b A F A' F' : D} {X : Rel} -> TyR a b X ->
        a ~~ Pi A F -> b ~~ Pi A' F' -> PiInv A A' F F' X
invPi (tyV ea _ _) e e' = Empty-elim1 (VPi ea e)
invPi {a} {b} {A} {F} {A'} {F'} (tySm r eX) e e' =
  piinv (I A) (\ w -> I (app F w)) (tySm (fst sm) ~-refl)
        (\ v v' i -> tySm (snd sm v v' i) ~-refl)
        (~-trans eX (piInt a A F e rAA (FamEq-l V rAA (snd sm))))
  where
    sm = piSmall2 r e e'
    rAA = RV.rl (fst sm)
invPi (tyPi A0 A0' F0 F0' XA XF ea eb dA dF eX) e e' =
  piinvTr (fst i1) (snd i1) (fst i2) (snd i2) (piinv XA XF dA dF eX)
  where
    i1 = Pi-inj (~~-trans (~~-sym ea) e)
    i2 = Pi-inj (~~-trans (~~-sym eb) e')
invPi (tySig _ _ _ _ _ _ ea _ _ _ _) e e' = Empty-elim1 (PiSig e ea)

invSig : {a b A F A' F' : D} {X : Rel} -> TyR a b X ->
         a ~~ Sig A F -> b ~~ Sig A' F' -> SigInv A A' F F' X
invSig (tyV ea _ _) e e' = Empty-elim1 (VSig ea e)
invSig {a} {b} {A} {F} {A'} {F'} (tySm r eX) e e' =
  siginv (I A) (\ w -> I (app F w)) (tySm (fst sm) ~-refl)
         (\ v v' i -> tySm (snd sm v v' i) ~-refl)
         (~-trans eX (sigInt a A F e rAA (FamEq-l V rAA (snd sm))))
  where
    sm = sigSmall2 r e e'
    rAA = RV.rl (fst sm)
invSig (tyPi _ _ _ _ _ _ ea _ _ _ _) e e' = Empty-elim1 (PiSig ea e)
invSig (tySig A0 A0' F0 F0' XA XF ea eb dA dF eX) e e' =
  siginvTr (fst i1) (snd i1) (fst i2) (snd i2) (siginv XA XF dA dF eX)
  where
    i1 = Sig-inj (~~-trans (~~-sym ea) e)
    i2 = Sig-inj (~~-trans (~~-sym eb) e')

------------------------------------------------------------------------
-- Building Pi and Sigma types from a pointwise family of types
------------------------------------------------------------------------

record TyV (a b : D) : Set1 where
  constructor tyv
  field
    X  : Rel
    ty : TyR a b X

-- the family of interpretations, made independent of the proofs
mkFam : (XA : Rel) -> ((v : D) -> XA v v -> Rel) -> D -> Rel
mkFam XA Y v w w' = Sigma (XA v v) (\ p -> Y v p w w')

private
  famOf : {A A' F F' : D} {XA : Rel} -> TyR A A' XA ->
          (h : (v v' : D) -> XA v v' -> TyV (app F v) (app F' v')) ->
          (v v' : D) -> XA v v' ->
          TyR (app F v) (app F' v') (mkFam XA (\ w p -> TyV.X (h w w p)) v)
  famOf {XA = XA} dA h v v' i =
    resp (TyV.ty (h v v' i))
      (~-trans (funL (TyV.ty (h v v' i)) (TyV.ty (h v v p0))) toFam)
    where
      p0 = IsPER.rl (per dA) i
      toFam : TyV.X (h v v p0) ~ mkFam XA (\ w p -> TyV.X (h w w p)) v
      toFam = (\ y -> p0 , y) ,
              (\ { (q , y) -> fst (funL (TyV.ty (h v v q)) (TyV.ty (h v v p0))) y })

piTy : {a b A A' F F' : D} {XA : Rel} -> a ~~ Pi A F -> b ~~ Pi A' F' ->
       TyR A A' XA -> ((v v' : D) -> XA v v' -> TyV (app F v) (app F' v')) -> TyV a b
piTy {XA = XA} ea eb dA h =
  tyv _ (tyPi _ _ _ _ XA _ ea eb dA (famOf dA h) ~-refl)

sigTy : {a b A A' F F' : D} {XA : Rel} -> a ~~ Sig A F -> b ~~ Sig A' F' ->
        TyR A A' XA -> ((v v' : D) -> XA v v' -> TyV (app F v) (app F' v')) -> TyV a b
sigTy {XA = XA} ea eb dA h =
  tyv _ (tySig _ _ _ _ XA _ ea eb dA (famOf dA h) ~-refl)

-- the interpretations of a pointwise family of types agree with the
-- proof-independent family  mkFam
famCoh : {f g : D -> D} {XA : Rel} -> IsPER XA ->
         (h : (v v' : D) -> XA v v' -> TyV (f v) (g v')) ->
         {v v' : D} (i : XA v v') ->
         TyV.X (h v v' i) ~ mkFam XA (\ w p -> TyV.X (h w w p)) v
famCoh {XA = XA} pA h {v} {v'} i =
  ~-trans (funL (TyV.ty (h v v' i)) (TyV.ty (h v v p0)))
    ((\ y -> p0 , y) ,
     (\ { (q , y) -> fst (funL (TyV.ty (h v v q)) (TyV.ty (h v v p0))) y }))
  where p0 = IsPER.rl pA i

------------------------------------------------------------------------
-- Interpretations are closed under the equality of D
------------------------------------------------------------------------

mutual
  TyR-elL : {a b : D} {X : Rel} -> TyR a b X -> ClL X
  TyR-elL (tyV _ _ eX) e x = snd eX (R-cl e (fst eX x))
  TyR-elL (tySm r eX) e x = snd eX (I-el e (fst eX x))
  TyR-elL (tyPi A A' F F' XA XF ea eb dA dF eX) e x =
    snd eX (\ v v' i -> TyR-elL (dF v v' i) (app-cong e ~~-refl) (fst eX x v v' i))
  TyR-elL (tySig A A' F F' XA XF ea eb dA dF eX) {v} {w} {v'} e x =
    snd eX (i' , TyR-elL (dF (pr1 w) (pr1 v') i') (pr2-cong e) (fst (famR dA dF k) j))
    where
      i = fst (fst eX x)
      j = snd (fst eX x)
      i' = TyR-elL dA (pr1-cong e) i
      k = TyR-elR dA (pr1-cong e) (IsPER.rl (per dA) i)

  TyR-elR : {a b : D} {X : Rel} -> TyR a b X -> ClR X
  TyR-elR (tyV _ _ eX) e x = snd eX (CandCl.R-cl2 V ~~-refl e (fst eX x))
  TyR-elR (tySm r eX) e x = snd eX (I-er e (fst eX x))
  TyR-elR (tyPi A A' F F' XA XF ea eb dA dF eX) e x =
    snd eX (\ v v' i -> TyR-elR (dF v v' i) (app-cong e ~~-refl) (fst eX x v v' i))
  TyR-elR (tySig A A' F F' XA XF ea eb dA dF eX) {v} {v'} {w'} e x =
    snd eX (TyR-elR dA (pr1-cong e) (fst (fst eX x)) ,
            TyR-elR (dF (pr1 v) (pr1 v') (fst (fst eX x))) (pr2-cong e) (snd (fst eX x)))

TyR-el2 : {a b v v' w w' : D} {X : Rel} -> TyR a b X -> v ~~ w -> v' ~~ w' -> X v v' -> X w w'
TyR-el2 d e e' x = TyR-elR d e' (TyR-elL d e x)

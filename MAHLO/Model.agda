{-# OPTIONS --without-K --exact-split --safe #-}

------------------------------------------------------------------------
-- MAHLO/Model.agda
--
-- Phase P2 of mahlo-plan.tex: the term model of Sec. 6 extended with
-- a denotation of the raw syntax (MAHLO/Syntax.agda), as in
-- Abel--Coquand Sec. 5.1.  The syntactic Pi, Sigma, Nat, V are
-- renamed tPi, tSigma, tNat, tV to keep them apart from those of D.  On top of the abstract TermModel of P1:
--
--   * the element V of D (not a code), zero, successor, rec, pairing;
--   * NatR is generated by zero, successor and the neutrals (it has
--     these introduction rules and the corresponding induction);
--   * den t rho is the value of t in an environment rho, with one
--     equation per constructor and the substitution law.
--
-- Concretely D is the set of terms, ~~ is beta-delta conversion and
-- den t rho = t[rho]; all equations hold up to ~~.  Fhat and Ghat
-- denote applications of f and g (the delta-equations hold in D).
------------------------------------------------------------------------

open import MAHLO.Basic
open import MAHLO.TermModel
open import MAHLO.Syntax
  renaming (Pi to tPi ; Sigma to tSigma ; Nat to tNat ; V to tV)

module MAHLO.Model (TM : TermModel) where

open TermModel TM

Env : Num -> Set
Env n = Fin n -> D

cons : {n : Num} -> Env n -> D -> Env (suc n)
cons rho d fzero    = d
cons rho d (fsuc i) = rho i

record Model : Set1 where
  field
    Vd    : D
    zeroD : D
    sucD  : D -> D
    recD  : D -> D -> D -> D -> D
    pairD : D -> D -> D

    -- V is a new constructor, and safe
    V-Pi  : {A F : D} -> Vd ~~ Pi A F -> Empty
    V-Sig : {A F : D} -> Vd ~~ Sig A F -> Empty
    V-Nat : Vd ~~ Nat -> Empty
    V-U   : {f g : D} -> Vd ~~ U f g -> Empty
    ne-V  : {b : D} -> N Vd b -> Empty
    S-V   : S Vd Vd

    -- natural numbers
    NatR-zero : NatR zeroD zeroD
    NatR-suc  : {n n' : D} -> NatR n n' -> NatR (sucD n) (sucD n')
    NatR-ind  : (P : D -> D -> Set) ->
                ({n m n' : D} -> n ~~ m -> P n n' -> P m n') ->
                ({n n' m' : D} -> n' ~~ m' -> P n n' -> P n m') ->
                ({n n' : D} -> N n n' -> P n n') ->
                P zeroD zeroD ->
                ({n n' : D} -> NatR n n' -> P n n' -> P (sucD n) (sucD n')) ->
                {n n' : D} -> NatR n n' -> P n n'
    sucD-cong  : {a a' : D} -> a ~~ a' -> sucD a ~~ sucD a'
    recD-cong  : {C C' z z' s s' n n' : D} -> C ~~ C' -> z ~~ z' -> s ~~ s' -> n ~~ n' ->
                 recD C z s n ~~ recD C' z' s' n'
    pairD-cong : {a a' b b' : D} -> a ~~ a' -> b ~~ b' -> pairD a b ~~ pairD a' b'
    rec-zero : {C z s : D} -> recD C z s zeroD ~~ z
    rec-suc  : {C z s n : D} ->
               recD C z s (sucD n) ~~ app (app s n) (recD C z s n)
    ne-rec   : {C C' z z' s s' n n' : D} -> S C C' -> S z z' -> S s s' ->
               N n n' -> N (recD C z s n) (recD C' z' s' n')

    -- pairs
    pr1-pair : {a b : D} -> pr1 (pairD a b) ~~ a
    pr2-pair : {a b : D} -> pr2 (pairD a b) ~~ b

    -- denotation
    den : {n : Num} -> Expr n -> Env n -> D

    den-subst : {h g : Num} (s : Sub h g) (rho : Env h) (rho' : Env g) ->
                ((i : Fin g) -> rho' i ~~ den (s i) rho) ->
                (t : Expr g) -> den (substExpr s t) rho ~~ den t rho'

    den-Var   : {n : Num} {rho : Env n} (i : Fin n) -> den (Var i) rho ~~ rho i
    den-Lam   : {n : Num} {rho : Env n} (A : Expr n) (t : Expr (suc n)) (d : D) ->
                app (den (Lam A t) rho) d ~~ den t (cons rho d)
    den-App   : {n : Num} {rho : Env n} (t u : Expr n) ->
                den (App t u) rho ~~ app (den t rho) (den u rho)
    den-Pi    : {n : Num} {rho : Env n} (A F : Expr n) ->
                den (tPi A F) rho ~~ Pi (den A rho) (den F rho)
    den-Sigma : {n : Num} {rho : Env n} (A F : Expr n) ->
                den (tSigma A F) rho ~~ Sig (den A rho) (den F rho)
    den-Pair  : {n : Num} {rho : Env n} (t u : Expr n) ->
                den (Pair t u) rho ~~ pairD (den t rho) (den u rho)
    den-Fst   : {n : Num} {rho : Env n} (t : Expr n) ->
                den (Fst t) rho ~~ pr1 (den t rho)
    den-Snd   : {n : Num} {rho : Env n} (t : Expr n) ->
                den (Snd t) rho ~~ pr2 (den t rho)
    den-Nat   : {n : Num} {rho : Env n} -> den tNat rho ~~ Nat
    den-Zero  : {n : Num} {rho : Env n} -> den Zero rho ~~ zeroD
    den-Suc   : {n : Num} {rho : Env n} (t : Expr n) ->
                den (Suc t) rho ~~ sucD (den t rho)
    den-Rec   : {n : Num} {rho : Env n} (C z s k : Expr n) ->
                den (Rec C z s k) rho ~~
                   recD (den C rho) (den z rho) (den s rho) (den k rho)
    den-V     : {n : Num} {rho : Env n} -> den tV rho ~~ Vd
    den-Ucode : {n : Num} {rho : Env n} (f g : Expr n) ->
                den (Ucode f g) rho ~~ U (den f rho) (den g rho)
    den-Fhat  : {n : Num} {rho : Env n} (f g A F : Expr n) ->
                den (Fhat f g A F) rho ~~
                   app (app (den f rho) (den A rho)) (den F rho)
    den-Ghat  : {n : Num} {rho : Env n} (f g A F c : Expr n) ->
                den (Ghat f g A F c) rho ~~
                   app (app (app (den g rho) (den A rho)) (den F rho)) (den c rho)

  ----------------------------------------------------------------------
  -- derived laws
  ----------------------------------------------------------------------

  -- syntactic equality gives equal denotations
  den-Eq : {n : Num} {t t' : Expr n} (rho : Env n) -> Eq t t' -> den t rho ~~ den t' rho
  den-Eq rho refl = ~~-refl

  -- pointwise equal environments
  den-ext : {n : Num} (rho rho' : Env n) -> ((i : Fin n) -> rho i ~~ rho' i) ->
            (t : Expr n) -> den t rho ~~ den t rho'
  den-ext rho rho' e t =
    ~~-trans (den-Eq rho (Eq-sym (substExpr-id t)))
      (den-subst idSub rho rho' (\ i -> ~~-trans (~~-sym (e i)) (~~-sym (den-Var i))) t)

  -- renaming
  den-ren : {n m : Num} (r : Ren n m) (rho : Env m) (t : Expr n) ->
            den (renExpr r t) rho ~~ den t (\ i -> rho (r i))
  den-ren r rho t =
    ~~-trans (den-Eq rho (ren-as-subst r t))
      (den-subst (\ i -> Var (r i)) rho (\ i -> rho (r i))
         (\ i -> ~~-sym (den-Var (r i))) t)

  -- weakening
  den-wk : {n : Num} (rho : Env (suc n)) (t : Expr n) ->
           den (wkExpr t) rho ~~ den t (\ i -> rho (fsuc i))
  den-wk rho t = den-ren wkRen rho t

  den-wk-cons : {n : Num} (rho : Env n) (d : D) (t : Expr n) ->
                den (wkExpr t) (cons rho d) ~~ den t rho
  den-wk-cons rho d t = den-wk (cons rho d) t

  -- single substitution
  den-subst1 : {n : Num} (rho : Env n) (B : Expr (suc n)) (a : Expr n) ->
               den (subst1 B a) rho ~~ den B (cons rho (den a rho))
  den-subst1 rho B a = den-subst (subst1Sub a) rho (cons rho (den a rho)) e B
    where
      e : (i : Fin _) -> cons rho (den a rho) i ~~ den (subst1Sub a i) rho
      e fzero    = ~~-refl
      e (fsuc i) = ~~-sym (den-Var i)

  -- environments extended by equal values
  den-cons : {n : Num} (rho : Env n) {d d' : D} (B : Expr (suc n)) -> d ~~ d' ->
             den B (cons rho d) ~~ den B (cons rho d')
  den-cons rho B e = den-ext (cons rho _) (cons rho _) pw B
    where
      pw : (i : Fin _) -> cons rho _ i ~~ cons rho _ i
      pw fzero    = e
      pw (fsuc i) = ~~-refl

  -- the substitution C[S x / x]
  den-sucSub : {n : Num} (rho : Env n) (d : D) (C : Expr (suc n)) ->
               den (substExpr sucSub C) (cons rho d) ~~ den C (cons rho (sucD d))
  den-sucSub rho d C = den-subst sucSub (cons rho d) (cons rho (sucD d)) e C
    where
      e : (i : Fin _) -> cons rho (sucD d) i ~~ den (sucSub i) (cons rho d)
      e fzero    = ~~-sym (~~-trans (den-Suc x0) (sucD-cong (den-Var fzero)))
      e (fsuc i) = ~~-sym (den-Var (fsuc i))

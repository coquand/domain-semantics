{-# OPTIONS --without-K --exact-split --safe #-}

------------------------------------------------------------------------
-- MAHLO/Concrete/Rel.agda
--
-- The three base PERs of the concrete model (plan Sec. 6.2):
--   S a b   a, b normalise to values with equal eta-normal forms
--   N a b   the same, with neutral values
--   NatR    generated by 0, S and N, up to conversion
-- They are PERs and closed under conversion (by Church-Rosser only).
------------------------------------------------------------------------

module MAHLO.Concrete.Rel where

open import MAHLO.Basic
open import MAHLO.Syntax using (Num ; zero ; suc ; cong2 ; cong4)
open import MAHLO.Concrete.Tm
open import MAHLO.Concrete.Red
open import MAHLO.Concrete.Confluence
open import MAHLO.Concrete.Conv
open import MAHLO.Concrete.Values
open import MAHLO.Concrete.Eta

record SR (a b : Tm) : Set where
  constructor sr
  field
    va : Tm
    vb : Tm
    da : a ⇓ va
    db : b ⇓ vb
    eq : Eq (etanf va) (etanf vb)

record NR (a b : Tm) : Set where
  constructor nr
  field
    va : Tm
    vb : Tm
    da : a ⇓ va
    db : b ⇓ vb
    na : Ne va
    nb : Ne vb
    eq : Eq (etanf va) (etanf vb)

------------------------------------------------------------------------
-- PERs, closed under conversion
------------------------------------------------------------------------

SR-sym : {a b : Tm} -> SR a b -> SR b a
SR-sym (sr va vb da db e) = sr vb va db da (Eq-sym e)

SR-trans : {a b c : Tm} -> SR a b -> SR b c -> SR a c
SR-trans (sr va vb da db e) (sr vb' vc db' dc e') =
  sr va vc da dc (Eq-trans e (Eq-trans (Eq-cong etanf (⇓-unique db db')) e'))

SR-resp : {a a' b : Tm} -> Conv a a' -> SR a b -> SR a' b
SR-resp c (sr va vb da db e) = sr va vb (⇓-conv c da) db e

NR-sym : {a b : Tm} -> NR a b -> NR b a
NR-sym (nr va vb da db na nb e) = nr vb va db da nb na (Eq-sym e)

NR-trans : {a b c : Tm} -> NR a b -> NR b c -> NR a c
NR-trans (nr va vb da db na nb e) (nr vb' vc db' dc nb' nc e') =
  nr va vc da dc na nc (Eq-trans e (Eq-trans (Eq-cong etanf (⇓-unique db db')) e'))

NR-resp : {a a' b : Tm} -> Conv a a' -> NR a b -> NR a' b
NR-resp c (nr va vb da db na nb e) = nr va vb (⇓-conv c da) db na nb e

NR-SR : {a b : Tm} -> NR a b -> SR a b
NR-SR (nr va vb da db na nb e) = sr va vb da db e

------------------------------------------------------------------------
-- Natural numbers
------------------------------------------------------------------------

data NatR (a b : Tm) : Set where
  nat-ne : NR a b -> NatR a b
  nat-ze : Conv a tze -> Conv b tze -> NatR a b
  nat-sc : {n n' : Tm} -> Conv a (tsc n) -> Conv b (tsc n') -> NatR n n' -> NatR a b

-- small facts about conversion to numerals and neutrals
cv-sc-inj : {a b : Tm} -> Conv (tsc a) (tsc b) -> Conv a b
cv-sc-inj (c , (p , q)) =
  let x = red-sc p ; y = red-sc q
      e = Eq-trans (Eq-sym (fst (snd x))) (fst (snd y))
  in fst x , (snd (snd x) , transport (Red _) (Eq-sym (sc-inj e)) (snd (snd y)))
  where
    sc-inj : {u v : Tm} -> Eq (tsc u) (tsc v) -> Eq u v
    sc-inj refl = refl

cv-ze-sc : {n : Tm} -> Conv tze (tsc n) -> Empty
cv-ze-sc (c , (p , q)) = h (Eq-trans (Eq-sym (red-ze p)) (fst (snd (red-sc q))))
  where h : {m : Tm} -> Eq tze (tsc m) -> Empty
        h ()

-- a neutral value is not convertible to 0 or to a successor
ne-ze : {a u : Tm} -> a ⇓ u -> Ne u -> Conv a tze -> Empty
ne-ze d n c = h (val-red v-ze (fst (⇓-conv c d))) n
  where h : {u : Tm} -> Eq u tze -> Ne u -> Empty
        h refl ()

ne-sc : {a u n : Tm} -> a ⇓ u -> Ne u -> Conv a (tsc n) -> Empty
ne-sc d n c = h (fst (snd (red-sc (fst (⇓-conv c d))))) n
  where h : {u m : Tm} -> Eq u (tsc m) -> Ne u -> Empty
        h refl ()

NatR-sym : {a b : Tm} -> NatR a b -> NatR b a
NatR-sym (nat-ne x) = nat-ne (NR-sym x)
NatR-sym (nat-ze p q) = nat-ze q p
NatR-sym (nat-sc p q x) = nat-sc q p (NatR-sym x)

NatR-resp : {a a' b : Tm} -> Conv a a' -> NatR a b -> NatR a' b
NatR-resp c (nat-ne x) = nat-ne (NR-resp c x)
NatR-resp c (nat-ze p q) = nat-ze (cv-trans (cv-sym c) p) q
NatR-resp c (nat-sc p q x) = nat-sc (cv-trans (cv-sym c) p) q x

NatR-trans : {a b c : Tm} -> NatR a b -> NatR b c -> NatR a c
NatR-trans (nat-ne x) (nat-ne y) = nat-ne (NR-trans x y)
NatR-trans (nat-ne x) (nat-ze p q) = Empty-elim (ne-ze (NR.db x) (NR.nb x) p)
NatR-trans (nat-ne x) (nat-sc p q y) = Empty-elim (ne-sc (NR.db x) (NR.nb x) p)
NatR-trans (nat-ze p q) (nat-ne y) = Empty-elim (ne-ze (NR.da y) (NR.na y) q)
NatR-trans (nat-ze p q) (nat-ze p' q') = nat-ze p q'
NatR-trans (nat-ze p q) (nat-sc p' q' y) = Empty-elim (cv-ze-sc (cv-trans (cv-sym q) p'))
NatR-trans (nat-sc p q x) (nat-ne y) = Empty-elim (ne-sc (NR.da y) (NR.na y) q)
NatR-trans (nat-sc p q x) (nat-ze p' q') = Empty-elim (cv-ze-sc (cv-trans (cv-sym p') q))
NatR-trans (nat-sc p q x) (nat-sc p' q' y) =
  nat-sc p q' (NatR-trans x (NatR-resp (cv-sc-inj (cv-trans (cv-sym p') q)) y))

-- NatR <= S
NatR-SR : {a b : Tm} -> NatR a b -> SR a b
NatR-SR (nat-ne x) = NR-SR x
NatR-SR (nat-ze p q) = sr tze tze (conv-val p v-ze) (conv-val q v-ze) refl
NatR-SR (nat-sc p q x) =
  let s = NatR-SR x in
  sr (tsc (SR.va s)) (tsc (SR.vb s))
     (conv-val (cv-trans p (cv-sc (cv-red (fst (SR.da s))))) (v-sc (snd (SR.da s))))
     (conv-val (cv-trans q (cv-sc (cv-red (fst (SR.db s))))) (v-sc (snd (SR.db s))))
     (Eq-cong tsc (SR.eq s))

-- induction, for motives closed under conversion
NatR-ind : (P : Tm -> Tm -> Set) ->
           ({n m n' : Tm} -> Conv n m -> P n n' -> P m n') ->
           ({n n' m' : Tm} -> Conv n' m' -> P n n' -> P n m') ->
           ({n n' : Tm} -> NR n n' -> P n n') ->
           P tze tze ->
           ({n n' : Tm} -> NatR n n' -> P n n' -> P (tsc n) (tsc n')) ->
           {n n' : Tm} -> NatR n n' -> P n n'
NatR-ind P clL clR pN pZ pS (nat-ne x) = pN x
NatR-ind P clL clR pN pZ pS (nat-ze p q) = clR (cv-sym q) (clL (cv-sym p) pZ)
NatR-ind P clL clR pN pZ pS (nat-sc p q x) =
  clR (cv-sym q) (clL (cv-sym p) (pS x (NatR-ind P clL clR pN pZ pS x)))

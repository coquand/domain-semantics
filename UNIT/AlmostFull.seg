-- Almost-full relations and the intuitionistic Ramsey theorem, after
-- Th. Coquand, "A direct proof of Ramsey's Theorem" (note, 2010).
--
-- Predicates on finite sequences (lists, the latest element first: x s is
-- consL x s).  A[x] s = A s or A (x s);  A_x s = A (x s).  Well-founded
-- trees WT; p secures A: p = z and A () holds, or p = sp f and f x secures
-- A[x] for all x.  An n-ary relation is a predicate R with Ar n R.
-- Theorem 0.1 (ram): if p secures A v R and q secures B v S (R, S n-ary)
-- then p (x)_n q secures A v B v (R & S).  Corollary: almost-full binary
-- relations are closed under intersection (afInter).
-- Everything is Bool-valued (decidable predicates).
level l ;
open Base ; open Prelude[l+] ; open ScottOrder[l] ;
module W = Dilator[l] ;
module PL = Prelude[l] ;
module DP = DilPtyx[l] ;
module LW = LOWF[l] ;
module CF0 = CatEmbFin[l] ;

-- Bool helpers
oE : (a b : W.Bool) -> Id W.Bool (W.orB a b) true -> W.Or (Id W.Bool a true) (Id W.Bool b true) = split {
  false -> \ b h -> inr h ; true -> \ b h -> inl (refl true) } ;
oL : (a b : W.Bool) -> Id W.Bool a true -> Id W.Bool (W.orB a b) true = split {
  false -> \ b h -> W.absurdB (Id W.Bool b true) h ; true -> \ b h -> refl true } ;
oR : (a b : W.Bool) -> Id W.Bool b true -> Id W.Bool (W.orB a b) true = split {
  false -> \ b h -> h ; true -> \ b h -> refl true } ;
orEl (A B C : U l) (f : A -> C) (g : B -> C) : W.Or A B -> C = split { inl a -> f a ; inr b -> g b } ;
eqTF (a : W.Bool) (h : Id W.Bool a true) (h' : Id W.Bool a false) (C : U l) : C =
  W.absurdB C (PL.trans W.Bool false a true (PL.sym W.Bool a false h') h) ;

module AF (X : U l) {
  L : U l = W.List X ;
  Pred : U l = L -> W.Bool ;
  up (A : Pred) (x : X) : Pred = \ s -> W.orB (A s) (A (consL x s)) ;
  sh (A : Pred) (x : X) : Pred = \ s -> A (consL x s) ;
  orP (A B : Pred) : Pred = \ s -> W.orB (A s) (B s) ;
  andP (A B : Pred) : Pred = \ s -> W.andB (A s) (B s) ;
  T (A : Pred) (s : L) : U l = Id W.Bool (A s) true ;
  Sub (A B : Pred) : U l = (s : L) -> T A s -> T B s ;

  data WT : U l = z | sp (f : X -> WT) ;
  Sec : WT -> Pred -> U l = split {
    z -> \ A -> T A nilL ;
    sp f | r -> \ A -> (x : X) -> r x (up A x) } ;

  -- inclusions
  subUp (A B : Pred) (h : Sub A B) (x : X) : Sub (up A x) (up B x) = \ s e ->
    orEl (T A s) (T A (consL x s)) (T (up B x) s)
      (\ a -> oL (B s) (B (consL x s)) (h s a)) (\ a -> oR (B s) (B (consL x s)) (h (consL x s) a))
      (oE (A s) (A (consL x s)) e) ;
  secMono : (p : WT) (A B : Pred) -> Sub A B -> Sec p A -> Sec p B = split {
    z -> \ A B h s -> h nilL s ;
    sp f | r -> \ A B h s x -> r x (up A x) (up B x) (subUp A B h x) (s x) } ;
  secTop : (p : WT) (A : Pred) -> T A nilL -> Sec p A = split {
    z -> \ A h -> h ;
    sp f | r -> \ A h x -> r x (up A x) (oL (A nilL) (A (consL x nilL)) h) } ;

  -- arities
  Ar : W.N -> Pred -> U l = split {
    zero -> \ R -> (s : L) -> Id W.Bool (R s) (R nilL) ;
    suc n | r -> \ R -> Id W.Bool (R nilL) false * ((x : X) -> r (sh R x)) } ;

  -- the product of trees
  tens0 : WT -> WT -> WT = split {
    z -> \ q -> q ;
    sp f | r -> \ q -> sp (\ x -> r x q) } ;
  tQ (rec : WT -> WT -> WT) (f : X -> WT) (rf : X -> WT -> WT) : WT -> WT = split {
    z -> z ;
    sp g | rg -> sp (\ x -> rec (rf x (sp g)) (rg x)) } ;
  tP (rec : WT -> WT -> WT) : WT -> WT -> WT = split {
    z -> \ q -> z ;
    sp f | rf -> tQ rec f rf } ;
  tens : W.N -> WT -> WT -> WT = split {
    zero -> tens0 ;
    suc m | r -> tP r } ;

  Goal (A B R S : Pred) : Pred = orP (orP A B) (andP R S) ;
  Stmt (n : W.N) (p q : WT) : U l = (A B R S : Pred) -> Ar n R -> Ar n S -> Sec p (orP A R) -> Sec q (orP B S) ->
    Sec (tens n p q) (Goal A B R S) ;

  -- small inclusions used below
  gA (A B R S : Pred) (s : L) (h : T A s) : T (Goal A B R S) s =
    oL (orP A B s) (andP R S s) (oL (A s) (B s) h) ;
  gB (A B R S : Pred) (s : L) (h : T B s) : T (Goal A B R S) s =
    oL (orP A B s) (andP R S s) (oR (A s) (B s) h) ;
  gRS (A B R S : Pred) (s : L) (h1 : T R s) (h2 : T S s) : T (Goal A B R S) s =
    oR (orP A B s) (andP R S s) (W.andB-intro (R s) (S s) h1 h2) ;
  -- a goal at x s is in the lifted goal at s
  gX (G : Pred) (x : X) (s : L) (h : T G (consL x s)) : T (up G x) s = oR (G s) (G (consL x s)) h ;
  g0 (G : Pred) (x : X) (s : L) (h : T G s) : T (up G x) s = oL (G s) (G (consL x s)) h ;

  -- n = 0
  ram0 : (p q : WT) -> Stmt zero p q = split {
    z -> \ q A B R S aR aS hp hq ->
      orEl (T A nilL) (T R nilL) (Sec q (Goal A B R S))
        (\ a -> secTop q (Goal A B R S) (gA A B R S nilL a))
        (\ r -> secMono q (orP B S) (Goal A B R S)
          (\ s e -> orEl (T B s) (T S s) (T (Goal A B R S) s)
            (\ b -> gB A B R S s b)
            (\ c -> gRS A B R S s (PL.trans W.Bool (R s) (R nilL) true (aR s) r) c)
            (oE (B s) (S s) e))
          hq)
        (oE (A nilL) (R nilL) hp) ;
    sp f | rf -> \ q A B R S aR aS hp hq x ->
      secMono (tens0 (f x) q) (Goal (up A x) B R S) (up (Goal A B R S) x)
        (\ s e -> orEl (T (orP (up A x) B) s) (T (andP R S) s) (T (up (Goal A B R S) x) s)
          (\ e1 -> orEl (T (up A x) s) (T B s) (T (up (Goal A B R S) x) s)
            (\ e2 -> orEl (T A s) (T A (consL x s)) (T (up (Goal A B R S) x) s)
              (\ a -> g0 (Goal A B R S) x s (gA A B R S s a))
              (\ a -> gX (Goal A B R S) x s (gA A B R S (consL x s) a))
              (oE (A s) (A (consL x s)) e2))
            (\ b -> g0 (Goal A B R S) x s (gB A B R S s b))
            (oE (up A x s) (B s) e1))
          (\ e1 -> g0 (Goal A B R S) x s (gRS A B R S s (W.andB-l (R s) (S s) e1) (W.andB-r (R s) (S s) e1)))
          (oE (orP (up A x) B s) (andP R S s) e))
        (rf x q (up A x) B R S aR aS
          (secMono (f x) (up (orP A R) x) (orP (up A x) R)
            (\ s e -> orEl (T (orP A R) s) (T (orP A R) (consL x s)) (T (orP (up A x) R) s)
              (\ e1 -> orEl (T A s) (T R s) (T (orP (up A x) R) s)
                (\ a -> oL (up A x s) (R s) (oL (A s) (A (consL x s)) a))
                (\ r -> oR (up A x s) (R s) r)
                (oE (A s) (R s) e1))
              (\ e1 -> orEl (T A (consL x s)) (T R (consL x s)) (T (orP (up A x) R) s)
                (\ a -> oL (up A x s) (R s) (oR (A s) (A (consL x s)) a))
                (\ r -> oR (up A x s) (R s) (PL.trans W.Bool (R s) (R nilL) true (aR s)
                  (PL.trans W.Bool (R nilL) (R (consL x s)) true (PL.sym W.Bool (R (consL x s)) (R nilL) (aR (consL x s))) r)))
                (oE (A (consL x s)) (R (consL x s)) e1))
              (oE (orP A R s) (orP A R (consL x s)) e))
            (hp x))
          hq) } ;

  -- n = m + 1
  -- the parts of the goal lift
  subGA (A B R S : Pred) (x : X) : Sub (up A x) (up (Goal A B R S) x) = subUp A (Goal A B R S) (gA A B R S) x ;
  subGB (A B R S : Pred) (x : X) : Sub (up B x) (up (Goal A B R S) x) = subUp B (Goal A B R S) (gB A B R S) x ;
  -- rearranging the hypothesis on f x
  hypUp (A R : Pred) (x : X) : Sub (up (orP A R) x) (orP (orP (up A x) (sh R x)) R) = \ s e ->
    orEl (T (orP A R) s) (T (orP A R) (consL x s)) (T (orP (orP (up A x) (sh R x)) R) s)
      (\ e1 -> orEl (T A s) (T R s) (T (orP (orP (up A x) (sh R x)) R) s)
        (\ a -> oL (orP (up A x) (sh R x) s) (R s) (oL (up A x s) (sh R x s) (oL (A s) (A (consL x s)) a)))
        (\ r -> oR (orP (up A x) (sh R x) s) (R s) r)
        (oE (A s) (R s) e1))
      (\ e1 -> orEl (T A (consL x s)) (T R (consL x s)) (T (orP (orP (up A x) (sh R x)) R) s)
        (\ a -> oL (orP (up A x) (sh R x) s) (R s) (oL (up A x s) (sh R x s) (oR (A s) (A (consL x s)) a)))
        (\ r -> oL (orP (up A x) (sh R x) s) (R s) (oR (up A x s) (sh R x s) r))
        (oE (A (consL x s)) (R (consL x s)) e1))
      (oE (orP A R s) (orP A R (consL x s)) e) ;
  -- (A' v R_x) v B v (R & S)  is in  ((A' v B) v (R & S)) v R_x
  reA (A' B R S : Pred) (x : X) : Sub (Goal (orP A' (sh R x)) B R S) (orP (Goal A' B R S) (sh R x)) = \ s e ->
    orEl (T (orP (orP A' (sh R x)) B) s) (T (andP R S) s) (T (orP (Goal A' B R S) (sh R x)) s)
      (\ e1 -> orEl (T (orP A' (sh R x)) s) (T B s) (T (orP (Goal A' B R S) (sh R x)) s)
        (\ e2 -> orEl (T A' s) (T (sh R x) s) (T (orP (Goal A' B R S) (sh R x)) s)
          (\ a -> oL (Goal A' B R S s) (sh R x s) (gA A' B R S s a))
          (\ r -> oR (Goal A' B R S s) (sh R x s) r)
          (oE (A' s) (sh R x s) e2))
        (\ b -> oL (Goal A' B R S s) (sh R x s) (gB A' B R S s b))
        (oE (orP A' (sh R x) s) (B s) e1))
      (\ e1 -> oL (Goal A' B R S s) (sh R x s) (gRS A' B R S s (W.andB-l (R s) (S s) e1) (W.andB-r (R s) (S s) e1)))
      (oE (orP (orP A' (sh R x)) B s) (andP R S s) e) ;
  -- A v (B' v S_x) v (R & S)  is in  ((A v B') v (R & S)) v S_x
  reB (A B' R S : Pred) (x : X) : Sub (Goal A (orP B' (sh S x)) R S) (orP (Goal A B' R S) (sh S x)) = \ s e ->
    orEl (T (orP A (orP B' (sh S x))) s) (T (andP R S) s) (T (orP (Goal A B' R S) (sh S x)) s)
      (\ e1 -> orEl (T A s) (T (orP B' (sh S x)) s) (T (orP (Goal A B' R S) (sh S x)) s)
        (\ a -> oL (Goal A B' R S s) (sh S x s) (gA A B' R S s a))
        (\ e2 -> orEl (T B' s) (T (sh S x) s) (T (orP (Goal A B' R S) (sh S x)) s)
          (\ b -> oL (Goal A B' R S s) (sh S x s) (gB A B' R S s b))
          (\ c -> oR (Goal A B' R S s) (sh S x s) c)
          (oE (B' s) (sh S x s) e2))
        (oE (A s) (orP B' (sh S x) s) e1))
      (\ e1 -> oL (Goal A B' R S s) (sh S x s) (gRS A B' R S s (W.andB-l (R s) (S s) e1) (W.andB-r (R s) (S s) e1)))
      (oE (orP A (orP B' (sh S x)) s) (andP R S s) e) ;
  -- the final inclusion
  fin (A B R S : Pred) (x : X) :
      Sub (Goal (Goal (up A x) B R S) (Goal A (up B x) R S) (sh R x) (sh S x)) (up (Goal A B R S) x) = \ s e ->
    orEl (T (orP (Goal (up A x) B R S) (Goal A (up B x) R S)) s) (T (andP (sh R x) (sh S x)) s) (T (up (Goal A B R S) x) s)
      (\ e1 -> orEl (T (Goal (up A x) B R S) s) (T (Goal A (up B x) R S) s) (T (up (Goal A B R S) x) s)
        (\ e2 -> orEl (T (orP (up A x) B) s) (T (andP R S) s) (T (up (Goal A B R S) x) s)
          (\ e3 -> orEl (T (up A x) s) (T B s) (T (up (Goal A B R S) x) s)
            (\ a -> subGA A B R S x s a)
            (\ b -> g0 (Goal A B R S) x s (gB A B R S s b))
            (oE (up A x s) (B s) e3))
          (\ e3 -> g0 (Goal A B R S) x s (gRS A B R S s (W.andB-l (R s) (S s) e3) (W.andB-r (R s) (S s) e3)))
          (oE (orP (up A x) B s) (andP R S s) e2))
        (\ e2 -> orEl (T (orP A (up B x)) s) (T (andP R S) s) (T (up (Goal A B R S) x) s)
          (\ e3 -> orEl (T A s) (T (up B x) s) (T (up (Goal A B R S) x) s)
            (\ a -> g0 (Goal A B R S) x s (gA A B R S s a))
            (\ b -> subGB A B R S x s b)
            (oE (A s) (up B x s) e3))
          (\ e3 -> g0 (Goal A B R S) x s (gRS A B R S s (W.andB-l (R s) (S s) e3) (W.andB-r (R s) (S s) e3)))
          (oE (orP A (up B x) s) (andP R S s) e2))
        (oE (Goal (up A x) B R S s) (Goal A (up B x) R S s) e1))
      (\ e1 -> gX (Goal A B R S) x s (gRS A B R S (consL x s) (W.andB-l (sh R x s) (sh S x s) e1) (W.andB-r (sh R x s) (sh S x s) e1)))
      (oE (orP (Goal (up A x) B R S) (Goal A (up B x) R S) s) (andP (sh R x) (sh S x) s) e) ;

  ramQ (m : W.N) (ih : (p q : WT) -> Stmt m p q) (f : X -> WT) (rf : (x : X) (q : WT) -> Stmt (suc m) (f x) q) :
      (q : WT) -> Stmt (suc m) (sp f) q = split {
    z -> \ A B R S aR aS hp hq ->
      orEl (T B nilL) (T S nilL) (T (Goal A B R S) nilL)
        (\ b -> gB A B R S nilL b)
        (\ c -> eqTF (S nilL) c aS.1 (T (Goal A B R S) nilL))
        (oE (B nilL) (S nilL) hq) ;
    sp g | rg -> \ A B R S aR aS hp hq x ->
      secMono (tens m (tens (suc m) (f x) (sp g)) (tens (suc m) (sp f) (g x)))
        (Goal (Goal (up A x) B R S) (Goal A (up B x) R S) (sh R x) (sh S x)) (up (Goal A B R S) x)
        (fin A B R S x)
        (ih (tens (suc m) (f x) (sp g)) (tens (suc m) (sp f) (g x))
          (Goal (up A x) B R S) (Goal A (up B x) R S) (sh R x) (sh S x) (aR.2 x) (aS.2 x)
          (secMono (tens (suc m) (f x) (sp g)) (Goal (orP (up A x) (sh R x)) B R S) (orP (Goal (up A x) B R S) (sh R x))
            (reA (up A x) B R S x)
            (rf x (sp g) (orP (up A x) (sh R x)) B R S aR aS
              (secMono (f x) (up (orP A R) x) (orP (orP (up A x) (sh R x)) R) (hypUp A R x) (hp x)) hq))
          (secMono (tens (suc m) (sp f) (g x)) (Goal A (orP (up B x) (sh S x)) R S) (orP (Goal A (up B x) R S) (sh S x))
            (reB A (up B x) R S x)
            (rg x A (orP (up B x) (sh S x)) R S aR aS hp
              (secMono (g x) (up (orP B S) x) (orP (orP (up B x) (sh S x)) S) (hypUp B S x) (hq x))))) } ;
  ramP (m : W.N) (ih : (p q : WT) -> Stmt m p q) : (p q : WT) -> Stmt (suc m) p q = split {
    z -> \ q A B R S aR aS hp hq ->
      orEl (T A nilL) (T R nilL) (T (Goal A B R S) nilL)
        (\ a -> gA A B R S nilL a)
        (\ c -> eqTF (R nilL) c aR.1 (T (Goal A B R S) nilL))
        (oE (A nilL) (R nilL) hp) ;
    sp f | rf -> ramQ m ih f rf } ;
  ram : (n : W.N) (p q : WT) -> Stmt n p q = split {
    zero -> ram0 ;
    suc m | r -> ramP m r } ;

  -- binary relations as predicates; almost-full relations
  Rel : U l = X -> X -> W.Bool ;
  rel1 (R : Rel) (x : X) : Pred = split { nilL -> false ; consL y s -> R x y } ;
  rel2 (R : Rel) : Pred = split { nilL -> false ; consL x s -> rel1 R x s } ;
  ar1 (R : Rel) (x : X) : Ar (suc zero) (sh (rel2 R) x) = (refl false,\ y s -> refl (R x y)) ;
  ar2 (R : Rel) : Ar (suc (suc zero)) (rel2 R) = (refl false,\ x -> ar1 R x) ;
  AFR (R : Rel) : U l = (p : WT) * Sec p (rel2 R) ;
  falseP : Pred = \ s -> false ;
  andRel1 (R S : Rel) (x : X) : (s : L) -> T (andP (rel1 R x) (rel1 S x)) s -> T (rel1 (\ x y -> W.andB (R x y) (S x y)) x) s = split {
    nilL -> \ e -> e ;
    consL y s -> \ e -> e } ;
  andRel (R S : Rel) : (s : L) -> T (andP (rel2 R) (rel2 S)) s -> T (rel2 (\ x y -> W.andB (R x y) (S x y))) s = split {
    nilL -> \ e -> e ;
    consL x s -> \ e -> andRel1 R S x s e } ;
  -- the intuitionistic Ramsey theorem: almost-full relations are closed under intersection
  afInter (R S : Rel) (a : AFR R) (b : AFR S) : AFR (\ x y -> W.andB (R x y) (S x y)) =
    (tens (suc (suc zero)) a.1 b.1,
     secMono (tens (suc (suc zero)) a.1 b.1) (Goal falseP falseP (rel2 R) (rel2 S)) (rel2 (\ x y -> W.andB (R x y) (S x y)))
       (\ s e -> orEl (T (orP falseP falseP) s) (T (andP (rel2 R) (rel2 S)) s) (T (rel2 (\ x y -> W.andB (R x y) (S x y))) s)
         (\ e1 -> W.absurdB (T (rel2 (\ x y -> W.andB (R x y) (S x y))) s) e1)
         (\ e1 -> andRel R S s e1)
         (oE (orP falseP falseP s) (andP (rel2 R) (rel2 S) s) e))
       (ram (suc (suc zero)) a.1 b.1 falseP falseP (rel2 R) (rel2 S) (ar2 R) (ar2 S) a.2 b.2)) ;
} ;

-- almost-fullness pulls back along maps
module AFPull (X Y : U l) (f : X -> Y) {
  module AX = AF[X] ;
  module AY = AF[Y] ;
  pullT : AY.WT -> AX.WT = split { z -> z ; sp g | r -> sp (\ x -> r (f x)) } ;
  secPull : (p : AY.WT) (A : AY.Pred) -> AY.Sec p A -> AX.Sec (pullT p) (\ s -> A (W.map X Y f s)) = split {
    z -> \ A h -> h ;
    sp g | r -> \ A h x -> r (f x) (AY.up A (f x)) (h (f x)) } ;
  split1 (R : AY.Rel) (a : X) : (s : AX.L) -> AX.T (\ t -> AY.rel2 R (W.map X Y f t)) (consL a s) ->
      AX.T (AX.rel2 (\ a b -> R (f a) (f b))) (consL a s) = split {
    nilL -> \ e -> e ;
    consL b s -> \ e -> e } ;
  relPull (R : AY.Rel) : (s : AX.L) -> AX.T (\ t -> AY.rel2 R (W.map X Y f t)) s -> AX.T (AX.rel2 (\ a b -> R (f a) (f b))) s = split {
    nilL -> \ e -> e ;
    consL a s -> split1 R a s } ;
  afPull (R : AY.Rel) (h : AY.AFR R) : AX.AFR (\ a b -> R (f a) (f b)) =
    (pullT h.1, AX.secMono (pullT h.1) (\ s -> AY.rel2 R (W.map X Y f s)) (AX.rel2 (\ a b -> R (f a) (f b))) (relPull R)
      (secPull h.1 (AY.rel2 R) h.2)) ;
} ;

leO : W.O3 -> W.Bool = split { lt -> true ; eq -> true ; gt -> false } ;

-- on a well-founded linear order, <= is almost full
module AFLe (B : DP.LO) {
  module A = AF[B.car] ;
  module AC = W.Acc[B.car,W.ltO B.car B.cmp] ;
  le (x y : B.car) : W.Bool = leO (B.cmp x y) ;
  P : A.Pred = A.rel2 le ;
  Px (x : B.car) : U l = (t : A.WT) * A.Sec t (A.up P x) ;
  -- y < x: the tree of y serves
  subY (x y : B.car) : A.Sub (A.up P y) (A.up (A.up P x) y) = \ s e ->
    orEl (A.T P s) (A.T P (consL y s)) (A.T (A.up (A.up P x) y) s)
      (\ a -> oL (A.up P x s) (A.up P x (consL y s)) (oL (P s) (P (consL x s)) a))
      (\ a -> oR (A.up P x s) (A.up P x (consL y s)) (oL (P (consL y s)) (P (consL x (consL y s))) a))
      (oE (P s) (P (consL y s)) e) ;
  leaf (x y : B.car) (h : Id W.Bool (le x y) true) : A.T (A.up (A.up P x) y) nilL =
    oR (A.up P x nilL) (A.up P x (consL y nilL)) (oR (P (consL y nilL)) (P (consL x (consL y nilL))) h) ;
  ltFlip (x y : B.car) (e : Id W.O3 (B.cmp x y) gt) : AC.Lt y x =
    PL.ap W.O3 W.Bool W.isLt (B.cmp y x) lt
      (PL.trans W.O3 (B.cmp y x) (W.flip (B.cmp x y)) lt (B.cflip x y) (PL.ap W.O3 W.O3 W.flip (B.cmp x y) gt e)) ;
  stepL (x y : B.car) (ih : (y : B.car) -> AC.Lt y x -> Px y) : (c : W.O3) -> Id W.O3 (B.cmp x y) c ->
      (t : A.WT) * A.Sec t (A.up (A.up P x) y) = split {
    lt -> \ e -> (z,leaf x y (PL.ap W.O3 W.Bool leO (B.cmp x y) lt e)) ;
    eq -> \ e -> (z,leaf x y (PL.ap W.O3 W.Bool leO (B.cmp x y) eq e)) ;
    gt -> \ e -> ((ih y (ltFlip x y e)).1,
      A.secMono (ih y (ltFlip x y e)).1 (A.up P y) (A.up (A.up P x) y) (subY x y) (ih y (ltFlip x y e)).2) } ;
  px (x : B.car) (ax : AC.AccP x) : Px x =
    AC.ind Px (\ x1 ih -> (sp (\ y -> (stepL x1 y ih (B.cmp x1 y) (refl (B.cmp x1 y))).1),
        \ y -> (stepL x1 y ih (B.cmp x1 y) (refl (B.cmp x1 y))).2)) x ax ;
  afLe (wf : LW.WF B) : A.AFR le = (sp (\ x -> (px x (wf x)).1),\ x -> (px x (wf x)).2) ;
} ;

-- an almost-full relation contained in <= makes a linear order well-founded
module AFWf (B : DP.LO) (R : B.car -> B.car -> W.Bool)
  (compat : (x y : B.car) -> Id W.Bool (R x y) true -> Id W.Bool (leO (B.cmp x y)) true) {
  module A = AF[B.car] ;
  module AC = W.Acc[B.car,W.ltO B.car B.cmp] ;
  P : A.Pred = A.rel2 R ;
  liftL : A.L -> A.Pred -> A.Pred = split {
    nilL -> \ Q -> Q ;
    consL y s | r -> \ Q -> A.up (r Q) y } ;
  liftC : (s : A.L) (Q : A.Pred) (t : A.L) -> A.T Q t -> A.T (liftL s Q) t = split {
    nilL -> \ Q t h -> h ;
    consL y s | r -> \ Q t h -> oL (liftL s Q t) (liftL s Q (consL y t)) (r Q t h) } ;
  MemR (w : B.car) : A.L -> U l = split { nilL -> W.Empty ; consL a s | r -> W.Or (Id W.Bool (R a w) true) r } ;
  HdR (s : A.L) : A.L -> U l = split { nilL -> W.Empty ; consL w t -> MemR w s } ;
  AllGt (w : B.car) : A.L -> U l = split { nilL -> W.Unit ; consL a s | r -> Id W.O3 (B.cmp a w) gt * r } ;
  -- a member related to w
  memB (w : B.car) : (s : A.L) -> MemR w s -> A.T (liftL s P) (consL w nilL) = split {
    nilL -> \ m -> CF0.efq (A.T P (consL w nilL)) m ;
    consL y s | r -> \ m -> orEl (Id W.Bool (R y w) true) (MemR w s) (A.T (liftL (consL y s) P) (consL w nilL))
      (\ h -> oR (liftL s P (consL w nilL)) (liftL s P (consL y (consL w nilL))) (liftC s P (consL y (consL w nilL)) h))
      (\ h -> oL (liftL s P (consL w nilL)) (liftL s P (consL y (consL w nilL))) (r h))
      m } ;
  -- what a lifted predicate can witness
  Res (s t : A.L) : U l = W.Or (A.T (liftL s P) nilL) (W.Or (HdR s t) (A.T P t)) ;
  memUp (y : B.car) (s : A.L) : (t : A.L) -> HdR s t -> HdR (consL y s) t = split {
    nilL -> \ m -> m ; consL w t -> \ m -> inr m } ;
  relHd (y : B.car) (s : A.L) : (t : A.L) -> A.T P (consL y t) -> HdR (consL y s) t = split {
    nilL -> \ h -> W.absurdB W.Empty h ;
    consL w t -> \ h -> inl h } ;
  resA : (s : A.L) (t : A.L) -> A.T (liftL s P) t -> Res s t = split {
    nilL -> \ t h -> inr (inr h) ;
    consL y s | r -> \ t h ->
      orEl (A.T (liftL s P) t) (A.T (liftL s P) (consL y t)) (Res (consL y s) t)
        (\ h1 -> orEl (A.T (liftL s P) nilL) (W.Or (HdR s t) (A.T P t)) (Res (consL y s) t)
          (\ a -> inl (oL (liftL s P nilL) (liftL s P (consL y nilL)) a))
          (\ b -> orEl (HdR s t) (A.T P t) (Res (consL y s) t)
            (\ m -> inr (inl (memUp y s t m)))
            (\ c -> inr (inr c))
            b)
          (r t h1))
        (\ h2 -> orEl (A.T (liftL s P) nilL) (W.Or (HdR s (consL y t)) (A.T P (consL y t))) (Res (consL y s) t)
          (\ a -> inl (oL (liftL s P nilL) (liftL s P (consL y nilL)) a))
          (\ b -> orEl (HdR s (consL y t)) (A.T P (consL y t)) (Res (consL y s) t)
            (\ m -> inl (oR (liftL s P nilL) (liftL s P (consL y nilL)) (memB y s m)))
            (\ c -> inr (inl (relHd y s t c)))
            b)
          (r (consL y t) h2))
        (oE (liftL s P t) (liftL s P (consL y t)) h) } ;
  notLe (a w : B.car) (g : Id W.O3 (B.cmp a w) gt) (h : Id W.Bool (R a w) true) : W.Empty =
    W.absurdB W.Empty (PL.trans W.Bool false (leO (B.cmp a w)) true
      (PL.sym W.Bool (leO (B.cmp a w)) false (PL.ap W.O3 W.Bool leO (B.cmp a w) gt g)) (compat a w h)) ;
  memGt (w : B.car) : (s : A.L) -> AllGt w s -> MemR w s -> W.Empty = split {
    nilL -> \ g m -> m ;
    consL a s | r -> \ g m -> orEl (Id W.Bool (R a w) true) (MemR w s) W.Empty (\ h -> notLe a w g.1 h) (\ m' -> r g.2 m') m } ;
  -- a bad descending chain stays bad when extended below
  keyA (s : A.L) (w : B.car) (g : AllGt w s) (bad : A.T (liftL s P) nilL -> W.Empty) (h : A.T (liftL s P) (consL w nilL)) : W.Empty =
    orEl (A.T (liftL s P) nilL) (W.Or (HdR s (consL w nilL)) (A.T P (consL w nilL))) W.Empty
      bad
      (\ b -> orEl (MemR w s) (A.T P (consL w nilL)) W.Empty (\ m -> memGt w s g m) (\ c -> W.absurdB W.Empty c) b)
      (resA s (consL w nilL) h) ;
  allGtT (y y' : B.car) (hl : Id W.O3 (B.cmp y' y) lt) : (s : A.L) -> AllGt y s -> AllGt y' s = split {
    nilL -> \ g -> tt ;
    consL a s | r -> \ g ->
      (PL.trans W.O3 (B.cmp a y') (W.flip (B.cmp y' a)) gt (B.cflip y' a)
        (PL.ap W.O3 W.O3 W.flip (B.cmp y' a) lt
          (B.ctrans y' y a hl (PL.trans W.O3 (B.cmp y a) (W.flip (B.cmp a y)) lt (B.cflip a y) (PL.ap W.O3 W.O3 W.flip (B.cmp a y) gt g.1)))),
       r g.2) } ;
  accT : (p : A.WT) (s : A.L) (y : B.car) -> A.Sec p (liftL (consL y s) P) -> AllGt y s ->
      (A.T (liftL (consL y s) P) nilL -> W.Empty) -> AC.AccP y = split {
    z -> \ s y h g bad -> CF0.efq (AC.AccP y) (bad h) ;
    sp f | rf -> \ s y h g bad -> AC.acc y (\ y' hl ->
      rf y' (consL y s) y' (h y')
        (PL.trans W.O3 (B.cmp y y') (W.flip (B.cmp y' y)) gt (B.cflip y' y) (PL.ap W.O3 W.O3 W.flip (B.cmp y' y) lt (W.isLt-sound (B.cmp y' y) hl)),
         allGtT y y' (W.isLt-sound (B.cmp y' y) hl) s g)
        (\ e -> orEl (A.T (liftL (consL y s) P) nilL) (A.T (liftL (consL y s) P) (consL y' nilL)) W.Empty
          bad
          (\ e2 -> keyA (consL y s) y'
            (PL.trans W.O3 (B.cmp y y') (W.flip (B.cmp y' y)) gt (B.cflip y' y) (PL.ap W.O3 W.O3 W.flip (B.cmp y' y) lt (W.isLt-sound (B.cmp y' y) hl)),
             allGtT y y' (W.isLt-sound (B.cmp y' y) hl) s g)
            bad e2)
          (oE (liftL (consL y s) P nilL) (liftL (consL y s) P (consL y' nilL)) e))) } ;
  wfT : (p : A.WT) -> A.Sec p P -> (y : B.car) -> AC.AccP y = split {
    z -> \ h y -> W.absurdB (AC.AccP y) h ;
    sp f -> \ h y -> accT (f y) nilL y (h y) tt (\ e -> W.absurdB W.Empty e) } ;
  wfAF (af : A.AFR R) : LW.WF B = wfT af.1 af.2 ;
} ;

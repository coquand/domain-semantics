-- PLAN-ID1, test: kind II cuts in the input of S4.  A cut whose X-atoms all
-- read stages BELOW top (and never Phi-bar) stays a kind II cut at
-- (A + Dl, inl top) after rep, so the kept-rule node of S4 (RegAsm.Fin:
-- CT.okRule, then the kind II elimination KC.elim) applies to it as it
-- stands: no elimination of kind II cuts for families is needed first.
level l ;
open Base ; open Prelude[l+] ; open ScottOrder[l] ;
module W = Dilator[l] ;
module DP = DilPtyx[l] ;
module CF = CatEmbFin[l] ;
module PL = Prelude[l] ;
module LT = LabTree[l] ;
module BP = BetaProof[l] ;
module BI = BetaID[l] ;
module BK = BetaIDCfCut[l] ;
module BO = BetaIDCfOps[l] ;
module S4 = BetaIDS4[l] ;

module Low (ev : (A : DP.LO) -> W.N -> LT.LL A -> W.Bool) (phi : BI.Form) (evN : S4.EvN ev) (A : DP.LO) (top : A.car) (Dl : DP.LO) {
  module I = BI.ID[ev,phi] ;
  module RR = S4.RepR[ev,phi,evN,A,top,Dl] ;
  B : DP.LO = RR.B ;
  module KB = BK.CK[ev,phi,B,inl top] ;
  -- kind II below top, in the source
  LowS : W.Or W.Unit A.car -> U l = split { inl u -> W.Empty ; inr mu -> Id W.Bool (I.ltB A mu top) true } ;
  StLow : BI.Form -> LT.LL A -> U l = split {
    atF b k -> \ e -> W.Unit ;
    andF p q | rp rq -> \ e -> rp e * rq e ;
    orF p q | rp rq -> \ e -> rp e * rq e ;
    allF p | rp -> \ e -> (x : I.Lb A) -> Id W.Bool (I.isNum A x) true -> rp (consL x e) ;
    exF p | rp -> \ e -> (x : I.Lb A) -> Id W.Bool (I.isNum A x) true -> rp (consL x e) ;
    xF b s k -> \ e -> LowS (I.nthL A s e).2 } ;
  -- a stage below top is kept, and is <= inl top
  lowX (mu : A.car) (h : Id W.Bool (I.ltB A mu top) true) : (b : W.Bool) -> Id W.Bool (I.ltB A mu top) b ->
      KB.LeS (inl top) (BO.pickB (W.Or W.Unit B.car) b (inr (inl mu)) (inl tt)) = split {
    true -> \ e -> PL.ap W.O3 W.Bool W.isLt (A.cmp top mu) gt
      (PL.trans W.O3 (A.cmp top mu) (W.flip (A.cmp mu top)) gt (A.cflip mu top)
        (PL.ap W.O3 W.O3 W.flip (A.cmp mu top) lt (W.isLt-sound (A.cmp mu top) h))) ;
    false -> \ e -> W.absurdB (KB.LeS (inl top) (BO.pickB (W.Or W.Unit B.car) false (inr (inl mu)) (inl tt)))
      (PL.trans W.Bool false (I.ltB A mu top) true (PL.sym W.Bool (I.ltB A mu top) false e) h) } ;
  lowO : (oo : W.Or W.Unit A.car) -> LowS oo -> KB.LeS (inl top) (RR.R.rO oo) = split {
    inl u -> \ h -> CF.efq (KB.LeS (inl top) (inl u)) h ;
    inr mu -> \ h -> lowX mu h (I.ltB A mu top) (refl (I.ltB A mu top)) } ;
  -- a number label of B is the rep of a number label of A
  numCase (p : BI.Form) (rp : (e1 : LT.LL A) -> StLow p e1 -> KB.StOK (inl top) p (RR.R.rE e1)) (e : LT.LL A)
      (h : (x : I.Lb A) -> Id W.Bool (I.isNum A x) true -> StLow p (consL x e)) (n : W.N) :
      (oo : W.Or W.Unit B.car) -> Id W.Bool (I.isNum B (n,oo)) true -> KB.StOK (inl top) p (consL (n,oo) (RR.R.rE e)) = split {
    inl u -> \ hx -> rp (consL (n,inl u) e) (h (n,inl u) (refl true)) ;
    inr z -> \ hx -> W.absurdB (KB.StOK (inl top) p (consL (n,inr z) (RR.R.rE e))) hx } ;
  -- THE TEST LEMMA: rep keeps such a cut of kind II at inl top
  stLow : (f : BI.Form) (e : LT.LL A) -> StLow f e -> KB.StOK (inl top) f (RR.R.rE e) = split {
    atF b k -> \ e h -> tt ;
    andF p q | rp rq -> \ e h -> (rp e h.1,rq e h.2) ;
    orF p q | rp rq -> \ e h -> (rp e h.1,rq e h.2) ;
    allF p | rp -> \ e h x hx -> numCase p (\ e1 h1 -> rp e1 h1) e h x.1 x.2 hx ;
    exF p | rp -> \ e h x hx -> numCase p (\ e1 h1 -> rp e1 h1) e h x.1 x.2 hx ;
    xF b s k -> \ e h -> PL.subst (I.Lb B) (\ z -> KB.LeS (inl top) z.2) (RR.R.rL (I.nthL A s e)) (I.nthL B s (RR.R.rE e))
      (PL.sym (I.Lb B) (I.nthL B s (RR.R.rE e)) (RR.R.rL (I.nthL A s e)) (RR.R.nthR s e)) (lowO (I.nthL A s e).2 h) } ;
  -- the cut rule: rR (cutR f e) = cutR f (rE e), and CutOK at a cut is StOK
  cutLow (f : BI.Form) (e : LT.LL A) (h : StLow f e) : KB.StOK (inl top) f (RR.R.rE e) = stLow f e h ;
} ;

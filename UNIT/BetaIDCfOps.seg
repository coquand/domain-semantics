-- PLAN-ID1 S4, building blocks: operations on CUT-FREE inductive
-- derivations (BetaIDCf.Cf), and the Phi-bar cut between cut-free
-- derivations directly on Cf (S2C).  These replace the pre-proof pipeline
-- of BetaIDS2 + BetaIDS21 when the premises are themselves outputs of the
-- cut elimination (S4: outputs are Cf derivations).
--
--  * TrC: transport along an embedding g : A -> B with a retraction rho,
--    initial below the bounds of the (xl) rules (a predicate Bd on bounds,
--    a condition BdOK on the derivation); Girard's Lemma 11.4.6 when g is
--    initial only below top (Bd la = "la <= top").
--  * ChopC: lowering top only removes premises of (l-bar).
--  * RenPC (Lemma 11.4.5 for an atom): a positive Phi-bar(t) is renamed
--    into I^c(t) when all choices of stages are below c.
--  * RenNC (Lemma 11.4.7): a negative Phi-bar(t) is renamed into I^top(t)
--    (same premises).
--  * S2C: from  L : H, Phi-bar(t)  at (A1, topA) and  R : g H, not Phi-bar(t)
--    at (A2, topK), g initial with image below topK, A2 well-founded:
--    a cut-free derivation of g H at (A2, g topA).  The new cut on
--    I^topK(t) is eliminated by BetaIDCfCut (kind II).
level l ;
open Base ; open Prelude[l+] ; open ScottOrder[l] ;
module W = Dilator[l] ;
module DP = DilPtyx[l] ;
module CF = CatEmbFin[l] ;
module PL = Prelude[l] ;
module LT = LabTree[l] ;
module BP = BetaProof[l] ;
module KT = KBTree[l] ;
module LW = LOWF[l] ;
module BI = BetaID[l] ;
module BT = BetaIDTr[l] ;
module BF = BetaIDCf[l] ;
module BK = BetaIDCfCut[l] ;

pickB (X : U l) : W.Bool -> X -> X -> X = split { false -> \ x y -> y ; true -> \ x y -> x } ;
-- all choices of stages (xr) are below c
ChB (B : DP.LO) (c : B.car) : BF.Cf (LT.Lab B).car B.car -> U l = split {
  cAx b k e -> W.Unit ;
  cAnd p q e d0 d1 | r0 r1 -> r0 * r1 ;
  cOr p q e d | r -> r ;
  cAll p e kk | r -> (x : (LT.Lab B).car) -> r x ;
  cEx p e w d | r -> r ;
  cXr s k e mu d | r -> Id W.Bool (W.isLt (B.cmp mu c)) true * r ;
  cXl s k e o kk | r -> (x : (LT.Lab B).car) -> r x } ;

------------------------------------------------------------------------
-- the bounds of the relevant (xl) rules satisfy Bd
BdOKf (ev : (A : DP.LO) -> W.N -> LT.LL A -> W.Bool) (phi : BI.Form) (A : DP.LO) (topA : A.car) (Bd : A.car -> U l) :
    BF.Cf (LT.Lab A).car A.car -> U l = split {
  cAx b k e -> W.Unit ;
  cAnd p q e d0 d1 | r0 r1 -> r0 * r1 ;
  cOr p q e d | r -> r ;
  cAll p e kk | r -> (x : (LT.Lab A).car) -> Id W.Bool (BI.ID[ev,phi].isNum A x) true -> r x ;
  cEx p e w d | r -> r ;
  cXr s k e mu d | r -> r ;
  cXl s k e o kk | r -> Bd (BI.ID[ev,phi].bound A topA o) *
    ((a : (LT.Lab A).car) -> Id W.Bool (BI.ID[ev,phi].below A (BI.ID[ev,phi].bound A topA o) a) true -> r a) } ;

------------------------------------------------------------------------
-- transport along an embedding
module TrC (ev : (A : DP.LO) -> W.N -> LT.LL A -> W.Bool) (phi : BI.Form)
  (A B : DP.LO) (g : DP.Map A B) (rho : B.car -> A.car)
  (evI : (k : W.N) (e : LT.LL A) -> Id W.Bool (ev B k (LT.mapL A B g e)) (ev A k e)) (topA : A.car)
  (Bd : A.car -> U l)
  (hb : (la : A.car) -> Bd la -> (b : B.car) -> Id W.O3 (B.cmp b (g.1 la)) lt -> Id B.car (g.1 (rho b)) b) {
  module I = BI.ID[ev,phi] ;
  module M = BT.Mp[ev,phi,A,B,g,evI,topA] ;
  module CA = BF.CI[ev,phi,A,topA] ;
  module CB = BF.CI[ev,phi,B,g.1 topA] ;
  pO : W.Or W.Unit B.car -> W.Or W.Unit A.car = split { inl u -> inl u ; inr b -> inr (rho b) } ;
  pL (y : I.Lb B) : I.Lb A = (y.1,pO y.2) ;
  mD : CA.C0 -> CB.C0 = split {
    cAx b k e -> cAx b k (M.mE e) ;
    cAnd p q e d0 d1 | r0 r1 -> cAnd p q (M.mE e) r0 r1 ;
    cOr p q e d | r -> cOr p q (M.mE e) r ;
    cAll p e kk | r -> cAll p (M.mE e) (\ y -> r (pL y)) ;
    cEx p e w d | r -> cEx p (M.mE e) (M.lm w) r ;
    cXr s k e mu d | r -> cXr s k (M.mE e) (g.1 mu) r ;
    cXl s k e o kk | r -> cXl s k (M.mE e) (M.om o) (\ y -> r (pL y)) } ;
  -- the bounds of the relevant (xl) rules satisfy Bd
  BdOK : CA.C0 -> U l = BdOKf ev phi A topA Bd ;
  bdAll (h : (la : A.car) -> Bd la) : (d : CA.C0) -> BdOK d = split {
    cAx b k e -> tt ;
    cAnd p q e d0 d1 | r0 r1 -> (r0,r1) ;
    cOr p q e d | r -> r ;
    cAll p e kk | r -> \ x hx -> r x ;
    cEx p e w d | r -> r ;
    cXr s k e mu d | r -> r ;
    cXl s k e o kk | r -> (h (I.bound A topA o),\ a ha -> r a) } ;

  memMap (c : I.Clo A) : (H : I.Seq A) -> CA.Mem c H -> CB.Mem (M.mC c) (M.mS H) = split {
    nilL -> \ m -> m ;
    consL x xs | r -> \ m -> CF.or-elim (Id (I.Clo A) x c) (CA.Mem c xs) (CB.Mem (M.mC c) (M.mS (consL x xs)))
      (\ e -> inl (PL.ap (I.Clo A) (I.Clo B) M.mC x c e)) (\ m' -> inr (r m')) m } ;
  -- number labels come back
  numBack (n : W.N) : (o : W.Or W.Unit B.car) -> Id W.Bool (BP.isInl W.Unit B.car o) true ->
      Id (I.Lb B) (M.lm (pL (n,o))) (n,o) = split {
    inl u -> \ h -> refl (n,inl u) ;
    inr b -> \ h -> W.absurdB (Id (I.Lb B) (M.lm (pL (n,inr b))) (n,inr b)) h } ;
  numPull (n : W.N) : (o : W.Or W.Unit B.car) -> Id W.Bool (BP.isInl W.Unit B.car o) true ->
      Id W.Bool (I.isNum A (pL (n,o))) true = split {
    inl u -> \ h -> refl true ;
    inr b -> \ h -> W.absurdB (Id W.Bool (I.isNum A (pL (n,inr b))) true) h } ;
  -- stage labels below the image of a bound come back
  belBack (la : A.car) (bl : Bd la) (n : W.N) : (o : W.Or W.Unit B.car) ->
      Id W.Bool (I.below B (g.1 la) (n,o)) true ->
      Id (I.Lb B) (M.lm (pL (n,o))) (n,o) * Id W.Bool (I.below A la (pL (n,o))) true = split {
    inl u -> \ h -> W.absurdB (Id (I.Lb B) (M.lm (pL (n,inl u))) (n,inl u) * Id W.Bool (I.below A la (pL (n,inl u))) true)
      (W.andB-r (BP.isZeroN n) false h) ;
    inr b -> \ h -> (PL.ap B.car (I.Lb B) (\ z -> (n,inr z)) (g.1 (rho b)) b
        (hb la bl b (W.isLt-sound (B.cmp b (g.1 la)) (W.andB-r (BP.isZeroN n) (I.ltB B b (g.1 la)) h))),
      W.andB-intro (BP.isZeroN n) (I.ltB A (rho b) la) (W.andB-l (BP.isZeroN n) (I.ltB B b (g.1 la)) h)
        (PL.trans W.Bool (I.ltB A (rho b) la) (I.ltB B b (g.1 la)) true
          (PL.trans W.Bool (W.isLt (A.cmp (rho b) la)) (W.isLt (B.cmp (g.1 (rho b)) (g.1 la))) (I.ltB B b (g.1 la))
            (PL.ap W.O3 W.Bool W.isLt (A.cmp (rho b) la) (B.cmp (g.1 (rho b)) (g.1 la)) (PL.sym W.O3 (B.cmp (g.1 (rho b)) (g.1 la)) (A.cmp (rho b) la) (g.2 (rho b) la)))
            (PL.ap B.car W.Bool (\ z -> I.ltB B z (g.1 la)) (g.1 (rho b)) b
              (hb la bl b (W.isLt-sound (B.cmp b (g.1 la)) (W.andB-r (BP.isZeroN n) (I.ltB B b (g.1 la)) h)))))
          (W.andB-r (BP.isZeroN n) (I.ltB B b (g.1 la)) h))) } ;
  allowMap (mu : A.car) : (o : W.Or W.Unit A.car) -> Id W.Bool (I.allowR B (g.1 mu) (M.om o)) (I.allowR A mu o) = split {
    inl u -> refl true ;
    inr la -> PL.ap W.O3 W.Bool W.isLt (B.cmp (g.1 mu) (g.1 la)) (A.cmp mu la) (g.2 mu la) } ;
  sameMap : (o o' : W.Or W.Unit A.car) -> Id W.Bool (I.sameO B (M.om o) (M.om o')) (I.sameO A o o') = split {
    inl u -> split { inl v -> refl true ; inr la -> refl false } ;
    inr mu -> split { inl v -> refl false ; inr la -> PL.ap W.O3 W.Bool W.isEq (B.cmp (g.1 mu) (g.1 la)) (A.cmp mu la) (g.2 mu la) } } ;
  -- the stage of an atom, after mapping
  stM (s : W.N) (e : LT.LL A) : Id (W.Or W.Unit B.car) (I.nthL B s (M.mE e)).2 (M.om (I.nthL A s e).2) =
    PL.ap (I.Lb B) (W.Or W.Unit B.car) (\ t -> t.2) (I.nthL B s (M.mE e)) (M.lm (I.nthL A s e)) (M.nthMap s e) ;
  -- premises of the x-rules, up to the argument and the stage label
  okE (f : BI.Form) (d : CB.C0) (Hs : I.Seq B) (t t' a a' : I.Lb B) (et : Id (I.Lb B) t' t) (ea : Id (I.Lb B) a' a)
      (o : CB.Ok d (consL (f,I.envP B t' a') Hs)) : CB.Ok d (consL (f,I.envP B t a) Hs) =
    PL.subst (I.Lb B) (\ z -> CB.Ok d (consL (f,I.envP B t z) Hs)) a' a ea
      (PL.subst (I.Lb B) (\ z -> CB.Ok d (consL (f,I.envP B z a') Hs)) t' t et o) ;

  okMap : (d : CA.C0) (H : I.Seq A) -> CA.Ok d H -> BdOK d -> CB.Ok (mD d) (M.mS H) = split {
    cAx b k e -> \ H o bd -> (memMap (atF b k,e) H o.1,PL.trans W.Bool (ev B k (M.mE e)) (ev A k e) b (evI k e) o.2) ;
    cAnd p q e d0 d1 | r0 r1 -> \ H o bd -> (memMap (andF p q,e) H o.1,
      (r0 (consL (p,e) H) o.2.1 bd.1,r1 (consL (q,e) H) o.2.2 bd.2)) ;
    cOr p q e d | r -> \ H o bd -> (memMap (orF p q,e) H o.1,r (consL (p,e) (consL (q,e) H)) o.2 bd) ;
    cAll p e kk | r -> \ H o bd -> (memMap (allF p,e) H o.1,
      \ y hy -> PL.subst (I.Lb B) (\ z -> CB.Ok (mD (kk (pL y))) (consL (p,consL z (M.mE e)) (M.mS H))) (M.lm (pL y)) y
        (numBack y.1 y.2 hy)
        (r (pL y) (consL (p,consL (pL y) e) H) (o.2 (pL y) (numPull y.1 y.2 hy)) (bd (pL y) (numPull y.1 y.2 hy)))) ;
    cEx p e w d | r -> \ H o bd -> (memMap (exF p,e) H o.1,
      (PL.trans W.Bool (I.isNum B (M.lm w)) (I.isNum A w) true (M.numMap w) o.2.1,r (consL (p,consL w e) H) o.2.2 bd)) ;
    cXr s k e mu d | r -> \ H o bd -> (memMap (xF true s k,e) H o.1,
      (PL.trans W.Bool (I.allowR B (g.1 mu) (I.nthL B s (M.mE e)).2) (I.allowR A mu (I.nthL A s e).2) true
         (PL.trans W.Bool (I.allowR B (g.1 mu) (I.nthL B s (M.mE e)).2) (I.allowR B (g.1 mu) (M.om (I.nthL A s e).2)) (I.allowR A mu (I.nthL A s e).2)
           (PL.ap (W.Or W.Unit B.car) W.Bool (I.allowR B (g.1 mu)) (I.nthL B s (M.mE e)).2 (M.om (I.nthL A s e).2) (stM s e))
           (allowMap mu (I.nthL A s e).2)) o.2.1,
       okE phi (mD d) (M.mS H) (I.nthL B k (M.mE e)) (M.lm (I.nthL A k e)) (I.stg B (g.1 mu)) (I.stg B (g.1 mu))
         (PL.sym (I.Lb B) (I.nthL B k (M.mE e)) (M.lm (I.nthL A k e)) (M.nthMap k e)) (refl (I.stg B (g.1 mu)))
         (r (consL (CA.cR k e mu) H) o.2.2 bd))) ;
    cXl s k e oo kk | r -> \ H o bd -> (memMap (xF false s k,e) H o.1,
      (PL.trans W.Bool (I.sameO B (M.om oo) (I.nthL B s (M.mE e)).2) (I.sameO A oo (I.nthL A s e).2) true
         (PL.trans W.Bool (I.sameO B (M.om oo) (I.nthL B s (M.mE e)).2) (I.sameO B (M.om oo) (M.om (I.nthL A s e).2)) (I.sameO A oo (I.nthL A s e).2)
           (PL.ap (W.Or W.Unit B.car) W.Bool (I.sameO B (M.om oo)) (I.nthL B s (M.mE e)).2 (M.om (I.nthL A s e).2) (stM s e))
           (sameMap oo (I.nthL A s e).2)) o.2.1,
       \ y hy -> okE (BI.neg phi) (mD (kk (pL y))) (M.mS H) (I.nthL B k (M.mE e)) (M.lm (I.nthL A k e)) y (M.lm (pL y))
         (PL.sym (I.Lb B) (I.nthL B k (M.mE e)) (M.lm (I.nthL A k e)) (M.nthMap k e))
         (belBack (I.bound A topA oo) bd.1 y.1 y.2
           (PL.subst B.car (\ z -> Id W.Bool (I.below B z y) true) (I.bound B (g.1 topA) (M.om oo)) (g.1 (I.bound A topA oo)) (M.boundMap oo) hy)).1
         (r (pL y) (consL (CA.cL k e (pL y)) H)
           (o.2.2 (pL y) (belBack (I.bound A topA oo) bd.1 y.1 y.2
             (PL.subst B.car (\ z -> Id W.Bool (I.below B z y) true) (I.bound B (g.1 topA) (M.om oo)) (g.1 (I.bound A topA oo)) (M.boundMap oo) hy)).2)
           (bd.2 (pL y) (belBack (I.bound A topA oo) bd.1 y.1 y.2
             (PL.subst B.car (\ z -> Id W.Bool (I.below B z y) true) (I.bound B (g.1 topA) (M.om oo)) (g.1 (I.bound A topA oo)) (M.boundMap oo) hy)).2)))) } ;
  resMap (H : I.Seq A) (x : CA.Res H) (bd : BdOK x.1) : CB.Res (M.mS H) = (mD x.1,okMap x.1 H x.2 bd) ;

  -- all choices of stages of a mapped derivation are images
  chMap (c : B.car) (below : (x : A.car) -> Id W.Bool (I.ltB B (g.1 x) c) true) : (d : CA.C0) -> ChB B c (mD d) = split {
    cAx b k e -> tt ;
    cAnd p q e d0 d1 | r0 r1 -> (r0,r1) ;
    cOr p q e d | r -> r ;
    cAll p e kk | r -> \ y -> r (pL y) ;
    cEx p e w d | r -> r ;
    cXr s k e mu d | r -> (below mu,r) ;
    cXl s k e o kk | r -> \ y -> r (pL y) } ;
} ;

------------------------------------------------------------------------
-- lowering top
module ChopC (ev : (A : DP.LO) -> W.N -> LT.LL A -> W.Bool) (phi : BI.Form) (A : DP.LO) (topT topK : A.car)
  (le : (x : A.car) -> Id W.Bool (BI.ID[ev,phi].ltB A x topT) true -> Id W.Bool (BI.ID[ev,phi].ltB A x topK) true) {
  module I = BI.ID[ev,phi] ;
  module CK = BF.CI[ev,phi,A,topK] ;
  module CT = BF.CI[ev,phi,A,topT] ;
  belLe (n : W.N) : (o : W.Or W.Unit A.car) -> Id W.Bool (I.below A topT (n,o)) true -> Id W.Bool (I.below A topK (n,o)) true = split {
    inl u -> \ h -> W.absurdB (Id W.Bool (I.below A topK (n,inl u)) true) (W.andB-r (BP.isZeroN n) false h) ;
    inr mu -> \ h -> W.andB-intro (BP.isZeroN n) (I.ltB A mu topK) (W.andB-l (BP.isZeroN n) (I.ltB A mu topT) h)
      (le mu (W.andB-r (BP.isZeroN n) (I.ltB A mu topT) h)) } ;
  boundLe : (o : W.Or W.Unit A.car) (a : I.Lb A) -> Id W.Bool (I.below A (I.bound A topT o) a) true ->
      Id W.Bool (I.below A (I.bound A topK o) a) true = split {
    inl u -> \ a h -> belLe a.1 a.2 h ;
    inr la -> \ a h -> h } ;
  chop : (d : CK.C0) (H : I.Seq A) -> CK.Ok d H -> CT.Ok d H = split {
    cAx b k e -> \ H o -> o ;
    cAnd p q e d0 d1 | r0 r1 -> \ H o -> (o.1,(r0 (consL (p,e) H) o.2.1,r1 (consL (q,e) H) o.2.2)) ;
    cOr p q e d | r -> \ H o -> (o.1,r (consL (p,e) (consL (q,e) H)) o.2) ;
    cAll p e kk | r -> \ H o -> (o.1,\ x hx -> r x (consL (p,consL x e) H) (o.2 x hx)) ;
    cEx p e w d | r -> \ H o -> (o.1,(o.2.1,r (consL (p,consL w e) H) o.2.2)) ;
    cXr s k e mu d | r -> \ H o -> (o.1,(o.2.1,r (consL (CK.cR k e mu) H) o.2.2)) ;
    cXl s k e oo kk | r -> \ H o -> (o.1,(o.2.1,\ a ha -> r a (consL (CK.cL k e a) H) (o.2.2 a (boundLe oo a ha)))) } ;
} ;

------------------------------------------------------------------------
-- renaming one atom closure C of the end sequent into C' (same argument);
-- the rules whose principal closure is C (decided on data) are renamed
module RenBase (ev : (A : DP.LO) -> W.N -> LT.LL A -> W.Bool) (phi : BI.Form) (A : DP.LO) (top : A.car) (C C' : BI.ID[ev,phi].Clo A) {
  open BF.CI[ev,phi,A,top] ;
  memOther (c0 : Clo) (H' : Seq) (hne : Id W.Bool (eqClo C c0) false) (m : Mem c0 (consL C H')) : Mem c0 (consL C' H') =
    CF.or-elim (Id Clo C c0) (Mem c0 H') (Mem c0 (consL C' H'))
      (\ e -> W.absurdB (Mem c0 (consL C' H')) (PL.trans W.Bool false (eqClo C c0) true (PL.sym W.Bool (eqClo C c0) false hne) (eqCloE C c0 e)))
      (\ m' -> inr m') m ;
  -- the premise sequents
  subP (c : Clo) (H H' : Seq) (sb : Sub H (consL C H')) : Sub (consL c H) (consL C (consL c H')) =
    subT (consL c H) (consL c (consL C H')) (consL C (consL c H')) (subCons c H (consL C H') sb) (sw c C H') ;
  backP (c : Clo) (d : C0) (H' : Seq) (o : Ok d (consL C' (consL c H'))) : Ok d (consL c (consL C' H')) =
    wk d (consL C' (consL c H')) (consL c (consL C' H')) o (sw C' c H') ;
} ;

-- Lemma 11.4.5 for an atom: C = Phi-bar(t) positive, C' = I^c(t)
module RenPC (ev : (A : DP.LO) -> W.N -> LT.LL A -> W.Bool) (phi : BI.Form) (A : DP.LO) (top : A.car)
  (s k : W.N) (e : LT.LL A) (s' k' : W.N) (e' : LT.LL A) (c : A.car)
  (eArg : Id (BI.ID[ev,phi].Lb A) (BI.ID[ev,phi].nthL A k' e') (BI.ID[ev,phi].nthL A k e))
  (hc : Id (W.Or W.Unit A.car) (BI.ID[ev,phi].nthL A s' e').2 (inr c)) {
  open BF.CI[ev,phi,A,top] ;
  C : Clo = (xF true s k,e) ;
  C' : Clo = (xF true s' k',e') ;
  module RB = RenBase[ev,phi,A,top,C,C'] ;
  ChB0 : C0 -> U l = ChB A c ;
  renD : C0 -> C0 = split {
    cAx b k0 e0 -> cAx b k0 e0 ;
    cAnd p q e0 d0 d1 | r0 r1 -> cAnd p q e0 r0 r1 ;
    cOr p q e0 d | r -> cOr p q e0 r ;
    cAll p e0 kk | r -> cAll p e0 r ;
    cEx p e0 w d | r -> cEx p e0 w r ;
    cXr s0 k0 e0 mu d | r -> pickB C0 (eqClo C (xF true s0 k0,e0)) (cXr s' k' e' mu r) (cXr s0 k0 e0 mu r) ;
    cXl s0 k0 e0 o kk | r -> cXl s0 k0 e0 o r } ;
  -- the premise of a renamed (xr): the argument is the same
  cREq (s0 k0 : W.N) (e0 : LT.LL A) (mu : A.car) (eq : Id Clo C (xF true s0 k0,e0)) : Id Clo (cR k0 e0 mu) (cR k' e' mu) =
    PL.trans Clo (cR k0 e0 mu) (cR k e mu) (cR k' e' mu)
      (PL.sym Clo (cR k e mu) (cR k0 e0 mu) (PL.ap Clo Clo (\ c0 -> cR (BK.kOf c0.1) c0.2 mu) C (xF true s0 k0,e0) eq))
      (PL.ap Lb Clo (\ t -> (phi,I.envP A t (I.stg A mu))) (I.nthL A k e) (I.nthL A k' e') (PL.sym Lb (I.nthL A k' e') (I.nthL A k e) eArg)) ;
  allowC (mu : A.car) (h : Id W.Bool (I.ltB A mu c) true) : Id W.Bool (I.allowR A mu (I.nthL A s' e').2) true =
    PL.trans W.Bool (I.allowR A mu (I.nthL A s' e').2) (I.allowR A mu (inr c)) true
      (PL.ap (W.Or W.Unit A.car) W.Bool (I.allowR A mu) (I.nthL A s' e').2 (inr c) hc) h ;
  IH (d : C0) : U l = (H H' : Seq) -> Ok d H -> Sub H (consL C H') -> ChB0 d -> Ok (renD d) (consL C' H') ;
  prem (c0 : Clo) (d : C0) (ih : IH d) (H H' : Seq) (sb : Sub H (consL C H')) (o : Ok d (consL c0 H)) (ch : ChB0 d) :
      Ok (renD d) (consL c0 (consL C' H')) =
    RB.backP c0 (renD d) H' (ih (consL c0 H) (consL c0 H') o (RB.subP c0 H H' sb) ch) ;
  xrV (s0 k0 : W.N) (e0 : LT.LL A) (mu : A.car) (d : C0) (ih : IH d) (H H' : Seq) (sb : Sub H (consL C H'))
      (o : Ok (cXr s0 k0 e0 mu d) H) (ch : ChB0 (cXr s0 k0 e0 mu d)) :
      (v : W.Bool) -> Id W.Bool (eqClo C (xF true s0 k0,e0)) v -> Ok (pickB C0 v (cXr s' k' e' mu (renD d)) (cXr s0 k0 e0 mu (renD d))) (consL C' H') = split {
    false -> \ h -> (RB.memOther (xF true s0 k0,e0) H' h (sb (xF true s0 k0,e0) o.1),
      (o.2.1,prem (cR k0 e0 mu) d ih H H' sb o.2.2 ch.2)) ;
    true -> \ h -> (inl (refl C'),(allowC mu ch.1,
      PL.subst Clo (\ z -> Ok (renD d) (consL z (consL C' H'))) (cR k0 e0 mu) (cR k' e' mu) (cREq s0 k0 e0 mu (eqCloS C (xF true s0 k0,e0) h))
        (prem (cR k0 e0 mu) d ih H H' sb o.2.2 ch.2))) } ;
  okRen : (d : C0) -> IH d = split {
    cAx b k0 e0 -> \ H H' o sb ch -> (RB.memOther (atF b k0,e0) H' (refl false) (sb (atF b k0,e0) o.1),o.2) ;
    cAnd p q e0 d0 d1 | r0 r1 -> \ H H' o sb ch -> (RB.memOther (andF p q,e0) H' (refl false) (sb (andF p q,e0) o.1),
      (prem (p,e0) d0 r0 H H' sb o.2.1 ch.1,prem (q,e0) d1 r1 H H' sb o.2.2 ch.2)) ;
    cOr p q e0 d | r -> \ H H' o sb ch -> (RB.memOther (orF p q,e0) H' (refl false) (sb (orF p q,e0) o.1),
      wk (renD d) (consL (p,e0) (consL C' (consL (q,e0) H'))) (consL (p,e0) (consL (q,e0) (consL C' H')))
        (prem (p,e0) d r (consL (q,e0) H) (consL (q,e0) H') (RB.subP (q,e0) H H' sb) o.2 ch)
        (subCons (p,e0) (consL C' (consL (q,e0) H')) (consL (q,e0) (consL C' H')) (sw C' (q,e0) H'))) ;
    cAll p e0 kk | r -> \ H H' o sb ch -> (RB.memOther (allF p,e0) H' (refl false) (sb (allF p,e0) o.1),
      \ x hx -> prem (p,consL x e0) (kk x) (r x) H H' sb (o.2 x hx) (ch x)) ;
    cEx p e0 w d | r -> \ H H' o sb ch -> (RB.memOther (exF p,e0) H' (refl false) (sb (exF p,e0) o.1),
      (o.2.1,prem (p,consL w e0) d r H H' sb o.2.2 ch)) ;
    cXr s0 k0 e0 mu d | r -> \ H H' o sb ch -> xrV s0 k0 e0 mu d r H H' sb o ch (eqClo C (xF true s0 k0,e0)) (refl (eqClo C (xF true s0 k0,e0))) ;
    cXl s0 k0 e0 oo kk | r -> \ H H' o sb ch -> (RB.memOther (xF false s0 k0,e0) H' (refl false) (sb (xF false s0 k0,e0) o.1),
      (o.2.1,\ a ha -> prem (cL k0 e0 a) (kk a) (r a) H H' sb (o.2.2 a ha) (ch a))) } ;
  ren (H : Seq) (d : C0) (o : Ok d (consL C H)) (ch : ChB0 d) : Ok (renD d) (consL C' H) =
    okRen d (consL C H) H o (\ x m -> m) ch ;
} ;

-- Lemma 11.4.7 for an atom: C = not Phi-bar(t), C' = not I^top(t);
-- (l-bar) at top and (lI^top) have the same premises
module RenNC (ev : (A : DP.LO) -> W.N -> LT.LL A -> W.Bool) (phi : BI.Form) (A : DP.LO) (top : A.car)
  (s k : W.N) (e : LT.LL A) (s' k' : W.N) (e' : LT.LL A)
  (eArg : Id (BI.ID[ev,phi].Lb A) (BI.ID[ev,phi].nthL A k' e') (BI.ID[ev,phi].nthL A k e))
  (hbar : Id (W.Or W.Unit A.car) (BI.ID[ev,phi].nthL A s e).2 (inl tt))
  (hc : Id (W.Or W.Unit A.car) (BI.ID[ev,phi].nthL A s' e').2 (inr top)) {
  open BF.CI[ev,phi,A,top] ;
  C : Clo = (xF false s k,e) ;
  C' : Clo = (xF false s' k',e') ;
  module RB = RenBase[ev,phi,A,top,C,C'] ;
  renD : C0 -> C0 = split {
    cAx b k0 e0 -> cAx b k0 e0 ;
    cAnd p q e0 d0 d1 | r0 r1 -> cAnd p q e0 r0 r1 ;
    cOr p q e0 d | r -> cOr p q e0 r ;
    cAll p e0 kk | r -> cAll p e0 r ;
    cEx p e0 w d | r -> cEx p e0 w r ;
    cXr s0 k0 e0 mu d | r -> cXr s0 k0 e0 mu r ;
    cXl s0 k0 e0 o kk | r -> pickB C0 (eqClo C (xF false s0 k0,e0)) (cXl s' k' e' (inr top) r) (cXl s0 k0 e0 o r) } ;
  cLEq (s0 k0 : W.N) (e0 : LT.LL A) (a : Lb) (eq : Id Clo C (xF false s0 k0,e0)) : Id Clo (cL k0 e0 a) (cL k' e' a) =
    PL.trans Clo (cL k0 e0 a) (cL k e a) (cL k' e' a)
      (PL.sym Clo (cL k e a) (cL k0 e0 a) (PL.ap Clo Clo (\ c0 -> cL (BK.kOf c0.1) c0.2 a) C (xF false s0 k0,e0) eq))
      (PL.ap Lb Clo (\ t -> (BI.neg phi,I.envP A t a)) (I.nthL A k e) (I.nthL A k' e') (PL.sym Lb (I.nthL A k' e') (I.nthL A k e) eArg)) ;
  sameC : Id W.Bool (I.sameO A (inr top) (I.nthL A s' e').2) true =
    PL.trans W.Bool (I.sameO A (inr top) (I.nthL A s' e').2) (I.sameO A (inr top) (inr top)) true
      (PL.ap (W.Or W.Unit A.car) W.Bool (I.sameO A (inr top)) (I.nthL A s' e').2 (inr top) hc)
      (PL.ap W.O3 W.Bool W.isEq (A.cmp top top) eq (A.crefl top)) ;
  -- the principal predicate is Phi-bar, so the bound was top
  boundTop : (o : W.Or W.Unit A.car) -> Id W.Bool (I.sameO A o (inl tt)) true -> Id A.car (I.bound A top o) top = split {
    inl u -> \ h -> refl top ;
    inr la -> \ h -> W.absurdB (Id A.car la top) h } ;
  sameBar (s0 k0 : W.N) (e0 : LT.LL A) (o : W.Or W.Unit A.car) (eq : Id Clo C (xF false s0 k0,e0))
      (h : Id W.Bool (I.sameO A o (I.nthL A s0 e0).2) true) : Id W.Bool (I.sameO A o (inl tt)) true =
    PL.subst (W.Or W.Unit A.car) (\ z -> Id W.Bool (I.sameO A o z) true) (I.nthL A s0 e0).2 (inl tt)
      (PL.trans (W.Or W.Unit A.car) (I.nthL A s0 e0).2 (I.nthL A s e).2 (inl tt)
        (PL.sym (W.Or W.Unit A.car) (I.nthL A s e).2 (I.nthL A s0 e0).2
          (PL.ap Clo (W.Or W.Unit A.car) (\ c0 -> (I.nthL A (BK.sOf c0.1) c0.2).2) C (xF false s0 k0,e0) eq)) hbar) h ;
  IH (d : C0) : U l = (H H' : Seq) -> Ok d H -> Sub H (consL C H') -> Ok (renD d) (consL C' H') ;
  prem (c0 : Clo) (d : C0) (ih : IH d) (H H' : Seq) (sb : Sub H (consL C H')) (o : Ok d (consL c0 H)) :
      Ok (renD d) (consL c0 (consL C' H')) =
    RB.backP c0 (renD d) H' (ih (consL c0 H) (consL c0 H') o (RB.subP c0 H H' sb)) ;
  xlV (s0 k0 : W.N) (e0 : LT.LL A) (oo : W.Or W.Unit A.car) (kk : Lb -> C0) (ih : (x : Lb) -> IH (kk x)) (H H' : Seq) (sb : Sub H (consL C H'))
      (o : Ok (cXl s0 k0 e0 oo kk) H) :
      (v : W.Bool) -> Id W.Bool (eqClo C (xF false s0 k0,e0)) v ->
      Ok (pickB C0 v (cXl s' k' e' (inr top) (\ x -> renD (kk x))) (cXl s0 k0 e0 oo (\ x -> renD (kk x)))) (consL C' H') = split {
    false -> \ h -> (RB.memOther (xF false s0 k0,e0) H' h (sb (xF false s0 k0,e0) o.1),
      (o.2.1,\ a ha -> prem (cL k0 e0 a) (kk a) (ih a) H H' sb (o.2.2 a ha))) ;
    true -> \ h -> (inl (refl C'),(sameC,
      \ a ha -> PL.subst Clo (\ z -> Ok (renD (kk a)) (consL z (consL C' H'))) (cL k0 e0 a) (cL k' e' a)
        (cLEq s0 k0 e0 a (eqCloS C (xF false s0 k0,e0) h))
        (prem (cL k0 e0 a) (kk a) (ih a) H H' sb
          (o.2.2 a (PL.subst A.car (\ z -> Id W.Bool (I.below A z a) true) top (I.bound A top oo)
            (PL.sym A.car (I.bound A top oo) top (boundTop oo (sameBar s0 k0 e0 oo (eqCloS C (xF false s0 k0,e0) h) o.2.1))) ha))))) } ;
  okRen : (d : C0) -> IH d = split {
    cAx b k0 e0 -> \ H H' o sb -> (RB.memOther (atF b k0,e0) H' (refl false) (sb (atF b k0,e0) o.1),o.2) ;
    cAnd p q e0 d0 d1 | r0 r1 -> \ H H' o sb -> (RB.memOther (andF p q,e0) H' (refl false) (sb (andF p q,e0) o.1),
      (prem (p,e0) d0 r0 H H' sb o.2.1,prem (q,e0) d1 r1 H H' sb o.2.2)) ;
    cOr p q e0 d | r -> \ H H' o sb -> (RB.memOther (orF p q,e0) H' (refl false) (sb (orF p q,e0) o.1),
      wk (renD d) (consL (p,e0) (consL C' (consL (q,e0) H'))) (consL (p,e0) (consL (q,e0) (consL C' H')))
        (prem (p,e0) d r (consL (q,e0) H) (consL (q,e0) H') (RB.subP (q,e0) H H' sb) o.2)
        (subCons (p,e0) (consL C' (consL (q,e0) H')) (consL (q,e0) (consL C' H')) (sw C' (q,e0) H'))) ;
    cAll p e0 kk | r -> \ H H' o sb -> (RB.memOther (allF p,e0) H' (refl false) (sb (allF p,e0) o.1),
      \ x hx -> prem (p,consL x e0) (kk x) (r x) H H' sb (o.2 x hx)) ;
    cEx p e0 w d | r -> \ H H' o sb -> (RB.memOther (exF p,e0) H' (refl false) (sb (exF p,e0) o.1),
      (o.2.1,prem (p,consL w e0) d r H H' sb o.2.2)) ;
    cXr s0 k0 e0 mu d | r -> \ H H' o sb -> (RB.memOther (xF true s0 k0,e0) H' (refl false) (sb (xF true s0 k0,e0) o.1),
      (o.2.1,prem (cR k0 e0 mu) d r H H' sb o.2.2)) ;
    cXl s0 k0 e0 oo kk | r -> \ H H' o sb -> xlV s0 k0 e0 oo kk r H H' sb o (eqClo C (xF false s0 k0,e0)) (refl (eqClo C (xF false s0 k0,e0))) } ;
  ren (H : Seq) (d : C0) (o : Ok d (consL C H)) : Ok (renD d) (consL C' H) =
    okRen d (consL C H) H o (\ x m -> m) ;
} ;

------------------------------------------------------------------------
-- S2C: the Phi-bar cut between cut-free derivations
module S2C (ev : (A : DP.LO) -> W.N -> LT.LL A -> W.Bool) (phi : BI.Form)
  (A1 A2 : DP.LO) (g : DP.Map A1 A2) (rho : A2.car -> A1.car)
  (hr : (b : A2.car) (a : A1.car) -> Id W.O3 (A2.cmp b (g.1 a)) lt -> Id A2.car (g.1 (rho b)) b)
  (evI : (k : W.N) (e : LT.LL A1) -> Id W.Bool (ev A2 k (LT.mapL A1 A2 g e)) (ev A1 k e))
  (topA : A1.car) (topK : A2.car)
  (gBelow : (x : A1.car) -> Id W.O3 (A2.cmp (g.1 x) topK) lt)
  (wA2 : LW.WF A2)
  (wfPhi : (t : BI.ID[ev,phi].Lb A2) (mu : A2.car) ->
     BK.CK[ev,phi,A2,g.1 topA].StOK mu phi (BI.ID[ev,phi].envP A2 t (BI.ID[ev,phi].stg A2 mu)))
  (H : BI.ID[ev,phi].Seq A1) (s k : W.N) (e : LT.LL A1)
  (hbar : Id (W.Or W.Unit A1.car) (BI.ID[ev,phi].nthL A1 s e).2 (inl tt)) {
  module I = BI.ID[ev,phi] ;
  module C1 = BF.CI[ev,phi,A1,topA] ;
  topT : A2.car = g.1 topA ;
  module CT = BF.CI[ev,phi,A2,topT] ;
  module CK = BF.CI[ev,phi,A2,topK] ;
  module Tr = TrC[ev,phi,A1,A2,g,rho,evI,topA,\ la -> W.Unit,\ la u b h -> hr b la h] ;
  H2 : I.Seq A2 = Tr.M.mS H ;
  e2 : LT.LL A2 = Tr.M.mE e ;
  -- the stage atom of the new cut: I^topK(t)
  env' : LT.LL A2 = I.envP A2 (I.nthL A2 k e2) (I.stg A2 topK) ;
  f : BI.Form = xF true (suc zero) zero ;
  hbar2 : Id (W.Or W.Unit A2.car) (I.nthL A2 s e2).2 (inl tt) =
    PL.trans (W.Or W.Unit A2.car) (I.nthL A2 s e2).2 (Tr.M.om (I.nthL A1 s e).2) (inl tt) (Tr.stM s e)
      (PL.ap (W.Or W.Unit A1.car) (W.Or W.Unit A2.car) Tr.M.om (I.nthL A1 s e).2 (inl tt) hbar) ;
  ltK (x : A1.car) : Id W.Bool (I.ltB A2 (g.1 x) topK) true = PL.ap W.O3 W.Bool W.isLt (A2.cmp (g.1 x) topK) lt (gBelow x) ;
  module RP = RenPC[ev,phi,A2,topT,s,k,e2,suc zero,zero,env',topK,refl (I.nthL A2 k e2),refl (inr topK)] ;
  module RN = RenNC[ev,phi,A2,topK,s,k,e2,suc zero,zero,env',refl (I.nthL A2 k e2),hbar2,refl (inr topK)] ;
  leT (x : A2.car) (hx : Id W.Bool (I.ltB A2 x topT) true) : Id W.Bool (I.ltB A2 x topK) true =
    PL.ap W.O3 W.Bool W.isLt (A2.cmp x topK) lt (A2.ctrans x topT topK (W.isLt-sound (A2.cmp x topT) hx) (gBelow topA)) ;
  module Ch = ChopC[ev,phi,A2,topT,topK,leT] ;
  module KC = BK.CK[ev,phi,A2,topT].Cut[wA2,wfPhi] ;
  stK : BK.CK[ev,phi,A2,topT].StOK topK f env' = PL.ap W.O3 W.Bool W.isLt (A2.cmp topK topK) eq (A2.crefl topK) ;
  -- L : H, Phi-bar(t) at (A1, topA);  R : g H, not Phi-bar(t) at (A2, topK)
  out (dL : C1.C0) (oL : C1.Ok dL (consL (xF true s k,e) H)) (dR : CK.C0) (oR : CK.Ok dR (consL (xF false s k,e2) H2)) : CT.Res H2 =
    KC.cutAll topK f env' stK H2
      (RP.renD (Tr.mD dL)) (RN.renD dR)
      (RP.ren H2 (Tr.mD dL) (Tr.okMap dL (consL (xF true s k,e) H) oL (Tr.bdAll (\ la -> tt) dL)) (Tr.chMap topK ltK dL))
      (Ch.chop (RN.renD dR) (consL (BI.neg f,env') H2) (RN.ren H2 dR oR)) ;
} ;

------------------------------------------------------------------------
-- the invariant of cut-free derivations: NEGATIVE stages are below top
-- (Girard's subformula argument for 11.4.6), from the syntactic
-- positivity of phi: its X-atoms are positive and read the stage
-- position (depth + 1), never used as an argument.  It gives the bounds needed by a transport that
-- is initial only below top.
posX : BI.Form -> W.N -> W.Bool = split {
  atF b k -> \ n -> true ;
  andF p q | rp rq -> \ n -> W.andB (rp n) (rq n) ;
  orF p q | rp rq -> \ n -> W.andB (rp n) (rq n) ;
  allF p | rp -> \ n -> rp (suc n) ;
  exF p | rp -> \ n -> rp (suc n) ;
  xF b s k -> \ n -> W.andB (BP.eqBo b true) (W.andB (W.eqN s (suc n)) (W.notB (W.eqN k (suc n)))) } ;
isEqT : (c : W.O3) -> Id W.Bool (W.isEq c) true -> Id W.O3 c eq = split {
  lt -> \ h -> W.absurdB (Id W.O3 lt eq) h ; eq -> \ h -> refl eq ; gt -> \ h -> W.absurdB (Id W.O3 gt eq) h } ;

module Inv (ev : (A : DP.LO) -> W.N -> LT.LL A -> W.Bool) (phi : BI.Form) (A : DP.LO) (top : A.car)
  (hPos : Id W.Bool (posX phi zero) true) {
  open BF.CI[ev,phi,A,top] ;
  NegOK : W.Or W.Unit A.car -> U l = split { inl u -> W.Unit ; inr la -> Id W.Bool (I.ltB A la top) true } ;
  XNeg : W.Bool -> W.Or W.Unit A.car -> U l = split { false -> NegOK ; true -> \ o -> W.Unit } ;
  InvF : BI.Form -> LT.LL A -> U l = split {
    atF b k -> \ e -> W.Unit ;
    andF p q | rp rq -> \ e -> rp e * rq e ;
    orF p q | rp rq -> \ e -> rp e * rq e ;
    allF p | rp -> \ e -> (x : Lb) -> Id W.Bool (I.isNum A x) true -> rp (consL x e) ;
    exF p | rp -> \ e -> (x : Lb) -> Id W.Bool (I.isNum A x) true -> rp (consL x e) ;
    xF b s k -> \ e -> XNeg b (I.nthL A s e).2 } ;
  InvS : Seq -> U l = split { nilL -> W.Unit ; consL c cs | r -> InvF c.1 c.2 * r } ;
  invMem (c : Clo) : (H : Seq) -> Mem c H -> InvS H -> InvF c.1 c.2 = split {
    nilL -> \ m iv -> CF.efq (InvF c.1 c.2) m ;
    consL x xs | r -> \ m iv -> CF.or-elim (Id Clo x c) (Mem c xs) (InvF c.1 c.2)
      (\ e -> PL.subst Clo (\ z -> InvF z.1 z.2) x c e iv.1) (\ m' -> r m' iv.2) m } ;

  -- phi has no negative X-atom; not phi has its negative X-atoms on the stage
  xPos : (b : W.Bool) -> Id W.Bool (BP.eqBo b true) true -> (o : W.Or W.Unit A.car) -> XNeg b o = split {
    false -> \ h o -> W.absurdB (NegOK o) h ;
    true -> \ h o -> tt } ;
  posInv : (f : BI.Form) (n : W.N) (e : LT.LL A) -> Id W.Bool (posX f n) true -> InvF f e = split {
    atF b k -> \ n e h -> tt ;
    andF p q | rp rq -> \ n e h -> (rp n e (W.andB-l (posX p n) (posX q n) h),rq n e (W.andB-r (posX p n) (posX q n) h)) ;
    orF p q | rp rq -> \ n e h -> (rp n e (W.andB-l (posX p n) (posX q n) h),rq n e (W.andB-r (posX p n) (posX q n) h)) ;
    allF p | rp -> \ n e h x hx -> rp (suc n) (consL x e) h ;
    exF p | rp -> \ n e h x hx -> rp (suc n) (consL x e) h ;
    xF b s k -> \ n e h -> xPos b (W.andB-l (BP.eqBo b true) (W.andB (W.eqN s (suc n)) (W.notB (W.eqN k (suc n)))) h) (I.nthL A s e).2 } ;
  xNeg (n : W.N) (e : LT.LL A) : (b : W.Bool) -> Id W.Bool (BP.eqBo b true) true -> (s : W.N) -> Id W.Bool (W.eqN s (suc n)) true ->
      NegOK (I.nthL A (suc n) e).2 -> XNeg (W.notB b) (I.nthL A s e).2 = split {
    false -> \ h s hs ng -> W.absurdB (XNeg true (I.nthL A s e).2) h ;
    true -> \ h s hs ng -> PL.subst W.N (\ z -> NegOK (I.nthL A z e).2) (suc n) s (PL.sym W.N s (suc n) (W.eqN-sound s (suc n) hs)) ng } ;
  negInv : (f : BI.Form) (n : W.N) (e : LT.LL A) -> Id W.Bool (posX f n) true -> NegOK (I.nthL A (suc n) e).2 -> InvF (BI.neg f) e = split {
    atF b k -> \ n e h ng -> tt ;
    andF p q | rp rq -> \ n e h ng -> (rp n e (W.andB-l (posX p n) (posX q n) h) ng,rq n e (W.andB-r (posX p n) (posX q n) h) ng) ;
    orF p q | rp rq -> \ n e h ng -> (rp n e (W.andB-l (posX p n) (posX q n) h) ng,rq n e (W.andB-r (posX p n) (posX q n) h) ng) ;
    allF p | rp -> \ n e h ng x hx -> rp (suc n) (consL x e) h ng ;
    exF p | rp -> \ n e h ng x hx -> rp (suc n) (consL x e) h ng ;
    xF b s k -> \ n e h ng -> xNeg n e b (W.andB-l (BP.eqBo b true) (W.andB (W.eqN s (suc n)) (W.notB (W.eqN k (suc n)))) h) s
      (W.andB-l (W.eqN s (suc n)) (W.notB (W.eqN k (suc n))) (W.andB-r (BP.eqBo b true) (W.andB (W.eqN s (suc n)) (W.notB (W.eqN k (suc n)))) h)) ng } ;
  -- and phi(I^mu, t) is of kind II at stage mu (the hypothesis wfPhi of BetaIDCfCut)
  module KK = BK.CK[ev,phi,A,top] ;
  stX (mu : A.car) (n : W.N) (e : LT.LL A) (hm : Id (W.Or W.Unit A.car) (I.nthL A (suc n) e).2 (inr mu)) (s : W.N)
      (hs : Id W.Bool (W.eqN s (suc n)) true) : KK.LeS mu (I.nthL A s e).2 =
    PL.subst W.N (\ z -> KK.LeS mu (I.nthL A z e).2) (suc n) s (PL.sym W.N s (suc n) (W.eqN-sound s (suc n) hs))
      (PL.subst (W.Or W.Unit A.car) (\ z -> KK.LeS mu z) (inr mu) (I.nthL A (suc n) e).2 (PL.sym (W.Or W.Unit A.car) (I.nthL A (suc n) e).2 (inr mu) hm)
        (PL.ap W.O3 W.Bool W.isLt (A.cmp mu mu) eq (A.crefl mu))) ;
  stInv (mu : A.car) : (f : BI.Form) (n : W.N) (e : LT.LL A) -> Id W.Bool (posX f n) true ->
      Id (W.Or W.Unit A.car) (I.nthL A (suc n) e).2 (inr mu) -> KK.StOK mu f e = split {
    atF b k -> \ n e h hm -> tt ;
    andF p q | rp rq -> \ n e h hm -> (rp n e (W.andB-l (posX p n) (posX q n) h) hm,rq n e (W.andB-r (posX p n) (posX q n) h) hm) ;
    orF p q | rp rq -> \ n e h hm -> (rp n e (W.andB-l (posX p n) (posX q n) h) hm,rq n e (W.andB-r (posX p n) (posX q n) h) hm) ;
    allF p | rp -> \ n e h hm x hx -> rp (suc n) (consL x e) h hm ;
    exF p | rp -> \ n e h hm x hx -> rp (suc n) (consL x e) h hm ;
    xF b s k -> \ n e h hm -> stX mu n e hm s
      (W.andB-l (W.eqN s (suc n)) (W.notB (W.eqN k (suc n))) (W.andB-r (BP.eqBo b true) (W.andB (W.eqN s (suc n)) (W.notB (W.eqN k (suc n)))) h)) } ;
  wfPhi (t : Lb) (mu : A.car) : KK.StOK mu phi (I.envP A t (I.stg A mu)) =
    stInv mu phi zero (I.envP A t (I.stg A mu)) hPos (refl (inr mu)) ;

  -- the bounds: below top, or top itself
  Bd (la : A.car) : U l = W.Or (Id W.Bool (I.ltB A la top) true) (Id A.car la top) ;
  belNeg (bd : A.car) (hb : (x : A.car) -> Id W.Bool (I.ltB A x bd) true -> Id W.Bool (I.ltB A x top) true) (n : W.N) :
      (o : W.Or W.Unit A.car) -> Id W.Bool (I.below A bd (n,o)) true -> NegOK o = split {
    inl u -> \ h -> tt ;
    inr mu -> \ h -> hb mu (W.andB-r (BP.isZeroN n) (I.ltB A mu bd) h) } ;
  bdFrom : (o x : W.Or W.Unit A.car) -> Id W.Bool (I.sameO A o x) true -> NegOK x ->
      Bd (I.bound A top o) * ((a : Lb) -> Id W.Bool (I.below A (I.bound A top o) a) true -> NegOK a.2) = split {
    inl u -> \ x h ng -> (inr (refl top),\ a ha -> belNeg top (\ y hy -> hy) a.1 a.2 ha) ;
    inr la -> split {
      inl v -> \ h ng -> W.absurdB (Bd la * ((a : Lb) -> Id W.Bool (I.below A la a) true -> NegOK a.2)) h ;
      inr la' -> \ h ng -> (inl (PL.subst A.car (\ z -> Id W.Bool (I.ltB A z top) true) la' la
          (PL.sym A.car la la' (A.ceq la la' (isEqT (A.cmp la la') h))) ng),
        \ a ha -> belNeg la (\ y hy -> PL.ap W.O3 W.Bool W.isLt (A.cmp y top) lt
            (A.ctrans y la top (W.isLt-sound (A.cmp y la) hy)
              (W.isLt-sound (A.cmp la top) (PL.subst A.car (\ z -> Id W.Bool (I.ltB A z top) true) la' la
                (PL.sym A.car la la' (A.ceq la la' (isEqT (A.cmp la la') h))) ng)))) a.1 a.2 ha) } } ;
  invBd : (d : C0) (H : Seq) -> Ok d H -> InvS H -> BdOKf ev phi A top Bd d = split {
    cAx b k e -> \ H o iv -> tt ;
    cAnd p q e d0 d1 | r0 r1 -> \ H o iv ->
      (r0 (consL (p,e) H) o.2.1 ((invMem (andF p q,e) H o.1 iv).1,iv),r1 (consL (q,e) H) o.2.2 ((invMem (andF p q,e) H o.1 iv).2,iv)) ;
    cOr p q e d | r -> \ H o iv ->
      r (consL (p,e) (consL (q,e) H)) o.2 ((invMem (orF p q,e) H o.1 iv).1,((invMem (orF p q,e) H o.1 iv).2,iv)) ;
    cAll p e kk | r -> \ H o iv x hx -> r x (consL (p,consL x e) H) (o.2 x hx) (invMem (allF p,e) H o.1 iv x hx,iv) ;
    cEx p e w d | r -> \ H o iv -> r (consL (p,consL w e) H) o.2.2 (invMem (exF p,e) H o.1 iv w o.2.1,iv) ;
    cXr s k e mu d | r -> \ H o iv -> r (consL (cR k e mu) H) o.2.2 (posInv phi zero (I.envP A (arg k e) (I.stg A mu)) hPos,iv) ;
    cXl s k e oo kk | r -> \ H o iv ->
      ((bdFrom oo (I.nthL A s e).2 o.2.1 (invMem (xF false s k,e) H o.1 iv)).1,
       \ a ha -> r a (consL (cL k e a) H) (o.2.2 a ha)
         (negInv phi zero (I.envP A (arg k e) a) hPos ((bdFrom oo (I.nthL A s e).2 o.2.1 (invMem (xF false s k,e) H o.1 iv)).2 a ha),iv)) } ;
} ;

------------------------------------------------------------------------
-- transport along an embedding which is initial below top only
-- (Lemma 11.4.6), for derivations of sequents satisfying the invariant
module TrL (ev : (A : DP.LO) -> W.N -> LT.LL A -> W.Bool) (phi : BI.Form)
  (A B : DP.LO) (g : DP.Map A B) (rho : B.car -> A.car)
  (evI : (k : W.N) (e : LT.LL A) -> Id W.Bool (ev B k (LT.mapL A B g e)) (ev A k e)) (topA : A.car)
  (hrT : (b : B.car) -> Id W.O3 (B.cmp b (g.1 topA)) lt -> Id B.car (g.1 (rho b)) b)
  (hPos : Id W.Bool (posX phi zero) true) {
  module V = Inv[ev,phi,A,topA,hPos] ;
  hb (la : A.car) (bl : V.Bd la) (b : B.car) (h : Id W.O3 (B.cmp b (g.1 la)) lt) : Id B.car (g.1 (rho b)) b =
    CF.or-elim (Id W.Bool (BI.ID[ev,phi].ltB A la topA) true) (Id A.car la topA) (Id B.car (g.1 (rho b)) b)
      (\ l -> hrT b (B.ctrans b (g.1 la) (g.1 topA) h
         (PL.trans W.O3 (B.cmp (g.1 la) (g.1 topA)) (A.cmp la topA) lt (g.2 la topA) (W.isLt-sound (A.cmp la topA) l))))
      (\ e -> hrT b (PL.subst A.car (\ z -> Id W.O3 (B.cmp b (g.1 z)) lt) la topA e h)) bl ;
  module T = TrC[ev,phi,A,B,g,rho,evI,topA,V.Bd,hb] ;
  okL (d : T.CA.C0) (H : BI.ID[ev,phi].Seq A) (o : T.CA.Ok d H) (iv : V.InvS H) : T.CB.Ok (T.mD d) (T.M.mS H) =
    T.okMap d H o (V.invBd d H o iv) ;
} ;

------------------------------------------------------------------------
-- Lemma 11.4.5, compound case: in a derivation of  H, phi(Phi-bar, t)
-- rename the Phi-bar of this occurrence into I^c, i.e. the environment
-- base = [t, xb] into base' = [t, stg c].  The descendants of the
-- occurrence are tracked as MARKED closures (f, pre ++ base), listed by
-- their (formula, prefix); a rule whose principal closure is marked
-- (decided on data) acts on the renamed closure and marks its new
-- closures.  The marked formulas are subformulas of phi at depth
-- |pre|, so (posX) their X-atoms are positive, read the stage position
-- |pre| + 1 and never use it as an argument.  All choices of stages must
-- be below c (ChB), and atoms must not see the difference (evB).
lenL (X : U l) : W.List X -> W.N = split { nilL -> zero ; consL x xs | r -> suc r } ;
module RenM (ev : (A : DP.LO) -> W.N -> LT.LL A -> W.Bool) (phi : BI.Form) (A : DP.LO) (top : A.car)
  (hPos : Id W.Bool (posX phi zero) true) (c : A.car) (t xb : BI.ID[ev,phi].Lb A)
  (evB : (pre : LT.LL A) (k : W.N) -> Id W.Bool (ev A k (KT.appL (BI.ID[ev,phi].Lb A) pre (consL t (consL (BI.ID[ev,phi].stg A c) nilL))))
     (ev A k (KT.appL (BI.ID[ev,phi].Lb A) pre (consL t (consL xb nilL))))) {
  open BF.CI[ev,phi,A,top] ;
  xc : Lb = I.stg A c ;
  base : LT.LL A = consL t (consL xb nilL) ;
  base' : LT.LL A = consL t (consL xc nilL) ;
  apB (pre : LT.LL A) : LT.LL A = KT.appL Lb pre base ;
  apB' (pre : LT.LL A) : LT.LL A = KT.appL Lb pre base' ;
  Mk : U l = BI.Form * LT.LL A ;
  cl (m : Mk) : Clo = (m.1,apB m.2) ;
  cl' (m : Mk) : Clo = (m.1,apB' m.2) ;
  S (M : W.List Mk) : Seq = W.map Mk Clo cl M ;
  S' (M : W.List Mk) : Seq = W.map Mk Clo cl' M ;
  AllP : W.List Mk -> U l = split { nilL -> W.Unit ; consL m ms | r -> Id W.Bool (posX m.1 (lenL Lb m.2)) true * r } ;
  allPMem (m : Mk) : (M : W.List Mk) -> LT.memG Mk m M -> AllP M -> Id W.Bool (posX m.1 (lenL Lb m.2)) true = split {
    nilL -> \ mm ap -> CF.efq (Id W.Bool (posX m.1 (lenL Lb m.2)) true) mm ;
    consL m0 ms | r -> \ mm ap -> CF.or-elim (Id Mk m0 m) (LT.memG Mk m ms) (Id W.Bool (posX m.1 (lenL Lb m.2)) true)
      (\ e -> PL.subst Mk (\ z -> Id W.Bool (posX z.1 (lenL Lb z.2)) true) m0 m e ap.1) (\ m' -> r m' ap.2) mm } ;
  clMem (m : Mk) : (M : W.List Mk) -> LT.memG Mk m M -> Mem (cl' m) (S' M) = split {
    nilL -> \ mm -> mm ;
    consL m0 ms | r -> \ mm -> CF.or-elim (Id Mk m0 m) (LT.memG Mk m ms) (Mem (cl' m) (S' (consL m0 ms)))
      (\ e -> inl (PL.ap Mk Clo cl' m0 m e)) (\ m' -> inr (r m')) mm } ;

  -- positions in the renamed environments
  nthNil1 : (j : W.N) -> Id W.Bool (W.notB (W.eqN (suc j) (suc zero))) true ->
      Id Lb (I.nthL A (suc j) base') (I.nthL A (suc j) base) = split {
    zero -> \ h -> W.absurdB (Id Lb xc xb) h ;
    suc j' -> \ h -> refl (I.nthL A j' nilL) } ;
  nthNil : (k : W.N) -> Id W.Bool (W.notB (W.eqN k (suc zero))) true ->
      Id Lb (I.nthL A k base') (I.nthL A k base) = split {
    zero -> \ h -> refl t ;
    suc j -> nthNil1 j } ;
  nthSame : (pre : LT.LL A) (k : W.N) -> Id W.Bool (W.notB (W.eqN k (suc (lenL Lb pre)))) true ->
      Id Lb (I.nthL A k (apB' pre)) (I.nthL A k (apB pre)) = split {
    nilL -> nthNil ;
    consL a pre' | r -> split {
      zero -> \ h -> refl a ;
      suc j -> \ h -> r j h } } ;
  nthBase' : (pre : LT.LL A) -> Id Lb (I.nthL A (suc (lenL Lb pre)) (apB' pre)) xc = split {
    nilL -> refl xc ;
    consL a pre' | r -> r } ;

  -- membership in appended sequents
  app (X Y : Seq) : Seq = KT.appL Clo X Y ;
  memAppE (Y : Seq) (x : Clo) : (X : Seq) -> Mem x (app X Y) -> W.Or (Mem x X) (Mem x Y) = split {
    nilL -> \ m -> inr m ;
    consL c0 cs | r -> \ m -> CF.or-elim (Id Clo c0 x) (Mem x (app cs Y)) (W.Or (Mem x (consL c0 cs)) (Mem x Y))
      (\ e -> inl (inl e)) (\ m' -> CF.or-elim (Mem x cs) (Mem x Y) (W.Or (Mem x (consL c0 cs)) (Mem x Y))
        (\ m1 -> inl (inr m1)) (\ m2 -> inr m2) (r m')) m } ;
  memAL (Y : Seq) (x : Clo) : (X : Seq) -> Mem x X -> Mem x (app X Y) = split {
    nilL -> \ m -> CF.efq (Mem x Y) m ;
    consL c0 cs | r -> \ m -> CF.or-elim (Id Clo c0 x) (Mem x cs) (Mem x (app (consL c0 cs) Y)) (\ e -> inl e) (\ m' -> inr (r m')) m } ;
  memAR (Y : Seq) (x : Clo) : (X : Seq) -> Mem x Y -> Mem x (app X Y) = split {
    nilL -> \ m -> m ;
    consL c0 cs | r -> \ m -> inr (r m) } ;
  subMid (X : Seq) (c1 : Clo) (Y : Seq) : Sub (app X (consL c1 Y)) (consL c1 (app X Y)) =
    \ x m -> CF.or-elim (Mem x X) (Mem x (consL c1 Y)) (Mem x (consL c1 (app X Y)))
      (\ mx -> inr (memAL Y x X mx))
      (\ my -> CF.or-elim (Id Clo c1 x) (Mem x Y) (Mem x (consL c1 (app X Y))) (\ e -> inl e) (\ my' -> inr (memAR Y x X my')) my)
      (memAppE (consL c1 Y) x X m) ;
  subIns (X : Seq) (c1 : Clo) (Y : Seq) : Sub (consL c1 (app X Y)) (app X (consL c1 Y)) =
    \ x m -> CF.or-elim (Id Clo c1 x) (Mem x (app X Y)) (Mem x (app X (consL c1 Y)))
      (\ e -> memAR (consL c1 Y) x X (inl e))
      (\ m' -> CF.or-elim (Mem x X) (Mem x Y) (Mem x (app X (consL c1 Y)))
        (\ mx -> memAL (consL c1 Y) x X mx) (\ my -> memAR (consL c1 Y) x X (inr my)) (memAppE Y x X m')) m ;

  -- is the principal closure marked?  (decided on data)
  FD (c0 : Clo) (M : W.List Mk) : U l = W.Or ((m : Mk) * (LT.memG Mk m M * Id Clo (cl m) c0)) (Mem c0 (S M) -> W.Empty) ;
  fdV (c0 : Clo) (m : Mk) (ms : W.List Mk) (r : FD c0 ms) : (v : W.Bool) -> Id W.Bool (eqClo (cl m) c0) v -> FD c0 (consL m ms) = split {
    false -> \ h -> CF.or-elim ((m1 : Mk) * (LT.memG Mk m1 ms * Id Clo (cl m1) c0)) (Mem c0 (S ms) -> W.Empty) (FD c0 (consL m ms))
      (\ u -> inl (u.1,(inr u.2.1,u.2.2)))
      (\ nf -> inr (\ mm -> CF.or-elim (Id Clo (cl m) c0) (Mem c0 (S ms)) W.Empty
        (\ e -> W.absurdB W.Empty (PL.trans W.Bool false (eqClo (cl m) c0) true (PL.sym W.Bool (eqClo (cl m) c0) false h) (eqCloE (cl m) c0 e)))
        nf mm)) r ;
    true -> \ h -> inl (m,(inl (refl m),eqCloS (cl m) c0 h)) } ;
  findD (c0 : Clo) : (M : W.List Mk) -> FD c0 M = split {
    nilL -> inr (\ m -> m) ;
    consL m ms | r -> fdV c0 m ms r (eqClo (cl m) c0) (refl (eqClo (cl m) c0)) } ;

  -- the renamed derivation
  brAx (b : W.Bool) (k : W.N) (e0 : LT.LL A) (M : W.List Mk) : FD (atF b k,e0) M -> C0 = split {
    inl u -> cAx b k (apB' u.1.2) ; inr nf -> cAx b k e0 } ;
  brAnd (p q : BI.Form) (e0 : LT.LL A) (r0 r1 : W.List Mk -> C0) (M : W.List Mk) : FD (andF p q,e0) M -> C0 = split {
    inl u -> cAnd p q (apB' u.1.2) (r0 (consL (p,u.1.2) M)) (r1 (consL (q,u.1.2) M)) ;
    inr nf -> cAnd p q e0 (r0 M) (r1 M) } ;
  brOr (p q : BI.Form) (e0 : LT.LL A) (r : W.List Mk -> C0) (M : W.List Mk) : FD (orF p q,e0) M -> C0 = split {
    inl u -> cOr p q (apB' u.1.2) (r (consL (p,u.1.2) (consL (q,u.1.2) M))) ;
    inr nf -> cOr p q e0 (r M) } ;
  brAll (p : BI.Form) (e0 : LT.LL A) (r : Lb -> W.List Mk -> C0) (M : W.List Mk) : FD (allF p,e0) M -> C0 = split {
    inl u -> cAll p (apB' u.1.2) (\ x -> r x (consL (p,consL x u.1.2) M)) ;
    inr nf -> cAll p e0 (\ x -> r x M) } ;
  brEx (p : BI.Form) (e0 : LT.LL A) (w : Lb) (r : W.List Mk -> C0) (M : W.List Mk) : FD (exF p,e0) M -> C0 = split {
    inl u -> cEx p (apB' u.1.2) w (r (consL (p,consL w u.1.2) M)) ;
    inr nf -> cEx p e0 w (r M) } ;
  brXr (s k : W.N) (e0 : LT.LL A) (mu : A.car) (r : W.List Mk -> C0) (M : W.List Mk) : FD (xF true s k,e0) M -> C0 = split {
    inl u -> cXr s k (apB' u.1.2) mu (r M) ;
    inr nf -> cXr s k e0 mu (r M) } ;
  renD : C0 -> W.List Mk -> C0 = split {
    cAx b k e0 -> \ M -> brAx b k e0 M (findD (atF b k,e0) M) ;
    cAnd p q e0 d0 d1 | r0 r1 -> \ M -> brAnd p q e0 r0 r1 M (findD (andF p q,e0) M) ;
    cOr p q e0 d | r -> \ M -> brOr p q e0 r M (findD (orF p q,e0) M) ;
    cAll p e0 kk | r -> \ M -> brAll p e0 r M (findD (allF p,e0) M) ;
    cEx p e0 w d | r -> \ M -> brEx p e0 w r M (findD (exF p,e0) M) ;
    cXr s k e0 mu d | r -> \ M -> brXr s k e0 mu r M (findD (xF true s k,e0) M) ;
    cXl s k e0 o kk | r -> \ M -> cXl s k e0 o (\ x -> r x M) } ;

  ----------------------------------------------------------------------
  -- correctness
  IH (d : C0) : U l = (M : W.List Mk) (H0 H' : Seq) -> Ok d H0 -> Sub H0 (app (S M) H') -> AllP M -> ChB A c d ->
    Ok (renD d M) (app (S' M) H') ;
  -- a principal closure that is not marked is in the context
  memN (c0 : Clo) (M : W.List Mk) (H0 H' : Seq) (sb : Sub H0 (app (S M) H')) (nf : Mem c0 (S M) -> W.Empty) (m : Mem c0 H0) :
      Mem c0 (app (S' M) H') =
    CF.or-elim (Mem c0 (S M)) (Mem c0 H') (Mem c0 (app (S' M) H'))
      (\ ms -> CF.efq (Mem c0 (app (S' M) H')) (nf ms)) (\ mh -> memAR H' c0 (S' M) mh) (memAppE H' c0 (S M) (sb c0 m)) ;
  -- a marked one: its renamed version is in the renamed marks
  memF (c0 : Clo) (M : W.List Mk) (H' : Seq) (u : (m : Mk) * (LT.memG Mk m M * Id Clo (cl m) c0)) :
      Mem (c0.1,apB' u.1.2) (app (S' M) H') =
    memAL H' (c0.1,apB' u.1.2) (S' M)
      (PL.subst BI.Form (\ f -> Mem (f,apB' u.1.2) (S' M)) u.1.1 c0.1 (PL.ap Clo BI.Form (\ z -> z.1) (cl u.1) c0 u.2.2) (clMem u.1 M u.2.1)) ;
  posF (c0 : Clo) (M : W.List Mk) (ap : AllP M) (u : (m : Mk) * (LT.memG Mk m M * Id Clo (cl m) c0)) :
      Id W.Bool (posX c0.1 (lenL Lb u.1.2)) true =
    PL.subst BI.Form (\ f -> Id W.Bool (posX f (lenL Lb u.1.2)) true) u.1.1 c0.1 (PL.ap Clo BI.Form (\ z -> z.1) (cl u.1) c0 u.2.2)
      (allPMem u.1 M u.2.1 ap) ;
  envF (c0 : Clo) (M : W.List Mk) (u : (m : Mk) * (LT.memG Mk m M * Id Clo (cl m) c0)) : Id (LT.LL A) (apB u.1.2) c0.2 =
    PL.ap Clo (LT.LL A) (\ z -> z.2) (cl u.1) c0 u.2.2 ;
  -- premises with an unmarked new closure
  premN (c1 : Clo) (d : C0) (ih : IH d) (M : W.List Mk) (H0 H' : Seq) (sb : Sub H0 (app (S M) H')) (ap : AllP M)
      (o : Ok d (consL c1 H0)) (ch : ChB A c d) : Ok (renD d M) (consL c1 (app (S' M) H')) =
    wk (renD d M) (app (S' M) (consL c1 H')) (consL c1 (app (S' M) H'))
      (ih M (consL c1 H0) (consL c1 H') o
        (subT (consL c1 H0) (consL c1 (app (S M) H')) (app (S M) (consL c1 H')) (subCons c1 H0 (app (S M) H') sb) (subIns (S M) c1 H'))
        ap ch)
      (subMid (S' M) c1 H') ;
  -- premises with a marked new closure m1, whose closure is c1
  premF (m1 : Mk) (c1 : Clo) (e1 : Id Clo (cl m1) c1) (d : C0) (ih : IH d) (M : W.List Mk) (H0 H' : Seq)
      (sb : Sub H0 (app (S M) H')) (ap : AllP (consL m1 M)) (o : Ok d (consL c1 H0)) (ch : ChB A c d) :
      Ok (renD d (consL m1 M)) (consL (cl' m1) (app (S' M) H')) =
    ih (consL m1 M) (consL c1 H0) H' o
      (\ x m -> CF.or-elim (Id Clo c1 x) (Mem x H0) (Mem x (consL (cl m1) (app (S M) H')))
        (\ e -> inl (PL.trans Clo (cl m1) c1 x e1 e)) (\ m' -> inr (sb x m')) m)
      ap ch ;
  clEq (f : BI.Form) (pre e0 : LT.LL A) (e : Id (LT.LL A) (apB pre) e0) : Id Clo (cl (f,pre)) (f,e0) =
    PL.ap (LT.LL A) Clo (\ z -> (f,z)) (apB pre) e0 e ;
  clEqX (f : BI.Form) (x : Lb) (pre e0 : LT.LL A) (e : Id (LT.LL A) (apB pre) e0) : Id Clo (cl (f,consL x pre)) (f,consL x e0) =
    PL.ap (LT.LL A) Clo (\ z -> (f,consL x z)) (apB pre) e0 e ;

  okAx (b : W.Bool) (k : W.N) (e0 : LT.LL A) (M : W.List Mk) (H0 H' : Seq) (o : Ok (cAx b k e0) H0) (sb : Sub H0 (app (S M) H')) :
      (x : FD (atF b k,e0) M) -> Ok (brAx b k e0 M x) (app (S' M) H') = split {
    inl u -> (memF (atF b k,e0) M H' u,
      PL.trans W.Bool (ev A k (apB' u.1.2)) (ev A k (apB u.1.2)) b (evB u.1.2 k)
        (PL.subst (LT.LL A) (\ z -> Id W.Bool (ev A k z) b) e0 (apB u.1.2) (PL.sym (LT.LL A) (apB u.1.2) e0 (envF (atF b k,e0) M u)) o.2)) ;
    inr nf -> (memN (atF b k,e0) M H0 H' sb nf o.1,o.2) } ;
  okAnd (p q : BI.Form) (e0 : LT.LL A) (d0 d1 : C0) (i0 : IH d0) (i1 : IH d1) (M : W.List Mk) (H0 H' : Seq)
      (o : Ok (cAnd p q e0 d0 d1) H0) (sb : Sub H0 (app (S M) H')) (ap : AllP M) (ch : ChB A c (cAnd p q e0 d0 d1)) :
      (x : FD (andF p q,e0) M) -> Ok (brAnd p q e0 (renD d0) (renD d1) M x) (app (S' M) H') = split {
    inl u -> (memF (andF p q,e0) M H' u,
      (premF (p,u.1.2) (p,e0) (clEq p u.1.2 e0 (envF (andF p q,e0) M u)) d0 i0 M H0 H' sb
         (W.andB-l (posX p (lenL Lb u.1.2)) (posX q (lenL Lb u.1.2)) (posF (andF p q,e0) M ap u),ap) o.2.1 ch.1,
       premF (q,u.1.2) (q,e0) (clEq q u.1.2 e0 (envF (andF p q,e0) M u)) d1 i1 M H0 H' sb
         (W.andB-r (posX p (lenL Lb u.1.2)) (posX q (lenL Lb u.1.2)) (posF (andF p q,e0) M ap u),ap) o.2.2 ch.2)) ;
    inr nf -> (memN (andF p q,e0) M H0 H' sb nf o.1,
      (premN (p,e0) d0 i0 M H0 H' sb ap o.2.1 ch.1,premN (q,e0) d1 i1 M H0 H' sb ap o.2.2 ch.2)) } ;
  okOr (p q : BI.Form) (e0 : LT.LL A) (d : C0) (i : IH d) (M : W.List Mk) (H0 H' : Seq)
      (o : Ok (cOr p q e0 d) H0) (sb : Sub H0 (app (S M) H')) (ap : AllP M) (ch : ChB A c (cOr p q e0 d)) :
      (x : FD (orF p q,e0) M) -> Ok (brOr p q e0 (renD d) M x) (app (S' M) H') = split {
    inl u -> (memF (orF p q,e0) M H' u,
      i (consL (p,u.1.2) (consL (q,u.1.2) M)) (consL (p,e0) (consL (q,e0) H0)) H' o.2
        (\ x m -> CF.or-elim (Id Clo (p,e0) x) (Mem x (consL (q,e0) H0)) (Mem x (app (S (consL (p,u.1.2) (consL (q,u.1.2) M))) H'))
          (\ e -> inl (PL.trans Clo (cl (p,u.1.2)) (p,e0) x (clEq p u.1.2 e0 (envF (orF p q,e0) M u)) e))
          (\ m1 -> CF.or-elim (Id Clo (q,e0) x) (Mem x H0) (Mem x (app (S (consL (p,u.1.2) (consL (q,u.1.2) M))) H'))
            (\ e -> inr (inl (PL.trans Clo (cl (q,u.1.2)) (q,e0) x (clEq q u.1.2 e0 (envF (orF p q,e0) M u)) e)))
            (\ m2 -> inr (inr (sb x m2))) m1) m)
        (W.andB-l (posX p (lenL Lb u.1.2)) (posX q (lenL Lb u.1.2)) (posF (orF p q,e0) M ap u),
         (W.andB-r (posX p (lenL Lb u.1.2)) (posX q (lenL Lb u.1.2)) (posF (orF p q,e0) M ap u),ap)) ch) ;
    inr nf -> (memN (orF p q,e0) M H0 H' sb nf o.1,
      wk (renD d M) (app (S' M) (consL (p,e0) (consL (q,e0) H'))) (consL (p,e0) (consL (q,e0) (app (S' M) H')))
        (i M (consL (p,e0) (consL (q,e0) H0)) (consL (p,e0) (consL (q,e0) H')) o.2
          (subT (consL (p,e0) (consL (q,e0) H0)) (consL (p,e0) (consL (q,e0) (app (S M) H'))) (app (S M) (consL (p,e0) (consL (q,e0) H')))
            (subCons (p,e0) (consL (q,e0) H0) (consL (q,e0) (app (S M) H')) (subCons (q,e0) H0 (app (S M) H') sb))
            (subT (consL (p,e0) (consL (q,e0) (app (S M) H'))) (consL (p,e0) (app (S M) (consL (q,e0) H'))) (app (S M) (consL (p,e0) (consL (q,e0) H')))
              (subCons (p,e0) (consL (q,e0) (app (S M) H')) (app (S M) (consL (q,e0) H')) (subIns (S M) (q,e0) H'))
              (subIns (S M) (p,e0) (consL (q,e0) H'))))
          ap ch)
        (subT (app (S' M) (consL (p,e0) (consL (q,e0) H'))) (consL (p,e0) (app (S' M) (consL (q,e0) H'))) (consL (p,e0) (consL (q,e0) (app (S' M) H')))
          (subMid (S' M) (p,e0) (consL (q,e0) H'))
          (subCons (p,e0) (app (S' M) (consL (q,e0) H')) (consL (q,e0) (app (S' M) H')) (subMid (S' M) (q,e0) H')))) } ;
  okAll (p : BI.Form) (e0 : LT.LL A) (kk : Lb -> C0) (i : (x : Lb) -> IH (kk x)) (M : W.List Mk) (H0 H' : Seq)
      (o : Ok (cAll p e0 kk) H0) (sb : Sub H0 (app (S M) H')) (ap : AllP M) (ch : ChB A c (cAll p e0 kk)) :
      (x : FD (allF p,e0) M) -> Ok (brAll p e0 (\ y -> renD (kk y)) M x) (app (S' M) H') = split {
    inl u -> (memF (allF p,e0) M H' u,
      \ y hy -> premF (p,consL y u.1.2) (p,consL y e0) (clEqX p y u.1.2 e0 (envF (allF p,e0) M u)) (kk y) (i y) M H0 H' sb
        (posF (allF p,e0) M ap u,ap) (o.2 y hy) (ch y)) ;
    inr nf -> (memN (allF p,e0) M H0 H' sb nf o.1,
      \ y hy -> premN (p,consL y e0) (kk y) (i y) M H0 H' sb ap (o.2 y hy) (ch y)) } ;
  okEx (p : BI.Form) (e0 : LT.LL A) (w : Lb) (d : C0) (i : IH d) (M : W.List Mk) (H0 H' : Seq)
      (o : Ok (cEx p e0 w d) H0) (sb : Sub H0 (app (S M) H')) (ap : AllP M) (ch : ChB A c (cEx p e0 w d)) :
      (x : FD (exF p,e0) M) -> Ok (brEx p e0 w (renD d) M x) (app (S' M) H') = split {
    inl u -> (memF (exF p,e0) M H' u,
      (o.2.1,premF (p,consL w u.1.2) (p,consL w e0) (clEqX p w u.1.2 e0 (envF (exF p,e0) M u)) d i M H0 H' sb
        (posF (exF p,e0) M ap u,ap) o.2.2 ch)) ;
    inr nf -> (memN (exF p,e0) M H0 H' sb nf o.1,(o.2.1,premN (p,consL w e0) d i M H0 H' sb ap o.2.2 ch)) } ;
  -- (xr) on a marked atom: its stage is the renamed position
  posS (b : W.Bool) (s k n : W.N) (h : Id W.Bool (posX (xF b s k) n) true) : Id W.N s (suc n) =
    W.eqN-sound s (suc n) (W.andB-l (W.eqN s (suc n)) (W.notB (W.eqN k (suc n))) (W.andB-r (BP.eqBo b true) (W.andB (W.eqN s (suc n)) (W.notB (W.eqN k (suc n)))) h)) ;
  posK (b : W.Bool) (s k n : W.N) (h : Id W.Bool (posX (xF b s k) n) true) : Id W.Bool (W.notB (W.eqN k (suc n))) true =
    W.andB-r (W.eqN s (suc n)) (W.notB (W.eqN k (suc n))) (W.andB-r (BP.eqBo b true) (W.andB (W.eqN s (suc n)) (W.notB (W.eqN k (suc n)))) h) ;
  okXr (s k : W.N) (e0 : LT.LL A) (mu : A.car) (d : C0) (i : IH d) (M : W.List Mk) (H0 H' : Seq)
      (o : Ok (cXr s k e0 mu d) H0) (sb : Sub H0 (app (S M) H')) (ap : AllP M) (ch : ChB A c (cXr s k e0 mu d)) :
      (x : FD (xF true s k,e0) M) -> Ok (brXr s k e0 mu (renD d) M x) (app (S' M) H') = split {
    inl u -> (memF (xF true s k,e0) M H' u,
      (PL.subst Lb (\ z -> Id W.Bool (I.allowR A mu z.2) true) xc (I.nthL A s (apB' u.1.2))
         (PL.sym Lb (I.nthL A s (apB' u.1.2)) xc
           (PL.subst W.N (\ z -> Id Lb (I.nthL A z (apB' u.1.2)) xc) (suc (lenL Lb u.1.2)) s
             (PL.sym W.N s (suc (lenL Lb u.1.2)) (posS true s k (lenL Lb u.1.2) (posF (xF true s k,e0) M ap u))) (nthBase' u.1.2)))
         ch.1,
       PL.subst Lb (\ z -> Ok (renD d M) (consL (phi,I.envP A z (I.stg A mu)) (app (S' M) H'))) (I.nthL A k e0) (I.nthL A k (apB' u.1.2))
         (PL.sym Lb (I.nthL A k (apB' u.1.2)) (I.nthL A k e0)
           (PL.trans Lb (I.nthL A k (apB' u.1.2)) (I.nthL A k (apB u.1.2)) (I.nthL A k e0)
             (nthSame u.1.2 k (posK true s k (lenL Lb u.1.2) (posF (xF true s k,e0) M ap u)))
             (PL.ap (LT.LL A) Lb (I.nthL A k) (apB u.1.2) e0 (envF (xF true s k,e0) M u))))
         (premN (cR k e0 mu) d i M H0 H' sb ap o.2.2 ch.2))) ;
    inr nf -> (memN (xF true s k,e0) M H0 H' sb nf o.1,(o.2.1,premN (cR k e0 mu) d i M H0 H' sb ap o.2.2 ch.2)) } ;
  -- (xl) is never principal on a marked closure (phi is positive)
  okXl (s k : W.N) (e0 : LT.LL A) (oo : W.Or W.Unit A.car) (kk : Lb -> C0) (i : (x : Lb) -> IH (kk x)) (M : W.List Mk) (H0 H' : Seq)
      (o : Ok (cXl s k e0 oo kk) H0) (sb : Sub H0 (app (S M) H')) (ap : AllP M) (ch : ChB A c (cXl s k e0 oo kk)) :
      (x : FD (xF false s k,e0) M) -> Ok (cXl s k e0 oo (\ y -> renD (kk y) M)) (app (S' M) H') = split {
    inl u -> W.absurdB (Ok (cXl s k e0 oo (\ y -> renD (kk y) M)) (app (S' M) H')) (posF (xF false s k,e0) M ap u) ;
    inr nf -> (memN (xF false s k,e0) M H0 H' sb nf o.1,(o.2.1,\ a ha -> premN (cL k e0 a) (kk a) (i a) M H0 H' sb ap (o.2.2 a ha) (ch a))) } ;
  okRen : (d : C0) -> IH d = split {
    cAx b k e0 -> \ M H0 H' o sb ap ch -> okAx b k e0 M H0 H' o sb (findD (atF b k,e0) M) ;
    cAnd p q e0 d0 d1 | i0 i1 -> \ M H0 H' o sb ap ch -> okAnd p q e0 d0 d1 i0 i1 M H0 H' o sb ap ch (findD (andF p q,e0) M) ;
    cOr p q e0 d | i -> \ M H0 H' o sb ap ch -> okOr p q e0 d i M H0 H' o sb ap ch (findD (orF p q,e0) M) ;
    cAll p e0 kk | i -> \ M H0 H' o sb ap ch -> okAll p e0 kk i M H0 H' o sb ap ch (findD (allF p,e0) M) ;
    cEx p e0 w d | i -> \ M H0 H' o sb ap ch -> okEx p e0 w d i M H0 H' o sb ap ch (findD (exF p,e0) M) ;
    cXr s k e0 mu d | i -> \ M H0 H' o sb ap ch -> okXr s k e0 mu d i M H0 H' o sb ap ch (findD (xF true s k,e0) M) ;
    cXl s k e0 oo kk | i -> \ M H0 H' o sb ap ch -> okXl s k e0 oo kk i M H0 H' o sb ap ch (findD (xF false s k,e0) M) } ;
  -- the lemma: H, phi(xb, t) becomes H, phi(I^c, t)
  ren (H : Seq) (d : C0) (o : Ok d (consL (phi,base) H)) (ch : ChB A c d) :
      Ok (renD d (consL (phi,nilL) nilL)) (consL (phi,base') H) =
    okRen d (consL (phi,nilL) nilL) (consL (phi,base) H) H o (\ x m -> m) (hPos,tt) ch ;
} ;

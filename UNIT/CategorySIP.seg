-- Structure identity principle for univalent categories.
level k l ;
open Base ; open Prelude[k \/ l] ;
module K = Category[k,l] ;
module Q = Prelude[k \/ l] ;
module R = Prelude[k+ \/ l+] ;
module H = Axioms[k \/ l].FunExtLemmas[fe @(k \/ l)] ;

module EquivProofs (A B : U (k \/ l))
  (setA : isSet A) (setB : isSet B) (f : A -> B) {
  SecEq (s : B -> A) : U (k \/ l) =
    (b : B) -> Id B (f (s b)) b ;
  RetEq (r : B -> A) : U (k \/ l) =
    (a : A) -> Id A (r (f a)) a ;
  Data : U (k \/ l) =
    (w : (B -> A) * (B -> A)) * (SecEq w.1 * RetEq w.2) ;
  from (w : Data) : isEquiv A B f = new IsEquiv[A,B,f,
    sec := w.1.1,sec-eq := w.2.1,
    ret := w.1.2,ret-eq := w.2.2] ;
  raw (e : isEquiv A B f) : Data =
    ((e.sec,e.ret),(e.sec-eq,e.ret-eq)) ;
  eta : (e : isEquiv A B f) -> Id (isEquiv A B f)
    (from (raw e)) e =
    split { IsEquiv A B f s se r re ->
      refl (new IsEquiv[A,B,f,s,se,r,re]) } ;
  ret-sec (e : isEquiv A B f) (b : B) :
    Id A (e.ret b) (e.sec b) =
    trans A (e.ret b) (e.ret (f (e.sec b))) (e.sec b)
      (sym A (e.ret (f (e.sec b))) (e.ret b)
        (ap B A e.ret (f (e.sec b)) b (e.sec-eq b)))
      (e.ret-eq (e.sec b)) ;
  sec-unique (e v : isEquiv A B f) (b : B) :
    Id A (e.sec b) (v.sec b) =
    trans A (e.sec b) (v.ret b) (v.sec b)
      (trans A (e.sec b) (v.ret (f (e.sec b))) (v.ret b)
        (sym A (v.ret (f (e.sec b))) (e.sec b)
          (v.ret-eq (e.sec b)))
        (ap B A v.ret (f (e.sec b)) b (e.sec-eq b)))
      (ret-sec v b) ;
  ret-unique (e v : isEquiv A B f) (b : B) :
    Id A (e.ret b) (v.ret b) =
    trans A (e.ret b) (e.sec b) (v.ret b)
      (ret-sec e b)
      (trans A (e.sec b) (v.sec b) (v.ret b)
        (sec-unique e v b)
        (sym A (v.ret b) (v.sec b) (ret-sec v b))) ;
  sec-law-prop (s : B -> A) : isProp (SecEq s) =
    H.isProp-Pi B (\ b -> Id B (f (s b)) b)
      (\ b -> setB (f (s b)) b) ;
  ret-law-prop (r : B -> A) : isProp (RetEq r) =
    H.isProp-Pi A (\ a -> Id A (r (f a)) a)
      (\ a -> setA (r (f a)) a) ;
  laws-prop (w : (B -> A) * (B -> A)) :
    isProp (SecEq w.1 * RetEq w.2) =
    isProp-Sigma (SecEq w.1) (\ _ -> RetEq w.2)
      (sec-law-prop w.1) (\ _ -> ret-law-prop w.2) ;
  data-prop : isProp Data = \ u v ->
    Sigma-eq ((B -> A) * (B -> A))
      (\ w -> SecEq w.1 * RetEq w.2)
      u.1 v.1 u.2 v.2
      (trans ((B -> A) * (B -> A)) u.1 (v.1.1,u.1.2) v.1
        (ap (B -> A) ((B -> A) * (B -> A))
          (\ s -> (s,u.1.2)) u.1.1 v.1.1
          (H.funext B (\ _ -> A) u.1.1 v.1.1
            (sec-unique (from u) (from v))))
        (ap (B -> A) ((B -> A) * (B -> A))
          (\ r -> (v.1.1,r)) u.1.2 v.1.2
          (H.funext B (\ _ -> A) u.1.2 v.1.2
            (ret-unique (from u) (from v)))))
      (laws-prop v.1) ;
  proof-prop : isProp (isEquiv A B f) =
    retract-prop (isEquiv A B f) Data raw from eta data-prop ;
} ;

module Proofs (C : K.Category) {
  univalence-prop : Q.isProp (K.Univalent C.pre) =
    H.isProp-Pi C.pre.ob
      (\ x -> (y : C.pre.ob) ->
        Q.isEquiv (Id C.pre.ob x y) (C.pre.Iso x y)
          (C.pre.idtoiso x y))
      (\ x -> H.isProp-Pi C.pre.ob
        (\ y -> Q.isEquiv (Id C.pre.ob x y)
          (C.pre.Iso x y) (C.pre.idtoiso x y))
        (\ y -> EquivProofs[
          Id C.pre.ob x y,C.pre.Iso x y,
          K.Objects[C].one-type x y,
          K.IsoSet[C.pre].set x y,
          C.pre.idtoiso x y].proof-prop)) ;
} ;

UnivalentHigh (P : K.Precategory) : U (k+ \/ l+) =
  K.Univalent P ;
CategoryRaw : U (k+ \/ l+) =
  (P : K.Precategory) * UnivalentHigh P ;
category-raw (C : K.Category) : CategoryRaw =
  (C.pre,C.univalent) ;
category-from (w : CategoryRaw) : K.Category =
  new K.Category[w.1,w.2] ;
category-eta : (C : K.Category) ->
  Id K.Category (category-from (category-raw C)) C =
  split { Category P u ->
    refl (new K.Category[P,u]) } ;
pre-path-to-category (C D : K.Category)
  (p : Id K.Precategory C.pre D.pre) :
  Id K.Category C D =
  R.trans K.Category C (category-from (category-raw C)) D
    (R.sym K.Category (category-from (category-raw C)) C
      (category-eta C))
    (R.trans K.Category (category-from (category-raw C))
      (category-from (category-raw D)) D
      (R.ap CategoryRaw K.Category category-from
        (category-raw C) (category-raw D)
        (R.Sigma-eq K.Precategory UnivalentHigh
          C.pre D.pre C.univalent D.univalent p
          (Proofs[D].univalence-prop)))
      (category-eta D)) ;

record Structure (O : U k) {
  hom : O -> O -> U l ;
  hom-set (x y : O) : Prelude[l].isSet (hom x y) ;
  idn (x : O) : hom x x ;
  comp (x y z : O) : hom y z -> hom x y -> hom x z ;
  unit-l (x y : O) (f : hom x y) :
    Id (hom x y) (comp x y y (idn y) f) f ;
  unit-r (x y : O) (f : hom x y) :
    Id (hom x y) (comp x x y f (idn x)) f ;
  assoc (w x y z : O) (f : hom w x)
    (g : hom x y) (h : hom y z) :
    Id (hom w z) (comp w y z h (comp w x y g f))
      (comp w x z (comp x y z h g) f) ;
} ;

to-pre (O : U k) (s : Structure[O]) : K.Precategory =
  new K.Precategory[
    ob := O,hom := s.hom,hom-set := s.hom-set,
    idn := s.idn,comp := s.comp,
    unit-l := s.unit-l,unit-r := s.unit-r,
    assoc := s.assoc] ;
from-pre (P : K.Precategory) : Structure[P.ob] =
  new Structure[P.ob,
    hom := P.hom,hom-set := P.hom-set,
    idn := P.idn,comp := P.comp,
    unit-l := P.unit-l,unit-r := P.unit-r,
    assoc := P.assoc] ;
structure-eta (O : U k) : (s : Structure[O]) ->
  Id (Structure[O]) (from-pre (to-pre O s)) s =
  split { Structure h hs i c ul ur a ->
    refl (new Structure[O,h,hs,i,c,ul,ur,a]) } ;
pre-eta : (P : K.Precategory) ->
  Id K.Precategory (to-pre P.ob (from-pre P)) P =
  split { Precategory O h hs i c ul ur a ->
    refl (new K.Precategory[O,h,hs,i,c,ul,ur,a]) } ;

record Operations (O : U k) (h : O -> O -> U l) {
  hom-set (x y : O) : Prelude[l].isSet (h x y) ;
  idn (x : O) : h x x ;
  comp (x y z : O) : h y z -> h x y -> h x z ;
  unit-l (x y : O) (f : h x y) :
    Id (h x y) (comp x y y (idn y) f) f ;
  unit-r (x y : O) (f : h x y) :
    Id (h x y) (comp x x y f (idn x)) f ;
  assoc (w x y z : O) (f : h w x)
    (g : h x y) (v : h y z) :
    Id (h w z) (comp w y z v (comp w x y g f))
      (comp w x z (comp x y z v g) f) ;
} ;
StructureRaw (O : U k) : U (k+ \/ l+) =
  (h : O -> O -> U l) * Operations[O,h] ;
structure-raw (O : U k) (s : Structure[O]) :
  StructureRaw O =
  (s.hom,new Operations[O,s.hom,
    s.hom-set,s.idn,s.comp,s.unit-l,s.unit-r,s.assoc]) ;
structure-from (O : U k) (w : StructureRaw O) :
  Structure[O] =
  new Structure[O,w.1,
    w.2.hom-set,w.2.idn,w.2.comp,
    w.2.unit-l,w.2.unit-r,w.2.assoc] ;
structure-raw-eta (O : U k) : (s : Structure[O]) ->
  Id (Structure[O]) (structure-from O (structure-raw O s)) s =
  split { Structure h hs i c ul ur a ->
    refl (new Structure[O,h,hs,i,c,ul,ur,a]) } ;

module Fixed (O : U k) (h : O -> O -> U l) {
  hom-eta : Id (O -> O -> U l)
    (\ x y -> h x y) h = refl h ;
  module HL = Axioms[l].FunExtLemmas[fe @l] ;
  HomSet : U (k \/ l) =
    (x y : O) -> Prelude[l].isSet (h x y) ;
  Idn : U (k \/ l) = (x : O) -> h x x ;
  Comp : U (k \/ l) =
    (x y z : O) -> h y z -> h x y -> h x z ;
  UnitL (i : Idn) (c : Comp) : U (k \/ l) =
    (x y : O) (f : h x y) ->
      Id (h x y) (c x y y (i y) f) f ;
  UnitR (i : Idn) (c : Comp) : U (k \/ l) =
    (x y : O) (f : h x y) ->
      Id (h x y) (c x x y f (i x)) f ;
  Assoc (c : Comp) : U (k \/ l) =
    (w x y z : O) (f : h w x) (g : h x y)
      (v : h y z) ->
      Id (h w z) (c w y z v (c w x y g f))
        (c w x z (c x y z v g) f) ;
  Laws (i : Idn) (c : Comp) : U (k \/ l) =
    UnitL i c * (UnitR i c * Assoc c) ;
  Data : U (k \/ l) = Idn * Comp ;
  Fiber (d : Data) : U (k \/ l) =
    HomSet * Laws d.1 d.2 ;
  Raw : U (k \/ l) = (d : Data) * Fiber d ;
  raw (s : Operations[O,h]) : Raw =
    ((s.idn,s.comp),
      (s.hom-set,(s.unit-l,(s.unit-r,s.assoc)))) ;
  from (r : Raw) : Operations[O,h] =
    new Operations[O,h,
      r.2.1,r.1.1,r.1.2,
      r.2.2.1,r.2.2.2.1,r.2.2.2.2] ;
  eta : (s : Operations[O,h]) ->
    Id (Operations[O,h]) (from (raw s)) s =
    split { Operations hs i c ul ur a ->
      refl (new Operations[O,h,hs,i,c,ul,ur,a]) } ;
  isSet-prop (A : U l) : Prelude[l].isProp
    (Prelude[l].isSet A) =
    HL.isProp-Pi A
      (\ x -> (y : A) -> Prelude[l].isProp (Id A x y))
      (\ x -> HL.isProp-Pi A
        (\ y -> Prelude[l].isProp (Id A x y))
        (\ y -> HL.isProp-isProp (Id A x y))) ;
  homset-prop : Q.isProp HomSet =
    H.isProp-Pi O
      (\ x -> (y : O) -> Prelude[l].isSet (h x y))
      (\ x -> H.isProp-Pi O
        (\ y -> Prelude[l].isSet (h x y))
        (\ y -> isSet-prop (h x y))) ;
  module UnitLProp (i : Idn) (c : Comp)
    (hs : HomSet) {
    X (x : O) : U (k \/ l) =
      (y : O) (f : h x y) ->
        Id (h x y) (c x y y (i y) f) f ;
    Y (x y : O) : U (k \/ l) =
      (f : h x y) -> Id (h x y)
        (c x y y (i y) f) f ;
    proposition : Q.isProp (UnitL i c) =
      H.isProp-Pi O X (\ x ->
        H.isProp-Pi O (Y x) (\ y ->
          H.isProp-Pi (h x y)
            (\ f -> Id (h x y) (c x y y (i y) f) f)
            (\ f -> hs x y (c x y y (i y) f) f))) ;
  } ;
  module UnitRProp (i : Idn) (c : Comp)
    (hs : HomSet) {
    X (x : O) : U (k \/ l) =
      (y : O) (f : h x y) ->
        Id (h x y) (c x x y f (i x)) f ;
    Y (x y : O) : U (k \/ l) =
      (f : h x y) -> Id (h x y)
        (c x x y f (i x)) f ;
    proposition : Q.isProp (UnitR i c) =
      H.isProp-Pi O X (\ x ->
        H.isProp-Pi O (Y x) (\ y ->
          H.isProp-Pi (h x y)
            (\ f -> Id (h x y) (c x x y f (i x)) f)
            (\ f -> hs x y (c x x y f (i x)) f))) ;
  } ;
  module AssocProp (c : Comp) (hs : HomSet) {
    Eq (w x y z : O) (f : h w x)
      (g : h x y) (v : h y z) : U (k \/ l) =
      Id (h w z) (c w y z v (c w x y g f))
        (c w x z (c x y z v g) f) ;
    W (w : O) : U (k \/ l) =
      (x y z : O) (f : h w x)
        (g : h x y) (v : h y z) -> Eq w x y z f g v ;
    X (w x : O) : U (k \/ l) =
      (y z : O) (f : h w x)
        (g : h x y) (v : h y z) -> Eq w x y z f g v ;
    Y (w x y : O) : U (k \/ l) =
      (z : O) (f : h w x)
        (g : h x y) (v : h y z) -> Eq w x y z f g v ;
    Z (w x y z : O) : U (k \/ l) =
      (f : h w x) (g : h x y)
        (v : h y z) -> Eq w x y z f g v ;
    F (w x y z : O) (f : h w x) : U (k \/ l) =
      (g : h x y) (v : h y z) -> Eq w x y z f g v ;
    G (w x y z : O) (f : h w x) (g : h x y) : U (k \/ l) =
      (v : h y z) -> Eq w x y z f g v ;
    proposition : Q.isProp (Assoc c) =
      H.isProp-Pi O W (\ w ->
        H.isProp-Pi O (X w) (\ x ->
          H.isProp-Pi O (Y w x) (\ y ->
            H.isProp-Pi O (Z w x y) (\ z ->
              H.isProp-Pi (h w x) (F w x y z) (\ f ->
                H.isProp-Pi (h x y) (G w x y z f) (\ g ->
                  H.isProp-Pi (h y z) (Eq w x y z f g)
                    (\ v -> hs w z
                      (c w y z v (c w x y g f))
                      (c w x z (c x y z v g) f)))))))) ;
  } ;
  laws-prop (i : Idn) (c : Comp) (hs : HomSet) :
    Q.isProp (Laws i c) =
    Q.isProp-Sigma (UnitL i c)
      (\ _ -> UnitR i c * Assoc c)
      (UnitLProp[i,c,hs].proposition)
      (\ _ -> Q.isProp-Sigma (UnitR i c)
        (\ _ -> Assoc c)
        (UnitRProp[i,c,hs].proposition)
        (\ _ -> AssocProp[c,hs].proposition)) ;
  fiber-prop (d : Data) : Q.isProp (Fiber d) =
    Q.isProp-Sigma HomSet
      (\ _ -> Laws d.1 d.2)
      homset-prop
      (\ hs -> laws-prop d.1 d.2 hs) ;
  data-eq (a b : Data)
    (pi : Id Idn a.1 b.1)
    (pc : Id Comp a.2 b.2) :
    Id Data a b =
    Q.trans Data a (b.1,a.2) b
      (Q.ap Idn Data (\ i -> (i,a.2)) a.1 b.1 pi)
      (Q.ap Comp Data (\ c -> (b.1,c)) a.2 b.2 pc) ;
  equal (s t : Operations[O,h])
    (pi : Id Idn s.idn t.idn)
    (pc : Id Comp s.comp t.comp) :
    Id (Operations[O,h]) s t =
    Q.trans (Operations[O,h]) s (from (raw s)) t
      (Q.sym (Operations[O,h]) (from (raw s)) s (eta s))
      (Q.trans (Operations[O,h]) (from (raw s))
        (from (raw t)) t
        (Q.ap Raw (Operations[O,h]) from
          (raw s) (raw t)
          (Q.Sigma-eq Data Fiber
            (raw s).1 (raw t).1 (raw s).2 (raw t).2
            (data-eq (raw s).1 (raw t).1 pi pc)
            (fiber-prop (raw t).1)))
        (eta t)) ;
} ;

fixed-hom-equal (O : U k) (s : Structure[O])
  (t : Operations[O,s.hom])
  (pi : Id (Fixed[O,s.hom].Idn) s.idn t.idn)
  (pc : Id (Fixed[O,s.hom].Comp) s.comp t.comp) :
  Id (Structure[O]) s (structure-from O (s.hom,t)) =
  R.trans (Structure[O]) s
    (structure-from O (structure-raw O s))
    (structure-from O (s.hom,t))
    (R.sym (Structure[O])
      (structure-from O (structure-raw O s)) s
      (structure-raw-eta O s))
    (R.ap (Operations[O,s.hom]) (Structure[O])
      (\ o -> structure-from O (s.hom,o))
      (structure-raw O s).2 t
      (Fixed[O,s.hom].equal
        (structure-raw O s).2 t pi pc)) ;

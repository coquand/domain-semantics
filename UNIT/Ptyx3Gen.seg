-- Type-3 ptykes preserve pull-backs, and every type-3 ptyx is covered by
-- the subobjects generated by points over finitely generated ptykes
-- (catemb.pdf one level up; the type-3 analogue of PtyxGen).
--
--   * Pre: the preimage of a subptyx s of D along T : A -> D;
--   * pb3: if X(T) y is supported by s, then y is supported by Pre T s
--     (X(T) y is supported by Im T, so by Im T /\ s (meet), and
--     Im T /\ s maps into Pre T s through the inverse of T);
--   * Gen3[X,A,y]: the points x of X(D) with a common origin with y.
--     Size: an origin over an arbitrary ptyx would be a large existential,
--     so origins are taken over the finitely generated subptykes of A
--     (small data Gens A).  Reflection along M : P -> Q: pull the origin
--     back by pb3 to the pull-back subptyx Pb of the origin, take a
--     finite support of the point there (continuity), and push it to A
--     with Ptyx3Fin.PushFG;
--   * self, least: Gen3 is the least subobject containing y;
--   * cover3: every point lies in Gen3 of a point over a finitely
--     generated subptyx.
level l ;
open Base ; open Prelude[l+] ; open ScottOrder[l] ;
module W = Dilator[l] ;
module CD = CatDil[l] ;
module DP = DilPtyx[l] ;
module PM = PtyxMor[l] ;
module PS = PtyxSub[l] ;
module P3 = Ptyx3[l] ;
module P3P = Ptyx3Pull[l] ;
module P3S = Ptyx3Sub[l] ;
module P3F = Ptyx3Fin[l] ;
module PL = Prelude[l] ;
module TC = TruncationCombinators[l] ;

----------------------------------------------------------------------
-- preimages and pull-backs

module Pre (A D : DP.Ptyx) (T : PM.Mor A D) (s : P3.Sub D) {
  S : PS.Pred A = \ E z -> s.1 E ((T.1 E).1 z) ;
  sp : PS.SProp A S = \ E z -> s.2.1 E ((T.1 E).1 z) ;
  fw : PS.Fwd A S = \ E E' M z h ->
    PL.subst (D.F E').car (s.1 E') ((D.arr E E' M).1 ((T.1 E).1 z)) ((T.1 E').1 ((A.arr E E' M).1 z)) (T.2.1 E E' M z)
      (s.2.2.1 E E' M ((T.1 E).1 z) h) ;
  bw : PS.Bwd A S = \ E E' M z h ->
    s.2.2.2 E E' M ((T.1 E).1 z)
      (PL.subst (D.F E').car (s.1 E') ((T.1 E').1 ((A.arr E E' M).1 z)) ((D.arr E E' M).1 ((T.1 E).1 z))
        (PL.sym (D.F E').car ((D.arr E E' M).1 ((T.1 E).1 z)) ((T.1 E').1 ((A.arr E E' M).1 z)) (T.2.1 E E' M z)) h) ;
  sub : P3.Sub A = (S,(sp,(fw,bw))) ;
} ;

module PB3 (X : P3.Ptyx3) (A D : DP.Ptyx) (T : PM.Mor A D) (s : P3.Sub D) (y : (X.G A).car)
  (u : P3.Supp3 X D ((X.arr A D T).1 y) s) {
  module I = P3P.Inv[A,D,T] ;
  Ty : (X.G D).car = (X.arr A D T).1 y ;
  sT : P3.Supp3 X D Ty I.s =
    ((X.arr A I.im I.Im.m).1 y,
     PL.trans (X.G D).car ((X.arr I.im D I.Im.SP.inc).1 ((X.arr A I.im I.Im.m).1 y))
       ((X.arr A D (PM.compP A I.im D I.Im.m I.Im.SP.inc)).1 y) Ty
       (X.arr-comp A I.im D I.Im.m I.Im.SP.inc y)
       (PL.ap (PM.Mor A D) (X.G D).car (\ M -> (X.arr A D M).1 y) (PM.compP A I.im D I.Im.m I.Im.SP.inc) T I.iso-tri)) ;
  ms : P3.Sub D = P3.meetSub D I.s s ;
  sm : P3.Supp3 X D Ty ms = X.meet D Ty I.s s sT u ;
  module MS = P3.SubOf[D,ms] ;
  module PR = Pre[A,D,T,s] ;
  module SAp = P3.SubOf[A,PR.sub] ;
  module J = P3.Incl[D,ms,I.s,\ E x h -> h.1] ;
  toA : PM.Mor MS.ptyx A = PM.compP MS.ptyx I.im A J.mor I.mor ;
  hs (E : CD.Dil) (p : MS.SP.Car E) : s.1 E ((T.1 E).1 ((toA.1 E).1 p)) =
    PL.subst (D.F E).car (s.1 E) p.1 ((T.1 E).1 ((toA.1 E).1 p))
      (PL.sym (D.F E).car ((T.1 E).1 ((toA.1 E).1 p)) p.1 (I.ge E (J.f E p))) p.2.2 ;
  module L = P3F.Coreg[MS.ptyx,A,toA,PR.sub,hs] ;
  w : (X.G SAp.ptyx).car = (X.arr MS.ptyx SAp.ptyx L.mor).1 sm.1 ;
  -- (L ; inc) ; T = inc of MS
  sq : Id (PM.Mor MS.ptyx D) (PM.compP MS.ptyx A D (PM.compP MS.ptyx SAp.ptyx A L.mor SAp.inc) T) MS.inc =
    P3.mor-eq MS.ptyx D (PM.compP MS.ptyx A D (PM.compP MS.ptyx SAp.ptyx A L.mor SAp.inc) T) MS.inc (\ E p -> I.ge E (J.f E p)) ;
  ew : Id (X.G A).car ((X.arr SAp.ptyx A SAp.inc).1 w) y =
    DP.map-inj (X.G A) (X.G D) (X.arr A D T) ((X.arr SAp.ptyx A SAp.inc).1 w) y
      (PL.trans (X.G D).car ((X.arr A D T).1 ((X.arr SAp.ptyx A SAp.inc).1 w))
        ((X.arr A D T).1 ((X.arr MS.ptyx A (PM.compP MS.ptyx SAp.ptyx A L.mor SAp.inc)).1 sm.1)) Ty
        (PL.ap (X.G A).car (X.G D).car (X.arr A D T).1 ((X.arr SAp.ptyx A SAp.inc).1 w)
          ((X.arr MS.ptyx A (PM.compP MS.ptyx SAp.ptyx A L.mor SAp.inc)).1 sm.1)
          (X.arr-comp MS.ptyx SAp.ptyx A L.mor SAp.inc sm.1))
        (PL.trans (X.G D).car ((X.arr A D T).1 ((X.arr MS.ptyx A (PM.compP MS.ptyx SAp.ptyx A L.mor SAp.inc)).1 sm.1))
          ((X.arr MS.ptyx D (PM.compP MS.ptyx A D (PM.compP MS.ptyx SAp.ptyx A L.mor SAp.inc) T)).1 sm.1) Ty
          (X.arr-comp MS.ptyx A D (PM.compP MS.ptyx SAp.ptyx A L.mor SAp.inc) T sm.1)
          (PL.trans (X.G D).car ((X.arr MS.ptyx D (PM.compP MS.ptyx A D (PM.compP MS.ptyx SAp.ptyx A L.mor SAp.inc) T)).1 sm.1)
            ((X.arr MS.ptyx D MS.inc).1 sm.1) Ty
            (PL.ap (PM.Mor MS.ptyx D) (X.G D).car (\ M -> (X.arr MS.ptyx D M).1 sm.1)
              (PM.compP MS.ptyx A D (PM.compP MS.ptyx SAp.ptyx A L.mor SAp.inc) T) MS.inc sq)
            sm.2))) ;
  result : P3.Supp3 X A y PR.sub = (w,ew) ;
} ;
pb3 (X : P3.Ptyx3) (A D : DP.Ptyx) (T : PM.Mor A D) (s : P3.Sub D) (y : (X.G A).car)
  (u : P3.Supp3 X D ((X.arr A D T).1 y) s) : P3.Supp3 X A y (Pre[A,D,T,s].sub) = PB3[X,A,D,T,s,y,u].result ;

----------------------------------------------------------------------
-- the subobject generated by a point

module Gen3 (X : P3.Ptyx3) (A : DP.Ptyx) (y : (X.G A).car) {
  Origin (D : DP.Ptyx) (x : (X.G D).car) : U l =
    (g : P3.Gens A) * ((z : (X.G (P3.SubOf[A,P3.FG[A,g].sub].ptyx)).car) *
      (Id (X.G A).car ((X.arr (P3.SubOf[A,P3.FG[A,g].sub].ptyx) A (P3.SubOf[A,P3.FG[A,g].sub].inc)).1 z) y *
       ((T : PM.Mor (P3.SubOf[A,P3.FG[A,g].sub].ptyx) D) *
         Id (X.G D).car ((X.arr (P3.SubOf[A,P3.FG[A,g].sub].ptyx) D T).1 z) x))) ;
  S : P3S.Pred3 X = \ D x -> Ex (Origin D x) ;
  sp : P3S.SProp3 X S = \ D x -> prop (Origin D x) ;
  module FwO (D E : DP.Ptyx) (M : PM.Mor D E) (x : (X.G D).car) (o : Origin D x) {
    module SO = P3.SubOf[A,P3.FG[A,o.1].sub] ;
    result : Origin E ((X.arr D E M).1 x) =
      (o.1,(o.2.1,(o.2.2.1,(PM.compP SO.ptyx D E o.2.2.2.1 M,
        PL.trans (X.G E).car ((X.arr SO.ptyx E (PM.compP SO.ptyx D E o.2.2.2.1 M)).1 o.2.1)
          ((X.arr D E M).1 ((X.arr SO.ptyx D o.2.2.2.1).1 o.2.1)) ((X.arr D E M).1 x)
          (PL.sym (X.G E).car ((X.arr D E M).1 ((X.arr SO.ptyx D o.2.2.2.1).1 o.2.1))
            ((X.arr SO.ptyx E (PM.compP SO.ptyx D E o.2.2.2.1 M)).1 o.2.1) (X.arr-comp SO.ptyx D E o.2.2.2.1 M o.2.1))
          (PL.ap (X.G D).car (X.G E).car (X.arr D E M).1 ((X.arr SO.ptyx D o.2.2.2.1).1 o.2.1) x o.2.2.2.2))))) ;
  } ;
  fw : P3S.Fwd3 X S = \ D E M x -> TC.map (Origin D x) (Origin E ((X.arr D E M).1 x)) (\ o -> FwO[D,E,M,x,o].result) ;

  -- reflection along M : P -> Q
  module BwO (P Q : DP.Ptyx) (M : PM.Mor P Q) (x : (X.G P).car) (o : Origin Q ((X.arr P Q M).1 x)) {
    g : P3.Gens A = o.1 ;
    module SO = P3.SubOf[A,P3.FG[A,g].sub] ;
    R : DP.Ptyx = SO.ptyx ;
    z : (X.G R).car = o.2.1 ;
    T : PM.Mor R Q = o.2.2.2.1 ;
    eT : Id (X.G Q).car ((X.arr R Q T).1 z) ((X.arr P Q M).1 x) = o.2.2.2.2 ;
    module I = P3P.Inv[P,Q,M] ;
    -- X(M) x, hence X(T) z, is supported by the image of M
    sM : P3.Supp3 X Q ((X.arr R Q T).1 z) I.s =
      ((X.arr P I.im I.Im.m).1 x,
       PL.trans (X.G Q).car ((X.arr I.im Q I.Im.SP.inc).1 ((X.arr P I.im I.Im.m).1 x))
         ((X.arr P Q M).1 x) ((X.arr R Q T).1 z)
         (PL.trans (X.G Q).car ((X.arr I.im Q I.Im.SP.inc).1 ((X.arr P I.im I.Im.m).1 x))
           ((X.arr P Q (PM.compP P I.im Q I.Im.m I.Im.SP.inc)).1 x) ((X.arr P Q M).1 x)
           (X.arr-comp P I.im Q I.Im.m I.Im.SP.inc x)
           (PL.ap (PM.Mor P Q) (X.G Q).car (\ N -> (X.arr P Q N).1 x) (PM.compP P I.im Q I.Im.m I.Im.SP.inc) M I.iso-tri))
         (PL.sym (X.G Q).car ((X.arr R Q T).1 z) ((X.arr P Q M).1 x) eT)) ;
    -- so z is supported by the pull-back Pb = Pre T (Im M)
    module PR = Pre[R,Q,T,I.s] ;
    module Pb = P3.SubOf[R,PR.sub] ;
    sz : P3.Supp3 X R z PR.sub = pb3 X R Q T I.s z sM ;
    z2 : (X.G Pb.ptyx).car = sz.1 ;
    -- Pb maps to P through the inverse of M
    module C = P3F.Coreg[Pb.ptyx,Q,PM.compP Pb.ptyx R Q Pb.inc T,I.s,\ D p -> p.2] ;
    Lp : PM.Mor Pb.ptyx P = PM.compP Pb.ptyx I.im P C.mor I.mor ;
    sqM : Id (PM.Mor Pb.ptyx Q) (PM.compP Pb.ptyx P Q Lp M) (PM.compP Pb.ptyx R Q Pb.inc T) =
      P3.mor-eq Pb.ptyx Q (PM.compP Pb.ptyx P Q Lp M) (PM.compP Pb.ptyx R Q Pb.inc T) (\ D p -> I.ge D (C.f D p)) ;
    eLp : Id (X.G P).car ((X.arr Pb.ptyx P Lp).1 z2) x =
      DP.map-inj (X.G P) (X.G Q) (X.arr P Q M) ((X.arr Pb.ptyx P Lp).1 z2) x
        (PL.trans (X.G Q).car ((X.arr P Q M).1 ((X.arr Pb.ptyx P Lp).1 z2)) ((X.arr Pb.ptyx Q (PM.compP Pb.ptyx P Q Lp M)).1 z2)
          ((X.arr P Q M).1 x)
          (X.arr-comp Pb.ptyx P Q Lp M z2)
          (PL.trans (X.G Q).car ((X.arr Pb.ptyx Q (PM.compP Pb.ptyx P Q Lp M)).1 z2)
            ((X.arr Pb.ptyx Q (PM.compP Pb.ptyx R Q Pb.inc T)).1 z2) ((X.arr P Q M).1 x)
            (PL.ap (PM.Mor Pb.ptyx Q) (X.G Q).car (\ N -> (X.arr Pb.ptyx Q N).1 z2)
              (PM.compP Pb.ptyx P Q Lp M) (PM.compP Pb.ptyx R Q Pb.inc T) sqM)
            (PL.trans (X.G Q).car ((X.arr Pb.ptyx Q (PM.compP Pb.ptyx R Q Pb.inc T)).1 z2)
              ((X.arr R Q T).1 ((X.arr Pb.ptyx R Pb.inc).1 z2)) ((X.arr P Q M).1 x)
              (PL.sym (X.G Q).car ((X.arr R Q T).1 ((X.arr Pb.ptyx R Pb.inc).1 z2))
                ((X.arr Pb.ptyx Q (PM.compP Pb.ptyx R Q Pb.inc T)).1 z2) (X.arr-comp Pb.ptyx R Q Pb.inc T z2))
              (PL.trans (X.G Q).car ((X.arr R Q T).1 ((X.arr Pb.ptyx R Pb.inc).1 z2)) ((X.arr R Q T).1 z) ((X.arr P Q M).1 x)
                (PL.ap (X.G R).car (X.G Q).car (X.arr R Q T).1 ((X.arr Pb.ptyx R Pb.inc).1 z2) z sz.2)
                eT)))) ;
    -- Pb maps to A
    U0 : PM.Mor Pb.ptyx A = PM.compP Pb.ptyx R A Pb.inc SO.inc ;
    eU0 : Id (X.G A).car ((X.arr Pb.ptyx A U0).1 z2) y =
      PL.trans (X.G A).car ((X.arr Pb.ptyx A U0).1 z2) ((X.arr R A SO.inc).1 ((X.arr Pb.ptyx R Pb.inc).1 z2)) y
        (PL.sym (X.G A).car ((X.arr R A SO.inc).1 ((X.arr Pb.ptyx R Pb.inc).1 z2)) ((X.arr Pb.ptyx A U0).1 z2)
          (X.arr-comp Pb.ptyx R A Pb.inc SO.inc z2))
        (PL.trans (X.G A).car ((X.arr R A SO.inc).1 ((X.arr Pb.ptyx R Pb.inc).1 z2)) ((X.arr R A SO.inc).1 z) y
          (PL.ap (X.G R).car (X.G A).car (X.arr R A SO.inc).1 ((X.arr Pb.ptyx R Pb.inc).1 z2) z sz.2)
          o.2.2.1) ;
    -- a finite support of z2 in Pb, pushed to A
    module Fin (w : (g2 : P3.Gens Pb.ptyx) * P3.Supp3 X Pb.ptyx z2 (P3.FG[Pb.ptyx,g2].sub)) {
      module K = P3F.PushFG[Pb.ptyx,A,U0,w.1] ;
      z3 : (X.G K.SR.ptyx).car = w.2.1 ;
      e3 : Id (X.G Pb.ptyx).car ((X.arr K.SR.ptyx Pb.ptyx K.SR.inc).1 z3) z2 = w.2.2 ;
      zs : (X.G K.SA.ptyx).car = (X.arr K.SR.ptyx K.SA.ptyx K.k).1 z3 ;
      -- X(inc) (X(SR.inc) z3) through U0
      eU : Id (X.G A).car ((X.arr K.SR.ptyx A (PM.compP K.SR.ptyx Pb.ptyx A K.SR.inc U0)).1 z3) y =
        PL.trans (X.G A).car ((X.arr K.SR.ptyx A (PM.compP K.SR.ptyx Pb.ptyx A K.SR.inc U0)).1 z3)
          ((X.arr Pb.ptyx A U0).1 ((X.arr K.SR.ptyx Pb.ptyx K.SR.inc).1 z3)) y
          (PL.sym (X.G A).car ((X.arr Pb.ptyx A U0).1 ((X.arr K.SR.ptyx Pb.ptyx K.SR.inc).1 z3))
            ((X.arr K.SR.ptyx A (PM.compP K.SR.ptyx Pb.ptyx A K.SR.inc U0)).1 z3) (X.arr-comp K.SR.ptyx Pb.ptyx A K.SR.inc U0 z3))
          (PL.trans (X.G A).car ((X.arr Pb.ptyx A U0).1 ((X.arr K.SR.ptyx Pb.ptyx K.SR.inc).1 z3)) ((X.arr Pb.ptyx A U0).1 z2) y
            (PL.ap (X.G Pb.ptyx).car (X.G A).car (X.arr Pb.ptyx A U0).1 ((X.arr K.SR.ptyx Pb.ptyx K.SR.inc).1 z3) z2 e3)
            eU0) ;
      es : Id (X.G A).car ((X.arr K.SA.ptyx A K.SA.inc).1 zs) y =
        PL.trans (X.G A).car ((X.arr K.SA.ptyx A K.SA.inc).1 zs) ((X.arr K.SR.ptyx A (PM.compP K.SR.ptyx K.SA.ptyx A K.k K.SA.inc)).1 z3) y
          (X.arr-comp K.SR.ptyx K.SA.ptyx A K.k K.SA.inc z3)
          (PL.trans (X.G A).car ((X.arr K.SR.ptyx A (PM.compP K.SR.ptyx K.SA.ptyx A K.k K.SA.inc)).1 z3)
            ((X.arr K.SR.ptyx A (PM.compP K.SR.ptyx Pb.ptyx A K.SR.inc U0)).1 z3) y
            (PL.ap (PM.Mor K.SR.ptyx A) (X.G A).car (\ N -> (X.arr K.SR.ptyx A N).1 z3)
              (PM.compP K.SR.ptyx K.SA.ptyx A K.k K.SA.inc) (PM.compP K.SR.ptyx Pb.ptyx A K.SR.inc U0) K.k-tri)
            eU) ;
      -- the new arrow to P
      toP : PM.Mor K.SR.ptyx P = PM.compP K.SR.ptyx Pb.ptyx P K.SR.inc Lp ;
      Ts : PM.Mor K.SA.ptyx P = PM.compP K.SA.ptyx K.SR.ptyx P K.kinv toP ;
      kT : Id (PM.Mor K.SR.ptyx P) (PM.compP K.SR.ptyx K.SA.ptyx P K.k Ts) toP =
        P3.mor-eq K.SR.ptyx P (PM.compP K.SR.ptyx K.SA.ptyx P K.k Ts) toP
          (\ D p -> PL.ap (K.SR.SP.Car D) (P.F D).car (toP.1 D).1 ((K.kinv.1 D).1 ((K.k.1 D).1 p)) p (K.k-kinv D p)) ;
      eTs : Id (X.G P).car ((X.arr K.SA.ptyx P Ts).1 zs) x =
        PL.trans (X.G P).car ((X.arr K.SA.ptyx P Ts).1 zs) ((X.arr K.SR.ptyx P (PM.compP K.SR.ptyx K.SA.ptyx P K.k Ts)).1 z3) x
          (X.arr-comp K.SR.ptyx K.SA.ptyx P K.k Ts z3)
          (PL.trans (X.G P).car ((X.arr K.SR.ptyx P (PM.compP K.SR.ptyx K.SA.ptyx P K.k Ts)).1 z3) ((X.arr K.SR.ptyx P toP).1 z3) x
            (PL.ap (PM.Mor K.SR.ptyx P) (X.G P).car (\ N -> (X.arr K.SR.ptyx P N).1 z3)
              (PM.compP K.SR.ptyx K.SA.ptyx P K.k Ts) toP kT)
            (PL.trans (X.G P).car ((X.arr K.SR.ptyx P toP).1 z3) ((X.arr Pb.ptyx P Lp).1 ((X.arr K.SR.ptyx Pb.ptyx K.SR.inc).1 z3)) x
              (PL.sym (X.G P).car ((X.arr Pb.ptyx P Lp).1 ((X.arr K.SR.ptyx Pb.ptyx K.SR.inc).1 z3)) ((X.arr K.SR.ptyx P toP).1 z3)
                (X.arr-comp K.SR.ptyx Pb.ptyx P K.SR.inc Lp z3))
              (PL.trans (X.G P).car ((X.arr Pb.ptyx P Lp).1 ((X.arr K.SR.ptyx Pb.ptyx K.SR.inc).1 z3)) ((X.arr Pb.ptyx P Lp).1 z2) x
                (PL.ap (X.G Pb.ptyx).car (X.G P).car (X.arr Pb.ptyx P Lp).1 ((X.arr K.SR.ptyx Pb.ptyx K.SR.inc).1 z3) z2 e3)
                eLp))) ;
      result : Origin P x = (K.pg,(zs,(es,(Ts,eTs)))) ;
    } ;
    result : Ex (Origin P x) =
      TC.map ((g2 : P3.Gens Pb.ptyx) * P3.Supp3 X Pb.ptyx z2 (P3.FG[Pb.ptyx,g2].sub)) (Origin P x)
        (\ w -> Fin[w].result) (X.support Pb.ptyx z2) ;
  } ;
  bw : P3S.Bwd3 X S = \ P Q M x -> TC.bind (Origin Q ((X.arr P Q M).1 x)) (Origin P x) (\ o -> BwO[P,Q,M,x,o].result) ;

  module SP = P3S.SubPtyx3[X,S,sp,fw,bw] ;
  gen : P3.Ptyx3 = SP.ptyx3 ;
  -- y is in its generated subobject (through a finite support of y)
  self : S A y =
    TC.map ((g : P3.Gens A) * P3.Supp3 X A y (P3.FG[A,g].sub)) (Origin A y)
      (\ w -> (w.1,(w.2.1,(w.2.2,(P3.SubOf[A,P3.FG[A,w.1].sub].inc,w.2.2))))) (X.support A y) ;
  -- and it is the least subobject containing y
  least (S' : P3S.Pred3 X) (sp' : P3S.SProp3 X S') (fw' : P3S.Fwd3 X S') (bw' : P3S.Bwd3 X S') (h : S' A y)
    (D : DP.Ptyx) (x : (X.G D).car) (gx : S D x) : S' D x =
    TC.rec (Origin D x) @l (S' D x) (sp' D x)
      (\ o -> PL.subst (X.G D).car (S' D) ((X.arr (P3.SubOf[A,P3.FG[A,o.1].sub].ptyx) D o.2.2.2.1).1 o.2.1) x o.2.2.2.2
        (fw' (P3.SubOf[A,P3.FG[A,o.1].sub].ptyx) D o.2.2.2.1 o.2.1
          (bw' (P3.SubOf[A,P3.FG[A,o.1].sub].ptyx) A (P3.SubOf[A,P3.FG[A,o.1].sub].inc) o.2.1
            (PL.subst (X.G A).car (S' A) y ((X.arr (P3.SubOf[A,P3.FG[A,o.1].sub].ptyx) A (P3.SubOf[A,P3.FG[A,o.1].sub].inc)).1 o.2.1)
              (PL.sym (X.G A).car ((X.arr (P3.SubOf[A,P3.FG[A,o.1].sub].ptyx) A (P3.SubOf[A,P3.FG[A,o.1].sub].inc)).1 o.2.1) y o.2.2.1)
              h))))
      gx ;
} ;

-- every point lies in the subobject generated by a point over a finitely
-- generated subptyx
cover3 (X : P3.Ptyx3) (D : DP.Ptyx) (x : (X.G D).car) :
    Ex ((g : P3.Gens D) * ((z : (X.G (P3.SubOf[D,P3.FG[D,g].sub].ptyx)).car) *
      Gen3[X,P3.SubOf[D,P3.FG[D,g].sub].ptyx,z].S D x)) =
  TC.map ((g : P3.Gens D) * P3.Supp3 X D x (P3.FG[D,g].sub))
    ((g : P3.Gens D) * ((z : (X.G (P3.SubOf[D,P3.FG[D,g].sub].ptyx)).car) *
      Gen3[X,P3.SubOf[D,P3.FG[D,g].sub].ptyx,z].S D x))
    (\ w -> (w.1,(w.2.1,
      PL.subst (X.G D).car (Gen3[X,P3.SubOf[D,P3.FG[D,w.1].sub].ptyx,w.2.1].S D)
        ((X.arr (P3.SubOf[D,P3.FG[D,w.1].sub].ptyx) D (P3.SubOf[D,P3.FG[D,w.1].sub].inc)).1 w.2.1) x w.2.2
        (Gen3[X,P3.SubOf[D,P3.FG[D,w.1].sub].ptyx,w.2.1].fw (P3.SubOf[D,P3.FG[D,w.1].sub].ptyx) D
          (P3.SubOf[D,P3.FG[D,w.1].sub].inc) w.2.1 Gen3[X,P3.SubOf[D,P3.FG[D,w.1].sub].ptyx,w.2.1].self))))
    (X.support D x) ;

-- Morphisms of type-3 ptykes are pull-backs along ALL morphisms of
-- ptykes (catemb.pdf one level up; the type-3 analogue of PtyxPull).
--
-- Mor3 only asks for pull-backs along inclusions of subptykes.  A ptyx
-- morphism a : A -> B is iso to the inclusion of its image subptyx
-- (PtyxSub.Image); Inv packages the inverse as a ptyx morphism, with the
-- two triangles as equalities of morphisms (Ptyx3.mor-eq).  Then, as in
-- PtyxPull: if Y(a) q = S_B y, the point S_B y is supported by Im a, so
-- y is (S cartesian), so y comes from A through the inverse.
level l ;
open Base ; open Prelude[l+] ; open ScottOrder[l] ;
module W = Dilator[l] ;
module CD = CatDil[l] ;
module DP = DilPtyx[l] ;
module PM = PtyxMor[l] ;
module PS = PtyxSub[l] ;
module P3 = Ptyx3[l] ;
module PL = Prelude[l] ;

-- the image of a ptyx morphism, with its inverse as a morphism
module Inv (A B : DP.Ptyx) (a : PM.Mor A B) {
  module Im = PS.Image[A,B,a] ;
  im : DP.Ptyx = Im.im ;
  s : P3.Sub B = (Im.S,(\ D y -> prop (Im.Fib D y),(Im.fw,Im.bw))) ;
  g (D : CD.Dil) (p : Im.SP.Car D) : (A.F D).car = Im.minv D p ;
  ge (D : CD.Dil) (p : Im.SP.Car D) : Id (B.F D).car ((a.1 D).1 (g D p)) p.1 = (Im.get D p).2 ;
  mono (D : CD.Dil) (p q : Im.SP.Car D) : Id W.O3 ((A.F D).cmp (g D p) (g D q)) ((B.F D).cmp p.1 q.1) =
    PL.trans W.O3 ((A.F D).cmp (g D p) (g D q)) ((B.F D).cmp ((a.1 D).1 (g D p)) ((a.1 D).1 (g D q))) ((B.F D).cmp p.1 q.1)
      (PL.sym W.O3 ((B.F D).cmp ((a.1 D).1 (g D p)) ((a.1 D).1 (g D q))) ((A.F D).cmp (g D p) (g D q)) ((a.1 D).2 (g D p) (g D q)))
      (PL.trans W.O3 ((B.F D).cmp ((a.1 D).1 (g D p)) ((a.1 D).1 (g D q))) ((B.F D).cmp p.1 ((a.1 D).1 (g D q))) ((B.F D).cmp p.1 q.1)
        (PL.ap (B.F D).car W.O3 (\ z -> (B.F D).cmp z ((a.1 D).1 (g D q))) ((a.1 D).1 (g D p)) p.1 (ge D p))
        (PL.ap (B.F D).car W.O3 (\ z -> (B.F D).cmp p.1 z) ((a.1 D).1 (g D q)) q.1 (ge D q))) ;
  f : PM.Fam im A = \ D -> (g D,mono D) ;
  nat : PM.Natural im A f = \ D E T p ->
    DP.map-inj (A.F E) (B.F E) (a.1 E) ((A.arr D E T).1 (g D p)) (g E ((Im.SP.arr D E T).1 p))
      (PL.trans (B.F E).car ((a.1 E).1 ((A.arr D E T).1 (g D p))) ((B.arr D E T).1 p.1) ((a.1 E).1 (g E ((Im.SP.arr D E T).1 p)))
        (PL.trans (B.F E).car ((a.1 E).1 ((A.arr D E T).1 (g D p))) ((B.arr D E T).1 ((a.1 D).1 (g D p))) ((B.arr D E T).1 p.1)
          (PL.sym (B.F E).car ((B.arr D E T).1 ((a.1 D).1 (g D p))) ((a.1 E).1 ((A.arr D E T).1 (g D p))) (a.2.1 D E T (g D p)))
          (PL.ap (B.F D).car (B.F E).car (B.arr D E T).1 ((a.1 D).1 (g D p)) p.1 (ge D p)))
        (PL.sym (B.F E).car ((a.1 E).1 (g E ((Im.SP.arr D E T).1 p))) ((B.arr D E T).1 p.1) (ge E ((Im.SP.arr D E T).1 p)))) ;
  cart : PM.Cartesian im A f = \ D p c sA ->
    PL.subst (Im.SP.Car D) (\ z -> PM.Supp im D z c) (Im.mf D (g D p)) p (Im.m-minv D p)
      (PM.preserve A im Im.m D (g D p) c sA) ;
  mor : PM.Mor im A = (f,(nat,cart)) ;
  inv-tri : Id (PM.Mor im B) (PM.compP im A B mor a) Im.SP.inc =
    P3.mor-eq im B (PM.compP im A B mor a) Im.SP.inc (\ D p -> ge D p) ;
  iso-tri : Id (PM.Mor A B) (PM.compP A im B Im.m Im.SP.inc) a =
    P3.mor-eq A B (PM.compP A im B Im.m Im.SP.inc) a (\ D x -> refl ((a.1 D).1 x)) ;
} ;

module Pull3 (X Y : P3.Ptyx3) (Sm : P3.Mor3 X Y) (A B : DP.Ptyx) (a : PM.Mor A B) (y : (X.G B).car) (q : (Y.G A).car)
  (e : Id (Y.G B).car ((Y.arr A B a).1 q) ((Sm.1 B).1 y)) {
  module I = Inv[A,B,a] ;
  Sd : DP.Ptyx = I.im ;
  -- S_B y is supported by the image of a ...
  q' : (Y.G Sd).car = (Y.arr A Sd I.Im.m).1 q ;
  qe : Id (Y.G B).car ((Y.arr Sd B I.Im.SP.inc).1 q') ((Sm.1 B).1 y) =
    PL.trans (Y.G B).car ((Y.arr Sd B I.Im.SP.inc).1 q') ((Y.arr A B (PM.compP A Sd B I.Im.m I.Im.SP.inc)).1 q) ((Sm.1 B).1 y)
      (Y.arr-comp A Sd B I.Im.m I.Im.SP.inc q)
      (PL.trans (Y.G B).car ((Y.arr A B (PM.compP A Sd B I.Im.m I.Im.SP.inc)).1 q) ((Y.arr A B a).1 q) ((Sm.1 B).1 y)
        (PL.ap (PM.Mor A B) (Y.G B).car (\ M -> (Y.arr A B M).1 q) (PM.compP A Sd B I.Im.m I.Im.SP.inc) a I.iso-tri)
        e) ;
  -- ... so y is (S is cartesian) ...
  sp : P3.Supp3 X B y I.s = Sm.2.2 B y I.s (q',qe) ;
  -- ... and y comes from A through the inverse
  p : (X.G A).car = (X.arr Sd A I.mor).1 sp.1 ;
  pe : Id (X.G B).car ((X.arr A B a).1 p) y =
    PL.trans (X.G B).car ((X.arr A B a).1 p) ((X.arr Sd B (PM.compP Sd A B I.mor a)).1 sp.1) y
      (X.arr-comp Sd A B I.mor a sp.1)
      (PL.trans (X.G B).car ((X.arr Sd B (PM.compP Sd A B I.mor a)).1 sp.1) ((X.arr Sd B I.Im.SP.inc).1 sp.1) y
        (PL.ap (PM.Mor Sd B) (X.G B).car (\ M -> (X.arr Sd B M).1 sp.1) (PM.compP Sd A B I.mor a) I.Im.SP.inc I.inv-tri)
        sp.2) ;
  result : (p0 : (X.G A).car) * Id (X.G B).car ((X.arr A B a).1 p0) y = (p,pe) ;
} ;
pull3 (X Y : P3.Ptyx3) (Sm : P3.Mor3 X Y) (A B : DP.Ptyx) (a : PM.Mor A B) (y : (X.G B).car) (q : (Y.G A).car)
  (e : Id (Y.G B).car ((Y.arr A B a).1 q) ((Sm.1 B).1 y)) : (p : (X.G A).car) * Id (X.G B).car ((X.arr A B a).1 p) y =
  Pull3[X,Y,Sm,A,B,a,y,q,e].result ;

-- PLAN-ID1, diagonal identity law for S4 homogeneity: the pointwise
-- hypotheses, the induction hypothesis at a node, and small lemmas.
level l ;
open Base ; open Prelude[l+] ; open ScottOrder[l] ;
module P1 = Prelude[l+] ;
module W = Dilator[l] ;
module DP = DilPtyx[l] ;
module CF = CatEmbFin[l] ;
module PL = Prelude[l] ;
module LT = LabTree[l] ;
module LC = LOCat[l] ;
module LW = LOWF[l] ;
module DS = DSumLO[l] ;
module BI = BetaID[l] ;
module BO = BetaIDCfOps[l] ;
module S4 = BetaIDS4[l] ;
module SH = BetaIDS4Hom[l] ;
module HT = BetaIDS4HomThm[l] ;

-- UIP for the carrier of an order
uipLO (A : DP.LO) (x y : A.car) (p q : Id A.car x y) : Id (Id A.car x y) p q = DS.DSum[A,\ a -> LT.one].uipI x y p q ;
-- a pointwise identity is the identity map
mapId (X : DP.LO) (f : DP.Map X X) (hf : (x : X.car) -> Id X.car (f.1 x) x) : Id (DP.Map X X) f (LC.idMap X) =
  LC.map-eq X X f (LC.idMap X) hf ;

module DB (ev : (A : DP.LO) -> W.N -> LT.LL A -> W.Bool) (phi : BI.Form) (evN : S4.EvN ev)
  (hPos : Id W.Bool (BO.posX phi zero) true) {
  module I = BI.ID[ev,phi] ;
  module O = S4.Obj[ev,phi,evN] ;
  module ST = HT.Stmt[ev,phi,evN,hPos] ;
  module SS = ST.SS ;
  module R = SH.Rel[ev,phi,evN] ;
  -- the pointwise hypotheses
  KmId (x : O.IObj) : U l+ = (Z : DP.LO) (p : (x.k Z).car) -> Id (x.k Z).car ((x.km Z Z (LC.idMap Z)).1 p) p ;
  CId (x : O.IObj) (c : DP.Map x.Cst x.Cst) : U l = (w : x.Cst.car) -> Id x.Cst.car (c.1 w) w ;
  TId (x : O.IObj) (tau : (Z : DP.LO) -> DP.Map (x.k Z) (x.k Z)) : U l+ = (Z : DP.LO) (p : (x.k Z).car) -> Id (x.k Z).car ((tau Z).1 p) p ;
  FId (Y : DP.LO) (f : DP.Map Y Y) : U l = (y : Y.car) -> Id Y.car (f.1 y) y ;
  -- km along a pointwise identity
  kmF (x : O.IObj) (hk : KmId x) (Z : DP.LO) (f : DP.Map Z Z) (hf : FId Z f) (p : (x.k Z).car) : Id (x.k Z).car ((x.km Z Z f).1 p) p =
    PL.trans (x.k Z).car ((x.km Z Z f).1 p) ((x.km Z Z (LC.idMap Z)).1 p) p
      (PL.ap (DP.Map Z Z) (x.k Z).car (\ g -> (x.km Z Z g).1 p) f (LC.idMap Z) (mapId Z f hf)) (hk Z p) ;
  -- the base map is a pointwise identity
  betaId (x : O.IObj) (tau : (Z : DP.LO) -> DP.Map (x.k Z) (x.k Z)) (Y : DP.LO) (f : DP.Map Y Y)
      (hk : KmId x) (ht : TId x tau) (hf : FId Y f) (p : (x.k Y).car) : Id (x.k Y).car ((ST.baseF x x tau Y Y f).1 p) p =
    PL.trans (x.k Y).car ((tau Y).1 ((x.km Y Y f).1 p)) ((x.km Y Y f).1 p) p (ht Y ((x.km Y Y f).1 p)) (kmF x hk Y f hf p) ;
  -- the induction hypothesis at a node, in the diagonal
  IHD (o : O.IObj) (ih : (s : SS.Step o) -> ST.Q (SS.shiftO o s)) (ihr : ST.IHR o o ih ih) : U l+ =
    (s : SS.Step o) (cs : DP.Map (SS.shiftO o s).Cst (SS.shiftO o s).Cst)
    (taus : (Z : DP.LO) -> DP.Map ((SS.shiftO o s).k Z) ((SS.shiftO o s).k Z))
    (rs : R.RelIn (SS.shiftO o s) (SS.shiftO o s) cs taus) (Y : DP.LO) (wY : LW.WF Y) (f : DP.Map Y Y) ->
    KmId (SS.shiftO o s) -> CId (SS.shiftO o s) cs -> TId (SS.shiftO o s) taus -> FId Y f ->
    (z : (ih s Y wY).1.car) -> Id (ih s Y wY).1.car ((ihr s s cs taus rs Y Y wY wY f).1.1 z) z ;
} ;

------------------------------------------------------------------------
-- rules over an order form a set (decidable equality, Hedberg)
Dec (X : U l) : U l = (x y : X) -> W.Or (Id X x y) (Id X x y -> W.Empty) ;
decBool (X : U l) (eq : X -> X -> W.Bool) (eS : (x y : X) -> Id W.Bool (eq x y) true -> Id X x y)
    (eR : (x : X) -> Id W.Bool (eq x x) true) (x y : X) : (b : W.Bool) -> Id W.Bool (eq x y) b -> W.Or (Id X x y) (Id X x y -> W.Empty) = split {
  true -> \ h -> inl (eS x y h) ;
  false -> \ h -> inr (\ p -> W.absurdB W.Empty
    (PL.trans W.Bool false (eq x y) true (PL.sym W.Bool (eq x y) false h)
      (PL.subst X (\ z -> Id W.Bool (eq x z) true) x y p (eR x)))) } ;
decOf (X : U l) (eq : X -> X -> W.Bool) (eS : (x y : X) -> Id W.Bool (eq x y) true -> Id X x y)
    (eR : (x : X) -> Id W.Bool (eq x x) true) : Dec X = \ x y -> decBool X eq eS eR x y (eq x y) (refl (eq x y)) ;
decLO (A : DP.LO) : Dec A.car = \ x y -> DS.DSum[A,\ a -> LT.one].decI x y (A.cmp x y) (refl (A.cmp x y)) ;
decPr2 (X Z : U l) (s t : X * Z) (p : Id X s.1 t.1) : W.Or (Id Z s.2 t.2) (Id Z s.2 t.2 -> W.Empty) -> W.Or (Id (X * Z) s t) (Id (X * Z) s t -> W.Empty) = split {
  inl q -> inl (W.prodEq X Z s t p q) ;
  inr n -> inr (\ h -> n (PL.ap (X * Z) Z (\ u -> u.2) s t h)) } ;
decPr1 (X Z : U l) (dz : Dec Z) (s t : X * Z) : W.Or (Id X s.1 t.1) (Id X s.1 t.1 -> W.Empty) -> W.Or (Id (X * Z) s t) (Id (X * Z) s t -> W.Empty) = split {
  inl p -> decPr2 X Z s t p (dz s.2 t.2) ;
  inr n -> inr (\ h -> n (PL.ap (X * Z) X (\ u -> u.1) s t h)) } ;
decPr (X Z : U l) (dx : Dec X) (dz : Dec Z) : Dec (X * Z) = \ s t -> decPr1 X Z dz s t (dx s.1 t.1) ;
module RuleSet (ev : (A : DP.LO) -> W.N -> LT.LL A -> W.Bool) (phi : BI.Form) (A : DP.LO) {
  module I = BI.ID[ev,phi] ;
  module BX = BetaCut[l].BCut[ev] ;
  Op : U l = W.Or W.Unit A.car ;
  T : U l = W.N * (W.N * (BI.Form * (LT.LL A * (I.Lb A * Op)))) ;
  f0 : BI.Form = atF true zero ;
  code : I.Rule A -> T = split {
    axR i -> (zero,(i,(f0,(nilL,(I.lab0 A,inl tt))))) ;
    andR i -> (suc zero,(i,(f0,(nilL,(I.lab0 A,inl tt))))) ;
    orR i -> (suc (suc zero),(i,(f0,(nilL,(I.lab0 A,inl tt))))) ;
    allR i -> (suc (suc (suc zero)),(i,(f0,(nilL,(I.lab0 A,inl tt))))) ;
    exR i w -> (suc (suc (suc (suc zero))),(i,(f0,(nilL,(w,inl tt))))) ;
    cutR f e -> (suc (suc (suc (suc (suc zero)))),(zero,(f,(e,(I.lab0 A,inl tt))))) ;
    xrR i mu -> (suc (suc (suc (suc (suc (suc zero))))),(i,(f0,(nilL,(I.lab0 A,inr mu))))) ;
    xlR i oo -> (suc (suc (suc (suc (suc (suc (suc zero)))))),(i,(f0,(nilL,(I.lab0 A,oo))))) } ;
  dXr (i : W.N) : Op -> I.Rule A = split { inl u -> axR i ; inr mu -> xrR i mu } ;
  d7 (t : T) : W.N -> I.Rule A = split { zero -> xlR t.2.1 t.2.2.2.2.2 ; suc m -> axR t.2.1 } ;
  d6 (t : T) : W.N -> I.Rule A = split { zero -> dXr t.2.1 t.2.2.2.2.2 ; suc m -> d7 t m } ;
  d5 (t : T) : W.N -> I.Rule A = split { zero -> cutR t.2.2.1 t.2.2.2.1 ; suc m -> d6 t m } ;
  d4 (t : T) : W.N -> I.Rule A = split { zero -> exR t.2.1 t.2.2.2.2.1 ; suc m -> d5 t m } ;
  d3 (t : T) : W.N -> I.Rule A = split { zero -> allR t.2.1 ; suc m -> d4 t m } ;
  d2 (t : T) : W.N -> I.Rule A = split { zero -> orR t.2.1 ; suc m -> d3 t m } ;
  d1 (t : T) : W.N -> I.Rule A = split { zero -> andR t.2.1 ; suc m -> d2 t m } ;
  d0 (t : T) : W.N -> I.Rule A = split { zero -> axR t.2.1 ; suc m -> d1 t m } ;
  decode (t : T) : I.Rule A = d0 t t.1 ;
  ret : (r : I.Rule A) -> Id (I.Rule A) (decode (code r)) r = split {
    axR i -> refl (axR i) ; andR i -> refl (andR i) ; orR i -> refl (orR i) ; allR i -> refl (allR i) ;
    exR i w -> refl (exR i w) ; cutR f e -> refl (cutR f e) ; xrR i mu -> refl (xrR i mu) ; xlR i oo -> refl (xlR i oo) } ;
  decT : Dec T = decPr W.N (W.N * (BI.Form * (LT.LL A * (I.Lb A * Op)))) W.decN
    (decPr W.N (BI.Form * (LT.LL A * (I.Lb A * Op))) W.decN
      (decPr BI.Form (LT.LL A * (I.Lb A * Op)) (decOf BI.Form BetaIDCf[l].eqF BetaIDCf[l].eqFS BetaIDCf[l].eqFR)
        (decPr (LT.LL A) (I.Lb A * Op) (decOf (LT.LL A) (BX.eqL A) (BX.eqLS A) (BX.eqLR A))
          (decPr (I.Lb A) Op (decLO (LT.Lab A)) (decLO (LT.Opt A)))))) ;
  decR2 (r r' : I.Rule A) : W.Or (Id T (code r) (code r')) (Id T (code r) (code r') -> W.Empty) -> W.Or (Id (I.Rule A) r r') (Id (I.Rule A) r r' -> W.Empty) = split {
    inl p -> inl (PL.trans (I.Rule A) r (decode (code r)) r' (PL.sym (I.Rule A) (decode (code r)) r (ret r))
      (PL.trans (I.Rule A) (decode (code r)) (decode (code r')) r' (PL.ap T (I.Rule A) decode (code r) (code r') p) (ret r'))) ;
    inr n -> inr (\ p -> n (PL.ap (I.Rule A) T code r r' p)) } ;
  decR : Dec (I.Rule A) = \ r r' -> decR2 r r' (decT (code r) (code r')) ;
  uipR (r r' : I.Rule A) (p q : Id (I.Rule A) r r') : Id (Id (I.Rule A) r r') p q = W.Hedberg[I.Rule A,decR].uip r r' p q ;
} ;

------------------------------------------------------------------------
-- maps of labels and environments along a pointwise identity
omId (A : DP.LO) (h : DP.Map A A) (hh : (x : A.car) -> Id A.car (h.1 x) x) : (oo : W.Or W.Unit A.car) ->
    Id (W.Or W.Unit A.car) (LT.omap A A h oo) oo = split {
  inl u -> refl (inl u) ;
  inr x -> PL.ap A.car (W.Or W.Unit A.car) (\ q -> inr q) (h.1 x) x (hh x) } ;
lmId (A : DP.LO) (h : DP.Map A A) (hh : (x : A.car) -> Id A.car (h.1 x) x) (a : (LT.Lab A).car) : Id (LT.Lab A).car (LT.lm A A h a) a =
  PL.ap (W.Or W.Unit A.car) (LT.Lab A).car (\ q -> (a.1,q)) (LT.omap A A h a.2) a.2 (omId A h hh a.2) ;
mEId (A : DP.LO) (h : DP.Map A A) (hh : (x : A.car) -> Id A.car (h.1 x) x) (e : LT.LL A) : Id (LT.LL A) (LT.mapL A A h e) e =
  PL.trans (LT.LL A) (LT.mapL A A h e) (LT.mapL A A (LC.idMap A) e) e
    (PL.ap (DP.Map A A) (LT.LL A) (\ g -> LT.mapL A A g e) h (LC.idMap A) (mapId A h hh)) (LT.mapL-id A e) ;

------------------------------------------------------------------------
-- based path induction at the endpoint
contrE (A : U l) (s v : A) (ew : Id A v s) : Id ((v0 : A) * Id A v0 s) (s,refl s) (v,ew) =
  idJ A v (\ s0 q0 -> Id ((v0 : A) * Id A v0 s0) (s0,refl s0) (v,q0)) (refl (v,refl v)) s ew ;
JE (A : U l) (s : A) (P : (v : A) -> Id A v s -> U l) (d : P s (refl s)) (v : A) (ew : Id A v s) : P v ew =
  PL.subst ((v0 : A) * Id A v0 s) (\ p -> P p.1 p.2) (s,refl s) (v,ew) (contrE A s v ew) d ;
-- transport in a family over a proposition, normalised to fix every point
module PropFam (J : U l) (F : J -> U l) (pr : (a b : J) -> Id J a b) {
  pn (a b : J) : Id J a b = PL.trans J a a b (PL.sym J a a (pr a a)) (pr a b) ;
  tr (a b : J) (y : F a) : F b = PL.subst J F a b (pn a b) y ;
  trRefl (a : J) (y : F a) : Id (F a) (tr a a y) y =
    PL.ap (Id J a a) (F a) (\ p -> PL.subst J F a a p y) (pn a a) (refl a) (PL.trans-sym-l J a a (pr a a)) ;
} ;
uipB (b c : W.Bool) (p q : Id W.Bool b c) : Id (Id W.Bool b c) p q = W.HB.uip b c p q ;

-- Characterisation by compact fixed points (paper 2.21--2.24).
-- Family is our presentation of Fp D. Its map into continuous maps is
-- injective; every finitary deflation is represented by its fixed compacts.
level l ;
open Base ; open Prelude[l] ; open Types[l] ; open Consistency[l] ;
open ExtFilter[l] ; open Domain[l] ; open Continuous[l] ; open CompactFamilies[l] ;
module TC = TruncationCombinators[l] ;

Fixed (p : Map) (x : D) : U l = Equal (run p x) x ;
FixedBasis (p : Map) (x : D) (t : Ty) : U l =
  (k : K) * (Fixed p (principal k) * (In x k.1 * Le k.1 t)) ;

record Finitary {
  operation : Map ;
  deflation (x : D) : Domain[l].Below (run operation x) x ;
  idempotence (x : D) : Fixed operation (run operation x) ;
  density (x : D) (fixed : Fixed operation x) (t : Ty) (h : In x t) : Ex (FixedBasis operation x t) ;
} ;

of-family (E : Family) : Finitary =
  new Finitary[Projector[l].map E,\ x -> Projector[l].At[E,x].below,Projector[l].idempotent E,
    \ x fixed t h -> TC.map (Projector[l].At[E,x].W t) (FixedBasis (Projector[l].map E) x t)
      (\ w -> (w.1,(Projector[l].compact-fixed E w.1 w.2.1,(w.2.2.1,w.2.2.2)))) (fixed.2 t h)] ;

module Compacts (p : Finitary) {
  f : Map = p.operation ;
  m (k : K) : U l = Fixed f (principal k) ;
  at-bottom : m bottomK = (p.deflation bottom,bottom-least (run f bottom)) ;
  at-join (a b : K) (c : Cons (meet a.1 b.1)) (ha : m a) (hb : m b) : m (joinK a b c) =
    (p.deflation (principal (joinK a b c)),
     prin-sub (meet a.1 b.1) (run f (principal (joinK a b c))).1
       (fmeet (run f (principal (joinK a b c))).1 a.1 b.1
         (f.2.1 (principal a) (principal (joinK a b c))
           (prin-anti (meet a.1 b.1) a.1 (le-meet-l a.1 b.1)) a.1 (ha.2 a.1 (prin-in a.1)))
         (f.2.1 (principal b) (principal (joinK a b c))
           (prin-anti (meet a.1 b.1) b.1 (le-meet-r a.1 b.1)) b.1 (hb.2 b.1 (prin-in b.1))))) ;
  at-equiv (a b : K) (e : EqK a b) (h : m a) : m b =
    (p.deflation (principal b),\ t ht ->
      f.2.1 (principal a) (principal b) (prin-anti b.1 a.1 e.2) t
        (h.2 t (prin-anti a.1 b.1 e.1 t ht))) ;
  family : Family = (m,(\ k -> eqv-prop (run f (principal k)).1 (principal k).1,
    (at-bottom,(at-join,at-equiv)))) ;

  module Recover (x : D) {
    module Q = Projector[l].At[family,x] ;
    forward : Domain[l].Below Q.value (run f x) = \ t ->
      ex-elim (Q.W t) (In (run f x) t) (fprop (run f x).1 t)
        (\ w -> fup (run f x).1 w.1.1 t w.2.2.2
          (f.2.1 (principal w.1) x (prin-sub w.1.1 x.1 w.2.2.1) w.1.1
            (w.2.1.2 w.1.1 (prin-in w.1.1)))) ;
    backward : Domain[l].Below (run f x) Q.value = \ t h ->
      TC.map (FixedBasis f (run f x) t) (Q.W t)
        (\ w -> (w.1,(w.2.1,(p.deflation x w.1.1 w.2.2.1,w.2.2.2))))
        (p.density (run f x) (p.idempotence x) t h) ;
  } ;
  reconstruction : Id Map (Projector[l].map family) f =
    Continuous[l].ext (Projector[l].map family) f (\ x -> (Recover[x].forward,Recover[x].backward)) ;
} ;

family-recovered (E : Family) : Id Family Compacts[of-family E].family E =
  CompactFamilies[l].ext Compacts[of-family E].family E
    (Projector[l].fixed-compact E,Projector[l].compact-fixed E) ;

family-injective (E H : Family) (h : (x : D) -> Equal (Projector[l].project E x) (Projector[l].project H x)) :
  Id Family E H = CompactFamilies[l].ext E H
  (\ k e -> Projector[l].fixed-compact H k
    (Projector[l].At[H,principal k].below,\ t ht -> (h (principal k)).1 t ((Projector[l].compact-fixed E k e).2 t ht)),
   \ k e -> Projector[l].fixed-compact E k
    (Projector[l].At[E,principal k].below,\ t ht -> (h (principal k)).2 t ((Projector[l].compact-fixed H k e).2 t ht))) ;

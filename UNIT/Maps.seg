-- Identity, composition, and strictness for continuous maps.
level l ;
open Base ; open Prelude[l] ; open Types[l] ; open ExtFilter[l] ; open Domain[l] ; open Continuous[l] ;
module TC = TruncationCombinators[l] ;

identity : Map = (\ x -> x,(\ x y h -> h,\ x t h ->
  TC.map (Domain[l].PW x.1 t) (Trace (\ y -> y) x t)
    (\ w -> ((w.1,(w.2.1,consistent x w.1 w.2.2.1)),(w.2.2.1,ex (Le w.1 t) w.2.2.2))) (x.2.2 t h))) ;

module Compose (f g : Map) {
  operation (x : D) : D = run f (run g x) ;
  monotone (x y : D) (h : Domain[l].Below x y) : Domain[l].Below (operation x) (operation y) =
    f.2.1 (run g x) (run g y) (g.2.1 x y h) ;
  finite (x : D) (t : Ty) (h : In (operation x) t) : Ex (Trace operation x t) =
    TC.bind (Trace f.1 (run g x) t) (Trace operation x t)
      (\ u -> TC.map (Trace g.1 x u.1.1) (Trace operation x t)
        (\ v -> (v.1,(v.2.1,f.2.1 (principal u.1) (run g (principal v.1))
          (prin-sub u.1.1 (run g (principal v.1)).1 v.2.2) t u.2.2)))
        (g.2.2 x u.1.1 u.2.1)) (f.2.2 (run g x) t h) ;
  map : Map = (operation,(monotone,finite)) ;
} ;
compose (f g : Map) : Map = Compose[f,g].map ;
respects (f : Map) (x y : D) (e : Equal x y) : Equal (run f x) (run f y) =
  (f.2.1 x y e.1,f.2.1 y x e.2) ;
Strict (f : Map) : U l = Equal (run f bottom) bottom ;

bottom-cod (a t : Ty) (h : Le om (arr a t)) : Le om t =
  les-le om t (ConsStable[l].bottom-to t
    (ConsStable[l].bottom-from om (arr a t) (le-les om (arr a t) h) tt)) ;
app-bottom (x : D) : Equal (Application[l].eval bottom x) bottom =
  (\ t -> TC.bind (Filter[l].AppW (raw bottom.1) (raw x.1) t) (Le om t)
    (\ w -> TC.map (Le om w.g) (Le om t)
      (\ h -> bottom-cod w.x t (le-trans om w.g (arr w.x t) h w.le)) w.ing),
   bottom-least (Application[l].eval bottom x)) ;

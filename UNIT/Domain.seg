-- The intended domain: consistent filters generated by proper tokens.
-- All existential assertions are truncated; no choice is assumed.
level l ;
open Base ; open Prelude[l] ; open Types[l] ; open Consistency[l] ;
open ExtFilter[l] ; open Directed[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module TC = TruncationCombinators[l] ;
Dir (I : U l) (x : I -> Filt) : U l = Directed[l].Directed I x ;

Good (s : Ty) : U l = Proper[l].Proper s ;
CW (s : Ty) : U l = Ex (Cons s) ;
PW (x : Filt) (t : Ty) : U l =
  (s : Ty) * (Good s * (mem x s * Le s t)) ;
Valid (x : Filt) : U l = (t : Ty) -> mem x t -> CW t ;
Generated (x : Filt) : U l = (t : Ty) -> mem x t -> Ex (PW x t) ;
Laws (x : Filt) : U l = Valid x * Generated x ;

valid-prop (x : Filt) : isProp (Valid x) =
  F.isProp-Pi Ty (\ t -> mem x t -> CW t)
    (\ t -> F.isProp-Pi (mem x t) (\ _ -> CW t) (\ _ -> ex-prop (Cons t))) ;
generated-prop (x : Filt) : isProp (Generated x) =
  F.isProp-Pi Ty (\ t -> mem x t -> Ex (PW x t))
    (\ t -> F.isProp-Pi (mem x t) (\ _ -> Ex (PW x t)) (\ _ -> ex-prop (PW x t))) ;
laws-prop (x : Filt) : isProp (Laws x) =
  isProp-Sigma (Valid x) (\ _ -> Generated x) (valid-prop x) (\ _ -> generated-prop x) ;

D : U l+ = (x : Filt) * Laws x ;
In (x : D) (s : Ty) : U l = mem x.1 s ;
Below (x y : D) : U l = Sub x.1 y.1 ;
Equal (x y : D) : U l = Eqv x.1 y.1 ;

ext (x y : D) (h : Equal x y) : Id D x y =
  Prelude[l+].Sigma-eq Filt (\ z -> Laws z) x.1 y.1 x.2 y.2
    (filt-ext x.1 y.1 h) (laws-prop y.1) ;
domain-set : Prelude[l+].isSet D = \ x ->
  Prelude[l+].Hedberg[D,x,\ y -> Equal x y,\ y -> eqv-prop x.1 y.1,
    eqv-refl x.1,\ y -> ext x y].hedberg ;

K : U l = (s : Ty) * (Good s * Cons s) ;
principal (k : K) : D = (prin k.1,
  (\ t -> TC.map (Le k.1 t) (Cons t) (\ h -> cons-down k.1 t h k.2.2),
   \ t -> TC.map (Le k.1 t) (PW (prin k.1) t)
     (\ h -> (k.1,(k.2.1,(prin-in k.1,h)))))) ;

bottomK : K = (om,(tt,cons-om)) ;
bottom : D = principal bottomK ;
bottom-least (x : D) : Below bottom x = bot-sub x.1 ;
universeK : K = (univ,(tt,cons-univ)) ;
universe : D = principal universeK ;

-- A canonical proof can be recovered from mere consistency.
consistent (x : D) (t : Ty) (h : In x t) : Cons t =
  ConsStable[l].cons-stable t (x.2.1 t h) ;

module Sup (I : U l) (x : I -> D) (d : Dir I (\ i -> (x i).1)) {
  module Un = Union[I,\ i -> (x i).1,d] ;
  valid : Valid Un.sup = \ t ->
    TC.bind (UW I (\ i -> (x i).1) t) (Cons t) (\ w -> (x w.1).2.1 t w.2) ;
  generated : Generated Un.sup = \ t ->
    TC.bind (UW I (\ i -> (x i).1) t) (PW Un.sup t)
      (\ w -> TC.map (PW (x w.1).1 t) (PW Un.sup t)
        (\ a -> (a.1,(a.2.1,(Un.inc w.1 a.1 a.2.2.1,a.2.2.2))))
        ((x w.1).2.2 t w.2)) ;
  value : D = (Un.sup,(valid,generated)) ;
  inc (i : I) : Below (x i) value = Un.inc i ;
  least (y : D) (h : (i : I) -> Below (x i) y) : Below value y = Un.least y.1 h ;
} ;

-- A small basis, with actual consistency witnesses in its indices.
-- Existence of an index is only asserted propositionally.
module BasisD (x : D) {
  index : U l = (k : K) * In x k.1 ;
  part (i : index) : D = principal i.1 ;
  bounded (i : index) : Below (part i) x = prin-sub i.1.1 x.1 i.2 ;
  upper (i j : index) : Ex (Upper index (\ a -> (part a).1) i j) =
    TC.map (Cons (meet i.1.1 j.1.1)) (Upper index (\ a -> (part a).1) i j)
      (\ c -> (((meet i.1.1 j.1.1,((i.1.2.1,j.1.2.1),c)),
                 fmeet x.1 i.1.1 j.1.1 i.2 j.2),
        (prin-anti (meet i.1.1 j.1.1) i.1.1 (le-meet-l i.1.1 j.1.1),
         prin-anti (meet i.1.1 j.1.1) j.1.1 (le-meet-r i.1.1 j.1.1))))
      (x.2.1 (meet i.1.1 j.1.1) (fmeet x.1 i.1.1 j.1.1 i.2 j.2)) ;
  directed : Dir index (\ i -> (part i).1) =
    (ex index (bottomK,fom x.1),upper) ;
  module S = Sup[index,part,directed] ;
  from : Below x S.value = \ t h ->
    ex-elim (PW x.1 t) (In S.value t) (fprop S.value.1 t)
      (\ w -> ex-elim (Cons w.1) (In S.value t) (fprop S.value.1 t)
        (\ c -> S.inc ((w.1,(w.2.1,c)),w.2.2.1) t
          (ex (Le w.1 t) w.2.2.2)) (x.2.1 w.1 w.2.2.1)) (x.2.2 t h) ;
  approximation : Equal S.value x = (S.least x bounded,from) ;
  equation : Id D S.value x = ext S.value x approximation ;
} ;

CompactD (x : D) : U l+ =
  (I : U l) (y : I -> D) (d : Dir I (\ i -> (y i).1)) ->
  Below x Sup[I,y,d].value -> Ex ((i : I) * Below x (y i)) ;

principal-compact (k : K) : CompactD (principal k) = \ I y d ->
  Directed[l].principal-compact k.1 I (\ i -> (y i).1) d ;

compact-principal (x : D) (c : CompactD x) :
  Ex ((k : K) * Equal x (principal k)) =
  TC.map ((i : BasisD[x].index) * Below x (BasisD[x].part i))
    ((k : K) * Equal x (principal k))
    (\ w -> (w.1.1,(w.2,BasisD[x].bounded w.1)))
    (c BasisD[x].index BasisD[x].part BasisD[x].directed BasisD[x].from) ;

-- The checked MIN bridge, reflected into actual sets of observations.
from-raw (X : Filter[l].Filt) (c : Filter[l].ConsF X)
  (g : Regular[l].Regular X) : D =
  (reflect X,
   (\ t -> TC.map (X.mem t) (Cons t) (c t),
    \ t -> TC.map (X.mem t) (PW (reflect X) t)
      (\ h -> ((g t h).value,((g t h).proper,
        (ex (X.mem (g t h).value) (g t h).inside,(g t h).below)))))) ;

from-typed (X A : Filter[l].Filt) (h : Sound[l].HasTy X A)
  (c : Filter[l].ConsF X) : D = from-raw X c (Regular[l].typed-regular X A h) ;

-- Pull-backs of stable functors (abstract catemb, stage 2).
--
-- For S : Y -> X and S' : Y' -> X (morphisms = finite parts), extend both
-- to all objects (StabFun.Ext: s, s') and put
--   Pb(A) = { (y, y') | s_A y = s'_A y' },  ordered by y.
-- It is a stable functor: continuity by directedness of the finite
-- witnesses of y and y' (injectivity of X(j) gives the equation at the
-- common finite level); stability componentwise.  Projections are
-- morphisms (cartesian: the Y' side is pulled back by Cart of S'), the
-- square commutes, and every commuting pair factors (pb-univ).
level l ;
open Base ; open Prelude[l+] ; open ScottOrder[l] ;
module W = Dilator[l] ;
module DP = DilPtyx[l] ;
module PF = PtyxFinite[l] ;
module CE = CatEmb[l] ;
module SF = StabFun[l] ;
module PL = Prelude[l] ;
module TC = TruncationCombinators[l] ;

module Pull (C : CE.CE) (X Y Y' : SF.SF[C]) (S : SF.Over[C].Mor Y X) (S' : SF.Over[C].Mor Y' X) {
  module O = SF.Over[C] ;
  module E = O.Ext[Y,X,S] ;
  module E' = O.Ext[Y',X,S'] ;
  s (A : C.Obj) (y : (Y.G A).car) : (X.G A).car = E.f A y ;
  s' (A : C.Obj) (y : (Y'.G A).car) : (X.G A).car = E'.f A y ;
  Snd (A : C.Obj) (y : (Y.G A).car) : U l = (y' : (Y'.G A).car) * Id (X.G A).car (s A y) (s' A y') ;
  snd-prop (A : C.Obj) (y : (Y.G A).car) : PL.isProp (Snd A y) = \ u v ->
    PL.Sigma-eq (Y'.G A).car (\ y' -> Id (X.G A).car (s A y) (s' A y')) u.1 v.1 u.2 v.2
      (DP.map-inj (Y'.G A) (X.G A) (E'.map A) u.1 v.1
        (PL.trans (X.G A).car (s' A u.1) (s A y) (s' A v.1) (PL.sym (X.G A).car (s A y) (s' A u.1) u.2) v.2))
      (PF.lo-set (X.G A) (s A y) (s' A v.1)) ;
  Car (A : C.Obj) : U l = (y : (Y.G A).car) * Snd A y ;
  peq (A : C.Obj) (p q : Car A) (e : Id (Y.G A).car p.1 q.1) : Id (Car A) p q =
    PL.Sigma-eq (Y.G A).car (Snd A) p.1 q.1 p.2 q.2 e (snd-prop A q.1) ;
  G (A : C.Obj) : DP.LO = new DP.LO[car := Car A, cmp := \ p q -> (Y.G A).cmp p.1 q.1,
    ceq := \ p q h -> peq A p q ((Y.G A).ceq p.1 q.1 h),
    crefl := \ p -> (Y.G A).crefl p.1, cflip := \ p q -> (Y.G A).cflip p.1 q.1,
    ctrans := \ p q r -> (Y.G A).ctrans p.1 q.1 r.1] ;
  -- the action
  ae (A B : C.Obj) (h : C.Mor A B) (p : Car A) : Id (X.G B).car (s B ((Y.arr A B h).1 p.1)) (s' B ((Y'.arr A B h).1 p.2.1)) =
    PL.trans (X.G B).car (s B ((Y.arr A B h).1 p.1)) ((X.arr A B h).1 (s A p.1)) (s' B ((Y'.arr A B h).1 p.2.1))
      (PL.sym (X.G B).car ((X.arr A B h).1 (s A p.1)) (s B ((Y.arr A B h).1 p.1)) (E.nat-all A B h p.1))
      (PL.trans (X.G B).car ((X.arr A B h).1 (s A p.1)) ((X.arr A B h).1 (s' A p.2.1)) (s' B ((Y'.arr A B h).1 p.2.1))
        (PL.ap (X.G A).car (X.G B).car (X.arr A B h).1 (s A p.1) (s' A p.2.1) p.2.2)
        (E'.nat-all A B h p.2.1)) ;
  arr (A B : C.Obj) (h : C.Mor A B) : DP.Map (G A) (G B) =
    (\ p -> ((Y.arr A B h).1 p.1,((Y'.arr A B h).1 p.2.1,ae A B h p)),\ p q -> (Y.arr A B h).2 p.1 q.1) ;
  arr-id (A : C.Obj) (p : Car A) : Id (Car A) ((arr A A (C.idm A)).1 p) p =
    peq A ((arr A A (C.idm A)).1 p) p (Y.arr-id A p.1) ;
  arr-comp (A B D : C.Obj) (f : C.Mor A B) (g : C.Mor B D) (p : Car A) :
      Id (Car D) ((arr B D g).1 ((arr A B f).1 p)) ((arr A D (C.comp A B D f g)).1 p) =
    peq D ((arr B D g).1 ((arr A B f).1 p)) ((arr A D (C.comp A B D f g)).1 p) (Y.arr-comp A B D f g p.1) ;

  -- equal images under X(j) of the two extensions force equality
  module Lev (A : C.Obj) (d : C.Fin) (j : C.Mor (C.fin d) A) (u : (Y.G (C.fin d)).car) (u' : (Y'.G (C.fin d)).car)
    (p : Car A) (eu : Id (Y.G A).car ((Y.arr (C.fin d) A j).1 u) p.1) (eu' : Id (Y'.G A).car ((Y'.arr (C.fin d) A j).1 u') p.2.1) {
    e : Id (X.G (C.fin d)).car (s (C.fin d) u) (s' (C.fin d) u') =
      DP.map-inj (X.G (C.fin d)) (X.G A) (X.arr (C.fin d) A j) (s (C.fin d) u) (s' (C.fin d) u')
        (PL.trans (X.G A).car ((X.arr (C.fin d) A j).1 (s (C.fin d) u)) (s A p.1) ((X.arr (C.fin d) A j).1 (s' (C.fin d) u'))
          (PL.trans (X.G A).car ((X.arr (C.fin d) A j).1 (s (C.fin d) u)) (s A ((Y.arr (C.fin d) A j).1 u)) (s A p.1)
            (E.nat-all (C.fin d) A j u) (PL.ap (Y.G A).car (X.G A).car (s A) ((Y.arr (C.fin d) A j).1 u) p.1 eu))
          (PL.trans (X.G A).car (s A p.1) (s' A p.2.1) ((X.arr (C.fin d) A j).1 (s' (C.fin d) u'))
            p.2.2
            (PL.sym (X.G A).car ((X.arr (C.fin d) A j).1 (s' (C.fin d) u')) (s' A p.2.1)
              (PL.trans (X.G A).car ((X.arr (C.fin d) A j).1 (s' (C.fin d) u')) (s' A ((Y'.arr (C.fin d) A j).1 u')) (s' A p.2.1)
                (E'.nat-all (C.fin d) A j u') (PL.ap (Y'.G A).car (X.G A).car (s' A) ((Y'.arr (C.fin d) A j).1 u') p.2.1 eu'))))) ;
    q : Car (C.fin d) = (u,(u',e)) ;
    eq : Id (Car A) ((arr (C.fin d) A j).1 q) p = peq A ((arr (C.fin d) A j).1 q) p eu ;
  } ;

  -- continuity
  module Cont (A : C.Obj) (p : Car A) (w : O.Wit Y A p.1) (w' : O.Wit Y' A p.2.1) (t : O.Dir A w.1 w'.1 w.2.1 w'.2.1) {
    module R = E.Ref[A,p.1,w,t.1,t.2.1,t.2.2.1,t.2.2.2.2.1] ;
    module R' = E'.Ref[A,p.2.1,w',t.1,t.2.1,t.2.2.2.1,t.2.2.2.2.2] ;
    module L = Lev[A,t.1,t.2.1,R.u,R'.u,p,R.eu,R'.eu] ;
    result : (c : C.Fin) * ((i : C.Mor (C.fin c) A) * SF.Im (G (C.fin c)) (G A) (arr (C.fin c) A i) p) =
      (t.1,(t.2.1,(L.q,L.eq))) ;
  } ;
  cont (A : C.Obj) (p : Car A) : Ex ((c : C.Fin) * ((i : C.Mor (C.fin c) A) * SF.Im (G (C.fin c)) (G A) (arr (C.fin c) A i) p)) =
    TC.bind (O.Wit Y A p.1) ((c : C.Fin) * ((i : C.Mor (C.fin c) A) * SF.Im (G (C.fin c)) (G A) (arr (C.fin c) A i) p))
      (\ w -> TC.bind (O.Wit Y' A p.2.1) ((c : C.Fin) * ((i : C.Mor (C.fin c) A) * SF.Im (G (C.fin c)) (G A) (arr (C.fin c) A i) p))
        (\ w' -> TC.map (O.Dir A w.1 w'.1 w.2.1 w'.2.1) ((c : C.Fin) * ((i : C.Mor (C.fin c) A) * SF.Im (G (C.fin c)) (G A) (arr (C.fin c) A i) p))
          (\ t -> Cont[A,p,w,w',t].result) (C.dir A w.1 w'.1 w.2.1 w'.2.1))
        (Y'.cont A p.2.1))
      (Y.cont A p.1) ;

  -- stability
  module Stab (A B B' : C.Obj) (f : C.Mor B A) (f' : C.Mor B' A) (p : Car A)
    (r : SF.Im (G B) (G A) (arr B A f) p) (r' : SF.Im (G B') (G A) (arr B' A f') p) {
    P : C.Obj = C.pb A B B' f f' ;
    g : C.Mor P A = C.comp P B A (C.p1 A B B' f f') f ;
    v : SF.Im (Y.G P) (Y.G A) (Y.arr P A g) p.1 =
      Y.stab A B B' f f' p.1 (r.1.1,PL.ap (Car A) (Y.G A).car (\ q -> q.1) ((arr B A f).1 r.1) p r.2)
        (r'.1.1,PL.ap (Car A) (Y.G A).car (\ q -> q.1) ((arr B' A f').1 r'.1) p r'.2) ;
    v' : SF.Im (Y'.G P) (Y'.G A) (Y'.arr P A g) p.2.1 =
      Y'.stab A B B' f f' p.2.1 (r.1.2.1,PL.ap (Car A) (Y'.G A).car (\ q -> q.2.1) ((arr B A f).1 r.1) p r.2)
        (r'.1.2.1,PL.ap (Car A) (Y'.G A).car (\ q -> q.2.1) ((arr B' A f').1 r'.1) p r'.2) ;
    e : Id (X.G P).car (s P v.1) (s' P v'.1) =
      DP.map-inj (X.G P) (X.G A) (X.arr P A g) (s P v.1) (s' P v'.1)
        (PL.trans (X.G A).car ((X.arr P A g).1 (s P v.1)) (s A p.1) ((X.arr P A g).1 (s' P v'.1))
          (PL.trans (X.G A).car ((X.arr P A g).1 (s P v.1)) (s A ((Y.arr P A g).1 v.1)) (s A p.1)
            (E.nat-all P A g v.1) (PL.ap (Y.G A).car (X.G A).car (s A) ((Y.arr P A g).1 v.1) p.1 v.2))
          (PL.trans (X.G A).car (s A p.1) (s' A p.2.1) ((X.arr P A g).1 (s' P v'.1))
            p.2.2
            (PL.sym (X.G A).car ((X.arr P A g).1 (s' P v'.1)) (s' A p.2.1)
              (PL.trans (X.G A).car ((X.arr P A g).1 (s' P v'.1)) (s' A ((Y'.arr P A g).1 v'.1)) (s' A p.2.1)
                (E'.nat-all P A g v'.1) (PL.ap (Y'.G A).car (X.G A).car (s' A) ((Y'.arr P A g).1 v'.1) p.2.1 v'.2))))) ;
    result : SF.Im (G P) (G A) (arr P A g) p = ((v.1,(v'.1,e)),peq A ((arr P A g).1 (v.1,(v'.1,e))) p v.2) ;
  } ;
  stab (A B B' : C.Obj) (f : C.Mor B A) (f' : C.Mor B' A) (p : Car A)
    (r : SF.Im (G B) (G A) (arr B A f) p) (r' : SF.Im (G B') (G A) (arr B' A f') p) :
      SF.Im (G (C.pb A B B' f f')) (G A) (arr (C.pb A B B' f f') A (C.comp (C.pb A B B' f f') B A (C.p1 A B B' f f') f)) p =
    Stab[A,B,B',f,f',p,r,r'].result ;

  obj : SF.SF[C] = new SF.SF[C,G := G, arr := arr, arr-id := arr-id, arr-comp := arr-comp, cont := cont, stab := stab] ;

  --------------------------------------------------------------------
  -- projections, square, universal property

  module CartPr1 (c d : C.Fin) (k : C.Mor (C.fin c) (C.fin d)) (p : Car (C.fin d))
    (r : SF.Im (Y.G (C.fin c)) (Y.G (C.fin d)) (Y.arr (C.fin c) (C.fin d) k) p.1) {
    -- s' y' = s y = X(k) (s v), so y' is in the image of Y'(k) (Cart of S')
    hx : SF.Im (Y'.G (C.fin c)) (Y'.G (C.fin d)) (Y'.arr (C.fin c) (C.fin d) k) p.2.1 =
      S'.2.2 c d k p.2.1 (s (C.fin c) r.1,
        PL.trans (X.G (C.fin d)).car ((X.arr (C.fin c) (C.fin d) k).1 (s (C.fin c) r.1)) (s' (C.fin d) p.2.1) ((S'.1 d).1 p.2.1)
          (PL.trans (X.G (C.fin d)).car ((X.arr (C.fin c) (C.fin d) k).1 (s (C.fin c) r.1)) (s (C.fin d) p.1) (s' (C.fin d) p.2.1)
            (PL.trans (X.G (C.fin d)).car ((X.arr (C.fin c) (C.fin d) k).1 (s (C.fin c) r.1)) (s (C.fin d) ((Y.arr (C.fin c) (C.fin d) k).1 r.1))
              (s (C.fin d) p.1)
              (E.nat-all (C.fin c) (C.fin d) k r.1)
              (PL.ap (Y.G (C.fin d)).car (X.G (C.fin d)).car (s (C.fin d)) ((Y.arr (C.fin c) (C.fin d) k).1 r.1) p.1 r.2))
            p.2.2)
          (E'.fin-eq d p.2.1)) ;
    module L = Lev[C.fin d,c,k,r.1,hx.1,p,r.2,hx.2] ;
    result : SF.Im (G (C.fin c)) (G (C.fin d)) (arr (C.fin c) (C.fin d) k) p = (L.q,L.eq) ;
  } ;
  pr1 : O.Mor obj Y =
    (\ c -> (\ p -> p.1,\ p q -> refl ((Y.G (C.fin c)).cmp p.1 q.1)),
     (\ c d k p -> refl ((Y.arr (C.fin c) (C.fin d) k).1 p.1),
      \ c d k p r -> CartPr1[c,d,k,p,r].result)) ;
  module CartPr2 (c d : C.Fin) (k : C.Mor (C.fin c) (C.fin d)) (p : Car (C.fin d))
    (r : SF.Im (Y'.G (C.fin c)) (Y'.G (C.fin d)) (Y'.arr (C.fin c) (C.fin d) k) p.2.1) {
    -- s y = s' y' = X(k) (s' v'), so y is in the image of Y(k) (Cart of S)
    hy : SF.Im (Y.G (C.fin c)) (Y.G (C.fin d)) (Y.arr (C.fin c) (C.fin d) k) p.1 =
      S.2.2 c d k p.1 (s' (C.fin c) r.1,
        PL.trans (X.G (C.fin d)).car ((X.arr (C.fin c) (C.fin d) k).1 (s' (C.fin c) r.1)) (s (C.fin d) p.1) ((S.1 d).1 p.1)
          (PL.trans (X.G (C.fin d)).car ((X.arr (C.fin c) (C.fin d) k).1 (s' (C.fin c) r.1)) (s' (C.fin d) p.2.1) (s (C.fin d) p.1)
            (PL.trans (X.G (C.fin d)).car ((X.arr (C.fin c) (C.fin d) k).1 (s' (C.fin c) r.1)) (s' (C.fin d) ((Y'.arr (C.fin c) (C.fin d) k).1 r.1))
              (s' (C.fin d) p.2.1)
              (E'.nat-all (C.fin c) (C.fin d) k r.1)
              (PL.ap (Y'.G (C.fin d)).car (X.G (C.fin d)).car (s' (C.fin d)) ((Y'.arr (C.fin c) (C.fin d) k).1 r.1) p.2.1 r.2))
            (PL.sym (X.G (C.fin d)).car (s (C.fin d) p.1) (s' (C.fin d) p.2.1) p.2.2))
          (E.fin-eq d p.1)) ;
    module L = Lev[C.fin d,c,k,hy.1,r.1,p,hy.2,r.2] ;
    result : SF.Im (G (C.fin c)) (G (C.fin d)) (arr (C.fin c) (C.fin d) k) p = (L.q,L.eq) ;
  } ;
  pr2-incr (c : C.Fin) (p q : Car (C.fin c)) : Id W.O3 ((Y'.G (C.fin c)).cmp p.2.1 q.2.1) ((Y.G (C.fin c)).cmp p.1 q.1) =
    PL.trans W.O3 ((Y'.G (C.fin c)).cmp p.2.1 q.2.1) ((X.G (C.fin c)).cmp (s' (C.fin c) p.2.1) (s' (C.fin c) q.2.1))
      ((Y.G (C.fin c)).cmp p.1 q.1)
      (PL.sym W.O3 ((X.G (C.fin c)).cmp (s' (C.fin c) p.2.1) (s' (C.fin c) q.2.1)) ((Y'.G (C.fin c)).cmp p.2.1 q.2.1)
        (E'.incr (C.fin c) p.2.1 q.2.1))
      (PL.trans W.O3 ((X.G (C.fin c)).cmp (s' (C.fin c) p.2.1) (s' (C.fin c) q.2.1)) ((X.G (C.fin c)).cmp (s (C.fin c) p.1) (s (C.fin c) q.1))
        ((Y.G (C.fin c)).cmp p.1 q.1)
        (W.ap2 (X.G (C.fin c)).car (X.G (C.fin c)).car W.O3 (X.G (C.fin c)).cmp (s' (C.fin c) p.2.1) (s (C.fin c) p.1)
          (s' (C.fin c) q.2.1) (s (C.fin c) q.1)
          (PL.sym (X.G (C.fin c)).car (s (C.fin c) p.1) (s' (C.fin c) p.2.1) p.2.2)
          (PL.sym (X.G (C.fin c)).car (s (C.fin c) q.1) (s' (C.fin c) q.2.1) q.2.2))
        (E.incr (C.fin c) p.1 q.1)) ;
  pr2 : O.Mor obj Y' =
    (\ c -> (\ p -> p.2.1,pr2-incr c),
     (\ c d k p -> refl ((Y'.arr (C.fin c) (C.fin d) k).1 p.2.1),
      \ c d k p r -> CartPr2[c,d,k,p,r].result)) ;

  sq : Id (O.Mor obj X) (O.compS obj Y X pr1 S) (O.compS obj Y' X pr2 S') =
    O.mor-eq obj X (O.compS obj Y X pr1 S) (O.compS obj Y' X pr2 S') (\ c p ->
      PL.trans (X.G (C.fin c)).car ((S.1 c).1 p.1) (s (C.fin c) p.1) ((S'.1 c).1 p.2.1)
        (PL.sym (X.G (C.fin c)).car (s (C.fin c) p.1) ((S.1 c).1 p.1) (E.fin-eq c p.1))
        (PL.trans (X.G (C.fin c)).car (s (C.fin c) p.1) (s' (C.fin c) p.2.1) ((S'.1 c).1 p.2.1) p.2.2 (E'.fin-eq c p.2.1))) ;

  module Univ (Z : SF.SF[C]) (T : O.Mor Z Y) (T' : O.Mor Z Y')
    (e : Id (O.Mor Z X) (O.compS Z Y X T S) (O.compS Z Y' X T' S')) {
    ec (c : C.Fin) (z : (Z.G (C.fin c)).car) : Id (X.G (C.fin c)).car (s (C.fin c) ((T.1 c).1 z)) (s' (C.fin c) ((T'.1 c).1 z)) =
      PL.trans (X.G (C.fin c)).car (s (C.fin c) ((T.1 c).1 z)) ((S.1 c).1 ((T.1 c).1 z)) (s' (C.fin c) ((T'.1 c).1 z))
        (E.fin-eq c ((T.1 c).1 z))
        (PL.trans (X.G (C.fin c)).car ((S.1 c).1 ((T.1 c).1 z)) ((S'.1 c).1 ((T'.1 c).1 z)) (s' (C.fin c) ((T'.1 c).1 z))
          (PL.ap (O.Mor Z X) (X.G (C.fin c)).car (\ M -> (M.1 c).1 z) (O.compS Z Y X T S) (O.compS Z Y' X T' S') e)
          (PL.sym (X.G (C.fin c)).car (s' (C.fin c) ((T'.1 c).1 z)) ((S'.1 c).1 ((T'.1 c).1 z)) (E'.fin-eq c ((T'.1 c).1 z)))) ;
    hf (c : C.Fin) (z : (Z.G (C.fin c)).car) : Car (C.fin c) = ((T.1 c).1 z,((T'.1 c).1 z,ec c z)) ;
    h : O.Mor Z obj =
      (\ c -> (hf c,\ z z' -> (T.1 c).2 z z'),
       (\ c d k z -> peq (C.fin d) ((arr (C.fin c) (C.fin d) k).1 (hf c z)) (hf d ((Z.arr (C.fin c) (C.fin d) k).1 z)) (T.2.1 c d k z),
        \ c d k z r -> T.2.2 c d k z (r.1.1,PL.ap (Car (C.fin d)) (Y.G (C.fin d)).car (\ q -> q.1)
          ((arr (C.fin c) (C.fin d) k).1 r.1) (hf d z) r.2))) ;
    h1 : Id (O.Mor Z Y) (O.compS Z obj Y h pr1) T = O.mor-eq Z Y (O.compS Z obj Y h pr1) T (\ c z -> refl ((T.1 c).1 z)) ;
    h2 : Id (O.Mor Z Y') (O.compS Z obj Y' h pr2) T' = O.mor-eq Z Y' (O.compS Z obj Y' h pr2) T' (\ c z -> refl ((T'.1 c).1 z)) ;
  } ;
} ;

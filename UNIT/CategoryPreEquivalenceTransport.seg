-- The full-faithful part of a precategory equivalence.
level k l ;
open Base ;
module K = Category[k,l] ;
module CE = CategoryEquivalence[k,l] ;
module H = Paths[l] ;

module On (C D : K.Precategory) (e : CE.PreEquivalence[C,D]) {
  module AC = CategoryArrows[k,l].Arrows[C] ;
  module AD = CategoryArrows[k,l].Arrows[D] ;
  forward-faithful (x y : C.ob)
    (f g : C.hom x y)
    (p : Id (D.hom (e.forward.object x)
      (e.forward.object y))
      (e.forward.arrow x y f) (e.forward.arrow x y g)) :
    Id (C.hom x y) f g =
    AC.cancel-l (e.unit-source y)
      (H.transH
        (H.symH (e.source-natural x y f))
        (H.transH
          (AC.right
            (H.apH
              (e.backward.arrow
                (e.forward.object x) (e.forward.object y)) p)
            (e.unit-source x).1)
          (e.source-natural x y g))) ;
  backward-faithful (x y : D.ob)
    (f g : D.hom x y)
    (p : Id (C.hom (e.backward.object x)
      (e.backward.object y))
      (e.backward.arrow x y f) (e.backward.arrow x y g)) :
    Id (D.hom x y) f g =
    AD.cancel-l (e.unit-target y)
      (H.transH
        (H.symH (e.target-natural x y f))
        (H.transH
          (AD.right
            (H.apH
              (e.forward.arrow
                (e.backward.object x) (e.backward.object y)) p)
            (e.unit-target x).1)
          (e.target-natural x y g))) ;

  hom-inverse (x y : C.ob)
    (g : D.hom (e.forward.object x)
      (e.forward.object y)) : C.hom x y =
    AC.cmp (e.unit-source y).2.1
      (AC.cmp
        (e.backward.arrow (e.forward.object x)
          (e.forward.object y) g)
        (e.unit-source x).1) ;
  inverse-forward (x y : C.ob)
    (f : C.hom x y) :
    Id (C.hom x y)
      (hom-inverse x y (e.forward.arrow x y f)) f =
    H.transH
      (AC.left (e.unit-source y).2.1
        (e.source-natural x y f))
      (AC.undo-l (e.unit-source y) f) ;
  forward-inverse (x y : C.ob)
    (g : D.hom (e.forward.object x)
      (e.forward.object y)) :
    Id (D.hom (e.forward.object x)
      (e.forward.object y))
      (e.forward.arrow x y (hom-inverse x y g)) g =
    backward-faithful
      (e.forward.object x) (e.forward.object y)
      (e.forward.arrow x y (hom-inverse x y g)) g
      (AC.cancel-r (e.unit-source x)
        (H.transH
          (e.source-natural x y (hom-inverse x y g))
          (AC.undo-l
            (AC.iso-inv (e.unit-source y))
            (AC.cmp
              (e.backward.arrow (e.forward.object x)
                (e.forward.object y) g)
              (e.unit-source x).1)))) ;
  hom-equivalence (x y : C.ob) :
    Prelude[l].Equiv (C.hom x y)
      (D.hom (e.forward.object x)
        (e.forward.object y)) =
    (e.forward.arrow x y,
      Prelude[l].qinv (C.hom x y)
        (D.hom (e.forward.object x)
          (e.forward.object y))
        (e.forward.arrow x y) (hom-inverse x y)
        (forward-inverse x y) (inverse-forward x y)) ;
} ;

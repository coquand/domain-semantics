-- Ptykes preserve pull-backs, and every ptyx is the directed union of
-- its finitely generated subptykes (catemb.pdf, linear-order case;
-- PLAN-CATEMB-LO.md step 5: Ptyx as a category of embeddings, part 2).
--
--   * PB: for T : A -> D, if P(T) y is supported by D|c then y is
--     supported by A|(pre T c).  T is iso onto D|Im T (DilImage), so this
--     is the intersection axiom for Im T and c, followed by Lift.
--   * Gen: the subptyx generated by y in P(A): the points x of P(D)
--     having a common origin with y (some y' in P(B) with B -> A sending
--     y' to y and B -> D sending y' to x).  It is reflected along any T
--     by PB; it is the least subptyx containing y (least).
--   * cover: every point lies in the subptyx generated by a point over a
--     finite dilator (a truncation); with PtyxSub.Union, finitely
--     generated subptykes form a directed family covering P.
level l ;
open Base ; open Prelude[l+] ; open ScottOrder[l] ;
module W = Dilator[l] ;
module CD = CatDil[l] ;
module DF = DilFinite[l] ;
module DP = DilPtyx[l] ;
module PM = PtyxMor[l] ;
module PF = PtyxFinite[l] ;
module DI = DilImage[l] ;
module PGP = PtyxGermPtyx[l] ;
module PS = PtyxSub[l] ;
module PL = Prelude[l] ;
module TC = TruncationCombinators[l] ;

----------------------------------------------------------------------
-- pull-backs

module PB (P : DP.Ptyx) (A D : CD.Dil) (T : CD.Mor A D) (c : DP.SubSet) (y : (P.F A).car)
  (s : PM.Supp P D ((P.arr A D T).1 y) c) {
  module Im = DI.Image[A,D,T] ;
  module SA = DF.On[A].Sub[PGP.pre A D T c] ;
  module Sc = DF.On[D].Sub[c] ;
  cm : DP.SubSet = DF.On[D].meet Im.c c ;
  module Sm = DF.On[D].Sub[cm] ;
  Ty : (P.F D).car = (P.arr A D T).1 y ;
  sT : PM.Supp P D Ty Im.c =
    ((P.arr A Im.S.dil Im.iso).1 y,
     PL.trans (P.F D).car ((P.arr Im.S.dil D Im.S.inc).1 ((P.arr A Im.S.dil Im.iso).1 y))
       ((P.arr A D (CD.compM A Im.S.dil D Im.iso Im.S.inc)).1 y) Ty
       (P.arr-comp A Im.S.dil D Im.iso Im.S.inc y)
       (PL.ap (CD.Mor A D) (P.F D).car (\ M -> (P.arr A D M).1 y) (CD.compM A Im.S.dil D Im.iso Im.S.inc) T Im.iso-tri)) ;
  sm : PM.Supp P D Ty cm = P.meet D Ty Im.c c sT s ;
  module Le (n x : W.N) (h : Id W.Bool (W.at (Sm.R.chi n) x) true) {
    hx : Id W.Bool (W.ltN x (D.1 n)) true =
      W.subst W.N (\ j -> Id W.Bool (W.ltN x j) true) (W.len (Sm.R.chi n)) (D.1 n) (Sm.R.len-chi n) (W.at-lt (Sm.R.chi n) x h) ;
    trm : Id W.Bool (Sm.R.trc n x) true =
      W.trans W.Bool (Sm.R.trc n x) (W.at (Sm.R.chi n) x) true (W.sym W.Bool (W.at (Sm.R.chi n) x) (Sm.R.trc n x) (Sm.member n x hx)) h ;
    trT : Id W.Bool (Im.R.trc n x) true = W.andB-l (Im.R.trc n x) (Sc.R.trc n x) trm ;
    trc : Id W.Bool (Sc.R.trc n x) true = W.andB-r (Im.R.trc n x) (Sc.R.trc n x) trm ;
    hT : Id W.Bool (W.at (T.1 n) x) true =
      Im.le-bwd n x (W.trans W.Bool (W.at (Im.R.chi n) x) (Im.R.trc n x) true (Im.S.member n x hx) trT) ;
    b : W.N = W.rank (T.1 n) x ;
    eb : Id W.N (W.sel (T.1 n) b) x = W.sel-rank (T.1 n) x hT ;
    hb : Id W.Bool (W.ltN b (A.1 n)) true =
      W.subst W.N (\ j -> Id W.Bool (W.ltN b j) true) (W.ones (T.1 n)) (A.1 n) (T.2.2.1 n) (W.rank-lt (T.1 n) x hT) ;
    trA : Id W.Bool (SA.R.trc n b) true =
      W.trans W.Bool (SA.R.trc n b) (Sc.R.trc n (W.sel (T.1 n) b)) true
        (W.sym W.Bool (Sc.R.trc n (W.sel (T.1 n) b)) (SA.R.trc n b) PGP.TraceMap[A,D,T,c,n,b,hb].result)
        (W.subst W.N (\ j -> Id W.Bool (Sc.R.trc n j) true) x (W.sel (T.1 n) b) (W.sym W.N (W.sel (T.1 n) b) x eb) trc) ;
    hA : Id W.Bool (W.at (SA.R.chi n) b) true = W.trans W.Bool (W.at (SA.R.chi n) b) (SA.R.trc n b) true (SA.member n b hb) trA ;
    result : Id W.Bool (W.at (W.compW (T.1 n) (SA.R.chi n)) x) true =
      W.subst W.N (\ j -> Id W.Bool (W.at (W.compW (T.1 n) (SA.R.chi n)) j) true) (W.sel (T.1 n) b) x eb
        (PGP.in-comp (T.1 n) (SA.R.chi n)
          (W.trans W.N (W.ones (T.1 n)) (A.1 n) (W.len (SA.R.chi n)) (T.2.2.1 n) (W.sym W.N (W.len (SA.R.chi n)) (A.1 n) (SA.R.len-chi n)))
          b hA) ;
  } ;
  module L = DI.Lift[Sm.dil,SA.dil,D,Sm.inc,CD.compM SA.dil A D SA.inc T,\ n x h -> Le[n,x,h].result] ;
  w : (P.F SA.dil).car = (P.arr Sm.dil SA.dil L.mor).1 sm.1 ;
  ew : Id (P.F A).car ((P.arr SA.dil A SA.inc).1 w) y =
    DP.map-inj (P.F A) (P.F D) (P.arr A D T) ((P.arr SA.dil A SA.inc).1 w) y
      (PL.trans (P.F D).car ((P.arr A D T).1 ((P.arr SA.dil A SA.inc).1 w)) ((P.arr SA.dil D (CD.compM SA.dil A D SA.inc T)).1 w) Ty
        (P.arr-comp SA.dil A D SA.inc T w)
        (PL.trans (P.F D).car ((P.arr SA.dil D (CD.compM SA.dil A D SA.inc T)).1 w)
          ((P.arr Sm.dil D (CD.compM Sm.dil SA.dil D L.mor (CD.compM SA.dil A D SA.inc T))).1 sm.1) Ty
          (P.arr-comp Sm.dil SA.dil D L.mor (CD.compM SA.dil A D SA.inc T) sm.1)
          (PL.trans (P.F D).car ((P.arr Sm.dil D (CD.compM Sm.dil SA.dil D L.mor (CD.compM SA.dil A D SA.inc T))).1 sm.1)
            ((P.arr Sm.dil D Sm.inc).1 sm.1) Ty
            (PL.ap (CD.Mor Sm.dil D) (P.F D).car (\ M -> (P.arr Sm.dil D M).1 sm.1)
              (CD.compM Sm.dil SA.dil D L.mor (CD.compM SA.dil A D SA.inc T)) Sm.inc L.tri)
            sm.2))) ;
  result : PM.Supp P A y (PGP.pre A D T c) = (w,ew) ;
} ;
pb (P : DP.Ptyx) (A D : CD.Dil) (T : CD.Mor A D) (c : DP.SubSet) (y : (P.F A).car)
  (s : PM.Supp P D ((P.arr A D T).1 y) c) : PM.Supp P A y (PGP.pre A D T c) = PB[P,A,D,T,c,y,s].result ;

----------------------------------------------------------------------
-- the subptyx generated by a point

module Gen (P : DP.Ptyx) (A : CD.Dil) (y : (P.F A).car) {
  Origin (D : CD.Dil) (x : (P.F D).car) : U l =
    (B : CD.Dil) * ((y' : (P.F B).car) * ((U0 : CD.Mor B A) * (Id (P.F A).car ((P.arr B A U0).1 y') y *
      ((T : CD.Mor B D) * Id (P.F D).car ((P.arr B D T).1 y') x)))) ;
  S : PS.Pred P = \ D x -> Ex (Origin D x) ;
  sp : PS.SProp P S = \ D x -> prop (Origin D x) ;
  fw : PS.Fwd P S = \ D E T x ->
    TC.map (Origin D x) (Origin E ((P.arr D E T).1 x))
      (\ o -> (o.1,(o.2.1,(o.2.2.1,(o.2.2.2.1,(CD.compM o.1 D E o.2.2.2.2.1 T,
        PL.trans (P.F E).car ((P.arr o.1 E (CD.compM o.1 D E o.2.2.2.2.1 T)).1 o.2.1)
          ((P.arr D E T).1 ((P.arr o.1 D o.2.2.2.2.1).1 o.2.1)) ((P.arr D E T).1 x)
          (PL.sym (P.F E).car ((P.arr D E T).1 ((P.arr o.1 D o.2.2.2.2.1).1 o.2.1)) ((P.arr o.1 E (CD.compM o.1 D E o.2.2.2.2.1 T)).1 o.2.1)
            (P.arr-comp o.1 D E o.2.2.2.2.1 T o.2.1))
          (PL.ap (P.F D).car (P.F E).car (P.arr D E T).1 ((P.arr o.1 D o.2.2.2.2.1).1 o.2.1) x o.2.2.2.2.2))))))) ;

  -- reflection: pull the origin back along T by PB
  module Bw (D E : CD.Dil) (T' : CD.Mor D E) (x : (P.F D).car) (o : Origin E ((P.arr D E T').1 x)) {
    B : CD.Dil = o.1 ;
    y' : (P.F B).car = o.2.1 ;
    U0 : CD.Mor B A = o.2.2.1 ;
    T : CD.Mor B E = o.2.2.2.2.1 ;
    eT : Id (P.F E).car ((P.arr B E T).1 y') ((P.arr D E T').1 x) = o.2.2.2.2.2 ;
    module Im = DI.Image[B,E,T] ;
    sT : PM.Supp P E ((P.arr D E T').1 x) Im.c =
      ((P.arr B Im.S.dil Im.iso).1 y',
       PL.trans (P.F E).car ((P.arr Im.S.dil E Im.S.inc).1 ((P.arr B Im.S.dil Im.iso).1 y'))
         ((P.arr B E T).1 y') ((P.arr D E T').1 x)
         (PL.trans (P.F E).car ((P.arr Im.S.dil E Im.S.inc).1 ((P.arr B Im.S.dil Im.iso).1 y'))
           ((P.arr B E (CD.compM B Im.S.dil E Im.iso Im.S.inc)).1 y') ((P.arr B E T).1 y')
           (P.arr-comp B Im.S.dil E Im.iso Im.S.inc y')
           (PL.ap (CD.Mor B E) (P.F E).car (\ M -> (P.arr B E M).1 y') (CD.compM B Im.S.dil E Im.iso Im.S.inc) T Im.iso-tri))
         eT) ;
    sx : PM.Supp P D x (PGP.pre D E T' Im.c) = pb P D E T' Im.c x sT ;
    module SD = DF.On[D].Sub[PGP.pre D E T' Im.c] ;
    module Le (n x0 : W.N) (h : Id W.Bool (W.at (W.compW (T'.1 n) (SD.R.chi n)) x0) true) {
      h1 : Id W.Bool (W.at (T'.1 n) x0) true = PGP.at-comp-l (T'.1 n) x0 (SD.R.chi n) h ;
      d : W.N = W.rank (T'.1 n) x0 ;
      ed : Id W.N (W.sel (T'.1 n) d) x0 = W.sel-rank (T'.1 n) x0 h1 ;
      hd : Id W.Bool (W.at (SD.R.chi n) d) true = PGP.at-comp-r (T'.1 n) x0 (SD.R.chi n) h ;
      hI : Id W.Bool (W.at (Im.R.chi n) x0) true =
        W.subst W.N (\ j -> Id W.Bool (W.at (Im.R.chi n) j) true) (W.sel (T'.1 n) d) x0 ed PGP.SubIm[D,E,T',Im.c,n,d,hd].result ;
      result : Id W.Bool (W.at (T.1 n) x0) true = Im.le-bwd n x0 hI ;
    } ;
    module L = DI.Lift[SD.dil,B,E,CD.compM SD.dil D E SD.inc T',T,\ n x0 h -> Le[n,x0,h].result] ;
    x2 : (P.F SD.dil).car = sx.1 ;
    -- P(psi) x2 = y'
    e1 : Id (P.F B).car ((P.arr SD.dil B L.mor).1 x2) y' =
      DP.map-inj (P.F B) (P.F E) (P.arr B E T) ((P.arr SD.dil B L.mor).1 x2) y'
        (PL.trans (P.F E).car ((P.arr B E T).1 ((P.arr SD.dil B L.mor).1 x2)) ((P.arr SD.dil E (CD.compM SD.dil B E L.mor T)).1 x2)
          ((P.arr B E T).1 y')
          (P.arr-comp SD.dil B E L.mor T x2)
          (PL.trans (P.F E).car ((P.arr SD.dil E (CD.compM SD.dil B E L.mor T)).1 x2) ((P.arr SD.dil E (CD.compM SD.dil D E SD.inc T')).1 x2)
            ((P.arr B E T).1 y')
            (PL.ap (CD.Mor SD.dil E) (P.F E).car (\ M -> (P.arr SD.dil E M).1 x2) (CD.compM SD.dil B E L.mor T) (CD.compM SD.dil D E SD.inc T') L.tri)
            (PL.trans (P.F E).car ((P.arr SD.dil E (CD.compM SD.dil D E SD.inc T')).1 x2) ((P.arr D E T').1 ((P.arr SD.dil D SD.inc).1 x2))
              ((P.arr B E T).1 y')
              (PL.sym (P.F E).car ((P.arr D E T').1 ((P.arr SD.dil D SD.inc).1 x2)) ((P.arr SD.dil E (CD.compM SD.dil D E SD.inc T')).1 x2)
                (P.arr-comp SD.dil D E SD.inc T' x2))
              (PL.trans (P.F E).car ((P.arr D E T').1 ((P.arr SD.dil D SD.inc).1 x2)) ((P.arr D E T').1 x) ((P.arr B E T).1 y')
                (PL.ap (P.F D).car (P.F E).car (P.arr D E T').1 ((P.arr SD.dil D SD.inc).1 x2) x sx.2)
                (PL.sym (P.F E).car ((P.arr B E T).1 y') ((P.arr D E T').1 x) eT))))) ;
    eU : Id (P.F A).car ((P.arr SD.dil A (CD.compM SD.dil B A L.mor U0)).1 x2) y =
      PL.trans (P.F A).car ((P.arr SD.dil A (CD.compM SD.dil B A L.mor U0)).1 x2) ((P.arr B A U0).1 ((P.arr SD.dil B L.mor).1 x2)) y
        (PL.sym (P.F A).car ((P.arr B A U0).1 ((P.arr SD.dil B L.mor).1 x2)) ((P.arr SD.dil A (CD.compM SD.dil B A L.mor U0)).1 x2)
          (P.arr-comp SD.dil B A L.mor U0 x2))
        (PL.trans (P.F A).car ((P.arr B A U0).1 ((P.arr SD.dil B L.mor).1 x2)) ((P.arr B A U0).1 y') y
          (PL.ap (P.F B).car (P.F A).car (P.arr B A U0).1 ((P.arr SD.dil B L.mor).1 x2) y' e1)
          o.2.2.2.1) ;
    result : Origin D x = (SD.dil,(x2,(CD.compM SD.dil B A L.mor U0,(eU,(SD.inc,sx.2))))) ;
  } ;
  bw : PS.Bwd P S = \ D E T x -> TC.map (Origin E ((P.arr D E T).1 x)) (Origin D x) (\ o -> Bw[D,E,T,x,o].result) ;
  module SP = PS.SubPtyx[P,S,sp,fw,bw] ;
  gen : DP.Ptyx = SP.ptyx ;
  -- y is in its generated subptyx
  self : S A y = inc (Origin A y) (A,(y,(CD.idM A,(P.arr-id A y,(CD.idM A,P.arr-id A y))))) ;
  -- and it is the least subptyx containing y
  least (S' : PS.Pred P) (sp' : PS.SProp P S') (fw' : PS.Fwd P S') (bw' : PS.Bwd P S') (h : S' A y)
    (D : CD.Dil) (x : (P.F D).car) (g : S D x) : S' D x =
    TC.rec (Origin D x) @l (S' D x) (sp' D x)
      (\ o -> PL.subst (P.F D).car (S' D) ((P.arr o.1 D o.2.2.2.2.1).1 o.2.1) x o.2.2.2.2.2
        (fw' o.1 D o.2.2.2.2.1 o.2.1
          (bw' o.1 A o.2.2.1 o.2.1
            (PL.subst (P.F A).car (S' A) y ((P.arr o.1 A o.2.2.1).1 o.2.1) (PL.sym (P.F A).car ((P.arr o.1 A o.2.2.1).1 o.2.1) y o.2.2.2.1) h))))
      g ;
} ;

-- every point lies in a subptyx generated by a point over a finite dilator
cover (P : DP.Ptyx) (D : CD.Dil) (x : (P.F D).car) :
    Ex ((A : DF.FinDil) * ((y : (P.F A.1).car) * Gen[P,A.1,y].S D x)) =
  TC.map (PF.Wit P D x) ((A : DF.FinDil) * ((y : (P.F A.1).car) * Gen[P,A.1,y].S D x))
    (\ w -> (DF.finite D w.1,(w.2.1,
      inc (Gen[P,PF.Tr D w.1,w.2.1].Origin D x)
        (PF.Tr D w.1,(w.2.1,(CD.idM (PF.Tr D w.1),(P.arr-id (PF.Tr D w.1) w.2.1,(PF.TrInc D w.1,w.2.2))))))))
    (P.support D x) ;

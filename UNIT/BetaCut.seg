-- Cut elimination for the infinitary propositional calculus of
-- BetaProof.seg, at a fixed linear order A ("pointwise", Girard 10.A.12;
-- regularity in the sense of Novikoff 1943).
--
-- Derivations are INDUCTIVE (well-founded) trees; every rule names its
-- principal closure, which must be a MEMBER of the sequent (so weakening
-- keeps the derivation: wk), and the principal closure is kept in the
-- premises (built-in contraction):
--   Cf A : cut-free derivations (Novikoff's regular sequents),
--   Dv A : derivations with cut.
--
--  * cut (admissibility of cut for cut-free derivations):
--        Cf (f,e)::G  and  Cf (neg f,e)::G   =>   Cf G,
--    by induction on the formula f (a FINITE syntax tree: the infinitary
--    character is only in the quantifiers over Lab A), and for fixed f by
--    a double induction on the two derivations (Ind, used twice): a rule
--    whose principal closure is not the cut closure commutes with the cut;
--    when both are principal, the cut is replaced by cuts on immediate
--    subformulas.  No ordinals, no excluded middle.
--  * elim : Dv G  =>  Cf G;
--  * no cut-free (hence no) derivation of the empty sequent;
--  * Tr: a locally correct pre-proof (BetaProof) with a Brouwer bound is
--    translated into a derivation of its end sequent (toDv, toOk), hence
--  * POINTWISE CUT ELIMINATION: a beta-proof has, at every well-order A,
--    a cut-free derivation of its end sequent (pointwise).
-- Not yet: the cut-free derivations as a HOMOGENEOUS family (naturality
-- of elim along embeddings), which is what makes the result a beta-proof.
level l ;
open Base ; open Prelude[l+] ; open ScottOrder[l] ;
module W = Dilator[l] ;
module DP = DilPtyx[l] ;
module CF = CatEmbFin[l] ;
module PL = Prelude[l] ;
module LT = LabTree[l] ;
module BP = BetaProof[l] ;
module KT = KBTree[l] ;
module LW = LOWF[l] ;

data Cf (L : U l) : U l = cAx (b : W.Bool) (k : W.N) (e : W.List L)
  | cAnd (p q : BP.Form) (e : W.List L) (d0 d1 : Cf L)
  | cOr (p q : BP.Form) (e : W.List L) (d : Cf L)
  | cAll (p : BP.Form) (e : W.List L) (k : L -> Cf L)
  | cEx (p : BP.Form) (e : W.List L) (w : L) (d : Cf L) ;
data Dv (L : U l) : U l = dAx (b : W.Bool) (k : W.N) (e : W.List L)
  | dAnd (p q : BP.Form) (e : W.List L) (d0 d1 : Dv L)
  | dOr (p q : BP.Form) (e : W.List L) (d : Dv L)
  | dAll (p : BP.Form) (e : W.List L) (k : L -> Dv L)
  | dEx (p : BP.Form) (e : W.List L) (w : L) (d : Dv L)
  | dCut (f : BP.Form) (e : W.List L) (d0 d1 : Dv L) ;

leftF : BP.Form -> BP.Form = split { atF b k -> atF b k ; andF p q -> p ; orF p q -> p ; allF p -> p ; exF p -> p } ;
rightF : BP.Form -> BP.Form = split { atF b k -> atF b k ; andF p q -> q ; orF p q -> q ; allF p -> p ; exF p -> p } ;
atB : BP.Form -> W.Bool = split { atF b k -> b ; andF p q -> true ; orF p q -> true ; allF p -> true ; exF p -> true } ;
atK : BP.Form -> W.N = split { atF b k -> k ; andF p q -> zero ; orF p q -> zero ; allF p -> zero ; exF p -> zero } ;
isAtF : BP.Form -> W.Bool = split { atF b k -> true ; andF p q -> false ; orF p q -> false ; allF p -> false ; exF p -> false } ;
eqBoSelf : (b : W.Bool) -> Id W.Bool (BP.eqBo b b) true = split { false -> refl true ; true -> refl true } ;
notBoth : (v b : W.Bool) -> Id W.Bool (BP.eqBo v b) true -> Id W.Bool (BP.eqBo v (W.notB b)) true -> W.Empty = split {
  false -> split { false -> \ h1 h2 -> W.absurdB W.Empty h2 ; true -> \ h1 h2 -> W.absurdB W.Empty h1 } ;
  true -> split { false -> \ h1 h2 -> W.absurdB W.Empty h1 ; true -> \ h1 h2 -> W.absurdB W.Empty h2 } } ;

module BCut (ev : (A : DP.LO) -> W.N -> LT.LL A -> W.Bool) {
  module B = BP.Beta[ev] ;
  Lb (A : DP.LO) : U l = B.Lb A ;
  Clo (A : DP.LO) : U l = B.Clo A ;
  Seq (A : DP.LO) : U l = B.Seq A ;
  Mem (A : DP.LO) (c : Clo A) (H : Seq A) : U l = LT.memG (Clo A) c H ;
  Ok (A : DP.LO) : Cf (Lb A) -> Seq A -> U l = split {
    cAx b k e -> \ H -> Mem A (atF b k,e) H * Id W.Bool (ev A k e) b ;
    cAnd p q e d0 d1 | r0 r1 -> \ H -> Mem A (andF p q,e) H * (r0 (consL (p,e) H) * r1 (consL (q,e) H)) ;
    cOr p q e d | r -> \ H -> Mem A (orF p q,e) H * r (consL (p,e) (consL (q,e) H)) ;
    cAll p e k | r -> \ H -> Mem A (allF p,e) H * ((x : Lb A) -> r x (consL (p,consL x e) H)) ;
    cEx p e w d | r -> \ H -> Mem A (exF p,e) H * r (consL (p,consL w e) H) } ;
  Res (A : DP.LO) (H : Seq A) : U l = (d : Cf (Lb A)) * Ok A d H ;

  ----------------------------------------------------------------------
  -- inclusions of sequents, weakening
  Sub (A : DP.LO) (H H' : Seq A) : U l = (c : Clo A) -> Mem A c H -> Mem A c H' ;
  subT (A : DP.LO) (H1 H2 H3 : Seq A) (s : Sub A H1 H2) (t : Sub A H2 H3) : Sub A H1 H3 = \ x m -> t x (s x m) ;
  subCons (A : DP.LO) (c : Clo A) (H H' : Seq A) (s : Sub A H H') : Sub A (consL c H) (consL c H') =
    \ x m -> CF.or-elim (Id (Clo A) c x) (Mem A x H) (Mem A x (consL c H')) (\ e -> inl e) (\ m' -> inr (s x m')) m ;
  wk1 (A : DP.LO) (c : Clo A) (H : Seq A) : Sub A H (consL c H) = \ x m -> inr m ;
  sw (A : DP.LO) (a b : Clo A) (H : Seq A) : Sub A (consL a (consL b H)) (consL b (consL a H)) =
    \ x m -> CF.or-elim (Id (Clo A) a x) (Mem A x (consL b H)) (Mem A x (consL b (consL a H)))
      (\ e -> inr (inl e))
      (\ m1 -> CF.or-elim (Id (Clo A) b x) (Mem A x H) (Mem A x (consL b (consL a H)))
        (\ e -> inl e) (\ m2 -> inr (inr m2)) m1) m ;
  sub3 (A : DP.LO) (a b c : Clo A) (H : Seq A) : Sub A (consL a (consL b (consL c H))) (consL c (consL a (consL b H))) =
    \ x m -> CF.or-elim (Id (Clo A) a x) (Mem A x (consL b (consL c H))) (Mem A x (consL c (consL a (consL b H))))
      (\ e -> inr (inl e))
      (\ m1 -> CF.or-elim (Id (Clo A) b x) (Mem A x (consL c H)) (Mem A x (consL c (consL a (consL b H))))
        (\ e -> inr (inr (inl e)))
        (\ m2 -> CF.or-elim (Id (Clo A) c x) (Mem A x H) (Mem A x (consL c (consL a (consL b H))))
          (\ e -> inl e) (\ m3 -> inr (inr (inr m3))) m2) m1) m ;
  eqSub (A : DP.LO) (c c' : Clo A) (H : Seq A) (e : Id (Clo A) c' c) : Sub A (consL c H) (consL c' H) =
    \ x m -> CF.or-elim (Id (Clo A) c x) (Mem A x H) (Mem A x (consL c' H))
      (\ e0 -> inl (PL.trans (Clo A) c' c x e e0)) (\ m' -> inr m') m ;
  wk (A : DP.LO) : (d : Cf (Lb A)) (H H' : Seq A) -> Ok A d H -> Sub A H H' -> Ok A d H' = split {
    cAx b k e -> \ H H' o s -> (s (atF b k,e) o.1,o.2) ;
    cAnd p q e d0 d1 | r0 r1 -> \ H H' o s -> (s (andF p q,e) o.1,
      (r0 (consL (p,e) H) (consL (p,e) H') o.2.1 (subCons A (p,e) H H' s),
       r1 (consL (q,e) H) (consL (q,e) H') o.2.2 (subCons A (q,e) H H' s))) ;
    cOr p q e d | r -> \ H H' o s -> (s (orF p q,e) o.1,
      r (consL (p,e) (consL (q,e) H)) (consL (p,e) (consL (q,e) H')) o.2
        (subCons A (p,e) (consL (q,e) H) (consL (q,e) H') (subCons A (q,e) H H' s))) ;
    cAll p e k | r -> \ H H' o s -> (s (allF p,e) o.1,
      \ x -> r x (consL (p,consL x e) H) (consL (p,consL x e) H') (o.2 x) (subCons A (p,consL x e) H H' s)) ;
    cEx p e w d | r -> \ H H' o s -> (s (exF p,e) o.1,
      r (consL (p,consL w e) H) (consL (p,consL w e) H') o.2 (subCons A (p,consL w e) H H' s)) } ;

  ----------------------------------------------------------------------
  -- generic induction on one derivation of C::G, the other side being
  -- described by Oth; handlers for the case where C is principal
  IHG (A : DP.LO) (C : Clo A) (Oth : Seq A -> U l) (d : Cf (Lb A)) : U l =
    (G' : Seq A) -> Ok A d (consL C G') -> Oth G' -> Res A G' ;
  mkAnd (A : DP.LO) (p q : BP.Form) (e0 : LT.LL A) (G : Seq A) (m : Mem A (andF p q,e0) G)
    (x0 : Res A (consL (p,e0) G)) (x1 : Res A (consL (q,e0) G)) : Res A G = (cAnd p q e0 x0.1 x1.1,(m,(x0.2,x1.2))) ;
  mkOr (A : DP.LO) (p q : BP.Form) (e0 : LT.LL A) (G : Seq A) (m : Mem A (orF p q,e0) G)
    (x : Res A (consL (p,e0) (consL (q,e0) G))) : Res A G = (cOr p q e0 x.1,(m,x.2)) ;
  mkAll (A : DP.LO) (p : BP.Form) (e0 : LT.LL A) (G : Seq A) (m : Mem A (allF p,e0) G)
    (x : (y : Lb A) -> Res A (consL (p,consL y e0) G)) : Res A G = (cAll p e0 (\ y -> (x y).1),(m,\ y -> (x y).2)) ;
  mkEx (A : DP.LO) (p : BP.Form) (e0 : LT.LL A) (w : Lb A) (G : Seq A) (m : Mem A (exF p,e0) G)
    (x : Res A (consL (p,consL w e0) G)) : Res A G = (cEx p e0 w x.1,(m,x.2)) ;
  module Ind (A : DP.LO) (C : Clo A) (Oth : Seq A -> U l)
    (oW : (G : Seq A) (c : Clo A) -> Oth G -> Oth (consL c G))
    (hAx : (b : W.Bool) (k : W.N) (e0 : LT.LL A) -> Id (Clo A) C (atF b k,e0) -> Id W.Bool (ev A k e0) b ->
       (G : Seq A) -> Oth G -> Res A G)
    (hAnd : (p q : BP.Form) (e0 : LT.LL A) (d0 d1 : Cf (Lb A)) -> Id (Clo A) C (andF p q,e0) ->
       IHG A C Oth d0 -> IHG A C Oth d1 -> (G : Seq A) ->
       Ok A d0 (consL (p,e0) (consL C G)) -> Ok A d1 (consL (q,e0) (consL C G)) -> Oth G -> Res A G)
    (hOr : (p q : BP.Form) (e0 : LT.LL A) (d : Cf (Lb A)) -> Id (Clo A) C (orF p q,e0) ->
       IHG A C Oth d -> (G : Seq A) -> Ok A d (consL (p,e0) (consL (q,e0) (consL C G))) -> Oth G -> Res A G)
    (hAll : (p : BP.Form) (e0 : LT.LL A) (k : Lb A -> Cf (Lb A)) -> Id (Clo A) C (allF p,e0) ->
       ((x : Lb A) -> IHG A C Oth (k x)) -> (G : Seq A) ->
       ((x : Lb A) -> Ok A (k x) (consL (p,consL x e0) (consL C G))) -> Oth G -> Res A G)
    (hEx : (p : BP.Form) (e0 : LT.LL A) (w : Lb A) (d : Cf (Lb A)) -> Id (Clo A) C (exF p,e0) ->
       IHG A C Oth d -> (G : Seq A) -> Ok A d (consL (p,consL w e0) (consL C G)) -> Oth G -> Res A G) {
    front (c : Clo A) (d : Cf (Lb A)) (G : Seq A) (o : Ok A d (consL c (consL C G))) : Ok A d (consL C (consL c G)) =
      wk A d (consL c (consL C G)) (consL C (consL c G)) o (sw A c C G) ;
    front2 (c c' : Clo A) (d : Cf (Lb A)) (G : Seq A) (o : Ok A d (consL c (consL c' (consL C G)))) :
        Ok A d (consL C (consL c (consL c' G))) =
      wk A d (consL c (consL c' (consL C G))) (consL C (consL c (consL c' G))) o (sub3 A c c' C G) ;
    L : (d : Cf (Lb A)) (G : Seq A) -> Ok A d (consL C G) -> Oth G -> Res A G = split {
      cAx b k e0 -> \ G o t -> CF.or-elim (Id (Clo A) C (atF b k,e0)) (Mem A (atF b k,e0) G) (Res A G)
        (\ eq -> hAx b k e0 eq o.2 G t) (\ m -> (cAx b k e0,(m,o.2))) o.1 ;
      cAnd p q e0 d0 d1 | r0 r1 -> \ G o t -> CF.or-elim (Id (Clo A) C (andF p q,e0)) (Mem A (andF p q,e0) G) (Res A G)
        (\ eq -> hAnd p q e0 d0 d1 eq r0 r1 G o.2.1 o.2.2 t)
        (\ m -> mkAnd A p q e0 G m
          (r0 (consL (p,e0) G) (front (p,e0) d0 G o.2.1) (oW G (p,e0) t))
          (r1 (consL (q,e0) G) (front (q,e0) d1 G o.2.2) (oW G (q,e0) t))) o.1 ;
      cOr p q e0 d | r -> \ G o t -> CF.or-elim (Id (Clo A) C (orF p q,e0)) (Mem A (orF p q,e0) G) (Res A G)
        (\ eq -> hOr p q e0 d eq r G o.2 t)
        (\ m -> mkOr A p q e0 G m
          (r (consL (p,e0) (consL (q,e0) G)) (front2 (p,e0) (q,e0) d G o.2) (oW (consL (q,e0) G) (p,e0) (oW G (q,e0) t)))) o.1 ;
      cAll p e0 k | r -> \ G o t -> CF.or-elim (Id (Clo A) C (allF p,e0)) (Mem A (allF p,e0) G) (Res A G)
        (\ eq -> hAll p e0 k eq r G o.2 t)
        (\ m -> mkAll A p e0 G m
          (\ y -> r y (consL (p,consL y e0) G) (front (p,consL y e0) (k y) G (o.2 y)) (oW G (p,consL y e0) t))) o.1 ;
      cEx p e0 w d | r -> \ G o t -> CF.or-elim (Id (Clo A) C (exF p,e0)) (Mem A (exF p,e0) G) (Res A G)
        (\ eq -> hEx p e0 w d eq r G o.2 t)
        (\ m -> mkEx A p e0 w G m
          (r (consL (p,consL w e0) G) (front (p,consL w e0) d G o.2) (oW G (p,consL w e0) t))) o.1 } ;
  } ;

  -- mismatched principal closures
  mis (A : DP.LO) (t : BP.Form -> W.Bool) (C c0 : Clo A) (eq : Id (Clo A) C c0)
    (h1 : Id W.Bool (t C.1) true) (h2 : Id W.Bool (t c0.1) false) (X : U l) : X =
    BP.tf X (PL.trans W.Bool true (t C.1) false (PL.sym W.Bool (t C.1) true h1)
      (PL.trans W.Bool (t C.1) (t c0.1) false (PL.ap (Clo A) W.Bool (\ c -> t c.1) C c0 eq) h2)) ;
  module Mis (A : DP.LO) (C : Clo A) (Oth : Seq A -> U l) (t : BP.Form -> W.Bool) (h1 : Id W.Bool (t C.1) true) {
    mAx (h2 : (b : W.Bool) (k : W.N) -> Id W.Bool (t (atF b k)) false) (b : W.Bool) (k : W.N) (e0 : LT.LL A)
      (eq : Id (Clo A) C (atF b k,e0)) (h : Id W.Bool (ev A k e0) b) (G : Seq A) (o : Oth G) : Res A G =
      mis A t C (atF b k,e0) eq h1 (h2 b k) (Res A G) ;
    mAnd (h2 : (p q : BP.Form) -> Id W.Bool (t (andF p q)) false) (p q : BP.Form) (e0 : LT.LL A) (d0 d1 : Cf (Lb A))
      (eq : Id (Clo A) C (andF p q,e0)) (r0 : IHG A C Oth d0) (r1 : IHG A C Oth d1) (G : Seq A)
      (o0 : Ok A d0 (consL (p,e0) (consL C G))) (o1 : Ok A d1 (consL (q,e0) (consL C G))) (o : Oth G) : Res A G =
      mis A t C (andF p q,e0) eq h1 (h2 p q) (Res A G) ;
    mOr (h2 : (p q : BP.Form) -> Id W.Bool (t (orF p q)) false) (p q : BP.Form) (e0 : LT.LL A) (d : Cf (Lb A))
      (eq : Id (Clo A) C (orF p q,e0)) (r : IHG A C Oth d) (G : Seq A)
      (o0 : Ok A d (consL (p,e0) (consL (q,e0) (consL C G)))) (o : Oth G) : Res A G =
      mis A t C (orF p q,e0) eq h1 (h2 p q) (Res A G) ;
    mAll (h2 : (p : BP.Form) -> Id W.Bool (t (allF p)) false) (p : BP.Form) (e0 : LT.LL A) (k : Lb A -> Cf (Lb A))
      (eq : Id (Clo A) C (allF p,e0)) (r : (x : Lb A) -> IHG A C Oth (k x)) (G : Seq A)
      (o0 : (x : Lb A) -> Ok A (k x) (consL (p,consL x e0) (consL C G))) (o : Oth G) : Res A G =
      mis A t C (allF p,e0) eq h1 (h2 p) (Res A G) ;
    mEx (h2 : (p : BP.Form) -> Id W.Bool (t (exF p)) false) (p : BP.Form) (e0 : LT.LL A) (w : Lb A) (d : Cf (Lb A))
      (eq : Id (Clo A) C (exF p,e0)) (r : IHG A C Oth d) (G : Seq A)
      (o0 : Ok A d (consL (p,consL w e0) (consL C G))) (o : Oth G) : Res A G =
      mis A t C (exF p,e0) eq h1 (h2 p) (Res A G) ;
  } ;

  ----------------------------------------------------------------------
  -- the two sides
  CutT (A : DP.LO) (f : BP.Form) : U l = (e : LT.LL A) (G : Seq A) (d1 d2 : Cf (Lb A)) ->
    Ok A d1 (consL (f,e) G) -> Ok A d2 (consL (BP.neg f,e) G) -> Res A G ;
  OthL (A : DP.LO) (C' : Clo A) (G : Seq A) : U l = (d : Cf (Lb A)) * Ok A d (consL C' G) ;
  oWL (A : DP.LO) (C' : Clo A) (G : Seq A) (c : Clo A) (t : OthL A C' G) : OthL A C' (consL c G) =
    (t.1,wk A t.1 (consL C' G) (consL C' (consL c G)) t.2 (subCons A C' G (consL c G) (wk1 A c G))) ;
  oWR (A : DP.LO) (C : Clo A) (dl : Cf (Lb A)) (G : Seq A) (c : Clo A) (t : Ok A dl (consL C G)) : Ok A dl (consL C (consL c G)) =
    wk A dl (consL C G) (consL C (consL c G)) t (subCons A C G (consL c G) (wk1 A c G)) ;
  lC (A : DP.LO) (c : Clo A) : Clo A = (leftF c.1,c.2) ;
  rC (A : DP.LO) (c : Clo A) : Clo A = (rightF c.1,c.2) ;
  lCw (A : DP.LO) (w : Lb A) (c : Clo A) : Clo A = (leftF c.1,consL w c.2) ;

  -- atoms: an axiom on C and an axiom on neg C contradict each other
  atVF (A : DP.LO) : BP.Form -> LT.LL A -> W.Bool = split {
    atF b k -> \ e -> BP.eqBo (ev A k e) b ; andF p q -> \ e -> false ; orF p q -> \ e -> false ;
    allF p -> \ e -> false ; exF p -> \ e -> false } ;
  module CAt (A : DP.LO) (b : W.Bool) (k : W.N) (e : LT.LL A) {
    Ca : Clo A = (atF b k,e) ;
    Cn : Clo A = (atF (W.notB b) k,e) ;
    atV (c : Clo A) : W.Bool = atVF A c.1 c.2 ;
    vt (b1 : W.Bool) (k1 : W.N) (e1 : LT.LL A) (h : Id W.Bool (ev A k1 e1) b1) : Id W.Bool (atV (atF b1 k1,e1)) true =
      PL.subst W.Bool (\ z -> Id W.Bool (BP.eqBo z b1) true) b1 (ev A k1 e1) (PL.sym W.Bool (ev A k1 e1) b1 h) (eqBoSelf b1) ;
    vv (c c0 : Clo A) (eq : Id (Clo A) c c0) (h : Id W.Bool (atV c0) true) : Id W.Bool (atV c) true =
      PL.trans W.Bool (atV c) (atV c0) true (PL.ap (Clo A) W.Bool atV c c0 eq) h ;
    module RA (b1 : W.Bool) (k1 : W.N) (e1 : LT.LL A) (eq1 : Id (Clo A) Ca (atF b1 k1,e1)) (h1 : Id W.Bool (ev A k1 e1) b1) {
      dl : Cf (Lb A) = cAx b1 k1 e1 ;
      Oth (G : Seq A) : U l = Ok A dl (consL Ca G) ;
      module MR = Mis[A,Cn,Oth,isAtF,refl true] ;
      hAx (b2 : W.Bool) (k2 : W.N) (e2 : LT.LL A) (eq2 : Id (Clo A) Cn (atF b2 k2,e2)) (h2 : Id W.Bool (ev A k2 e2) b2)
        (G : Seq A) (t : Oth G) : Res A G =
        CF.efq (Res A G) (notBoth (ev A k e) b (vv Ca (atF b1 k1,e1) eq1 (vt b1 k1 e1 h1)) (vv Cn (atF b2 k2,e2) eq2 (vt b2 k2 e2 h2))) ;
      module IR = Ind[A,Cn,Oth,oWR A Ca dl,hAx,MR.mAnd (\ p q -> refl false),MR.mOr (\ p q -> refl false),
        MR.mAll (\ p -> refl false),MR.mEx (\ p -> refl false)] ;
    } ;
    module ML = Mis[A,Ca,OthL A Cn,isAtF,refl true] ;
    hAxL (b1 : W.Bool) (k1 : W.N) (e1 : LT.LL A) (eq1 : Id (Clo A) Ca (atF b1 k1,e1)) (h1 : Id W.Bool (ev A k1 e1) b1)
      (G : Seq A) (t : OthL A Cn G) : Res A G = RA[b1,k1,e1,eq1,h1].IR.L t.1 G t.2 (inl eq1,h1) ;
    module IL = Ind[A,Ca,OthL A Cn,oWL A Cn,hAxL,ML.mAnd (\ p q -> refl false),ML.mOr (\ p q -> refl false),
      ML.mAll (\ p -> refl false),ML.mEx (\ p -> refl false)] ;
  } ;

  -- conjunction against disjunction
  module CAnd (A : DP.LO) (p q : BP.Form) (rp : CutT A p) (rq : CutT A q) (e : LT.LL A) {
    Ca : Clo A = (andF p q,e) ;
    Cn : Clo A = (orF (BP.neg p) (BP.neg q),e) ;
    cp : Clo A = (p,e) ; cq : Clo A = (q,e) ; cnp : Clo A = (BP.neg p,e) ; cnq : Clo A = (BP.neg q,e) ;
    module RA (p1 q1 : BP.Form) (e1 : LT.LL A) (d10 d11 : Cf (Lb A)) (eq1 : Id (Clo A) Ca (andF p1 q1,e1))
      (r0 : IHG A Ca (OthL A Cn) d10) (r1 : IHG A Ca (OthL A Cn) d11) {
      dl : Cf (Lb A) = cAnd p1 q1 e1 d10 d11 ;
      Oth (G : Seq A) : U l = Ok A dl (consL Ca G) ;
      oW (G : Seq A) (c : Clo A) (t : Oth G) : Oth (consL c G) = oWR A Ca dl G c t ;
      module MR = Mis[A,Cn,Oth,BP.isOrF,refl true] ;
      module PC (np2 nq2 : BP.Form) (e2 : LT.LL A) (d2 : Cf (Lb A)) (eq2 : Id (Clo A) Cn (orF np2 nq2,e2))
        (r2 : IHG A Cn Oth d2) (G : Seq A) (o2 : Ok A d2 (consL (np2,e2) (consL (nq2,e2) (consL Cn G)))) (t : Oth G) {
        d2n : Cf (Lb A) = cOr np2 nq2 e2 d2 ;
        o2n : Ok A d2n (consL Cn G) = (inl eq2,o2) ;
        a1 : Res A (consL cp G) = r0 (consL cp G)
          (wk A d10 (consL (p1,e1) (consL Ca G)) (consL Ca (consL cp G)) t.2.1
            (subT A (consL (p1,e1) (consL Ca G)) (consL cp (consL Ca G)) (consL Ca (consL cp G))
              (eqSub A (p1,e1) cp (consL Ca G) (PL.ap (Clo A) (Clo A) (lC A) Ca (andF p1 q1,e1) eq1)) (sw A cp Ca G)))
          (oWL A Cn G cp (d2n,o2n)) ;
        a2 : Res A (consL cq G) = r1 (consL cq G)
          (wk A d11 (consL (q1,e1) (consL Ca G)) (consL Ca (consL cq G)) t.2.2
            (subT A (consL (q1,e1) (consL Ca G)) (consL cq (consL Ca G)) (consL Ca (consL cq G))
              (eqSub A (q1,e1) cq (consL Ca G) (PL.ap (Clo A) (Clo A) (rC A) Ca (andF p1 q1,e1) eq1)) (sw A cq Ca G)))
          (oWL A Cn G cq (d2n,o2n)) ;
        a3 : Res A (consL cnp (consL cnq G)) = r2 (consL cnp (consL cnq G))
          (wk A d2 (consL (np2,e2) (consL (nq2,e2) (consL Cn G))) (consL Cn (consL cnp (consL cnq G))) o2
            (subT A (consL (np2,e2) (consL (nq2,e2) (consL Cn G))) (consL cnp (consL (nq2,e2) (consL Cn G))) (consL Cn (consL cnp (consL cnq G)))
              (eqSub A (np2,e2) cnp (consL (nq2,e2) (consL Cn G)) (PL.ap (Clo A) (Clo A) (lC A) Cn (orF np2 nq2,e2) eq2))
              (subT A (consL cnp (consL (nq2,e2) (consL Cn G))) (consL cnp (consL cnq (consL Cn G))) (consL Cn (consL cnp (consL cnq G)))
                (subCons A cnp (consL (nq2,e2) (consL Cn G)) (consL cnq (consL Cn G))
                  (eqSub A (nq2,e2) cnq (consL Cn G) (PL.ap (Clo A) (Clo A) (rC A) Cn (orF np2 nq2,e2) eq2)))
                (sub3 A cnp cnq Cn G))))
          (oW (consL cnq G) cnp (oW G cnq t)) ;
        a4 : Res A (consL cnp G) = rq e (consL cnp G) a2.1 a3.1
          (wk A a2.1 (consL cq G) (consL cq (consL cnp G)) a2.2 (subCons A cq G (consL cnp G) (wk1 A cnp G)))
          (wk A a3.1 (consL cnp (consL cnq G)) (consL cnq (consL cnp G)) a3.2 (sw A cnp cnq G)) ;
        res : Res A G = rp e G a1.1 a4.1 a1.2 a4.2 ;
      } ;
      hOr (np2 nq2 : BP.Form) (e2 : LT.LL A) (d2 : Cf (Lb A)) (eq2 : Id (Clo A) Cn (orF np2 nq2,e2))
        (r2 : IHG A Cn Oth d2) (G : Seq A) (o2 : Ok A d2 (consL (np2,e2) (consL (nq2,e2) (consL Cn G)))) (t : Oth G) : Res A G =
        PC[np2,nq2,e2,d2,eq2,r2,G,o2,t].res ;
      module IR = Ind[A,Cn,Oth,oW,MR.mAx (\ b k -> refl false),MR.mAnd (\ p0 q0 -> refl false),hOr,
        MR.mAll (\ p0 -> refl false),MR.mEx (\ p0 -> refl false)] ;
    } ;
    module ML = Mis[A,Ca,OthL A Cn,BP.isAndF,refl true] ;
    hAnd (p1 q1 : BP.Form) (e1 : LT.LL A) (d10 d11 : Cf (Lb A)) (eq1 : Id (Clo A) Ca (andF p1 q1,e1))
      (r0 : IHG A Ca (OthL A Cn) d10) (r1 : IHG A Ca (OthL A Cn) d11) (G : Seq A)
      (o0 : Ok A d10 (consL (p1,e1) (consL Ca G))) (o1 : Ok A d11 (consL (q1,e1) (consL Ca G))) (t : OthL A Cn G) : Res A G =
      RA[p1,q1,e1,d10,d11,eq1,r0,r1].IR.L t.1 G t.2 (inl eq1,(o0,o1)) ;
    module IL = Ind[A,Ca,OthL A Cn,oWL A Cn,ML.mAx (\ b k -> refl false),hAnd,ML.mOr (\ p0 q0 -> refl false),
      ML.mAll (\ p0 -> refl false),ML.mEx (\ p0 -> refl false)] ;
  } ;

  -- disjunction against conjunction
  module COr (A : DP.LO) (p q : BP.Form) (rp : CutT A p) (rq : CutT A q) (e : LT.LL A) {
    Ca : Clo A = (orF p q,e) ;
    Cn : Clo A = (andF (BP.neg p) (BP.neg q),e) ;
    cp : Clo A = (p,e) ; cq : Clo A = (q,e) ; cnp : Clo A = (BP.neg p,e) ; cnq : Clo A = (BP.neg q,e) ;
    module RA (p1 q1 : BP.Form) (e1 : LT.LL A) (d1 : Cf (Lb A)) (eq1 : Id (Clo A) Ca (orF p1 q1,e1))
      (r1 : IHG A Ca (OthL A Cn) d1) {
      dl : Cf (Lb A) = cOr p1 q1 e1 d1 ;
      Oth (G : Seq A) : U l = Ok A dl (consL Ca G) ;
      oW (G : Seq A) (c : Clo A) (t : Oth G) : Oth (consL c G) = oWR A Ca dl G c t ;
      module MR = Mis[A,Cn,Oth,BP.isAndF,refl true] ;
      module PC (np2 nq2 : BP.Form) (e2 : LT.LL A) (d20 d21 : Cf (Lb A)) (eq2 : Id (Clo A) Cn (andF np2 nq2,e2))
        (r20 : IHG A Cn Oth d20) (r21 : IHG A Cn Oth d21) (G : Seq A)
        (o20 : Ok A d20 (consL (np2,e2) (consL Cn G))) (o21 : Ok A d21 (consL (nq2,e2) (consL Cn G))) (t : Oth G) {
        d2n : Cf (Lb A) = cAnd np2 nq2 e2 d20 d21 ;
        o2n : Ok A d2n (consL Cn G) = (inl eq2,(o20,o21)) ;
        a1 : Res A (consL cp (consL cq G)) = r1 (consL cp (consL cq G))
          (wk A d1 (consL (p1,e1) (consL (q1,e1) (consL Ca G))) (consL Ca (consL cp (consL cq G))) t.2
            (subT A (consL (p1,e1) (consL (q1,e1) (consL Ca G))) (consL cp (consL (q1,e1) (consL Ca G))) (consL Ca (consL cp (consL cq G)))
              (eqSub A (p1,e1) cp (consL (q1,e1) (consL Ca G)) (PL.ap (Clo A) (Clo A) (lC A) Ca (orF p1 q1,e1) eq1))
              (subT A (consL cp (consL (q1,e1) (consL Ca G))) (consL cp (consL cq (consL Ca G))) (consL Ca (consL cp (consL cq G)))
                (subCons A cp (consL (q1,e1) (consL Ca G)) (consL cq (consL Ca G))
                  (eqSub A (q1,e1) cq (consL Ca G) (PL.ap (Clo A) (Clo A) (rC A) Ca (orF p1 q1,e1) eq1)))
                (sub3 A cp cq Ca G))))
          (oWL A Cn (consL cq G) cp (oWL A Cn G cq (d2n,o2n))) ;
        a2 : Res A (consL cnp G) = r20 (consL cnp G)
          (wk A d20 (consL (np2,e2) (consL Cn G)) (consL Cn (consL cnp G)) o20
            (subT A (consL (np2,e2) (consL Cn G)) (consL cnp (consL Cn G)) (consL Cn (consL cnp G))
              (eqSub A (np2,e2) cnp (consL Cn G) (PL.ap (Clo A) (Clo A) (lC A) Cn (andF np2 nq2,e2) eq2)) (sw A cnp Cn G)))
          (oW G cnp t) ;
        a3 : Res A (consL cnq G) = r21 (consL cnq G)
          (wk A d21 (consL (nq2,e2) (consL Cn G)) (consL Cn (consL cnq G)) o21
            (subT A (consL (nq2,e2) (consL Cn G)) (consL cnq (consL Cn G)) (consL Cn (consL cnq G))
              (eqSub A (nq2,e2) cnq (consL Cn G) (PL.ap (Clo A) (Clo A) (rC A) Cn (andF np2 nq2,e2) eq2)) (sw A cnq Cn G)))
          (oW G cnq t) ;
        a4 : Res A (consL cq G) = rp e (consL cq G) a1.1 a2.1 a1.2
          (wk A a2.1 (consL cnp G) (consL cnp (consL cq G)) a2.2 (subCons A cnp G (consL cq G) (wk1 A cq G))) ;
        res : Res A G = rq e G a4.1 a3.1 a4.2 a3.2 ;
      } ;
      hAnd (np2 nq2 : BP.Form) (e2 : LT.LL A) (d20 d21 : Cf (Lb A)) (eq2 : Id (Clo A) Cn (andF np2 nq2,e2))
        (r20 : IHG A Cn Oth d20) (r21 : IHG A Cn Oth d21) (G : Seq A)
        (o20 : Ok A d20 (consL (np2,e2) (consL Cn G))) (o21 : Ok A d21 (consL (nq2,e2) (consL Cn G))) (t : Oth G) : Res A G =
        PC[np2,nq2,e2,d20,d21,eq2,r20,r21,G,o20,o21,t].res ;
      module IR = Ind[A,Cn,Oth,oW,MR.mAx (\ b k -> refl false),hAnd,MR.mOr (\ p0 q0 -> refl false),
        MR.mAll (\ p0 -> refl false),MR.mEx (\ p0 -> refl false)] ;
    } ;
    module ML = Mis[A,Ca,OthL A Cn,BP.isOrF,refl true] ;
    hOr (p1 q1 : BP.Form) (e1 : LT.LL A) (d1 : Cf (Lb A)) (eq1 : Id (Clo A) Ca (orF p1 q1,e1))
      (r1 : IHG A Ca (OthL A Cn) d1) (G : Seq A) (o1 : Ok A d1 (consL (p1,e1) (consL (q1,e1) (consL Ca G)))) (t : OthL A Cn G) : Res A G =
      RA[p1,q1,e1,d1,eq1,r1].IR.L t.1 G t.2 (inl eq1,o1) ;
    module IL = Ind[A,Ca,OthL A Cn,oWL A Cn,ML.mAx (\ b k -> refl false),ML.mAnd (\ p0 q0 -> refl false),hOr,
      ML.mAll (\ p0 -> refl false),ML.mEx (\ p0 -> refl false)] ;
  } ;

  -- universal against existential
  module CAll (A : DP.LO) (p : BP.Form) (rp : CutT A p) (e : LT.LL A) {
    Ca : Clo A = (allF p,e) ;
    Cn : Clo A = (exF (BP.neg p),e) ;
    module RA (p1 : BP.Form) (e1 : LT.LL A) (k1 : Lb A -> Cf (Lb A)) (eq1 : Id (Clo A) Ca (allF p1,e1))
      (rk : (x : Lb A) -> IHG A Ca (OthL A Cn) (k1 x)) {
      dl : Cf (Lb A) = cAll p1 e1 k1 ;
      Oth (G : Seq A) : U l = Ok A dl (consL Ca G) ;
      oW (G : Seq A) (c : Clo A) (t : Oth G) : Oth (consL c G) = oWR A Ca dl G c t ;
      module MR = Mis[A,Cn,Oth,BP.isExF,refl true] ;
      module PC (np2 : BP.Form) (e2 : LT.LL A) (w : Lb A) (d2 : Cf (Lb A)) (eq2 : Id (Clo A) Cn (exF np2,e2))
        (r2 : IHG A Cn Oth d2) (G : Seq A) (o2 : Ok A d2 (consL (np2,consL w e2) (consL Cn G))) (t : Oth G) {
        cw : Clo A = (p,consL w e) ;
        cnw : Clo A = (BP.neg p,consL w e) ;
        d2n : Cf (Lb A) = cEx np2 e2 w d2 ;
        o2n : Ok A d2n (consL Cn G) = (inl eq2,o2) ;
        a1 : Res A (consL cw G) = rk w (consL cw G)
          (wk A (k1 w) (consL (p1,consL w e1) (consL Ca G)) (consL Ca (consL cw G)) (t.2 w)
            (subT A (consL (p1,consL w e1) (consL Ca G)) (consL cw (consL Ca G)) (consL Ca (consL cw G))
              (eqSub A (p1,consL w e1) cw (consL Ca G) (PL.ap (Clo A) (Clo A) (lCw A w) Ca (allF p1,e1) eq1)) (sw A cw Ca G)))
          (oWL A Cn G cw (d2n,o2n)) ;
        a2 : Res A (consL cnw G) = r2 (consL cnw G)
          (wk A d2 (consL (np2,consL w e2) (consL Cn G)) (consL Cn (consL cnw G)) o2
            (subT A (consL (np2,consL w e2) (consL Cn G)) (consL cnw (consL Cn G)) (consL Cn (consL cnw G))
              (eqSub A (np2,consL w e2) cnw (consL Cn G) (PL.ap (Clo A) (Clo A) (lCw A w) Cn (exF np2,e2) eq2)) (sw A cnw Cn G)))
          (oW G cnw t) ;
        res : Res A G = rp (consL w e) G a1.1 a2.1 a1.2 a2.2 ;
      } ;
      hEx (np2 : BP.Form) (e2 : LT.LL A) (w : Lb A) (d2 : Cf (Lb A)) (eq2 : Id (Clo A) Cn (exF np2,e2))
        (r2 : IHG A Cn Oth d2) (G : Seq A) (o2 : Ok A d2 (consL (np2,consL w e2) (consL Cn G))) (t : Oth G) : Res A G =
        PC[np2,e2,w,d2,eq2,r2,G,o2,t].res ;
      module IR = Ind[A,Cn,Oth,oW,MR.mAx (\ b k -> refl false),MR.mAnd (\ p0 q0 -> refl false),MR.mOr (\ p0 q0 -> refl false),
        MR.mAll (\ p0 -> refl false),hEx] ;
    } ;
    module ML = Mis[A,Ca,OthL A Cn,BP.isAllF,refl true] ;
    hAll (p1 : BP.Form) (e1 : LT.LL A) (k1 : Lb A -> Cf (Lb A)) (eq1 : Id (Clo A) Ca (allF p1,e1))
      (rk : (x : Lb A) -> IHG A Ca (OthL A Cn) (k1 x)) (G : Seq A)
      (o1 : (x : Lb A) -> Ok A (k1 x) (consL (p1,consL x e1) (consL Ca G))) (t : OthL A Cn G) : Res A G =
      RA[p1,e1,k1,eq1,rk].IR.L t.1 G t.2 (inl eq1,o1) ;
    module IL = Ind[A,Ca,OthL A Cn,oWL A Cn,ML.mAx (\ b k -> refl false),ML.mAnd (\ p0 q0 -> refl false),
      ML.mOr (\ p0 q0 -> refl false),hAll,ML.mEx (\ p0 -> refl false)] ;
  } ;

  -- existential against universal
  module CEx (A : DP.LO) (p : BP.Form) (rp : CutT A p) (e : LT.LL A) {
    Ca : Clo A = (exF p,e) ;
    Cn : Clo A = (allF (BP.neg p),e) ;
    module RA (p1 : BP.Form) (e1 : LT.LL A) (w : Lb A) (d1 : Cf (Lb A)) (eq1 : Id (Clo A) Ca (exF p1,e1))
      (r1 : IHG A Ca (OthL A Cn) d1) {
      dl : Cf (Lb A) = cEx p1 e1 w d1 ;
      Oth (G : Seq A) : U l = Ok A dl (consL Ca G) ;
      oW (G : Seq A) (c : Clo A) (t : Oth G) : Oth (consL c G) = oWR A Ca dl G c t ;
      module MR = Mis[A,Cn,Oth,BP.isAllF,refl true] ;
      cw : Clo A = (p,consL w e) ;
      cnw : Clo A = (BP.neg p,consL w e) ;
      module PC (np2 : BP.Form) (e2 : LT.LL A) (k2 : Lb A -> Cf (Lb A)) (eq2 : Id (Clo A) Cn (allF np2,e2))
        (rk2 : (x : Lb A) -> IHG A Cn Oth (k2 x)) (G : Seq A)
        (o2 : (x : Lb A) -> Ok A (k2 x) (consL (np2,consL x e2) (consL Cn G))) (t : Oth G) {
        d2n : Cf (Lb A) = cAll np2 e2 k2 ;
        o2n : Ok A d2n (consL Cn G) = (inl eq2,o2) ;
        a1 : Res A (consL cw G) = r1 (consL cw G)
          (wk A d1 (consL (p1,consL w e1) (consL Ca G)) (consL Ca (consL cw G)) t.2
            (subT A (consL (p1,consL w e1) (consL Ca G)) (consL cw (consL Ca G)) (consL Ca (consL cw G))
              (eqSub A (p1,consL w e1) cw (consL Ca G) (PL.ap (Clo A) (Clo A) (lCw A w) Ca (exF p1,e1) eq1)) (sw A cw Ca G)))
          (oWL A Cn G cw (d2n,o2n)) ;
        a2 : Res A (consL cnw G) = rk2 w (consL cnw G)
          (wk A (k2 w) (consL (np2,consL w e2) (consL Cn G)) (consL Cn (consL cnw G)) (o2 w)
            (subT A (consL (np2,consL w e2) (consL Cn G)) (consL cnw (consL Cn G)) (consL Cn (consL cnw G))
              (eqSub A (np2,consL w e2) cnw (consL Cn G) (PL.ap (Clo A) (Clo A) (lCw A w) Cn (allF np2,e2) eq2)) (sw A cnw Cn G)))
          (oW G cnw t) ;
        res : Res A G = rp (consL w e) G a1.1 a2.1 a1.2 a2.2 ;
      } ;
      hAll (np2 : BP.Form) (e2 : LT.LL A) (k2 : Lb A -> Cf (Lb A)) (eq2 : Id (Clo A) Cn (allF np2,e2))
        (rk2 : (x : Lb A) -> IHG A Cn Oth (k2 x)) (G : Seq A)
        (o2 : (x : Lb A) -> Ok A (k2 x) (consL (np2,consL x e2) (consL Cn G))) (t : Oth G) : Res A G =
        PC[np2,e2,k2,eq2,rk2,G,o2,t].res ;
      module IR = Ind[A,Cn,Oth,oW,MR.mAx (\ b k -> refl false),MR.mAnd (\ p0 q0 -> refl false),MR.mOr (\ p0 q0 -> refl false),
        hAll,MR.mEx (\ p0 -> refl false)] ;
    } ;
    module ML = Mis[A,Ca,OthL A Cn,BP.isExF,refl true] ;
    hEx (p1 : BP.Form) (e1 : LT.LL A) (w : Lb A) (d1 : Cf (Lb A)) (eq1 : Id (Clo A) Ca (exF p1,e1))
      (r1 : IHG A Ca (OthL A Cn) d1) (G : Seq A) (o1 : Ok A d1 (consL (p1,consL w e1) (consL Ca G))) (t : OthL A Cn G) : Res A G =
      RA[p1,e1,w,d1,eq1,r1].IR.L t.1 G t.2 (inl eq1,o1) ;
    module IL = Ind[A,Ca,OthL A Cn,oWL A Cn,ML.mAx (\ b k -> refl false),ML.mAnd (\ p0 q0 -> refl false),
      ML.mOr (\ p0 q0 -> refl false),ML.mAll (\ p0 -> refl false),hEx] ;
  } ;

  ----------------------------------------------------------------------
  -- admissibility of cut, by induction on the cut formula
  cut (A : DP.LO) : (f : BP.Form) -> CutT A f = split {
    atF b k -> \ e G d1 d2 o1 o2 -> CAt[A,b,k,e].IL.L d1 G o1 (d2,o2) ;
    andF p q | rp rq -> \ e G d1 d2 o1 o2 -> CAnd[A,p,q,rp,rq,e].IL.L d1 G o1 (d2,o2) ;
    orF p q | rp rq -> \ e G d1 d2 o1 o2 -> COr[A,p,q,rp,rq,e].IL.L d1 G o1 (d2,o2) ;
    allF p | rp -> \ e G d1 d2 o1 o2 -> CAll[A,p,rp,e].IL.L d1 G o1 (d2,o2) ;
    exF p | rp -> \ e G d1 d2 o1 o2 -> CEx[A,p,rp,e].IL.L d1 G o1 (d2,o2) } ;

  -- derivations with cut, and cut elimination
  OkD (A : DP.LO) : Dv (Lb A) -> Seq A -> U l = split {
    dAx b k e -> \ H -> Mem A (atF b k,e) H * Id W.Bool (ev A k e) b ;
    dAnd p q e d0 d1 | r0 r1 -> \ H -> Mem A (andF p q,e) H * (r0 (consL (p,e) H) * r1 (consL (q,e) H)) ;
    dOr p q e d | r -> \ H -> Mem A (orF p q,e) H * r (consL (p,e) (consL (q,e) H)) ;
    dAll p e k | r -> \ H -> Mem A (allF p,e) H * ((x : Lb A) -> r x (consL (p,consL x e) H)) ;
    dEx p e w d | r -> \ H -> Mem A (exF p,e) H * r (consL (p,consL w e) H) ;
    dCut f e d0 d1 | r0 r1 -> \ H -> r0 (consL (f,e) H) * r1 (consL (BP.neg f,e) H) } ;
  elim (A : DP.LO) : (d : Dv (Lb A)) (H : Seq A) -> OkD A d H -> Res A H = split {
    dAx b k e -> \ H o -> (cAx b k e,o) ;
    dAnd p q e d0 d1 | r0 r1 -> \ H o -> mkAnd A p q e H o.1 (r0 (consL (p,e) H) o.2.1) (r1 (consL (q,e) H) o.2.2) ;
    dOr p q e d | r -> \ H o -> mkOr A p q e H o.1 (r (consL (p,e) (consL (q,e) H)) o.2) ;
    dAll p e k | r -> \ H o -> mkAll A p e H o.1 (\ y -> r y (consL (p,consL y e) H) (o.2 y)) ;
    dEx p e w d | r -> \ H o -> mkEx A p e w H o.1 (r (consL (p,consL w e) H) o.2) ;
    dCut f e d0 d1 | r0 r1 -> \ H o ->
      cut A f e H (r0 (consL (f,e) H) o.1).1 (r1 (consL (BP.neg f,e) H) o.2).1 (r0 (consL (f,e) H) o.1).2 (r1 (consL (BP.neg f,e) H) o.2).2 } ;

  -- syntactic consistency: no cut-free, hence no, derivation of the empty sequent
  noEmpty (A : DP.LO) : (d : Cf (Lb A)) -> Ok A d nilL -> W.Empty = split {
    cAx b k e -> \ o -> o.1 ; cAnd p q e d0 d1 -> \ o -> o.1 ; cOr p q e d -> \ o -> o.1 ;
    cAll p e k -> \ o -> o.1 ; cEx p e w d -> \ o -> o.1 } ;
  consistentD (A : DP.LO) (d : Dv (Lb A)) (o : OkD A d nilL) : W.Empty = noEmpty A (elim A d nilL o).1 (elim A d nilL o).2 ;
  ----------------------------------------------------------------------
  -- from pre-proofs (BetaProof) with a Brouwer bound to derivations
  dflt (A : DP.LO) : Clo A = (atF true zero,nilL) ;
  cOf (A : DP.LO) (i : W.N) (G : Seq A) : Clo A = B.outR A (dflt A) (B.getM A i G) ;
  ruleD (A : DP.LO) (G : Seq A) : B.Rule A -> (Lb A -> Dv (Lb A)) -> Dv (Lb A) = split {
    axR i -> \ ch -> dAx (atB (cOf A i G).1) (atK (cOf A i G).1) (cOf A i G).2 ;
    andR i -> \ ch -> dAnd (leftF (cOf A i G).1) (rightF (cOf A i G).1) (cOf A i G).2 (ch (B.lab0 A)) (ch (B.lab1 A)) ;
    orR i -> \ ch -> dOr (leftF (cOf A i G).1) (rightF (cOf A i G).1) (cOf A i G).2 (ch (B.lab0 A)) ;
    allR i -> \ ch -> dAll (leftF (cOf A i G).1) (cOf A i G).2 ch ;
    exR i w -> \ ch -> dEx (leftF (cOf A i G).1) (cOf A i G).2 w (ch (B.lab0 A)) ;
    cutR f e -> \ ch -> dCut f e (ch (B.lab0 A)) (ch (B.lab1 A)) } ;

  -- membership in appended sequents
  app (A : DP.LO) (G S : Seq A) : Seq A = B.app A G S ;
  memApp (A : DP.LO) (S : Seq A) (x : Clo A) : (G : Seq A) -> Mem A x (app A G S) -> W.Or (Mem A x G) (Mem A x S) = split {
    nilL -> \ m -> inr m ;
    consL c cs | r -> \ m -> CF.or-elim (Id (Clo A) c x) (Mem A x (app A cs S)) (W.Or (Mem A x (consL c cs)) (Mem A x S))
      (\ e -> inl (inl e)) (\ m' -> CF.or-elim (Mem A x cs) (Mem A x S) (W.Or (Mem A x (consL c cs)) (Mem A x S))
        (\ m1 -> inl (inr m1)) (\ m2 -> inr m2) (r m')) m } ;
  memAppL (A : DP.LO) (H : Seq A) (x : Clo A) : (S : Seq A) -> Mem A x S -> Mem A x (app A S H) = split {
    nilL -> \ m -> CF.efq (Mem A x H) m ;
    consL c cs | r -> \ m -> CF.or-elim (Id (Clo A) c x) (Mem A x cs) (Mem A x (app A (consL c cs) H)) (\ e -> inl e) (\ m' -> inr (r m')) m } ;
  memAppR (A : DP.LO) (H : Seq A) (x : Clo A) : (S : Seq A) -> Mem A x H -> Mem A x (app A S H) = split {
    nilL -> \ m -> m ;
    consL c cs | r -> \ m -> inr (r m) } ;
  subStep (A : DP.LO) (G H S S' : Seq A) (s : Sub A G H) (t : Sub A S S') : Sub A (app A G S) (app A S' H) =
    \ x m -> CF.or-elim (Mem A x G) (Mem A x S) (Mem A x (app A S' H))
      (\ m1 -> memAppR A H x S' (s x m1)) (\ m2 -> memAppL A H x S' (t x m2)) (memApp A S x G m) ;
  subEq (A : DP.LO) (S S' : Seq A) (e : Id (Seq A) S S') : Sub A S S' =
    \ x m -> PL.subst (Seq A) (\ z -> Mem A x z) S S' e m ;
  hSub (A : DP.LO) (G H : Seq A) (s : Sub A G H) (o : B.OC A) (c : Clo A) (eo : Id (B.OC A) o (inr c))
    (F : B.OC A -> Seq A) (S' : Seq A) (ef : Id (Seq A) (F (inr c)) S') : Sub A (app A G (F o)) (app A S' H) =
    subStep A G H (F o) S' s (subEq A (F o) S' (PL.trans (Seq A) (F o) (F (inr c)) S' (PL.ap (B.OC A) (Seq A) F o (inr c) eo) ef)) ;
  getMem (A : DP.LO) : (i : W.N) (G : Seq A) (c : Clo A) -> Id (B.OC A) (B.getM A i G) (inr c) -> Mem A c G = split {
    zero -> split {
      nilL -> \ c e -> W.absurdB (Mem A c nilL) (PL.ap (B.OC A) W.Bool (BP.isInr W.Unit (Clo A)) (inl tt) (inr c) e) ;
      consL c' cs -> \ c e -> inl (PL.ap (B.OC A) (Clo A) (B.outR A c') (inr c') (inr c) e) } ;
    suc i | r -> split {
      nilL -> \ c e -> W.absurdB (Mem A c nilL) (PL.ap (B.OC A) W.Bool (BP.isInr W.Unit (Clo A)) (inl tt) (inr c) e) ;
      consL c' cs -> \ c e -> inr (r cs c e) } } ;
  memP (A : DP.LO) (G H : Seq A) (s : Sub A G H) (c : Clo A) (f' : BP.Form) (eta : Id BP.Form f' c.1) (m : Mem A c G) : Mem A (f',c.2) H =
    s (f',c.2) (PL.subst (Clo A) (\ z -> Mem A z G) c (f',c.2)
      (PL.ap BP.Form (Clo A) (\ g -> (g,c.2)) c.1 f' (PL.sym BP.Form f' c.1 eta)) m) ;
  -- applicable rules have their principal closure
  inrOf (A : DP.LO) (t : BP.Form -> W.Bool) : (o : B.OC A) -> Id W.Bool (B.isO A t o) true ->
      Id (B.OC A) o (inr (B.outR A (dflt A) o)) * Id W.Bool (t (B.outR A (dflt A) o).1) true = split {
    inl u -> \ h -> W.absurdB (Id (B.OC A) (inl u) (inr (dflt A)) * Id W.Bool (t (dflt A).1) true) h ;
    inr c -> \ h -> (refl (inr c),h) } ;
  inrAx (A : DP.LO) : (o : B.OC A) -> Id W.Bool (B.isAx A o) true ->
      Id (B.OC A) o (inr (B.outR A (dflt A) o)) * Id W.Bool (B.isAxF A (B.outR A (dflt A) o).1 (B.outR A (dflt A) o).2) true = split {
    inl u -> \ h -> W.absurdB (Id (B.OC A) (inl u) (inr (dflt A)) * Id W.Bool (B.isAxF A (dflt A).1 (dflt A).2) true) h ;
    inr c -> \ h -> (refl (inr c),h) } ;
  eqBoS : (v b : W.Bool) -> Id W.Bool (BP.eqBo v b) true -> Id W.Bool v b = split {
    false -> split { false -> \ h -> refl false ; true -> \ h -> W.absurdB (Id W.Bool false true) h } ;
    true -> split { false -> \ h -> W.absurdB (Id W.Bool true false) h ; true -> \ h -> refl true } } ;
  axShape (A : DP.LO) : (f : BP.Form) (e : LT.LL A) -> Id W.Bool (B.isAxF A f e) true ->
      Id BP.Form (atF (atB f) (atK f)) f * Id W.Bool (ev A (atK f) e) (atB f) = split {
    atF b k -> \ e h -> (refl (atF b k),eqBoS (ev A k e) b h) ;
    andF p q -> \ e h -> W.absurdB (Id BP.Form (atF true zero) (andF p q) * Id W.Bool (ev A zero e) true) h ;
    orF p q -> \ e h -> W.absurdB (Id BP.Form (atF true zero) (orF p q) * Id W.Bool (ev A zero e) true) h ;
    allF p -> \ e h -> W.absurdB (Id BP.Form (atF true zero) (allF p) * Id W.Bool (ev A zero e) true) h ;
    exF p -> \ e h -> W.absurdB (Id BP.Form (atF true zero) (exF p) * Id W.Bool (ev A zero e) true) h } ;
  -- shapes and added closures
  etaAnd : (f : BP.Form) -> Id W.Bool (BP.isAndF f) true -> Id BP.Form (andF (leftF f) (rightF f)) f = split {
    atF b k -> \ h -> W.absurdB (Id BP.Form (andF (atF b k) (atF b k)) (atF b k)) h ; andF p q -> \ h -> refl (andF p q) ;
    orF p q -> \ h -> W.absurdB (Id BP.Form (andF p q) (orF p q)) h ; allF p -> \ h -> W.absurdB (Id BP.Form (andF p p) (allF p)) h ;
    exF p -> \ h -> W.absurdB (Id BP.Form (andF p p) (exF p)) h } ;
  etaOr : (f : BP.Form) -> Id W.Bool (BP.isOrF f) true -> Id BP.Form (orF (leftF f) (rightF f)) f = split {
    atF b k -> \ h -> W.absurdB (Id BP.Form (orF (atF b k) (atF b k)) (atF b k)) h ; andF p q -> \ h -> W.absurdB (Id BP.Form (orF p q) (andF p q)) h ;
    orF p q -> \ h -> refl (orF p q) ; allF p -> \ h -> W.absurdB (Id BP.Form (orF p p) (allF p)) h ;
    exF p -> \ h -> W.absurdB (Id BP.Form (orF p p) (exF p)) h } ;
  etaAll : (f : BP.Form) -> Id W.Bool (BP.isAllF f) true -> Id BP.Form (allF (leftF f)) f = split {
    atF b k -> \ h -> W.absurdB (Id BP.Form (allF (atF b k)) (atF b k)) h ; andF p q -> \ h -> W.absurdB (Id BP.Form (allF p) (andF p q)) h ;
    orF p q -> \ h -> W.absurdB (Id BP.Form (allF p) (orF p q)) h ; allF p -> \ h -> refl (allF p) ;
    exF p -> \ h -> W.absurdB (Id BP.Form (allF p) (exF p)) h } ;
  etaEx : (f : BP.Form) -> Id W.Bool (BP.isExF f) true -> Id BP.Form (exF (leftF f)) f = split {
    atF b k -> \ h -> W.absurdB (Id BP.Form (exF (atF b k)) (atF b k)) h ; andF p q -> \ h -> W.absurdB (Id BP.Form (exF p) (andF p q)) h ;
    orF p q -> \ h -> W.absurdB (Id BP.Form (exF p) (orF p q)) h ; allF p -> \ h -> W.absurdB (Id BP.Form (exF p) (allF p)) h ;
    exF p -> \ h -> refl (exF p) } ;
  addAndE (A : DP.LO) (a : Lb A) : (f : BP.Form) (e : LT.LL A) -> Id W.Bool (BP.isAndF f) true ->
      Id (Seq A) (B.addAndF A f e a) (consL (BP.pickF a.1 (leftF f) (rightF f),e) nilL) = split {
    atF b k -> \ e h -> W.absurdB (Id (Seq A) nilL (consL (BP.pickF a.1 (atF b k) (atF b k),e) nilL)) h ;
    andF p q -> \ e h -> refl (consL (BP.pickF a.1 p q,e) nilL) ;
    orF p q -> \ e h -> W.absurdB (Id (Seq A) nilL (consL (BP.pickF a.1 p q,e) nilL)) h ;
    allF p -> \ e h -> W.absurdB (Id (Seq A) nilL (consL (BP.pickF a.1 p p,e) nilL)) h ;
    exF p -> \ e h -> W.absurdB (Id (Seq A) nilL (consL (BP.pickF a.1 p p,e) nilL)) h } ;
  addOrE (A : DP.LO) : (f : BP.Form) (e : LT.LL A) -> Id W.Bool (BP.isOrF f) true ->
      Id (Seq A) (B.addOrF A f e) (consL (leftF f,e) (consL (rightF f,e) nilL)) = split {
    atF b k -> \ e h -> W.absurdB (Id (Seq A) nilL (consL (atF b k,e) (consL (atF b k,e) nilL))) h ;
    andF p q -> \ e h -> W.absurdB (Id (Seq A) nilL (consL (p,e) (consL (q,e) nilL))) h ;
    orF p q -> \ e h -> refl (consL (p,e) (consL (q,e) nilL)) ;
    allF p -> \ e h -> W.absurdB (Id (Seq A) nilL (consL (p,e) (consL (p,e) nilL))) h ;
    exF p -> \ e h -> W.absurdB (Id (Seq A) nilL (consL (p,e) (consL (p,e) nilL))) h } ;
  addAllE (A : DP.LO) (a : Lb A) : (f : BP.Form) (e : LT.LL A) -> Id W.Bool (BP.isAllF f) true ->
      Id (Seq A) (B.addAllF A f e a) (consL (leftF f,consL a e) nilL) = split {
    atF b k -> \ e h -> W.absurdB (Id (Seq A) nilL (consL (atF b k,consL a e) nilL)) h ;
    andF p q -> \ e h -> W.absurdB (Id (Seq A) nilL (consL (p,consL a e) nilL)) h ;
    orF p q -> \ e h -> W.absurdB (Id (Seq A) nilL (consL (p,consL a e) nilL)) h ;
    allF p -> \ e h -> refl (consL (p,consL a e) nilL) ;
    exF p -> \ e h -> W.absurdB (Id (Seq A) nilL (consL (p,consL a e) nilL)) h } ;
  addExE (A : DP.LO) (a : Lb A) : (f : BP.Form) (e : LT.LL A) -> Id W.Bool (BP.isExF f) true ->
      Id (Seq A) (B.addExF A f e a) (consL (leftF f,consL a e) nilL) = split {
    atF b k -> \ e h -> W.absurdB (Id (Seq A) nilL (consL (atF b k,consL a e) nilL)) h ;
    andF p q -> \ e h -> W.absurdB (Id (Seq A) nilL (consL (p,consL a e) nilL)) h ;
    orF p q -> \ e h -> W.absurdB (Id (Seq A) nilL (consL (p,consL a e) nilL)) h ;
    allF p -> \ e h -> W.absurdB (Id (Seq A) nilL (consL (p,consL a e) nilL)) h ;
    exF p -> \ e h -> refl (consL (p,consL a e) nilL) } ;

  -- every rule translates correctly, given correct premises
  CH (A : DP.LO) (G : Seq A) (r : B.Rule A) (ch : Lb A -> Dv (Lb A)) : U l =
    (a : Lb A) -> Id W.Bool (B.br A r a) true -> (H' : Seq A) -> Sub A (B.step A G r a) H' -> OkD A (ch a) H' ;
  module RuleOk (A : DP.LO) (G H : Seq A) (s : Sub A G H) (i : W.N) {
    c : Clo A = cOf A i G ;
    okAx (h : Id W.Bool (B.isAx A (B.getM A i G)) true) : OkD A (dAx (atB c.1) (atK c.1) c.2) H =
      (memP A G H s c (atF (atB c.1) (atK c.1)) (axShape A c.1 c.2 (inrAx A (B.getM A i G) h).2).1 (getMem A i G c (inrAx A (B.getM A i G) h).1),
       (axShape A c.1 c.2 (inrAx A (B.getM A i G) h).2).2) ;
    okAnd (h : Id W.Bool (B.isO A BP.isAndF (B.getM A i G)) true) (ch : Lb A -> Dv (Lb A)) (ih : CH A G (andR i) ch) :
        OkD A (dAnd (leftF c.1) (rightF c.1) c.2 (ch (B.lab0 A)) (ch (B.lab1 A))) H =
      (memP A G H s c (andF (leftF c.1) (rightF c.1)) (etaAnd c.1 (inrOf A BP.isAndF (B.getM A i G) h).2) (getMem A i G c (inrOf A BP.isAndF (B.getM A i G) h).1),
       (ih (B.lab0 A) (refl true) (consL (leftF c.1,c.2) H)
          (hSub A G H s (B.getM A i G) c (inrOf A BP.isAndF (B.getM A i G) h).1 (\ o -> B.addAnd A o (B.lab0 A))
            (consL (leftF c.1,c.2) nilL) (addAndE A (B.lab0 A) c.1 c.2 (inrOf A BP.isAndF (B.getM A i G) h).2)),
        ih (B.lab1 A) (refl true) (consL (rightF c.1,c.2) H)
          (hSub A G H s (B.getM A i G) c (inrOf A BP.isAndF (B.getM A i G) h).1 (\ o -> B.addAnd A o (B.lab1 A))
            (consL (rightF c.1,c.2) nilL) (addAndE A (B.lab1 A) c.1 c.2 (inrOf A BP.isAndF (B.getM A i G) h).2)))) ;
    okOr (h : Id W.Bool (B.isO A BP.isOrF (B.getM A i G)) true) (ch : Lb A -> Dv (Lb A)) (ih : CH A G (orR i) ch) :
        OkD A (dOr (leftF c.1) (rightF c.1) c.2 (ch (B.lab0 A))) H =
      (memP A G H s c (orF (leftF c.1) (rightF c.1)) (etaOr c.1 (inrOf A BP.isOrF (B.getM A i G) h).2) (getMem A i G c (inrOf A BP.isOrF (B.getM A i G) h).1),
       ih (B.lab0 A) (refl true) (consL (leftF c.1,c.2) (consL (rightF c.1,c.2) H))
         (hSub A G H s (B.getM A i G) c (inrOf A BP.isOrF (B.getM A i G) h).1 (B.addOr A)
           (consL (leftF c.1,c.2) (consL (rightF c.1,c.2) nilL)) (addOrE A c.1 c.2 (inrOf A BP.isOrF (B.getM A i G) h).2))) ;
    okAll (h : Id W.Bool (B.isO A BP.isAllF (B.getM A i G)) true) (ch : Lb A -> Dv (Lb A)) (ih : CH A G (allR i) ch) :
        OkD A (dAll (leftF c.1) c.2 ch) H =
      (memP A G H s c (allF (leftF c.1)) (etaAll c.1 (inrOf A BP.isAllF (B.getM A i G) h).2) (getMem A i G c (inrOf A BP.isAllF (B.getM A i G) h).1),
       \ x -> ih x (refl true) (consL (leftF c.1,consL x c.2) H)
         (hSub A G H s (B.getM A i G) c (inrOf A BP.isAllF (B.getM A i G) h).1 (\ o -> B.addAll A o x)
           (consL (leftF c.1,consL x c.2) nilL) (addAllE A x c.1 c.2 (inrOf A BP.isAllF (B.getM A i G) h).2))) ;
    okEx (w : Lb A) (h : Id W.Bool (B.isO A BP.isExF (B.getM A i G)) true) (ch : Lb A -> Dv (Lb A)) (ih : CH A G (exR i w) ch) :
        OkD A (dEx (leftF c.1) c.2 w (ch (B.lab0 A))) H =
      (memP A G H s c (exF (leftF c.1)) (etaEx c.1 (inrOf A BP.isExF (B.getM A i G) h).2) (getMem A i G c (inrOf A BP.isExF (B.getM A i G) h).1),
       ih (B.lab0 A) (refl true) (consL (leftF c.1,consL w c.2) H)
         (hSub A G H s (B.getM A i G) c (inrOf A BP.isExF (B.getM A i G) h).1 (\ o -> B.addEx A o w)
           (consL (leftF c.1,consL w c.2) nilL) (addExE A w c.1 c.2 (inrOf A BP.isExF (B.getM A i G) h).2))) ;
  } ;
  okRule (A : DP.LO) (G H : Seq A) (s : Sub A G H) : (r : B.Rule A) -> Id W.Bool (B.appl A G r) true ->
      (ch : Lb A -> Dv (Lb A)) -> CH A G r ch -> OkD A (ruleD A G r ch) H = split {
    axR i -> \ h ch ih -> RuleOk[A,G,H,s,i].okAx h ;
    andR i -> \ h ch ih -> RuleOk[A,G,H,s,i].okAnd h ch ih ;
    orR i -> \ h ch ih -> RuleOk[A,G,H,s,i].okOr h ch ih ;
    allR i -> \ h ch ih -> RuleOk[A,G,H,s,i].okAll h ch ih ;
    exR i w -> \ h ch ih -> RuleOk[A,G,H,s,i].okEx w h ch ih ;
    cutR f e -> \ h ch ih ->
      (ih (B.lab0 A) (refl true) (consL (f,e) H) (subStep A G H (consL (f,e) nilL) (consL (f,e) nilL) s (\ x m -> m)),
       ih (B.lab1 A) (refl true) (consL (BP.neg f,e) H) (subStep A G H (consL (BP.neg f,e) nilL) (consL (BP.neg f,e) nilL) s (\ x m -> m))) } ;

  module Tr (A : DP.LO) {
    module K = KT.KB[LT.Lab A] ;
    toDv : (b : K.BT) (R : B.Rl A) (G : Seq A) -> Dv (Lb A) = split {
      leaf -> \ R G -> dAx true zero nilL ;
      node f | r -> \ R G -> ruleD A G (R nilL) (\ a -> r a (B.shift A R a) (B.step A G (R nilL) a)) } ;
    toOk : (b : K.BT) (R : B.Rl A) (G : Seq A) -> K.Bnd b (B.tree A R G) -> B.LocOK A R G ->
        (H : Seq A) -> Sub A G H -> OkD A (toDv b R G) H = split {
      leaf -> \ R G hb lo H s -> BP.tf (OkD A (toDv leaf R G) H) (hb nilL) ;
      node f | r -> \ R G hb lo H s -> okRule A G H s (R nilL) (lo nilL (refl true))
        (\ a -> toDv (f a) (B.shift A R a) (B.step A G (R nilL) a))
        (\ a ha -> r a (B.shift A R a) (B.step A G (R nilL) a)
          (K.bnd-ext (f a) (K.sub (B.tree A R G) a) (B.tree A (B.shift A R a) (B.step A G (R nilL) a))
            (\ xs -> BP.andTrue (B.br A (R nilL) a) (B.inTree A xs (B.shift A R a) (B.step A G (R nilL) a)) ha) (hb a))
          (\ ys hv -> lo (consL a ys)
            (PL.trans W.Bool (B.inTree A (consL a ys) R G) (B.inTree A ys (B.shift A R a) (B.step A G (R nilL) a)) true
              (BP.andTrue (B.br A (R nilL) a) (B.inTree A ys (B.shift A R a) (B.step A G (R nilL) a)) ha) hv))) } ;
    -- a well-founded pre-proof has a cut-free derivation of its end sequent
    cutFree (R : B.Rl A) (G : Seq A) (w : B.WFP A R G) (lo : B.LocOK A R G) : Res A G =
      elim A (toDv w.1 R G) G (toOk w.1 R G w.2 lo G (\ x m -> m)) ;
  } ;
  -- POINTWISE CUT ELIMINATION: a beta-proof has, at every well-order, a
  -- cut-free derivation of its end sequent
  pointwise (G : (A : DP.LO) -> Seq A) (R : (A : DP.LO) -> B.Rl A) (lo : (A : DP.LO) -> B.LocOK A (R A) (G A))
    (c : B.Pre[G,R,lo].Correct) (A : DP.LO) (w : LW.WF A) : Res A (G A) = Tr[A].cutFree (R A) (G A) (c A w) (lo A) ;
} ;

-- Subptykes and images (catemb.pdf, linear-order case; PLAN-CATEMB-LO.md
-- step 5: Ptyx as a category of embeddings, part 1).
--
--   * mono: morphisms of ptykes are monomorphisms;
--   * a subptyx of P is a predicate S on the points of P which is a
--     proposition, preserved by every P(T) and reflected by every P(T);
--     SubPtyx makes it a ptyx with a cartesian inclusion into P;
--   * Image: the image of a morphism a : Q -> P is a subptyx (reflection
--     along any T is PtyxPull.pull, the pull-back property), and a is an
--     isomorphism onto it followed by the inclusion;
--   * intersections and unions of subptykes are subptykes.
level l ;
open Base ; open Prelude[l+] ; open ScottOrder[l] ;
module W = Dilator[l] ;
module CD = CatDil[l] ;
module DF = DilFinite[l] ;
module DP = DilPtyx[l] ;
module PM = PtyxMor[l] ;
module PF = PtyxFinite[l] ;
module PU = PtyxPull[l] ;
module PL = Prelude[l] ;
module TC = TruncationCombinators[l] ;

mono (P Q R : DP.Ptyx) (T : PM.Mor Q R) (S S' : PM.Mor P Q)
  (e : PM.MorEq P R (PM.compP P Q R S T) (PM.compP P Q R S' T)) : PM.MorEq P Q S S' =
  \ D y -> DP.map-inj (Q.F D) (R.F D) (T.1 D) ((S.1 D).1 y) ((S'.1 D).1 y) (e D y) ;

----------------------------------------------------------------------
-- subptykes

Pred (P : DP.Ptyx) : U l+ = (D : CD.Dil) -> (P.F D).car -> U l ;
SProp (P : DP.Ptyx) (S : Pred P) : U l+ = (D : CD.Dil) (y : (P.F D).car) -> PL.isProp (S D y) ;
Fwd (P : DP.Ptyx) (S : Pred P) : U l+ =
  (D E : CD.Dil) (T : CD.Mor D E) (y : (P.F D).car) -> S D y -> S E ((P.arr D E T).1 y) ;
Bwd (P : DP.Ptyx) (S : Pred P) : U l+ =
  (D E : CD.Dil) (T : CD.Mor D E) (y : (P.F D).car) -> S E ((P.arr D E T).1 y) -> S D y ;

module SubPtyx (P : DP.Ptyx) (S : Pred P) (sp : SProp P S) (fw : Fwd P S) (bw : Bwd P S) {
  Car (D : CD.Dil) : U l = (y : (P.F D).car) * S D y ;
  peq (D : CD.Dil) (p q : Car D) (e : Id (P.F D).car p.1 q.1) : Id (Car D) p q =
    PL.Sigma-eq (P.F D).car (S D) p.1 q.1 p.2 q.2 e (sp D q.1) ;
  F (D : CD.Dil) : DP.LO = new DP.LO[car := Car D, cmp := \ p q -> (P.F D).cmp p.1 q.1,
    ceq := \ p q h -> peq D p q ((P.F D).ceq p.1 q.1 h),
    crefl := \ p -> (P.F D).crefl p.1, cflip := \ p q -> (P.F D).cflip p.1 q.1,
    ctrans := \ p q r -> (P.F D).ctrans p.1 q.1 r.1] ;
  arr (D E : CD.Dil) (T : CD.Mor D E) : DP.Map (F D) (F E) =
    (\ p -> ((P.arr D E T).1 p.1,fw D E T p.1 p.2),\ p q -> (P.arr D E T).2 p.1 q.1) ;
  arr-id (D : CD.Dil) (p : Car D) : Id (Car D) ((arr D D (CD.idM D)).1 p) p =
    peq D ((arr D D (CD.idM D)).1 p) p (P.arr-id D p.1) ;
  arr-comp (D E G : CD.Dil) (S0 : CD.Mor D E) (T : CD.Mor E G) (p : Car D) :
      Id (Car G) ((arr E G T).1 ((arr D E S0).1 p)) ((arr D G (CD.compM D E G S0 T)).1 p) =
    peq G ((arr E G T).1 ((arr D E S0).1 p)) ((arr D G (CD.compM D E G S0 T)).1 p) (P.arr-comp D E G S0 T p.1) ;
  -- a support in P of the underlying point is a support in the subptyx
  lift (D : CD.Dil) (p : Car D) (c : DP.SubSet) (s : PM.Supp P D p.1 c) :
      (z : Car (DF.On[D].Sub[c].dil)) * Id (Car D) ((arr (DF.On[D].Sub[c].dil) D (DF.On[D].Sub[c].inc)).1 z) p =
    ((s.1,bw (DF.On[D].Sub[c].dil) D (DF.On[D].Sub[c].inc) s.1
        (PL.subst (P.F D).car (S D) p.1 ((P.arr (DF.On[D].Sub[c].dil) D (DF.On[D].Sub[c].inc)).1 s.1)
          (PL.sym (P.F D).car ((P.arr (DF.On[D].Sub[c].dil) D (DF.On[D].Sub[c].inc)).1 s.1) p.1 s.2) p.2)),
     peq D ((arr (DF.On[D].Sub[c].dil) D (DF.On[D].Sub[c].inc)).1
        (s.1,bw (DF.On[D].Sub[c].dil) D (DF.On[D].Sub[c].inc) s.1
          (PL.subst (P.F D).car (S D) p.1 ((P.arr (DF.On[D].Sub[c].dil) D (DF.On[D].Sub[c].inc)).1 s.1)
            (PL.sym (P.F D).car ((P.arr (DF.On[D].Sub[c].dil) D (DF.On[D].Sub[c].inc)).1 s.1) p.1 s.2) p.2))) p s.2) ;
  drop (D : CD.Dil) (p : Car D) (c : DP.SubSet)
    (s : (z : Car (DF.On[D].Sub[c].dil)) * Id (Car D) ((arr (DF.On[D].Sub[c].dil) D (DF.On[D].Sub[c].inc)).1 z) p) :
      PM.Supp P D p.1 c =
    (s.1.1,PL.ap (Car D) (P.F D).car (\ q -> q.1) ((arr (DF.On[D].Sub[c].dil) D (DF.On[D].Sub[c].inc)).1 s.1) p s.2) ;
  support (D : CD.Dil) (p : Car D) :
      Ex ((K : W.N) * ((z : Car (DF.On[D].Trunc[K].dil)) * Id (Car D) ((arr (DF.On[D].Trunc[K].dil) D (DF.On[D].Trunc[K].inc)).1 z) p)) =
    TC.map (PF.Wit P D p.1)
      ((K : W.N) * ((z : Car (DF.On[D].Trunc[K].dil)) * Id (Car D) ((arr (DF.On[D].Trunc[K].dil) D (DF.On[D].Trunc[K].inc)).1 z) p))
      (\ w -> (w.1,lift D p (DF.On[D].lev w.1) w.2)) (P.support D p.1) ;
  meet (D : CD.Dil) (p : Car D) (c c' : DP.SubSet)
    (s : (z : Car (DF.On[D].Sub[c].dil)) * Id (Car D) ((arr (DF.On[D].Sub[c].dil) D (DF.On[D].Sub[c].inc)).1 z) p)
    (s' : (z : Car (DF.On[D].Sub[c'].dil)) * Id (Car D) ((arr (DF.On[D].Sub[c'].dil) D (DF.On[D].Sub[c'].inc)).1 z) p) :
      (z : Car (DF.On[D].Sub[DF.On[D].meet c c'].dil)) *
        Id (Car D) ((arr (DF.On[D].Sub[DF.On[D].meet c c'].dil) D (DF.On[D].Sub[DF.On[D].meet c c'].inc)).1 z) p =
    lift D p (DF.On[D].meet c c') (P.meet D p.1 c c' (drop D p c s) (drop D p c' s')) ;
  ptyx : DP.Ptyx = new DP.Ptyx[F := F, arr := arr, arr-id := arr-id, arr-comp := arr-comp, support := support, meet := meet] ;
  -- the inclusion is a (cartesian) morphism
  inc : PM.Mor ptyx P =
    (\ D -> (\ p -> p.1,\ p q -> refl ((P.F D).cmp p.1 q.1)),
     (\ D E T p -> refl ((P.arr D E T).1 p.1),\ D p c s -> lift D p c s)) ;
} ;

----------------------------------------------------------------------
-- the image of a morphism

module Image (Q P : DP.Ptyx) (a : PM.Mor Q P) {
  Fib (D : CD.Dil) (y : (P.F D).car) : U l = (x : (Q.F D).car) * Id (P.F D).car ((a.1 D).1 x) y ;
  fib-prop (D : CD.Dil) (y : (P.F D).car) : PL.isProp (Fib D y) = \ u v ->
    PL.Sigma-eq (Q.F D).car (\ x -> Id (P.F D).car ((a.1 D).1 x) y) u.1 v.1 u.2 v.2
      (DP.map-inj (Q.F D) (P.F D) (a.1 D) u.1 v.1
        (PL.trans (P.F D).car ((a.1 D).1 u.1) y ((a.1 D).1 v.1) u.2 (PL.sym (P.F D).car ((a.1 D).1 v.1) y v.2)))
      (PF.lo-set (P.F D) ((a.1 D).1 v.1) y) ;
  S (D : CD.Dil) (y : (P.F D).car) : U l = Ex (Fib D y) ;
  fw : Fwd P S = \ D E T y ->
    TC.map (Fib D y) (Fib E ((P.arr D E T).1 y))
      (\ u -> ((Q.arr D E T).1 u.1,
        PL.trans (P.F E).car ((a.1 E).1 ((Q.arr D E T).1 u.1)) ((P.arr D E T).1 ((a.1 D).1 u.1)) ((P.arr D E T).1 y)
          (PL.sym (P.F E).car ((P.arr D E T).1 ((a.1 D).1 u.1)) ((a.1 E).1 ((Q.arr D E T).1 u.1)) (a.2.1 D E T u.1))
          (PL.ap (P.F D).car (P.F E).car (P.arr D E T).1 ((a.1 D).1 u.1) y u.2))) ;
  -- reflection along T is the pull-back property of a
  module Bw (D E : CD.Dil) (T : CD.Mor D E) (y : (P.F D).car) (u : Fib E ((P.arr D E T).1 y)) {
    pb : (p : (Q.F D).car) * Id (Q.F E).car ((Q.arr D E T).1 p) u.1 =
      PU.pull Q P a D E T u.1 y (PL.sym (P.F E).car ((a.1 E).1 u.1) ((P.arr D E T).1 y) u.2) ;
    result : Fib D y =
      (pb.1,DP.map-inj (P.F D) (P.F E) (P.arr D E T) ((a.1 D).1 pb.1) y
        (PL.trans (P.F E).car ((P.arr D E T).1 ((a.1 D).1 pb.1)) ((a.1 E).1 ((Q.arr D E T).1 pb.1)) ((P.arr D E T).1 y)
          (a.2.1 D E T pb.1)
          (PL.trans (P.F E).car ((a.1 E).1 ((Q.arr D E T).1 pb.1)) ((a.1 E).1 u.1) ((P.arr D E T).1 y)
            (PL.ap (Q.F E).car (P.F E).car (a.1 E).1 ((Q.arr D E T).1 pb.1) u.1 pb.2)
            u.2))) ;
  } ;
  bw : Bwd P S = \ D E T y -> TC.map (Fib E ((P.arr D E T).1 y)) (Fib D y) (\ u -> Bw[D,E,T,y,u].result) ;
  module SP = SubPtyx[P,S,\ D y -> prop (Fib D y),fw,bw] ;
  im : DP.Ptyx = SP.ptyx ;
  -- a = inc . m with m an isomorphism Q ~ im
  mf (D : CD.Dil) (x : (Q.F D).car) : SP.Car D = ((a.1 D).1 x,inc (Fib D ((a.1 D).1 x)) (x,refl ((a.1 D).1 x))) ;
  m : PM.Mor Q im =
    (\ D -> (mf D,\ x x' -> (a.1 D).2 x x'),
     (\ D E T x -> SP.peq E ((SP.arr D E T).1 (mf D x)) (mf E ((Q.arr D E T).1 x)) (a.2.1 D E T x),
      \ D x c s -> a.2.2 D x c (SP.drop D (mf D x) c s))) ;
  tri : PM.MorEq Q P (PM.compP Q im P m SP.inc) a = \ D x -> refl ((a.1 D).1 x) ;
  get (D : CD.Dil) (p : SP.Car D) : Fib D p.1 = TC.rec (Fib D p.1) @l (Fib D p.1) (fib-prop D p.1) (\ u -> u) p.2 ;
  minv (D : CD.Dil) (p : SP.Car D) : (Q.F D).car = (get D p).1 ;
  m-minv (D : CD.Dil) (p : SP.Car D) : Id (SP.Car D) (mf D (minv D p)) p = SP.peq D (mf D (minv D p)) p (get D p).2 ;
  minv-m (D : CD.Dil) (x : (Q.F D).car) : Id (Q.F D).car (minv D (mf D x)) x =
    DP.map-inj (Q.F D) (P.F D) (a.1 D) (minv D (mf D x)) x (get D (mf D x)).2 ;
} ;

----------------------------------------------------------------------
-- intersections and unions of subptykes

module Inter (P : DP.Ptyx) (S : Pred P) (sp : SProp P S) (fw : Fwd P S) (bw : Bwd P S)
  (S' : Pred P) (sp' : SProp P S') (fw' : Fwd P S') (bw' : Bwd P S') {
  I : Pred P = \ D y -> S D y * S' D y ;
  ip : SProp P I = \ D y -> PL.isProp-Sigma (S D y) (\ _ -> S' D y) (sp D y) (\ _ -> sp' D y) ;
  ifw : Fwd P I = \ D E T y h -> (fw D E T y h.1,fw' D E T y h.2) ;
  ibw : Bwd P I = \ D E T y h -> (bw D E T y h.1,bw' D E T y h.2) ;
} ;

orMap (A B A' B' : U l) (f : A -> A') (g : B -> B') : W.Or A B -> W.Or A' B' = split {
  inl x -> inl (f x) ;
  inr y -> inr (g y) } ;

module Union (P : DP.Ptyx) (S : Pred P) (fw : Fwd P S) (bw : Bwd P S)
  (S' : Pred P) (fw' : Fwd P S') (bw' : Bwd P S') {
  J : Pred P = \ D y -> Ex (W.Or (S D y) (S' D y)) ;
  jp : SProp P J = \ D y -> prop (W.Or (S D y) (S' D y)) ;
  jfw : Fwd P J = \ D E T y ->
    TC.map (W.Or (S D y) (S' D y)) (W.Or (S E ((P.arr D E T).1 y)) (S' E ((P.arr D E T).1 y)))
      (orMap (S D y) (S' D y) (S E ((P.arr D E T).1 y)) (S' E ((P.arr D E T).1 y)) (fw D E T y) (fw' D E T y)) ;
  jbw : Bwd P J = \ D E T y ->
    TC.map (W.Or (S E ((P.arr D E T).1 y)) (S' E ((P.arr D E T).1 y))) (W.Or (S D y) (S' D y))
      (orMap (S E ((P.arr D E T).1 y)) (S' E ((P.arr D E T).1 y)) (S D y) (S' D y) (bw D E T y) (bw' D E T y)) ;
  left (D : CD.Dil) (y : (P.F D).car) (h : S D y) : J D y = inc (W.Or (S D y) (S' D y)) (inl h) ;
  right (D : CD.Dil) (y : (P.F D).car) (h : S' D y) : J D y = inc (W.Or (S D y) (S' D y)) (inr h) ;
} ;

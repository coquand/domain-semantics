-- The one-point Scott domain is initial in the unpresented EP category.
level l ;
open Base ; open Prelude[l+] ;
module SO = ScottDomainObjects[l] ;
module DM = ScottDomainMaps[l] ;
module EP = ScottDomainCategories[l].EmbeddingProjection ;
module K = CategoryInitialChain[l++,l+] ;
terminal : SO.Domain = SO.from-presented ScottTerminal[l].scott ;

initial-pair (D : SO.Domain) : EP.Between[terminal,D].Pair =
  (((\ _ -> D.bottom,
      (\ x y h -> D.order.reflexive D.bottom,
       \ I x d z h -> D.bottom-least z)),
    (\ _ -> tt,(\ x y h -> tt,\ I x d z h -> tt))),
   (\ x -> ScottTerminal[l].order.antisymmetric tt x tt tt,
    D.bottom-least)) ;

unique (D : SO.Domain) (q : EP.Between[terminal,D].Pair) :
  Id (EP.Between[terminal,D].Pair) q (initial-pair D) =
  EP.Between[terminal,D].equal q (initial-pair D)
    (DM.Between[terminal,D].equal q.1.1 (initial-pair D).1.1
      (\ a -> D.order.antisymmetric (q.1.1.1 a) D.bottom
        (ScottDomainCategories[l].le-replace D.order
          (q.1.1.1 (q.1.2.1 D.bottom)) (q.1.1.1 a)
          D.bottom D.bottom
          (ap ScottTerminal[l].order.carrier D.order.carrier q.1.1.1
            (q.1.2.1 D.bottom) a
            (ScottTerminal[l].order.antisymmetric
              (q.1.2.1 D.bottom) a tt tt))
          (refl D.bottom) (q.2.2 D.bottom))
        (D.bottom-least (q.1.1.1 a))))
    (DM.Between[D,terminal].equal q.1.2 (initial-pair D).1.2
      (\ y -> ScottTerminal[l].order.antisymmetric
        (q.1.2.1 y) tt tt tt)) ;

initial : K.Initial[EP.pre] = new K.Initial[EP.pre,
  object := terminal,arrow := initial-pair,unique := unique] ;

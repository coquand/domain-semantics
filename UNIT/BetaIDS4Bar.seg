-- PLAN-ID1, S6 for Part 3's bar predicate.  For a decidable G and a
-- decidable child relation ch on (codes of) histories, the operator
--     phi(X, s) = G(s) or forall t (not ch(s,t) or X(t))
-- (atom 0 = G(env 0), atom 1 = ch(env 1, env 0); the stage at position 1,
-- read at position 2 under t).
--
-- ORDINARY stages B^lambda(s) = Sigma mu < lambda. phi(B^mu)(s) do NOT give
-- a split model directly: CondR for the hereditary clause needs, from
-- not B^lambda(s), not not exists t (ch(s,t) & not B^mu(t)), i.e. the
-- double-negation shift over children.  STABLE stages
--     J^lambda(s) = not not Sigma mu < lambda. phi(J^mu)(s)
-- do: J^mu(t) is not-not-stable.  This file builds the split model on any
-- well-order (J at stages; negative Phi-bar = J^top; positive Phi-bar = J
-- after all of A), proves CondR and CondL, relates J and B (B -> J; J ->
-- not not B given the double-negation shift), checks the example
-- G = nonempty, and states the stage bound for the bar predicate.
level l ;
open Base ; open Prelude[l+] ; open ScottOrder[l] ;
module W = Dilator[l] ;
module DP = DilPtyx[l] ;
module CF = CatEmbFin[l] ;
module PL = Prelude[l] ;
module LT = LabTree[l] ;
module LW = LOWF[l] ;
module BP = BetaProof[l] ;
module BI = BetaID[l] ;
module BO = BetaIDCfOps[l] ;
module S4 = BetaIDS4[l] ;
module SG = BetaIDS4Stage[l] ;

module Bar (g : W.N -> W.Bool) (ch : W.N -> W.N -> W.Bool) {
  -- the atoms read the numbers of the environment
  hd : W.List W.N -> W.N = split { nilL -> zero ; consL n ns -> n } ;
  tl : W.List W.N -> W.List W.N = split { nilL -> nilL ; consL n ns -> ns } ;
  evL1 : W.N -> W.List W.N -> W.Bool = split { zero -> \ ns -> ch (hd (tl ns)) (hd ns) ; suc j -> \ ns -> false } ;
  evL : W.N -> W.List W.N -> W.Bool = split { zero -> \ ns -> g (hd ns) ; suc k -> evL1 k } ;
  ev (A : DP.LO) (k : W.N) (e : LT.LL A) : W.Bool = evL k (S4.fstL A e) ;
  evN : S4.EvN ev = \ A B k e e' h -> PL.ap (W.List W.N) W.Bool (evL k) (S4.fstL A e) (S4.fstL B e') h ;
  phi : BI.Form = orF (atF true zero) (allF (orF (atF false (suc zero)) (xF true (suc (suc zero)) zero))) ;
  hPos : Id W.Bool (BO.posX phi zero) true = refl true ;
  -- the operator on predicates
  Phi (X : W.N -> U l) (s : W.N) : U l = W.Or (Id W.Bool (g s) true) ((t : W.N) -> Id W.Bool (ch s t) true -> X t) ;
  phiMon (X X' : W.N -> U l) (m : (s : W.N) -> X s -> X' s) (s : W.N) : Phi X s -> Phi X' s = split {
    inl h -> inl h ; inr k -> inr (\ t c -> m t (k t c)) } ;

  module Model (A : DP.LO) (top : A.car) (wA : LW.WF A) {
    module I = BI.ID[ev,phi] ;
    module Ac = W.Acc[A.car,W.ltO A.car A.cmp] ;
    Lt (x y : A.car) : U l = Ac.Lt x y ;
    -- stable stages, by recursion on accessibility trees
    Jn : Ac.AT -> W.N -> U l = split {
      node x0 f | r -> \ s -> BI.Not (BI.Not ((mu : A.car) * ((h : Lt mu x0) * Phi (r mu h) s))) } ;
    -- ordinary stages
    Bn : Ac.AT -> W.N -> U l = split {
      node x0 f | r -> \ s -> (mu : A.car) * ((h : Lt mu x0) * Phi (r mu h) s) } ;
    J (la : A.car) (s : W.N) : U l = Jn (wA la).1 s ;
    B (la : A.car) (s : W.N) : U l = Bn (wA la).1 s ;
    -- the tree does not matter
    jIrr2 (x0 : A.car) (f : (y : A.car) -> Lt y x0 -> Ac.AT)
        (r : (y : A.car) (h : Lt y x0) (x : A.car) -> Ac.Good (f y h) x -> (t' : Ac.AT) -> Ac.Good t' x -> (s : W.N) -> Jn (f y h) s -> Jn t' s)
        (x : A.car) (g0 : Ac.Good (node x0 f) x) : (t' : Ac.AT) -> Ac.Good t' x -> (s : W.N) -> Jn (node x0 f) s -> Jn t' s = split {
      node x1 f' -> \ g1 s j k -> j (\ z -> k (z.1,
        (PL.subst A.car (\ w -> Lt z.1 w) x0 x1 (PL.trans A.car x0 x x1 g0.1 (PL.sym A.car x1 x g1.1)) z.2.1,
         phiMon (Jn (f z.1 z.2.1)) (Jn (f' z.1 (PL.subst A.car (\ w -> Lt z.1 w) x0 x1 (PL.trans A.car x0 x x1 g0.1 (PL.sym A.car x1 x g1.1)) z.2.1)))
           (\ s' -> r z.1 z.2.1 z.1 (g0.2 z.1 z.2.1) (f' z.1 (PL.subst A.car (\ w -> Lt z.1 w) x0 x1 (PL.trans A.car x0 x x1 g0.1 (PL.sym A.car x1 x g1.1)) z.2.1))
             (g1.2 z.1 (PL.subst A.car (\ w -> Lt z.1 w) x0 x1 (PL.trans A.car x0 x x1 g0.1 (PL.sym A.car x1 x g1.1)) z.2.1)) s')
           s z.2.2))) } ;
    jIrr : (t : Ac.AT) (x : A.car) -> Ac.Good t x -> (t' : Ac.AT) -> Ac.Good t' x -> (s : W.N) -> Jn t s -> Jn t' s = split {
      node x0 f | r -> \ x g0 -> jIrr2 x0 f r x g0 } ;
    -- unfolding J
    jOutT : (t : Ac.AT) (la : A.car) -> Ac.Good t la -> (s : W.N) -> Jn t s ->
        BI.Not (BI.Not ((mu : A.car) * ((h : Lt mu la) * Phi (J mu) s))) = split {
      node x0 f -> \ la g0 s j k -> j (\ z -> k (z.1,
        (PL.subst A.car (\ w -> Lt z.1 w) x0 la g0.1 z.2.1,
         phiMon (Jn (f z.1 z.2.1)) (J z.1) (\ s' -> jIrr (f z.1 z.2.1) z.1 (g0.2 z.1 z.2.1) (wA z.1).1 (wA z.1).2 s') s z.2.2))) } ;
    jInT : (t : Ac.AT) (la : A.car) -> Ac.Good t la -> (s : W.N) ->
        BI.Not (BI.Not ((mu : A.car) * ((h : Lt mu la) * Phi (J mu) s))) -> Jn t s = split {
      node x0 f -> \ la g0 s j k -> j (\ z -> k (z.1,
        (PL.subst A.car (\ w -> Lt z.1 w) la x0 (PL.sym A.car x0 la g0.1) z.2.1,
         phiMon (J z.1) (Jn (f z.1 (PL.subst A.car (\ w -> Lt z.1 w) la x0 (PL.sym A.car x0 la g0.1) z.2.1)))
           (\ s' -> jIrr (wA z.1).1 z.1 (wA z.1).2 (f z.1 (PL.subst A.car (\ w -> Lt z.1 w) la x0 (PL.sym A.car x0 la g0.1) z.2.1))
             (g0.2 z.1 (PL.subst A.car (\ w -> Lt z.1 w) la x0 (PL.sym A.car x0 la g0.1) z.2.1)) s') s z.2.2))) } ;
    jOut (la : A.car) (s : W.N) (j : J la s) : BI.Not (BI.Not ((mu : A.car) * ((h : Lt mu la) * Phi (J mu) s))) = jOutT (wA la).1 la (wA la).2 s j ;
    jIn (la : A.car) (s : W.N) (j : BI.Not (BI.Not ((mu : A.car) * ((h : Lt mu la) * Phi (J mu) s)))) : J la s = jInT (wA la).1 la (wA la).2 s j ;
    jStab (la : A.car) (s : W.N) (h : BI.Not (BI.Not (J la s))) : J la s =
      jIn la s (\ k -> h (\ j -> jOut la s j k)) ;
    -- J after all of A (positive Phi-bar)
    Jall (s : W.N) : U l = BI.Not (BI.Not ((mu : A.car) * Phi (J mu) s)) ;
    -- J is monotone in the stage
    ltTr (x y z : A.car) (h : Lt x y) (h' : Lt y z) : Lt x z =
      PL.ap W.O3 W.Bool W.isLt (A.cmp x z) lt (A.ctrans x y z (W.isLt-sound (A.cmp x y) h) (W.isLt-sound (A.cmp y z) h')) ;
    jMon (mu la : A.car) (h : Lt mu la) (t : W.N) (j : J mu t) : J la t =
      jIn la t (\ k -> jOut mu t j (\ z -> k (z.1,(ltTr z.1 mu la z.2.1 h,z.2.2)))) ;
    -- THE DIRECT PROOF: for G monotone along children, J^lambda(s) -> J^lambda(t)
    -- for every child t of s, at the SAME stage (good case: monotonicity of
    -- G; hereditary case: J^mu(t) with mu < lambda, then jMon)
    module Mono (mono : (s t : W.N) -> Id W.Bool (ch s t) true -> Id W.Bool (g s) true -> Id W.Bool (g t) true) {
      jChild (la : A.car) (s t : W.N) (c : Id W.Bool (ch s t) true) (j : J la s) : J la t =
        jStab la t (\ k -> jOut la s j (\ z -> CF.or-elim (Id W.Bool (g s) true) ((t' : W.N) -> Id W.Bool (ch s t') true -> J z.1 t') W.Empty
          (\ gs -> k (jIn la t (\ k2 -> k2 (z.1,(z.2.1,inl (mono s t c gs))))))
          (\ all -> k (jMon z.1 la z.2.1 t (all t c))) z.2.2)) ;
    } ;
    ----------------------------------------------------------------------
    -- the split model
    MB : W.Bool -> W.N -> U l = split { true -> Jall ; false -> J top } ;
    Mo (b : W.Bool) : W.Or W.Unit A.car -> W.N -> U l = split { inl u -> MB b ; inr la -> J la } ;
    M (b : W.Bool) (xi : I.Lb A) (n : W.N) : U l = Mo b xi.2 n ;
    module S = SG.PN[ev,phi,A,top,M] ;
    -- CondR: the hereditary clause uses the stability of J^mu (no shift)
    gPart (s : W.N) (Big : W.N -> U l) (mu : A.car) (intro : Phi (J mu) s -> Big s) (hn : BI.Not (Big s)) :
        (b : W.Bool) -> Id W.Bool (g s) b -> Id W.Bool (g s) false = split {
      true -> \ e -> CF.efq (Id W.Bool (g s) false) (hn (intro (inl e))) ;
      false -> \ e -> e } ;
    core (mu : A.car) (s : W.N) (Big : W.N -> U l) (intro : Phi (J mu) s -> Big s) (hn : BI.Not (Big s)) :
        Id W.Bool (g s) false * BI.Not (BI.Not ((n : W.N) * (Id W.Bool (ch s n) true * BI.Not (J mu n)))) =
      (gPart s Big mu intro hn (g s) (refl (g s)),
       \ k -> hn (intro (inr (\ n c -> jStab mu n (\ nj -> k (n,(c,nj))))))) ;
    crO (t : I.Lb A) (mu : A.car) : (o : W.Or W.Unit A.car) -> Id W.Bool (I.allowR A mu o) true -> BI.Not (Mo true o t.1) ->
        S.F phi (I.envP A t (I.stg A mu)) = split {
      inl u -> \ ha hn -> core mu t.1 Jall (\ p k -> k (mu,p)) hn ;
      inr la -> \ ha hn -> core mu t.1 (J la) (\ p -> jIn la t.1 (\ k -> k (mu,(ha,p)))) hn } ;
    condR : S.CondR = \ xi t mu ha hn -> crO t mu xi.2 ha hn ;
    -- CondL: from an unfolding below the bound, the negated unfolding is refuted
    chCase (s n : W.N) (nu : A.car) (all : (t : W.N) -> Id W.Bool (ch s t) true -> J nu t) : (b : W.Bool) -> Id W.Bool (ch s n) b ->
        BI.Not (BI.Not (W.Or (Id W.Bool (ch s n) false) (BI.Not (BI.Not (J nu n))))) = split {
      true -> \ e k -> k (inr (\ nj -> nj (all n e))) ;
      false -> \ e k -> k (inl e) } ;
    negF (t : I.Lb A) (nu : A.car) : Phi (J nu) t.1 -> S.F (BI.neg phi) (I.envP A t (zero,inr nu)) = split {
      inl h -> \ k -> k (inl h) ;
      inr all -> \ k -> k (inr (\ n -> chCase t.1 n nu all (ch t.1 n) (refl (ch t.1 n)))) } ;
    refuteJ (t : I.Lb A) (la bd : A.car) (lb : (nu : A.car) -> Lt nu la -> Lt nu bd)
        (hb : (a : I.Lb A) -> Id W.Bool (I.below A bd a) true -> BI.Not (S.F (BI.neg phi) (I.envP A t a))) : BI.Not (J la t.1) =
      \ j -> jOut la t.1 j (\ z -> hb (zero,inr z.1) (lb z.1 z.2.1) (negF t z.1 z.2.2)) ;
    eqLa (x y : A.car) (h : Id W.Bool (I.eqB A x y) true) : Id A.car x y = A.ceq x y (BO.isEqT (A.cmp x y) h) ;
    clI (t : I.Lb A) (la : A.car) : (o : W.Or W.Unit A.car) -> Id W.Bool (I.sameO A o (inr la)) true ->
        ((a : I.Lb A) -> Id W.Bool (I.below A (I.bound A top o) a) true -> BI.Not (S.F (BI.neg phi) (I.envP A t a))) -> BI.Not (J la t.1) = split {
      inl u -> \ hs hb -> W.absurdB (BI.Not (J la t.1)) hs ;
      inr la' -> \ hs hb -> refuteJ t la la' (\ nu h -> PL.subst A.car (\ w -> Lt nu w) la la' (PL.sym A.car la' la (eqLa la' la hs)) h) hb } ;
    clB (t : I.Lb A) : (o : W.Or W.Unit A.car) -> Id W.Bool (I.sameO A o (inl tt)) true ->
        ((a : I.Lb A) -> Id W.Bool (I.below A (I.bound A top o) a) true -> BI.Not (S.F (BI.neg phi) (I.envP A t a))) -> BI.Not (J top t.1) = split {
      inl u -> \ hs hb -> refuteJ t top top (\ nu h -> h) hb ;
      inr la' -> \ hs hb -> W.absurdB (BI.Not (J top t.1)) hs } ;
    clO (t : I.Lb A) (o : W.Or W.Unit A.car) : (xo : W.Or W.Unit A.car) -> Id W.Bool (I.sameO A o xo) true ->
        ((a : I.Lb A) -> Id W.Bool (I.below A (I.bound A top o) a) true -> BI.Not (S.F (BI.neg phi) (I.envP A t a))) -> BI.Not (Mo false xo t.1) = split {
      inl u -> \ hs hb -> clB t o (PL.subst W.Unit (\ v -> Id W.Bool (I.sameO A o (inl v)) true) u tt (LT.unitEq u tt) hs) hb ;
      inr la -> \ hs hb -> clI t la o hs hb } ;
    condL : S.CondL = \ xi t o hs hb -> clO t o xi.2 hs hb ;
    ----------------------------------------------------------------------
    -- J and the ordinary stages
    bToJT : (t : Ac.AT) (s : W.N) -> Bn t s -> Jn t s = split {
      node x0 f | r -> \ s b k -> k (b.1,(b.2.1,phiMon (Bn (f b.1 b.2.1)) (Jn (f b.1 b.2.1)) (r b.1 b.2.1) s b.2.2)) } ;
    bToJ (la : A.car) (s : W.N) (b : B la s) : J la s = bToJT (wA la).1 s b ;
    DNS : U l+ = (P : W.N -> U l) -> ((n : W.N) -> BI.Not (BI.Not (P n))) -> BI.Not (BI.Not ((n : W.N) -> P n)) ;
    impNN (C D : U l) (h : C -> BI.Not (BI.Not D)) : BI.Not (BI.Not (C -> D)) =
      \ k -> k (\ c -> CF.efq D (h c (\ d -> k (\ c' -> d)))) ;
    -- ordinary stages: tree irrelevance and folding
    bIrr2 (x0 : A.car) (f : (y : A.car) -> Lt y x0 -> Ac.AT)
        (r : (y : A.car) (h : Lt y x0) (x : A.car) -> Ac.Good (f y h) x -> (t' : Ac.AT) -> Ac.Good t' x -> (s : W.N) -> Bn (f y h) s -> Bn t' s)
        (x : A.car) (g0 : Ac.Good (node x0 f) x) : (t' : Ac.AT) -> Ac.Good t' x -> (s : W.N) -> Bn (node x0 f) s -> Bn t' s = split {
      node x1 f' -> \ g1 s z -> (z.1,
        (PL.subst A.car (\ w -> Lt z.1 w) x0 x1 (PL.trans A.car x0 x x1 g0.1 (PL.sym A.car x1 x g1.1)) z.2.1,
         phiMon (Bn (f z.1 z.2.1)) (Bn (f' z.1 (PL.subst A.car (\ w -> Lt z.1 w) x0 x1 (PL.trans A.car x0 x x1 g0.1 (PL.sym A.car x1 x g1.1)) z.2.1)))
           (\ s' -> r z.1 z.2.1 z.1 (g0.2 z.1 z.2.1) (f' z.1 (PL.subst A.car (\ w -> Lt z.1 w) x0 x1 (PL.trans A.car x0 x x1 g0.1 (PL.sym A.car x1 x g1.1)) z.2.1))
             (g1.2 z.1 (PL.subst A.car (\ w -> Lt z.1 w) x0 x1 (PL.trans A.car x0 x x1 g0.1 (PL.sym A.car x1 x g1.1)) z.2.1)) s')
           s z.2.2)) } ;
    bIrr : (t : Ac.AT) (x : A.car) -> Ac.Good t x -> (t' : Ac.AT) -> Ac.Good t' x -> (s : W.N) -> Bn t s -> Bn t' s = split {
      node x0 f | r -> \ x g0 -> bIrr2 x0 f r x g0 } ;
    bInT : (t : Ac.AT) (la : A.car) -> Ac.Good t la -> (s : W.N) -> ((mu : A.car) * ((h : Lt mu la) * Phi (B mu) s)) -> Bn t s = split {
      node x0 f -> \ la g0 s z -> (z.1,
        (PL.subst A.car (\ w -> Lt z.1 w) la x0 (PL.sym A.car x0 la g0.1) z.2.1,
         phiMon (B z.1) (Bn (f z.1 (PL.subst A.car (\ w -> Lt z.1 w) la x0 (PL.sym A.car x0 la g0.1) z.2.1)))
           (\ s' -> bIrr (wA z.1).1 z.1 (wA z.1).2 (f z.1 (PL.subst A.car (\ w -> Lt z.1 w) la x0 (PL.sym A.car x0 la g0.1) z.2.1))
             (g0.2 z.1 (PL.subst A.car (\ w -> Lt z.1 w) la x0 (PL.sym A.car x0 la g0.1) z.2.1)) s') s z.2.2)) } ;
    bIn (la : A.car) (s : W.N) (z : (mu : A.car) * ((h : Lt mu la) * Phi (B mu) s)) : B la s = bInT (wA la).1 la (wA la).2 s z ;
    -- THE OBLIGATION FOR ORDINARY STAGES: the hereditary clause of CondR
    -- is exactly a double-negation shift over the children
    HerB (mu la : A.car) (s : W.N) : U l = BI.Not (B la s) -> BI.Not (BI.Not ((n : W.N) * (Id W.Bool (ch s n) true * BI.Not (B mu n)))) ;
    chDec (mu : A.car) (s n : W.N) (k : BI.Not ((n : W.N) * (Id W.Bool (ch s n) true * BI.Not (B mu n)))) :
        (b : W.Bool) -> Id W.Bool (ch s n) b -> BI.Not (BI.Not (Id W.Bool (ch s n) true -> B mu n)) = split {
      true -> \ e kk -> k (n,(e,\ bm -> kk (\ c -> bm))) ;
      false -> \ e kk -> kk (\ c -> W.absurdB (B mu n) (PL.trans W.Bool false (ch s n) true (PL.sym W.Bool (ch s n) false e) c)) } ;
    -- conversely, HerB turns the hypothesis of the shift into not not B^lambda
    herToShift (mu la : A.car) (s : W.N) (her : HerB mu la s)
        (all : (n : W.N) -> BI.Not (BI.Not (Id W.Bool (ch s n) true -> B mu n))) : BI.Not (BI.Not (B la s)) =
      \ nb -> her nb (\ z -> all z.1 (\ imp -> z.2.2 (imp z.2.1))) ;
    -- with the double-negation shift, J^lambda gives not not B^lambda
    module WithDNS (dns : DNS) {
      phiNN (X X' : W.N -> U l) (m : (s : W.N) -> X s -> BI.Not (BI.Not (X' s))) (s : W.N) : Phi X s -> BI.Not (BI.Not (Phi X' s)) = split {
        inl h -> \ k -> k (inl h) ;
        inr all -> \ k -> dns (\ t -> Id W.Bool (ch s t) true -> X' t) (\ t -> impNN (Id W.Bool (ch s t) true) (X' t) (\ c -> m t (all t c)))
          (\ a -> k (inr a)) } ;
      jToBT : (t : Ac.AT) (s : W.N) -> Jn t s -> BI.Not (BI.Not (Bn t s)) = split {
        node x0 f | r -> \ s j k -> j (\ z -> phiNN (Jn (f z.1 z.2.1)) (Bn (f z.1 z.2.1)) (r z.1 z.2.1) s z.2.2
          (\ p -> k (z.1,(z.2.1,p)))) } ;
      jToB (la : A.car) (s : W.N) (j : J la s) : BI.Not (BI.Not (B la s)) = jToBT (wA la).1 s j ;
      herB (mu la : A.car) (hl : Lt mu la) (s : W.N) : HerB mu la s =
        \ nb k -> dns (\ n -> Id W.Bool (ch s n) true -> B mu n) (\ n -> chDec mu s n k (ch s n) (refl (ch s n)))
          (\ a -> nb (bIn la s (mu,(hl,inr a)))) ;
    } ;
  } ;
  ----------------------------------------------------------------------
  -- THE STAGE BOUND for the bar predicate: an accessible family proving
  -- forall x (B(x) -> exists y (A(x,y) & B(y))) gives, at every WF Y with
  -- E returned by normalisation: if x is in J at top_Y, then it is refuted
  -- that every y fails A(x,y) or is outside J after all of kY + E.
  module Cor (o : S4.Obj[ev,phi,evN].IObj) (ac : S4.SSteps[ev,phi,evN].AccI o) (Y : DP.LO) (wY : LW.WF Y) (pA : BI.Form) (nN nP : W.N)
    (eG : Id (BI.ID[ev,phi].Seq (o.k Y)) (o.G Y) (consL (allF (orF (xF false (suc zero) zero) (exF (andF pA (xF true (suc (suc (suc zero))) zero)))),
       consL (nN,inl tt) (consL (nP,inl tt) nilL)) nilL)) {
    module C = SG.Cor[ev,phi,evN,hPos,o,ac,Y,wY] ;
    module Md = Model[C.B,inl C.top,S4.wfSm C.A C.E (S4.wfKO ev phi evN o Y wY) C.out.2.1] ;
    stageBound (n : W.N) (hx : Md.J (inl C.top) n) :
        BI.Not ((m : W.N) -> BI.Not (BI.Not (W.Or (Md.S.F pA (consL (m,inl tt) (consL (n,inl tt) (consL (nN,inl tt) (consL (nP,inl tt) nilL)))))
          (BI.Not (Md.Jall m))))) =
      C.Mixed[pA,nN,nP,eG].Bd[Md.M,Md.condR,Md.condL].stageBound n hx ;
  } ;
  ----------------------------------------------------------------------
  -- THE CHILD SEQUENT  forall s t (not Child(s,t) or not B(s) or B(t)):
  -- under s, t (env t :: s :: e0), the negative B reads bN at position 2
  -- with argument s, the positive B reads bP at position 3 with argument t.
  fC : BI.Form = allF (allF (orF (atF false (suc zero)) (orF (xF false (suc (suc zero)) (suc zero)) (xF true (suc (suc (suc zero))) zero)))) ;
  module ChildCor (o : S4.Obj[ev,phi,evN].IObj) (ac : S4.SSteps[ev,phi,evN].AccI o) (Y : DP.LO) (wY : LW.WF Y) (nN nP : W.N)
    (eG : Id (BI.ID[ev,phi].Seq (o.k Y)) (o.G Y) (consL (fC,consL (nN,inl tt) (consL (nP,inl tt) nilL)) nilL)) {
    module C = SG.Cor[ev,phi,evN,hPos,o,ac,Y,wY] ;
    module Md = Model[C.B,inl C.top,S4.wfSm C.A C.E (S4.wfKO ev phi evN o Y wY) C.out.2.1] ;
    e0 : LT.LL C.B = consL (nN,inl tt) (consL (nP,inl tt) nilL) ;
    vB : BI.Not (Md.S.F fC e0) = \ fv -> C.bound Md.M Md.condR Md.condL
      (PL.subst (BI.ID[ev,phi].Seq C.A) (\ G -> Md.S.AllF (C.R.rS G)) (consL (fC,consL (nN,inl tt) (consL (nP,inl tt) nilL)) nilL) (o.G Y)
        (PL.sym (BI.ID[ev,phi].Seq C.A) (o.G Y) (consL (fC,consL (nN,inl tt) (consL (nP,inl tt) nilL)) nilL) eG) (fv,tt)) ;
    -- THE S4 BOUND: s in J at top_Y, t a child of s  ==>  t in J after all
    -- of (Y+1)+E (no shift, no witness extraction: Jall is stable)
    childBound (s t : W.N) (c : Id W.Bool (ch s t) true) (hs : Md.J (inl C.top) s) : Md.Jall t =
      \ nj -> vB (\ k -> k (s,\ k2 -> k2 (t,(c,(\ nh -> nh hs,\ ja -> ja nj))))) ;
  } ;
} ;

------------------------------------------------------------------------
-- the example G(s) = "s nonempty" (codes: 0 = empty history), children
-- are nonempty: a nonempty history enters at stage 1, the empty one at
-- stage 2, on omega
nz (n : W.N) : W.Bool = W.notB (BP.isZeroN n) ;
module Ex {
  module Bx = Bar[nz,\ s t -> nz t] ;
  module Md = Bx.Model[LW.omega,zero,LW.wf-omega] ;
  enter1 (t : W.N) (c : Id W.Bool (nz t) true) : Md.J (suc zero) t = Md.jIn (suc zero) t (\ k -> k (zero,(refl true,inl c))) ;
  lt0 : (mu : W.N) -> Md.Lt mu zero -> W.Empty = split {
    zero -> \ h -> W.absurdB W.Empty h ; suc m -> \ h -> W.absurdB W.Empty h } ;
  lt1 : (mu : W.N) -> Md.Lt mu (suc zero) -> Bx.Phi (Md.J mu) zero -> W.Empty = split {
    zero -> \ h p -> CF.or-elim (Id W.Bool (nz zero) true) ((t : W.N) -> Id W.Bool (nz t) true -> Md.J zero t) W.Empty
      (\ e -> W.absurdB W.Empty e)
      (\ all -> Md.jOut zero (suc zero) (all (suc zero) (refl true)) (\ z -> lt0 z.1 z.2.1)) p ;
    suc m -> \ h p -> lt0 m h } ;
  -- the empty history is not in J^1, and is in J^2
  notEnter1 : BI.Not (Md.J (suc zero) zero) = \ j -> Md.jOut (suc zero) zero j (\ z -> lt1 z.1 z.2.1 z.2.2) ;
  enter2 : Md.J (suc (suc zero)) zero = Md.jIn (suc (suc zero)) zero (\ k -> k (suc zero,(refl true,inr (\ t c -> enter1 t c)))) ;
} ;

-- PLAN-ID1, diagonal identity law: the (r-bar) case (e2 = e1 + id_1) and
-- kind III (e3 = e1 + ((1 + t1) + e2), with f1 = f + ((1 + t) + e1) and the
-- tail maps t, t1 pointwise identities).
level l ;
open Base ; open Prelude[l+] ; open ScottOrder[l] ;
module P1 = Prelude[l+] ;
module W = Dilator[l] ;
module DP = DilPtyx[l] ;
module CF = CatEmbFin[l] ;
module PL = Prelude[l] ;
module LT = LabTree[l] ;
module LC = LOCat[l] ;
module PS = PtyxSum[l] ;
module LW = LOWF[l] ;
module BI = BetaID[l] ;
module BO = BetaIDCfOps[l] ;
module S4 = BetaIDS4[l] ;
module SH = BetaIDS4Hom[l] ;
module HT = BetaIDS4HomThm[l] ;
module HR = BetaIDS4HomReg[l] ;
module HK3 = BetaIDS4HomK3[l] ;
module HK3N = BetaIDS4HomK3N[l] ;
module DBs = BetaIDS4DiagBase[l] ;

------------------------------------------------------------------------
-- the tail map of a pointwise identity is a pointwise identity
module DTail (ev : (A : DP.LO) -> W.N -> LT.LL A -> W.Bool) (phi : BI.Form) (evN : S4.EvN ev)
  (o : S4.Obj[ev,phi,evN].IObj) (Z : DP.LO) (b : DP.Map (o.k Z) (o.k Z))
  (bTop : Id (o.k Z).car (b.1 (S4.Obj[ev,phi,evN].topO o Z)) (S4.Obj[ev,phi,evN].topO o Z))
  (hb : (p : (o.k Z).car) -> Id (o.k Z).car (b.1 p) p) {
  module O = S4.Obj[ev,phi,evN] ;
  module T = HK3.Tail[ev,phi,evN,o,o,Z,Z,b,bTop] ;
  PZ : DP.LO = O.P o.Cst o.Fp Z ;
  sgiInj (x y : PZ.car) (h : Id (o.k Z).car ((o.sgi Z).1 x) ((o.sgi Z).1 y)) : Id PZ.car x y =
    PL.trans PZ.car x ((o.sg Z).1 ((o.sgi Z).1 y)) y
      (PL.trans PZ.car x ((o.sg Z).1 ((o.sgi Z).1 x)) ((o.sg Z).1 ((o.sgi Z).1 y))
        (PL.sym PZ.car ((o.sg Z).1 ((o.sgi Z).1 x)) x (o.ret Z x))
        (PL.ap (o.k Z).car PZ.car (o.sg Z).1 ((o.sgi Z).1 x) ((o.sgi Z).1 y) h))
      (o.ret Z y) ;
  tlId (t : (o.Fp Z).car) : Id (o.Fp Z).car (T.tl t) t =
    PL.sym (o.Fp Z).car t (T.tl t)
      (PS.SumLO[LT.one,o.Fp Z].inr-inj t (T.tl t)
        (PS.SumLO[S4.Sm o.Cst Z,S4.Sm LT.one (o.Fp Z)].inr-inj (inr t) (inr (T.tl t))
          (sgiInj (inr (inr t)) (inr (inr (T.tl t)))
            (PL.trans (o.k Z).car ((o.sgi Z).1 (inr (inr t))) (b.1 (T.pT t)) ((o.sgi Z).1 (inr (inr (T.tl t))))
              (PL.sym (o.k Z).car (b.1 (T.pT t)) (T.pT t) (hb (T.pT t))) (T.tlp t).2)))) ;
  tTId : (t : (S4.Sm LT.one (o.Fp Z)).car) -> Id (S4.Sm LT.one (o.Fp Z)).car (T.tT.1 t) t = split {
    inl u -> refl (inl u) ;
    inr t -> PL.ap (o.Fp Z).car (S4.Sm LT.one (o.Fp Z)).car (\ q -> inr q) (T.tl t) t (tlId t) } ;
} ;

module DRbK3 (ev : (A : DP.LO) -> W.N -> LT.LL A -> W.Bool) (phi : BI.Form) (evN : S4.EvN ev)
  (hPos : Id W.Bool (BO.posX phi zero) true)
  (o : S4.Obj[ev,phi,evN].IObj)
  (ih : (s : S4.SSteps[ev,phi,evN].Step o) -> S4.Main[ev,phi,evN,hPos].Q (S4.SSteps[ev,phi,evN].shiftO o s))
  (ihr : HT.Stmt[ev,phi,evN,hPos].IHR o o ih ih)
  (c : DP.Map o.Cst o.Cst) (tau : (Z : DP.LO) -> DP.Map (o.k Z) (o.k Z)) (rl : SH.Rel[ev,phi,evN].RelIn o o c tau)
  (Y : DP.LO) (wY : LW.WF Y) (f : DP.Map Y Y)
  (ihd : DBs.DB[ev,phi,evN,hPos].IHD o ih ihr) (hk : DBs.DB[ev,phi,evN,hPos].KmId o)
  (hc : DBs.DB[ev,phi,evN,hPos].CId o c) (ht : DBs.DB[ev,phi,evN,hPos].TId o tau) (hf : DBs.DB[ev,phi,evN,hPos].FId Y f) {
  module I = BI.ID[ev,phi] ;
  module O = S4.Obj[ev,phi,evN] ;
  module DD = DBs.DB[ev,phi,evN,hPos] ;
  module ST = DD.ST ;
  A : DP.LO = o.k Y ;
  top : A.car = O.topO o Y ;
  ----------------------------------------------------------------------
  -- (r-bar)
  module Rb (i : W.N) (mu : A.car) (eY : Id (I.Rule A) (o.R Y nilL) (xrR i mu)) (h : Id W.Bool (I.ltB A mu top) false) {
    module RR = BetaIDS4HomRb[l].RBarRel[ev,phi,evN,hPos,o,o,ih,ih,ihr,c,tau,rl,Y,Y,wY,wY,f,i,mu,eY,h,mu,eY,h] ;
    law : (z : RR.RB.E2.car) -> Id RR.RB.E2.car (RR.out.1.1 z) z = split {
      inl y -> PL.ap RR.RB.E1.car RR.RB.E2.car (\ q -> inl q) (RR.e1.1 y) y
        (ihd (inl (RR.RB.N0.stNum zero tt RR.RB.hbr)) c tau
          (HR.PShRel[ev,phi,evN,o,o,c,tau,rl,RR.RB.N0.stNum zero tt RR.RB.hbr,RR.RB.N0.stNum zero tt RR.RB.hbr,\ Z -> refl (zero,inl tt)].rel)
          Y wY f hk hc ht hf y) ;
      inr u -> refl (inr u) } ;
  } ;
  ----------------------------------------------------------------------
  -- kind III
  module K3 (nP nN s k : W.N) (e0 : LT.LL A)
    (hbP : Id W.Bool (I.br A top (o.R Y nilL) (nP,inl tt)) true)
    (hbN : Id W.Bool (I.br A top (o.R Y nilL) (nN,inl tt)) true)
    (eP : Id (I.Seq A) (I.step A (o.G Y) (o.R Y nilL) (nP,inl tt)) (I.app A (o.G Y) (consL (xF true s k,e0) nilL)))
    (eN : Id (I.Seq A) (I.step A (o.G Y) (o.R Y nilL) (nN,inl tt)) (I.app A (o.G Y) (consL (xF false s k,e0) nilL)))
    (hbar : Id (W.Or W.Unit A.car) (I.nthL A s e0).2 (inl tt))
    (eE0 : Id (LT.LL A) e0 (LT.mapL A A (ST.baseF o o tau Y Y f) e0)) {
    module KR = HK3N.K3NodeRel[ev,phi,evN,hPos,o,o,ih,ih,ihr,c,tau,rl,Y,Y,wY,wY,f,nP,nN,s,k,e0,hbP,hbN,eP,eN,hbar,e0,hbP,hbN,eP,eN,hbar,eE0] ;
    module KN = KR.KN ;
    e1Id (y : KN.E1.car) : Id KN.E1.car (KR.e1.1 y) y =
      ihd (inl (KN.N0.stNum nP tt hbP)) c tau
        (HR.PShRel[ev,phi,evN,o,o,c,tau,rl,KN.N0.stNum nP tt hbP,KN.N0.stNum nP tt hbP,\ Z -> refl (nP,inl tt)].rel) Y wY f hk hc ht hf y ;
    module TY = DTail[ev,phi,evN,o,Y,KR.SN.b,KR.SN.bTop,DD.betaId o tau Y f hk ht hf] ;
    f1W : (w : (S4.Sm KN.C0.T0 KN.E1).car) -> Id (S4.Sm KN.C0.T0 KN.E1).car ((PS.SumMap[KN.C0.T0,KN.E1,KN.C0.T0,KN.E1,KR.SN.T.tT,KR.e1].map).1 w) w = split {
      inl t -> PL.ap KN.C0.T0.car (S4.Sm KN.C0.T0 KN.E1).car (\ q -> inl q) (KR.SN.T.tT.1 t) t (TY.tTId t) ;
      inr y -> PL.ap KN.E1.car (S4.Sm KN.C0.T0 KN.E1).car (\ q -> inr q) (KR.e1.1 y) y (e1Id y) } ;
    f1Id : DD.FId KN.V1 KR.f1 = split {
      inl y -> PL.ap Y.car KN.V1.car (\ q -> inl q) (f.1 y) y (hf y) ;
      inr w -> PL.ap (S4.Sm KN.C0.T0 KN.E1).car KN.V1.car (\ q -> inr q) ((PS.SumMap[KN.C0.T0,KN.E1,KN.C0.T0,KN.E1,KR.SN.T.tT,KR.e1].map).1 w) w (f1W w) } ;
    e2Id (x : KN.E2.car) : Id KN.E2.car (KR.e2.1 x) x =
      ihd (inl (KN.N0.stNum nN tt hbN)) c tau
        (HR.PShRel[ev,phi,evN,o,o,c,tau,rl,KN.N0.stNum nN tt hbN,KN.N0.stNum nN tt hbN,\ Z -> refl (nN,inl tt)].rel) KN.V1 KN.wV1 KR.f1 hk hc ht f1Id x ;
    module TV = DTail[ev,phi,evN,o,KN.V1,KR.Q.SN1.b,KR.Q.SN1.bTop,DD.betaId o tau KN.V1 KR.f1 hk ht f1Id] ;
    lawR : (w : (S4.Sm KN.C.T1 KN.E2).car) -> Id (S4.Sm KN.C.T1 KN.E2).car (KR.Q.tT2.1 w) w = split {
      inl t -> PL.ap KN.C.T1.car (S4.Sm KN.C.T1 KN.E2).car (\ q -> inl q) (KR.Q.SN1.T.tT.1 t) t (TV.tTId t) ;
      inr x -> PL.ap KN.E2.car (S4.Sm KN.C.T1 KN.E2).car (\ q -> inr q) (KR.e2.1 x) x (e2Id x) } ;
    law : (z : KR.Q.E3.car) -> Id KR.Q.E3.car (KR.out.1.1 z) z = split {
      inl y -> PL.ap KN.E1.car KR.Q.E3.car (\ q -> inl q) (KR.e1.1 y) y (e1Id y) ;
      inr w -> PL.ap (S4.Sm KN.C.T1 KN.E2).car KR.Q.E3.car (\ q -> inr q) (KR.Q.tT2.1 w) w (lawR w) } ;
  } ;
  ----------------------------------------------------------------------
  -- the kind III selection (sign of the displayed atom)
  module SR = HK3N.K3SelRel[ev,phi,evN,hPos,o,o,ih,ih,ihr,c,tau,rl,Y,Y,wY,wY,f] ;
  sgnD (s k : W.N) (e0 : LT.LL A) (hbar : Id (W.Or W.Unit A.car) (I.nthL A s e0).2 (inl tt)) :
      (b : W.Bool) (er : Id (I.Rule A) (o.R Y nilL) (cutR (xF b s k) e0))
      (z : (S4.K3Sel[ev,phi,evN,hPos,o,ih,Y,wY,e0].sgn s k hbar b er).1.car) ->
      Id (S4.K3Sel[ev,phi,evN,hPos,o,ih,Y,wY,e0].sgn s k hbar b er).1.car ((SR.sgnR s k e0 e0 hbar hbar b er er).1.1 z) z = split {
    true -> \ er z -> K3[zero,suc zero,s,k,e0,
        S4.K3Sel[ev,phi,evN,hPos,o,ih,Y,wY,e0].brL (xF true s k) er zero,S4.K3Sel[ev,phi,evN,hPos,o,ih,Y,wY,e0].brL (xF true s k) er (suc zero),
        S4.K3Sel[ev,phi,evN,hPos,o,ih,Y,wY,e0].stL (xF true s k) er zero,S4.K3Sel[ev,phi,evN,hPos,o,ih,Y,wY,e0].stL (xF true s k) er (suc zero),hbar,
        SR.eEnv (xF true s k) e0 e0 er er].law z ;
    false -> \ er z -> K3[suc zero,zero,s,k,e0,
        S4.K3Sel[ev,phi,evN,hPos,o,ih,Y,wY,e0].brL (xF false s k) er (suc zero),S4.K3Sel[ev,phi,evN,hPos,o,ih,Y,wY,e0].brL (xF false s k) er zero,
        S4.K3Sel[ev,phi,evN,hPos,o,ih,Y,wY,e0].stL (xF false s k) er (suc zero),S4.K3Sel[ev,phi,evN,hPos,o,ih,Y,wY,e0].stL (xF false s k) er zero,hbar,
        SR.eEnv (xF false s k) e0 e0 er er].law z } ;
  K3T (f0 : BI.Form) (e0 : LT.LL A) (eY : Id (I.Rule A) (o.R Y nilL) (cutR f0 e0)) (hb : Id W.Bool (O.barAt A f0 e0) true) : U l =
    (z : (S4.K3Sel[ev,phi,evN,hPos,o,ih,Y,wY,e0].out f0 eY hb).1.car) ->
    Id (S4.K3Sel[ev,phi,evN,hPos,o,ih,Y,wY,e0].out f0 eY hb).1.car ((SR.hk3 f0 e0 e0 eY eY hb hb).1.1 z) z ;
  k3D : (f0 : BI.Form) (e0 : LT.LL A) (eY : Id (I.Rule A) (o.R Y nilL) (cutR f0 e0)) (hb : Id W.Bool (O.barAt A f0 e0) true) -> K3T f0 e0 eY hb = split {
    atF b k -> \ e0 eY hb -> W.absurdB (K3T (atF b k) e0 eY hb) hb ;
    andF p q -> \ e0 eY hb -> W.absurdB (K3T (andF p q) e0 eY hb) hb ;
    orF p q -> \ e0 eY hb -> W.absurdB (K3T (orF p q) e0 eY hb) hb ;
    allF p -> \ e0 eY hb -> W.absurdB (K3T (allF p) e0 eY hb) hb ;
    exF p -> \ e0 eY hb -> W.absurdB (K3T (exF p) e0 eY hb) hb ;
    xF b s k -> \ e0 eY hb z -> sgnD s k e0 (S4.K3Sel[ev,phi,evN,hPos,o,ih,Y,wY,e0].inlEq (I.nthL A s e0).2 hb) b eY z } ;
} ;

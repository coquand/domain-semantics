sb7 (Y : DP.LO) (o1 : W.Or W.Unit (K Y).car) (n2 : W.N) (o2 : W.Or W.Unit (K Y).car) (n3 : W.N) (o3 : W.Or W.Unit (K Y).car) (om : W.Or W.Unit (K Y).car) (n5 : W.N) (o5 : W.Or W.Unit (K Y).car) (nv : W.N) (nu : (K Y).car) (n7 : W.N) (o7 : W.Or W.Unit (K Y).car) : I.Seq (K Y) = I.step (K Y) (sb6 Y o1 n2 o2 n3 o3 om n5 o5 nv nu) (xrR (suc (suc (suc (suc (suc (suc (suc (suc zero)))))))) nu) (n7,o7) ;

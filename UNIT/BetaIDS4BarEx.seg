-- PLAN-ID1, S6 benchmark: stage growth forced by a cut.  Part 3's bar on
-- histories keeping only their length: Child(n,m) iff m = n+1, and
-- G(n) iff n >= 2.  Stages (Unit's convention): 2 enters at stage 1, 1 at
-- stage 2, 0 at stage 3.  The input family proves  B(2) -> B(0)  by a root
-- cut on Phi-bar(1) between two one-step proofs B(n+1) -> B(n):
--   branch 0 (B(2) -> B(1)): r-bar on Phi-bar(1) at top; for the child 2,
--     l-bar on not Phi-bar(2), then I^top(2) at the premise stage, closed
--     by G(2);
--   branch 1 (B(1) -> B(0)): r-bar on Phi-bar(0) at top; for the child 1,
--     l-bar on not Phi-bar(1) at nu, then I^top(1) at nu, whose unfolding
--     needs I^nu(2): from not phi(I^nu,1) (and-rule, witness 2), l on
--     not I^nu(2) at nu' < nu, I^nu(2) at nu', closed by G(2).
-- kY = Y + 1 (k Y = (0+Y)+(1+0)).  At Y = 1 the hypothesis J^top(2)
-- holds; if the extension E returned by S4 were empty the output order
-- would have two points, on which Jall(0) is false; S4 gives Jall(0).
level l ;
open Base ; open Prelude[l+] ; open ScottOrder[l] ;
module W = Dilator[l] ;
module DP = DilPtyx[l] ;
module CF = CatEmbFin[l] ;
module PL = Prelude[l] ;
module LT = LabTree[l] ;
module LC = LOCat[l] ;
module PS = PtyxSum[l] ;
module LW = LOWF[l] ;
module BP = BetaProof[l] ;
module BI = BetaID[l] ;
module BT0 = BetaIDTr[l] ;
module BO = BetaIDCfOps[l] ;
module BA = BetaAcc[l] ;
module S4 = BetaIDS4[l] ;
module SG = BetaIDS4Stage[l] ;
module BB = BetaIDS4Bar[l] ;

gL : W.N -> W.Bool = split { zero -> false ; suc k -> W.notB (BP.isZeroN k) } ;
chL (n m : W.N) : W.Bool = W.eqN m (suc n) ;
module Bx = BB.Bar[gL,chL] ;
module I = BI.ID[Bx.ev,Bx.phi] ;
module O = S4.Obj[Bx.ev,Bx.phi,Bx.evN] ;
module SS = S4.SSteps[Bx.ev,Bx.phi,Bx.evN] ;
n1 : W.N = suc zero ;
n2 : W.N = suc (suc zero) ;
------------------------------------------------------------------------
-- the input orders kY = (0 + Y) + (1 + 0)
Fp (Y : DP.LO) : DP.LO = BA.E0 ;
T : DP.LO = S4.Sm LT.one BA.E0 ;
K (Y : DP.LO) : DP.LO = O.P BA.E0 Fp Y ;
kmK (X Y : DP.LO) (f : DP.Map X Y) : DP.Map (K X) (K Y) =
  PS.SumMap[S4.Sm BA.E0 X,T,S4.Sm BA.E0 Y,T,O.smapC BA.E0 X Y f,LC.idMap T].map ;
topK (Y : DP.LO) : (K Y).car = O.tp BA.E0 Fp Y ;
nuOf (Y : DP.LO) : W.Or W.Unit (K Y).car -> (K Y).car = split { inl u -> topK Y ; inr v -> v } ;
lN (A : DP.LO) (n : W.N) : I.Lb A = (n,inl tt) ;
-- the end sequent: not Phi-bar(2), Phi-bar(0); the cut formula Phi-bar(1)
eG (A : DP.LO) : LT.LL A = consL (lN A zero) (consL (lN A n2) (consL (lN A zero) (consL (lN A n1) nilL))) ;
nB2 : BI.Form = xF false zero (suc zero) ;
pB0 : BI.Form = xF true zero (suc (suc zero)) ;
cutf : BI.Form = xF true zero (suc (suc (suc zero))) ;
GK (Y : DP.LO) : I.Seq (K Y) = consL (nB2,eG (K Y)) (consL (pB0,eG (K Y)) nilL) ;
w2 (A : DP.LO) : I.Lb A = lN A n2 ;
------------------------------------------------------------------------
-- the rule function, piece by piece
leafR (A : DP.LO) (i : W.N) : I.Rl A = \ zs -> axR i ;
eqPick (A : DP.LO) (rT rF : I.Rule A) : W.N -> W.N -> I.Rule A = split {
  zero -> split { zero -> rT ; suc m -> rF } ;
  suc t | r -> split { zero -> rF ; suc m -> r m } } ;
pick3b (A : DP.LO) (r1 r2 : I.Rule A) : W.N -> I.Rule A = split { zero -> r1 ; suc k -> r2 } ;
pick3 (A : DP.LO) (r0 r1 r2 : I.Rule A) : W.N -> I.Rule A = split { zero -> r0 ; suc k -> pick3b A r1 r2 k } ;
b7 (Y : DP.LO)  : I.Rl (K Y) = split { nilL -> orR (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero)))))))))) ; consL a zs -> leafR (K Y) (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero))))))))))) zs } ;
b6 (Y : DP.LO) (oo : W.Or W.Unit (K Y).car) : I.Rl (K Y) = split { nilL -> xrR (suc (suc (suc (suc (suc (suc (suc (suc zero)))))))) (nuOf Y oo) ; consL a zs -> b7 Y zs } ;
b5 (Y : DP.LO) (m : W.N) : I.Rl (K Y) = split { nilL -> eqPick (K Y) (xlR zero (inl tt)) (axR (suc (suc (suc (suc (suc (suc (suc zero)))))))) (suc (suc zero)) m ; consL a zs -> b6 Y a.2 zs } ;
b4 (Y : DP.LO) (m : W.N) : I.Rl (K Y) = split { nilL -> orR (suc (suc (suc (suc (suc (suc zero)))))) ; consL a zs -> b5 Y m zs } ;
b3 (Y : DP.LO)  : I.Rl (K Y) = split { nilL -> allR (suc (suc (suc (suc (suc zero))))) ; consL a zs -> b4 Y a.1 zs } ;
b2 (Y : DP.LO)  : I.Rl (K Y) = split { nilL -> orR (suc (suc (suc zero))) ; consL a zs -> b3 Y zs } ;
b1 (Y : DP.LO)  : I.Rl (K Y) = split { nilL -> xrR (suc (suc zero)) (topK Y) ; consL a zs -> b2 Y zs } ;
c15 (Y : DP.LO)  : I.Rl (K Y) = split { nilL -> orR (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero)))))))))))))))))))) ; consL a zs -> leafR (K Y) (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero))))))))))))))))))))) zs } ;
c14 (Y : DP.LO) (oo : W.Or W.Unit (K Y).car) : I.Rl (K Y) = split { nilL -> xrR (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero))))))))))))))) (nuOf Y oo) ; consL a zs -> c15 Y zs } ;
c13 (Y : DP.LO) (oo : W.Or W.Unit (K Y).car) (c : W.N) : I.Rl (K Y) = split { nilL -> pick3 (K Y) (axR (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero))))))))))))))))))) (xlR (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero)))))))))))))))))) oo) (axR zero) c ; consL a zs -> c14 Y a.2 zs } ;
c12 (Y : DP.LO) (oo : W.Or W.Unit (K Y).car) : I.Rl (K Y) = split { nilL -> andR (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero))))))))))))))))) ; consL a zs -> c13 Y oo a.1 zs } ;
c11 (Y : DP.LO) (oo : W.Or W.Unit (K Y).car) (b : W.N) : I.Rl (K Y) = split { nilL -> pick3 (K Y) (axR (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero))))))))))))))))) (exR (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero)))))))))))))))) (w2 (K Y))) (axR zero) b ; consL a zs -> c12 Y oo zs } ;
c10 (Y : DP.LO) (oo : W.Or W.Unit (K Y).car) (m' : W.N) : I.Rl (K Y) = split { nilL -> eqPick (K Y) (andR (suc (suc (suc (suc (suc (suc (suc (suc (suc zero)))))))))) (axR (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero))))))))))))))) (suc (suc zero)) m' ; consL a zs -> c11 Y oo a.1 zs } ;
c9 (Y : DP.LO) (oo : W.Or W.Unit (K Y).car) (m' : W.N) : I.Rl (K Y) = split { nilL -> orR (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero))))))))))))) ; consL a zs -> c10 Y oo m' zs } ;
c8 (Y : DP.LO) (oo : W.Or W.Unit (K Y).car) : I.Rl (K Y) = split { nilL -> allR (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero)))))))))))) ; consL a zs -> c9 Y oo a.1 zs } ;
c7 (Y : DP.LO) (oo : W.Or W.Unit (K Y).car) : I.Rl (K Y) = split { nilL -> orR (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero)))))))))) ; consL a zs -> c8 Y oo zs } ;
c6 (Y : DP.LO) (oo : W.Or W.Unit (K Y).car) : I.Rl (K Y) = split { nilL -> xrR (suc (suc (suc (suc (suc (suc (suc (suc zero)))))))) (nuOf Y oo) ; consL a zs -> c7 Y oo zs } ;
c5 (Y : DP.LO) (m : W.N) : I.Rl (K Y) = split { nilL -> eqPick (K Y) (xlR (suc (suc zero)) (inl tt)) (axR (suc (suc (suc (suc (suc (suc (suc zero)))))))) (suc zero) m ; consL a zs -> c6 Y a.2 zs } ;
c4 (Y : DP.LO) (m : W.N) : I.Rl (K Y) = split { nilL -> orR (suc (suc (suc (suc (suc (suc zero)))))) ; consL a zs -> c5 Y m zs } ;
c3 (Y : DP.LO)  : I.Rl (K Y) = split { nilL -> allR (suc (suc (suc (suc (suc zero))))) ; consL a zs -> c4 Y a.1 zs } ;
c2 (Y : DP.LO)  : I.Rl (K Y) = split { nilL -> orR (suc (suc (suc zero))) ; consL a zs -> c3 Y zs } ;
c1 (Y : DP.LO)  : I.Rl (K Y) = split { nilL -> xrR (suc zero) (topK Y) ; consL a zs -> c2 Y zs } ;

selB1 (Y : DP.LO) : W.N -> I.Rl (K Y) = split { zero -> c1 Y ; suc k -> leafR (K Y) zero } ;
selB (Y : DP.LO) : W.N -> I.Rl (K Y) = split { zero -> b1 Y ; suc k -> selB1 Y k } ;
RK (Y : DP.LO) : I.Rl (K Y) = split { nilL -> cutR cutf (eG (K Y)) ; consL a zs -> selB Y a.1 zs } ;
------------------------------------------------------------------------
-- naturality of the rules
mRK (X Y : DP.LO) (f : DP.Map X Y) (r : I.Rule (K X)) : I.Rule (K Y) =
  BT0.Mp[Bx.ev,Bx.phi,K X,K Y,kmK X Y f,S4.evMap Bx.ev Bx.evN (K X) (K Y) (kmK X Y f),topK X].mR r ;
omK (X Y : DP.LO) (f : DP.Map X Y) (oo : W.Or W.Unit (K X).car) : W.Or W.Unit (K Y).car = LT.omap (K X) (K Y) (kmK X Y f) oo ;
nuNat (X Y : DP.LO) (f : DP.Map X Y) : (oo : W.Or W.Unit (K X).car) -> Id (K Y).car (nuOf Y (omK X Y f oo)) ((kmK X Y f).1 (nuOf X oo)) = split {
  inl u -> refl (topK Y) ; inr v -> refl ((kmK X Y f).1 v) } ;
eqPickNat (X Y : DP.LO) (f : DP.Map X Y) (rT rF : I.Rule (K X)) : (t m : W.N) ->
    Id (I.Rule (K Y)) (eqPick (K Y) (mRK X Y f rT) (mRK X Y f rF) t m) (mRK X Y f (eqPick (K X) rT rF t m)) = split {
  zero -> split { zero -> refl (mRK X Y f rT) ; suc m -> refl (mRK X Y f rF) } ;
  suc t | r -> split { zero -> refl (mRK X Y f rF) ; suc m -> r m } } ;
pick3bNat (X Y : DP.LO) (f : DP.Map X Y) (r1 r2 : I.Rule (K X)) : (c : W.N) ->
    Id (I.Rule (K Y)) (pick3b (K Y) (mRK X Y f r1) (mRK X Y f r2) c) (mRK X Y f (pick3b (K X) r1 r2 c)) = split {
  zero -> refl (mRK X Y f r1) ; suc k -> refl (mRK X Y f r2) } ;
pick3Nat (X Y : DP.LO) (f : DP.Map X Y) (r0 r1 r2 : I.Rule (K X)) : (c : W.N) ->
    Id (I.Rule (K Y)) (pick3 (K Y) (mRK X Y f r0) (mRK X Y f r1) (mRK X Y f r2) c) (mRK X Y f (pick3 (K X) r0 r1 r2 c)) = split {
  zero -> refl (mRK X Y f r0) ; suc k -> pick3bNat X Y f r1 r2 k } ;
nr_b7 (X Y : DP.LO) (f : DP.Map X Y)  : (zs : LT.LL (K X)) -> Id (I.Rule (K Y)) (b7 Y  (LT.mapL (K X) (K Y) (kmK X Y f) zs)) (mRK X Y f (b7 X  zs)) = split {
  nilL -> refl (orR (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero))))))))))) ;
  consL a zs -> refl (axR (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero)))))))))))) } ;
nr_b6 (X Y : DP.LO) (f : DP.Map X Y) (oo : W.Or W.Unit (K X).car) : (zs : LT.LL (K X)) -> Id (I.Rule (K Y)) (b6 Y (omK X Y f oo) (LT.mapL (K X) (K Y) (kmK X Y f) zs)) (mRK X Y f (b6 X oo zs)) = split {
  nilL -> PL.ap (K Y).car (I.Rule (K Y)) (\ z -> xrR (suc (suc (suc (suc (suc (suc (suc (suc zero)))))))) z) (nuOf Y (omK X Y f oo)) ((kmK X Y f).1 (nuOf X oo)) (nuNat X Y f oo) ;
  consL a zs -> nr_b7 X Y f  zs } ;
nr_b5 (X Y : DP.LO) (f : DP.Map X Y) (m : W.N) : (zs : LT.LL (K X)) -> Id (I.Rule (K Y)) (b5 Y m (LT.mapL (K X) (K Y) (kmK X Y f) zs)) (mRK X Y f (b5 X m zs)) = split {
  nilL -> eqPickNat X Y f (xlR zero (inl tt)) (axR (suc (suc (suc (suc (suc (suc (suc zero)))))))) (suc (suc zero)) m ;
  consL a zs -> nr_b6 X Y f a.2 zs } ;
nr_b4 (X Y : DP.LO) (f : DP.Map X Y) (m : W.N) : (zs : LT.LL (K X)) -> Id (I.Rule (K Y)) (b4 Y m (LT.mapL (K X) (K Y) (kmK X Y f) zs)) (mRK X Y f (b4 X m zs)) = split {
  nilL -> refl (orR (suc (suc (suc (suc (suc (suc zero))))))) ;
  consL a zs -> nr_b5 X Y f m zs } ;
nr_b3 (X Y : DP.LO) (f : DP.Map X Y)  : (zs : LT.LL (K X)) -> Id (I.Rule (K Y)) (b3 Y  (LT.mapL (K X) (K Y) (kmK X Y f) zs)) (mRK X Y f (b3 X  zs)) = split {
  nilL -> refl (allR (suc (suc (suc (suc (suc zero)))))) ;
  consL a zs -> nr_b4 X Y f a.1 zs } ;
nr_b2 (X Y : DP.LO) (f : DP.Map X Y)  : (zs : LT.LL (K X)) -> Id (I.Rule (K Y)) (b2 Y  (LT.mapL (K X) (K Y) (kmK X Y f) zs)) (mRK X Y f (b2 X  zs)) = split {
  nilL -> refl (orR (suc (suc (suc zero)))) ;
  consL a zs -> nr_b3 X Y f  zs } ;
nr_b1 (X Y : DP.LO) (f : DP.Map X Y)  : (zs : LT.LL (K X)) -> Id (I.Rule (K Y)) (b1 Y  (LT.mapL (K X) (K Y) (kmK X Y f) zs)) (mRK X Y f (b1 X  zs)) = split {
  nilL -> refl (xrR (suc (suc zero)) (topK Y)) ;
  consL a zs -> nr_b2 X Y f  zs } ;
nr_c15 (X Y : DP.LO) (f : DP.Map X Y)  : (zs : LT.LL (K X)) -> Id (I.Rule (K Y)) (c15 Y  (LT.mapL (K X) (K Y) (kmK X Y f) zs)) (mRK X Y f (c15 X  zs)) = split {
  nilL -> refl (orR (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero))))))))))))))))))))) ;
  consL a zs -> refl (axR (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero)))))))))))))))))))))) } ;
nr_c14 (X Y : DP.LO) (f : DP.Map X Y) (oo : W.Or W.Unit (K X).car) : (zs : LT.LL (K X)) -> Id (I.Rule (K Y)) (c14 Y (omK X Y f oo) (LT.mapL (K X) (K Y) (kmK X Y f) zs)) (mRK X Y f (c14 X oo zs)) = split {
  nilL -> PL.ap (K Y).car (I.Rule (K Y)) (\ z -> xrR (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero))))))))))))))) z) (nuOf Y (omK X Y f oo)) ((kmK X Y f).1 (nuOf X oo)) (nuNat X Y f oo) ;
  consL a zs -> nr_c15 X Y f  zs } ;
nr_c13 (X Y : DP.LO) (f : DP.Map X Y) (oo : W.Or W.Unit (K X).car) (c : W.N) : (zs : LT.LL (K X)) -> Id (I.Rule (K Y)) (c13 Y (omK X Y f oo) c (LT.mapL (K X) (K Y) (kmK X Y f) zs)) (mRK X Y f (c13 X oo c zs)) = split {
  nilL -> pick3Nat X Y f (axR (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero))))))))))))))))))) (xlR (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero)))))))))))))))))) oo) (axR zero) c ;
  consL a zs -> nr_c14 X Y f a.2 zs } ;
nr_c12 (X Y : DP.LO) (f : DP.Map X Y) (oo : W.Or W.Unit (K X).car) : (zs : LT.LL (K X)) -> Id (I.Rule (K Y)) (c12 Y (omK X Y f oo) (LT.mapL (K X) (K Y) (kmK X Y f) zs)) (mRK X Y f (c12 X oo zs)) = split {
  nilL -> refl (andR (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero)))))))))))))))))) ;
  consL a zs -> nr_c13 X Y f oo a.1 zs } ;
nr_c11 (X Y : DP.LO) (f : DP.Map X Y) (oo : W.Or W.Unit (K X).car) (b : W.N) : (zs : LT.LL (K X)) -> Id (I.Rule (K Y)) (c11 Y (omK X Y f oo) b (LT.mapL (K X) (K Y) (kmK X Y f) zs)) (mRK X Y f (c11 X oo b zs)) = split {
  nilL -> pick3Nat X Y f (axR (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero))))))))))))))))) (exR (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero)))))))))))))))) (w2 (K X))) (axR zero) b ;
  consL a zs -> nr_c12 X Y f oo zs } ;
nr_c10 (X Y : DP.LO) (f : DP.Map X Y) (oo : W.Or W.Unit (K X).car) (m' : W.N) : (zs : LT.LL (K X)) -> Id (I.Rule (K Y)) (c10 Y (omK X Y f oo) m' (LT.mapL (K X) (K Y) (kmK X Y f) zs)) (mRK X Y f (c10 X oo m' zs)) = split {
  nilL -> eqPickNat X Y f (andR (suc (suc (suc (suc (suc (suc (suc (suc (suc zero)))))))))) (axR (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero))))))))))))))) (suc (suc zero)) m' ;
  consL a zs -> nr_c11 X Y f oo a.1 zs } ;
nr_c9 (X Y : DP.LO) (f : DP.Map X Y) (oo : W.Or W.Unit (K X).car) (m' : W.N) : (zs : LT.LL (K X)) -> Id (I.Rule (K Y)) (c9 Y (omK X Y f oo) m' (LT.mapL (K X) (K Y) (kmK X Y f) zs)) (mRK X Y f (c9 X oo m' zs)) = split {
  nilL -> refl (orR (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero)))))))))))))) ;
  consL a zs -> nr_c10 X Y f oo m' zs } ;
nr_c8 (X Y : DP.LO) (f : DP.Map X Y) (oo : W.Or W.Unit (K X).car) : (zs : LT.LL (K X)) -> Id (I.Rule (K Y)) (c8 Y (omK X Y f oo) (LT.mapL (K X) (K Y) (kmK X Y f) zs)) (mRK X Y f (c8 X oo zs)) = split {
  nilL -> refl (allR (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero))))))))))))) ;
  consL a zs -> nr_c9 X Y f oo a.1 zs } ;
nr_c7 (X Y : DP.LO) (f : DP.Map X Y) (oo : W.Or W.Unit (K X).car) : (zs : LT.LL (K X)) -> Id (I.Rule (K Y)) (c7 Y (omK X Y f oo) (LT.mapL (K X) (K Y) (kmK X Y f) zs)) (mRK X Y f (c7 X oo zs)) = split {
  nilL -> refl (orR (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero))))))))))) ;
  consL a zs -> nr_c8 X Y f oo zs } ;
nr_c6 (X Y : DP.LO) (f : DP.Map X Y) (oo : W.Or W.Unit (K X).car) : (zs : LT.LL (K X)) -> Id (I.Rule (K Y)) (c6 Y (omK X Y f oo) (LT.mapL (K X) (K Y) (kmK X Y f) zs)) (mRK X Y f (c6 X oo zs)) = split {
  nilL -> PL.ap (K Y).car (I.Rule (K Y)) (\ z -> xrR (suc (suc (suc (suc (suc (suc (suc (suc zero)))))))) z) (nuOf Y (omK X Y f oo)) ((kmK X Y f).1 (nuOf X oo)) (nuNat X Y f oo) ;
  consL a zs -> nr_c7 X Y f oo zs } ;
nr_c5 (X Y : DP.LO) (f : DP.Map X Y) (m : W.N) : (zs : LT.LL (K X)) -> Id (I.Rule (K Y)) (c5 Y m (LT.mapL (K X) (K Y) (kmK X Y f) zs)) (mRK X Y f (c5 X m zs)) = split {
  nilL -> eqPickNat X Y f (xlR (suc (suc zero)) (inl tt)) (axR (suc (suc (suc (suc (suc (suc (suc zero)))))))) (suc zero) m ;
  consL a zs -> nr_c6 X Y f a.2 zs } ;
nr_c4 (X Y : DP.LO) (f : DP.Map X Y) (m : W.N) : (zs : LT.LL (K X)) -> Id (I.Rule (K Y)) (c4 Y m (LT.mapL (K X) (K Y) (kmK X Y f) zs)) (mRK X Y f (c4 X m zs)) = split {
  nilL -> refl (orR (suc (suc (suc (suc (suc (suc zero))))))) ;
  consL a zs -> nr_c5 X Y f m zs } ;
nr_c3 (X Y : DP.LO) (f : DP.Map X Y)  : (zs : LT.LL (K X)) -> Id (I.Rule (K Y)) (c3 Y  (LT.mapL (K X) (K Y) (kmK X Y f) zs)) (mRK X Y f (c3 X  zs)) = split {
  nilL -> refl (allR (suc (suc (suc (suc (suc zero)))))) ;
  consL a zs -> nr_c4 X Y f a.1 zs } ;
nr_c2 (X Y : DP.LO) (f : DP.Map X Y)  : (zs : LT.LL (K X)) -> Id (I.Rule (K Y)) (c2 Y  (LT.mapL (K X) (K Y) (kmK X Y f) zs)) (mRK X Y f (c2 X  zs)) = split {
  nilL -> refl (orR (suc (suc (suc zero)))) ;
  consL a zs -> nr_c3 X Y f  zs } ;
nr_c1 (X Y : DP.LO) (f : DP.Map X Y)  : (zs : LT.LL (K X)) -> Id (I.Rule (K Y)) (c1 Y  (LT.mapL (K X) (K Y) (kmK X Y f) zs)) (mRK X Y f (c1 X  zs)) = split {
  nilL -> refl (xrR (suc zero) (topK Y)) ;
  consL a zs -> nr_c2 X Y f  zs } ;
nr_leaf (X Y : DP.LO) (f : DP.Map X Y) (i : W.N) (zs : LT.LL (K X)) : Id (I.Rule (K Y)) (axR i) (axR i) = refl (axR i) ;
nr_sel1 (X Y : DP.LO) (f : DP.Map X Y) : (k : W.N) (zs : LT.LL (K X)) ->
    Id (I.Rule (K Y)) (selB1 Y k (LT.mapL (K X) (K Y) (kmK X Y f) zs)) (mRK X Y f (selB1 X k zs)) = split {
  zero -> nr_c1 X Y f ; suc k -> \ zs -> refl (axR zero) } ;
nr_sel (X Y : DP.LO) (f : DP.Map X Y) : (k : W.N) (zs : LT.LL (K X)) ->
    Id (I.Rule (K Y)) (selB Y k (LT.mapL (K X) (K Y) (kmK X Y f) zs)) (mRK X Y f (selB X k zs)) = split {
  zero -> nr_b1 X Y f ; suc k -> nr_sel1 X Y f k } ;
nrK (X Y : DP.LO) (f : DP.Map X Y) : (zs : LT.LL (K X)) ->
    Id (I.Rule (K Y)) (RK Y (LT.mapL (K X) (K Y) (kmK X Y f) zs)) (mRK X Y f (RK X zs)) = split {
  nilL -> refl (cutR cutf (eG (K Y))) ;
  consL a zs -> nr_sel X Y f a.1 zs } ;
------------------------------------------------------------------------
-- accessibility: if every address of length n carries an axiom, the
-- family is accessible (induction on n; the predecessors are subtrees)
isAxR (A : DP.LO) : I.Rule A -> W.Bool = split {
  axR i -> true ; andR i -> false ; orR i -> false ; allR i -> false ; exR i w -> false ;
  cutR f e -> false ; xrR i mu -> false ; xlR i o -> false } ;
AxD (A : DP.LO) : W.N -> I.Rl A -> U l = split {
  zero -> \ R -> Id W.Bool (isAxR A (R nilL)) true ;
  suc n | r -> \ R -> (a : I.Lb A) -> r (I.shift A R a) } ;
brAx (A : DP.LO) (tp : A.car) : (r : I.Rule A) -> Id W.Bool (isAxR A r) true -> (a : I.Lb A) -> Id W.Bool (I.br A tp r a) false = split {
  axR i -> \ h a -> refl false ;
  andR i -> \ h a -> W.absurdB (Id W.Bool (I.br A tp (andR i) a) false) h ;
  orR i -> \ h a -> W.absurdB (Id W.Bool (I.br A tp (orR i) a) false) h ;
  allR i -> \ h a -> W.absurdB (Id W.Bool (I.br A tp (allR i) a) false) h ;
  exR i w -> \ h a -> W.absurdB (Id W.Bool (I.br A tp (exR i w) a) false) h ;
  cutR f e -> \ h a -> W.absurdB (Id W.Bool (I.br A tp (cutR f e) a) false) h ;
  xrR i mu -> \ h a -> W.absurdB (Id W.Bool (I.br A tp (xrR i mu) a) false) h ;
  xlR i o -> \ h a -> W.absurdB (Id W.Bool (I.br A tp (xlR i o) a) false) h } ;
brCon (A : DP.LO) (tp : A.car) (R : I.Rl A) (G : I.Seq A) (a : I.Lb A) (h : Id W.Bool (isAxR A (R nilL)) true)
    (nd : Id W.Bool (I.inTree A tp (consL a nilL) R G) true) : W.Empty =
  W.absurdB W.Empty (PL.trans W.Bool false (W.andB (I.br A tp (R nilL) a) true) true
    (PL.sym W.Bool (W.andB (I.br A tp (R nilL) a) true) false
      (PL.ap W.Bool W.Bool (\ b -> W.andB b true) (I.br A tp (R nilL) a) false (brAx A tp (R nilL) h a))) nd) ;
emptyAx (x : O.IObj) (h : (Y : DP.LO) -> AxD (x.k Y) zero (x.R Y)) : (s : SS.Step x) -> W.Empty = split {
  inl st -> brCon (x.k BA.E0) (O.topO x BA.E0) (x.R BA.E0) (x.G BA.E0) (st.1 BA.E0) (h BA.E0) (st.2.2 BA.E0) ;
  inr st -> brCon (x.k (S4.Sm st.1 BA.E0)) (O.topO x (S4.Sm st.1 BA.E0)) (x.R (S4.Sm st.1 BA.E0)) (x.G (S4.Sm st.1 BA.E0))
    (st.2.2.1 BA.E0) (h (S4.Sm st.1 BA.E0)) (st.2.2.2.2 BA.E0) } ;
axShift (n : W.N) (x : O.IObj) (h : (Y : DP.LO) -> AxD (x.k Y) (suc n) (x.R Y)) : (s : SS.Step x) (Y : DP.LO) -> AxD ((SS.shiftO x s).k Y) n ((SS.shiftO x s).R Y) = split {
  inl st -> \ Y -> h Y (st.1 Y) ;
  inr st -> \ Y -> h (S4.Sm st.1 Y) (st.2.2.1 Y) } ;
accAx : (n : W.N) (x : O.IObj) -> ((Y : DP.LO) -> AxD (x.k Y) n (x.R Y)) -> SS.AccI x = split {
  zero -> \ x h -> SS.AO.acc x (\ s -> S4.efq1 (SS.AccI (SS.shiftO x s)) (emptyAx x h s)) ;
  suc n | r -> \ x h -> SS.AO.acc x (\ s -> r (SS.shiftO x s) (axShift n x h s)) } ;
axLeaf (A : DP.LO) (i : W.N) : (n : W.N) -> AxD A n (leafR A i) = split {
  zero -> refl true ;
  suc n | r -> \ a -> r } ;
------------------------------------------------------------------------
-- local correctness and the kind condition, node by node
LK (A : DP.LO) (tp : A.car) (R : I.Rl A) (G : I.Seq A) : U l = (zs : LT.LL A) -> Id W.Bool (I.inTree A tp zs R G) true ->
  Id W.Bool (I.appl A (I.seqAt A zs R G) (R zs)) true * O.KindOK A tp (R zs) ;
lkNode (A : DP.LO) (tp : A.car) (R : I.Rl A) (G : I.Seq A) (h0 : Id W.Bool (I.appl A G (R nilL)) true) (k0 : O.KindOK A tp (R nilL))
    (hb : (a : I.Lb A) -> Id W.Bool (I.br A tp (R nilL) a) true -> LK A tp (I.shift A R a) (I.step A G (R nilL) a)) : LK A tp R G = split {
  nilL -> \ h -> (h0,k0) ;
  consL a ys -> \ h -> hb a (W.andB-l (I.br A tp (R nilL) a) (I.inTree A tp ys (I.shift A R a) (I.step A G (R nilL) a)) h) ys
    (W.andB-r (I.br A tp (R nilL) a) (I.inTree A tp ys (I.shift A R a) (I.step A G (R nilL) a)) h) } ;
-- a node whose rule is an axiom has no branch
lkAx (A : DP.LO) (tp : A.car) (R : I.Rl A) (G : I.Seq A) (i : W.N) (e : Id (I.Rule A) (R nilL) (axR i))
    (h0 : Id W.Bool (I.appl A G (axR i)) true) : LK A tp R G =
  lkNode A tp R G (PL.subst (I.Rule A) (\ r -> Id W.Bool (I.appl A G r) true) (axR i) (R nilL) (PL.sym (I.Rule A) (R nilL) (axR i) e) h0)
    (PL.subst (I.Rule A) (\ r -> O.KindOK A tp r) (axR i) (R nilL) (PL.sym (I.Rule A) (R nilL) (axR i) e) tt)
    (\ a hb -> W.absurdB (LK A tp (I.shift A R a) (I.step A G (R nilL) a))
      (PL.trans W.Bool false (I.br A tp (R nilL) a) true
        (PL.sym W.Bool (I.br A tp (R nilL) a) false (PL.subst (I.Rule A) (\ r -> Id W.Bool (I.br A tp r a) false) (axR i) (R nilL)
          (PL.sym (I.Rule A) (R nilL) (axR i) e) (refl false))) hb)) ;
ax_b7 (Y : DP.LO)  (n : W.N) : AxD (K Y) (suc n) (b7 Y ) = \ a -> axLeaf (K Y) (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero))))))))))) n ;
ax_b6 (Y : DP.LO) (oo : W.Or W.Unit (K Y).car) (n : W.N) : AxD (K Y) (suc (suc n)) (b6 Y oo) = \ a -> ax_b7 Y  n ;
ax_b5 (Y : DP.LO) (m : W.N) (n : W.N) : AxD (K Y) (suc (suc (suc n))) (b5 Y m) = \ a -> ax_b6 Y a.2 n ;
ax_b4 (Y : DP.LO) (m : W.N) (n : W.N) : AxD (K Y) (suc (suc (suc (suc n)))) (b4 Y m) = \ a -> ax_b5 Y m n ;
ax_b3 (Y : DP.LO)  (n : W.N) : AxD (K Y) (suc (suc (suc (suc (suc n))))) (b3 Y ) = \ a -> ax_b4 Y a.1 n ;
ax_b2 (Y : DP.LO)  (n : W.N) : AxD (K Y) (suc (suc (suc (suc (suc (suc n)))))) (b2 Y ) = \ a -> ax_b3 Y  n ;
ax_b1 (Y : DP.LO)  (n : W.N) : AxD (K Y) (suc (suc (suc (suc (suc (suc (suc n))))))) (b1 Y ) = \ a -> ax_b2 Y  n ;
ax_c15 (Y : DP.LO)  (n : W.N) : AxD (K Y) (suc n) (c15 Y ) = \ a -> axLeaf (K Y) (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero))))))))))))))))))))) n ;
ax_c14 (Y : DP.LO) (oo : W.Or W.Unit (K Y).car) (n : W.N) : AxD (K Y) (suc (suc n)) (c14 Y oo) = \ a -> ax_c15 Y  n ;
ax_c13 (Y : DP.LO) (oo : W.Or W.Unit (K Y).car) (c : W.N) (n : W.N) : AxD (K Y) (suc (suc (suc n))) (c13 Y oo c) = \ a -> ax_c14 Y a.2 n ;
ax_c12 (Y : DP.LO) (oo : W.Or W.Unit (K Y).car) (n : W.N) : AxD (K Y) (suc (suc (suc (suc n)))) (c12 Y oo) = \ a -> ax_c13 Y oo a.1 n ;
ax_c11 (Y : DP.LO) (oo : W.Or W.Unit (K Y).car) (b : W.N) (n : W.N) : AxD (K Y) (suc (suc (suc (suc (suc n))))) (c11 Y oo b) = \ a -> ax_c12 Y oo n ;
ax_c10 (Y : DP.LO) (oo : W.Or W.Unit (K Y).car) (m' : W.N) (n : W.N) : AxD (K Y) (suc (suc (suc (suc (suc (suc n)))))) (c10 Y oo m') = \ a -> ax_c11 Y oo a.1 n ;
ax_c9 (Y : DP.LO) (oo : W.Or W.Unit (K Y).car) (m' : W.N) (n : W.N) : AxD (K Y) (suc (suc (suc (suc (suc (suc (suc n))))))) (c9 Y oo m') = \ a -> ax_c10 Y oo m' n ;
ax_c8 (Y : DP.LO) (oo : W.Or W.Unit (K Y).car) (n : W.N) : AxD (K Y) (suc (suc (suc (suc (suc (suc (suc (suc n)))))))) (c8 Y oo) = \ a -> ax_c9 Y oo a.1 n ;
ax_c7 (Y : DP.LO) (oo : W.Or W.Unit (K Y).car) (n : W.N) : AxD (K Y) (suc (suc (suc (suc (suc (suc (suc (suc (suc n))))))))) (c7 Y oo) = \ a -> ax_c8 Y oo n ;
ax_c6 (Y : DP.LO) (oo : W.Or W.Unit (K Y).car) (n : W.N) : AxD (K Y) (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc n)))))))))) (c6 Y oo) = \ a -> ax_c7 Y oo n ;
ax_c5 (Y : DP.LO) (m : W.N) (n : W.N) : AxD (K Y) (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc n))))))))))) (c5 Y m) = \ a -> ax_c6 Y a.2 n ;
ax_c4 (Y : DP.LO) (m : W.N) (n : W.N) : AxD (K Y) (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc n)))))))))))) (c4 Y m) = \ a -> ax_c5 Y m n ;
ax_c3 (Y : DP.LO)  (n : W.N) : AxD (K Y) (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc n))))))))))))) (c3 Y ) = \ a -> ax_c4 Y a.1 n ;
ax_c2 (Y : DP.LO)  (n : W.N) : AxD (K Y) (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc n)))))))))))))) (c2 Y ) = \ a -> ax_c3 Y  n ;
ax_c1 (Y : DP.LO)  (n : W.N) : AxD (K Y) (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc n))))))))))))))) (c1 Y ) = \ a -> ax_c2 Y  n ;
axSel1 (Y : DP.LO) (n : W.N) : (k : W.N) -> AxD (K Y) (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc n))))))))))))))) (selB1 Y k) = split { zero -> ax_c1 Y n ; suc k -> axLeaf (K Y) zero (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc n))))))))))))))) } ;
axSel (Y : DP.LO) (n : W.N) : (k : W.N) -> AxD (K Y) (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc n))))))))))))))) (selB Y k) = split { zero -> ax_b1 Y (suc (suc (suc (suc (suc (suc (suc (suc n)))))))) ; suc k -> axSel1 Y n k } ;
axRK (Y : DP.LO) (n : W.N) : AxD (K Y) (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc n)))))))))))))))) (RK Y) = \ a -> axSel Y n a.1 ;
sb1 (Y : DP.LO) (o1 : W.Or W.Unit (K Y).car) : I.Seq (K Y) = I.step (K Y) (GK Y) (cutR cutf (eG (K Y))) (zero,o1) ;
sb2 (Y : DP.LO) (o1 : W.Or W.Unit (K Y).car) (n2 : W.N) (o2 : W.Or W.Unit (K Y).car) : I.Seq (K Y) = I.step (K Y) (sb1 Y o1) (xrR (suc (suc zero)) (topK Y)) (n2,o2) ;
sb3 (Y : DP.LO) (o1 : W.Or W.Unit (K Y).car) (n2 : W.N) (o2 : W.Or W.Unit (K Y).car) (n3 : W.N) (o3 : W.Or W.Unit (K Y).car) : I.Seq (K Y) = I.step (K Y) (sb2 Y o1 n2 o2) (orR (suc (suc (suc zero)))) (n3,o3) ;
sb4 (Y : DP.LO) (o1 : W.Or W.Unit (K Y).car) (n2 : W.N) (o2 : W.Or W.Unit (K Y).car) (n3 : W.N) (o3 : W.Or W.Unit (K Y).car) (m : W.N) (om : W.Or W.Unit (K Y).car) : I.Seq (K Y) = I.step (K Y) (sb3 Y o1 n2 o2 n3 o3) (allR (suc (suc (suc (suc (suc zero)))))) (m,om) ;
sb5 (Y : DP.LO) (o1 : W.Or W.Unit (K Y).car) (n2 : W.N) (o2 : W.Or W.Unit (K Y).car) (n3 : W.N) (o3 : W.Or W.Unit (K Y).car) (m : W.N) (om : W.Or W.Unit (K Y).car) (n5 : W.N) (o5 : W.Or W.Unit (K Y).car) : I.Seq (K Y) = I.step (K Y) (sb4 Y o1 n2 o2 n3 o3 m om) (orR (suc (suc (suc (suc (suc (suc zero))))))) (n5,o5) ;

lk_b7 (Y : DP.LO) (o1 : W.Or W.Unit (K Y).car) (n2 : W.N) (o2 : W.Or W.Unit (K Y).car) (n3 : W.N) (o3 : W.Or W.Unit (K Y).car) (om : W.Or W.Unit (K Y).car) (n5 : W.N) (o5 : W.Or W.Unit (K Y).car) (nv : W.N) (nu : (K Y).car) (n7 : W.N) (o7 : W.Or W.Unit (K Y).car) : LK (K Y) (topK Y) (b7 Y) (sb7 Y o1 n2 o2 n3 o3 om n5 o5 nv nu n7 o7) = lkNode (K Y) (topK Y) (b7 Y) (sb7 Y o1 n2 o2 n3 o3 om n5 o5 nv nu n7 o7) (refl true) tt (\ a hb -> lk_b8 Y o1 n2 o2 n3 o3 om n5 o5 nv nu n7 o7 a.1 a.2) ;
lk_b6 (Y : DP.LO) (o1 : W.Or W.Unit (K Y).car) (n2 : W.N) (o2 : W.Or W.Unit (K Y).car) (n3 : W.N) (o3 : W.Or W.Unit (K Y).car) (om : W.Or W.Unit (K Y).car) (n5 : W.N) (o5 : W.Or W.Unit (K Y).car) (nv : W.N) (nu : (K Y).car) (hv : Id W.Bool (I.ltB (K Y) nu (topK Y)) true) : LK (K Y) (topK Y) (b6 Y (inr nu)) (sb6 Y o1 n2 o2 n3 o3 om n5 o5 nv nu) = lkNode (K Y) (topK Y) (b6 Y (inr nu)) (sb6 Y o1 n2 o2 n3 o3 om n5 o5 nv nu) hv tt (\ a hb -> lk_b7 Y o1 n2 o2 n3 o3 om n5 o5 nv nu a.1 a.2) ;
lk_b6v (Y : DP.LO) (o1 : W.Or W.Unit (K Y).car) (n2 : W.N) (o2 : W.Or W.Unit (K Y).car) (n3 : W.N) (o3 : W.Or W.Unit (K Y).car) (om : W.Or W.Unit (K Y).car) (n5 : W.N) (o5 : W.Or W.Unit (K Y).car) (nv : W.N) : (ov : W.Or W.Unit (K Y).car) -> Id W.Bool (I.below (K Y) (topK Y) (nv,ov)) true -> LK (K Y) (topK Y) (b6 Y ov) (I.step (K Y) (sb5 Y o1 n2 o2 n3 o3 (suc (suc zero)) om n5 o5) (xlR zero (inl tt)) (nv,ov)) = split {

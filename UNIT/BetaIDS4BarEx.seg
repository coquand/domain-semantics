-- THE INPUT FAMILY: B(2) -> B(0) by a cut on Phi-bar(1), at kY = Y + 1
o : O.IObj = new O.IObj[k := K, km := kmK, Cst := BA.E0, Fp := Fp,
  sg := \ Y -> LC.idMap (K Y), sgi := \ Y -> LC.idMap (K Y),
  sec := \ Y p -> refl p, ret := \ Y q -> refl q,
  natS := \ X Y f w -> refl (inl ((O.smapC BA.E0 X Y f).1 w)),
  ntop := \ X Y f -> refl (topK Y),
  wC := BA.wfE0, wF := \ Y w -> BA.wfE0,
  G := GK, R := RK,
  ng := \ X Y f -> refl (GK Y),
  nr := nrK,
  lo := \ Y ys h -> (lkRK Y ys h).1, kd := \ Y zs h -> (lkRK Y zs h).2] ;
-- accessible: every address of length 16 carries an axiom
ac : SS.AccI o = accAx (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero)))))))))))))))) o (\ Y -> axRK Y zero) ;
------------------------------------------------------------------------
-- S4 at Y = 1
module At1 {
  module C = SG.Cor[Bx.ev,Bx.phi,Bx.evN,Bx.hPos,o,ac,LT.one,LT.wfUnit] ;
  module Md = Bx.Model[C.B,inl C.top,S4.wfSm C.A C.E (S4.wfKO Bx.ev Bx.phi Bx.evN o LT.one LT.wfUnit) C.out.2.1] ;
  E : DP.LO = C.E ;
  yP : C.B.car = inl (inl (inr tt)) ;
  tP : C.B.car = inl C.top ;
  -- the hypothesis: 2 is in J at top_1
  hJ2 : Md.J tP n2 = Md.jIn tP n2 (\ k -> k (yP,(refl true,inl (refl true)))) ;
  -- S4: soundness of the output gives Jall(0)
  jall0 : Md.Jall zero = \ nj -> C.bound Md.M Md.condR Md.condL ((\ nn -> nn hJ2),((\ ja -> ja nj),tt)) ;
  -- THE TWO-POINT CALCULATION: if E is empty, the output order has the two
  -- points 1 < top, no chain of three points, and Jall(0) is false
  nbY2 : (q : (S4.Sm BA.E0 LT.one).car) -> Md.Lt (inl (inl q)) yP -> W.Empty = split {
    inl e0 -> \ h -> CF.efq W.Empty e0 ;
    inr u -> \ h -> W.absurdB W.Empty h } ;
  nbY1 : (p : C.A.car) -> Md.Lt (inl p) yP -> W.Empty = split {
    inl q -> nbY2 q ;
    inr t -> \ h -> W.absurdB W.Empty h } ;
  noBelowY (hE : E.car -> W.Empty) : (r : C.B.car) -> Md.Lt r yP -> W.Empty = split {
    inl p -> nbY1 p ;
    inr e -> \ h -> hE e } ;
  naT3 : (t : T.car) -> Md.Lt tP (inl (inr t)) -> W.Empty = split {
    inl u -> \ h -> W.absurdB W.Empty h ;
    inr e0 -> \ h -> CF.efq W.Empty e0 } ;
  naT2 : (q : (S4.Sm BA.E0 LT.one).car) -> Md.Lt tP (inl (inl q)) -> W.Empty = split {
    inl e0 -> \ h -> CF.efq W.Empty e0 ;
    inr u -> \ h -> W.absurdB W.Empty h } ;
  naT1 : (p : C.A.car) -> Md.Lt tP (inl p) -> W.Empty = split {
    inl q -> naT2 q ;
    inr t -> naT3 t } ;
  noAboveT (hE : E.car -> W.Empty) : (r : C.B.car) -> Md.Lt tP r -> W.Empty = split {
    inl p -> naT1 p ;
    inr e -> \ h -> hE e } ;
  noChain3 (hE : E.car -> W.Empty) (r m : C.B.car) : (t : T.car) -> Md.Lt r (inl (inr t)) -> Md.Lt (inl (inr t)) m -> W.Empty = split {
    inl u -> \ h1 h2 -> noAboveT hE m (PL.subst W.Unit (\ w -> Md.Lt (inl (inr (inl w))) m) u tt (LT.unitEq u tt) h2) ;
    inr e0 -> \ h1 h2 -> CF.efq W.Empty e0 } ;
  noChain2 (hE : E.car -> W.Empty) (r m : C.B.car) : (q : (S4.Sm BA.E0 LT.one).car) -> Md.Lt r (inl (inl q)) -> Md.Lt (inl (inl q)) m -> W.Empty = split {
    inl e0 -> \ h1 h2 -> CF.efq W.Empty e0 ;
    inr u -> \ h1 h2 -> noBelowY hE r (PL.subst W.Unit (\ w -> Md.Lt r (inl (inl (inr w)))) u tt (LT.unitEq u tt) h1) } ;
  noChain1 (hE : E.car -> W.Empty) (r m : C.B.car) : (p : C.A.car) -> Md.Lt r (inl p) -> Md.Lt (inl p) m -> W.Empty = split {
    inl q -> noChain2 hE r m q ;
    inr t -> noChain3 hE r m t } ;
  noChain (hE : E.car -> W.Empty) (r m : C.B.car) : (v : C.B.car) -> Md.Lt r v -> Md.Lt v m -> W.Empty = split {
    inl p -> noChain1 hE r m p ;
    inr e -> \ h1 h2 -> hE e } ;
  notJall0 (hE : E.car -> W.Empty) : BI.Not (Md.Jall zero) = \ ja -> ja (\ z ->
    CF.or-elim (Id W.Bool (gL zero) true) ((t : W.N) -> Id W.Bool (chL zero t) true -> Md.J z.1 t) W.Empty
      (\ h -> W.absurdB W.Empty h)
      (\ all -> Md.jOut z.1 n1 (all n1 (refl true)) (\ z2 ->
        CF.or-elim (Id W.Bool (gL n1) true) ((t : W.N) -> Id W.Bool (chL n1 t) true -> Md.J z2.1 t) W.Empty
          (\ h -> W.absurdB W.Empty h)
          (\ all2 -> Md.jOut z2.1 n2 (all2 n2 (refl true)) (\ z3 -> noChain hE z3.1 z.1 z2.1 z3.2.1 z2.2.1)) z2.2.2))
      z.2) ;
  -- THE STOPPING POINT: the extension returned by S4 at Y = 1 is not empty
  eNonEmpty : BI.Not (E.car -> W.Empty) = \ hE -> notJall0 hE jall0 ;
} ;

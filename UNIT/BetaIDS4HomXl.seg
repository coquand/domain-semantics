-- PLAN-ID1, homogeneity of S4: the stage relation of an (xl) node.
-- A constant stage sigma^-1(inl (inl a)) goes to sigma'^-1(inl (inl (c a))):
-- the two plain predecessors are related (PShRel).  A variable stage
-- sigma^-1(inl (inr y)) goes to sigma'^-1(inl (inr (f y))): the two shifted
-- predecessors are related (ShiftRel, varLab), the induction hypothesis at
-- E0 relates the children, and backRel carries this through OutBack.
level l ;
open Base ; open Prelude[l+] ; open ScottOrder[l] ;
module W = Dilator[l] ;
module DP = DilPtyx[l] ;
module CF = CatEmbFin[l] ;
module PL = Prelude[l] ;
module LT = LabTree[l] ;
module LC = LOCat[l] ;
module PS = PtyxSum[l] ;
module LW = LOWF[l] ;
module BP = BetaProof[l] ;
module BI = BetaID[l] ;
module BT = BetaIDTr[l] ;
module BO = BetaIDCfOps[l] ;
module S4 = BetaIDS4[l] ;
module SH = BetaIDS4Hom[l] ;
module BH = BetaIDHom[l] ;
module HR = BetaIDS4HomReg[l] ;
module HT = BetaIDS4HomThm[l] ;

module XlRel (ev : (A : DP.LO) -> W.N -> LT.LL A -> W.Bool) (phi : BI.Form) (evN : S4.EvN ev)
  (hPos : Id W.Bool (BO.posX phi zero) true)
  (o o' : S4.Obj[ev,phi,evN].IObj)
  (ih : (s : S4.SSteps[ev,phi,evN].Step o) -> S4.Main[ev,phi,evN,hPos].Q (S4.SSteps[ev,phi,evN].shiftO o s))
  (ih' : (s : S4.SSteps[ev,phi,evN].Step o') -> S4.Main[ev,phi,evN,hPos].Q (S4.SSteps[ev,phi,evN].shiftO o' s))
  (ihr : HT.Stmt[ev,phi,evN,hPos].IHR o o' ih ih')
  (c : DP.Map o.Cst o'.Cst) (tau : (Z : DP.LO) -> DP.Map (o.k Z) (o'.k Z)) (rl : SH.Rel[ev,phi,evN].RelIn o o' c tau)
  (Y Y' : DP.LO) (wY : LW.WF Y) (wY' : LW.WF Y') (f : DP.Map Y Y')
  (i : W.N) (oo0 : W.Or W.Unit (o.k BetaAcc[l].E0).car) (oo0' : W.Or W.Unit (o'.k BetaAcc[l].E0).car)
  (e : Id (BI.ID[ev,phi].Rule (o.k BetaAcc[l].E0)) (o.R BetaAcc[l].E0 nilL) (xlR i oo0))
  (e' : Id (BI.ID[ev,phi].Rule (o'.k BetaAcc[l].E0)) (o'.R BetaAcc[l].E0 nilL) (xlR i oo0')) {
  module I = BI.ID[ev,phi] ;
  module O = S4.Obj[ev,phi,evN] ;
  module BA = BetaAcc[l] ;
  module ST = HT.Stmt[ev,phi,evN,hPos] ;
  module X = S4.XLV[ev,phi,evN,hPos,o,ih,Y,wY,i,oo0,e] ;
  module X' = S4.XLV[ev,phi,evN,hPos,o',ih',Y',wY',i,oo0',e'] ;
  A : DP.LO = o.k Y ;
  A' : DP.LO = o'.k Y' ;
  top : A.car = O.topO o Y ;
  top' : A'.car = O.topO o' Y' ;
  beta : DP.Map A A' = ST.baseF o o' tau Y Y' f ;
  bt : Id A'.car (beta.1 top) top' = ST.baseTop o o' c tau rl Y Y' f ;
  cf : DP.Map (S4.Sm o.Cst Y) (S4.Sm o'.Cst Y') = PS.SumMap[o.Cst,Y,o'.Cst,Y',c,f].map ;
  cfZ : (w : (S4.Sm o.Cst Y).car) -> Id (S4.Sm o'.Cst Y').car ((SH.Rel[ev,phi,evN].cZ o.Cst o'.Cst c Y').1 ((O.smapC o.Cst Y Y' f).1 w)) (cf.1 w) = split {
    inl a -> refl (inl (c.1 a)) ; inr y -> refl (inr (f.1 y)) } ;
  betaLow (w : (S4.Sm o.Cst Y).car) : Id A'.car (beta.1 ((o.sgi Y).1 (inl w))) ((o'.sgi Y').1 (inl (cf.1 w))) =
    PL.trans A'.car (beta.1 ((o.sgi Y).1 (inl w))) ((tau Y').1 ((o.sgi Y').1 (inl ((O.smapC o.Cst Y Y' f).1 w)))) ((o'.sgi Y').1 (inl (cf.1 w)))
      (PL.ap (o.k Y').car A'.car (tau Y').1 ((o.km Y Y' f).1 ((o.sgi Y).1 (inl w))) ((o.sgi Y').1 (inl ((O.smapC o.Cst Y Y' f).1 w))) (o.natS Y Y' f w))
      (PL.trans A'.car ((tau Y').1 ((o.sgi Y').1 (inl ((O.smapC o.Cst Y Y' f).1 w))))
         ((o'.sgi Y').1 (inl ((SH.Rel[ev,phi,evN].cZ o.Cst o'.Cst c Y').1 ((O.smapC o.Cst Y Y' f).1 w)))) ((o'.sgi Y').1 (inl (cf.1 w)))
        (rl.2.2.2 Y' ((O.smapC o.Cst Y Y' f).1 w))
        (PL.ap (S4.Sm o'.Cst Y').car A'.car (\ z -> (o'.sgi Y').1 (inl z)) ((SH.Rel[ev,phi,evN].cZ o.Cst o'.Cst c Y').1 ((O.smapC o.Cst Y Y' f).1 w)) (cf.1 w) (cfZ w))) ;
  -- the relation along beta, between outputs of premises at stages a and a'
  HOs (n : W.N) (a : A.car) (a' : A'.car) (x : S4.OutM[ev,phi,A,top].Out (I.step A (o.G Y) (o.R Y nilL) (n,inr a)))
      (x' : S4.OutM[ev,phi,A',top'].Out (I.step A' (o'.G Y') (o'.R Y' nilL) (n,inr a'))) : U l =
    ST.HomOut A A' top top' beta bt (I.step A (o.G Y) (o.R Y nilL) (n,inr a)) (I.step A' (o'.G Y') (o'.R Y' nilL) (n,inr a')) x x' ;
  -- transport of the outputs along the stage: the derivation is unchanged
  trD (n : W.N) (a : A.car) (x : S4.OutM[ev,phi,A,top].Out (I.step A (o.G Y) (o.R Y nilL) (n,inr a))) :
      (b : A.car) (eb : Id A.car a b) -> Id (BetaIDCf[l].Cf (LT.Lab (S4.Sm A x.1)).car (S4.Sm A x.1).car) (X.trO n a b eb x).2.2.1 x.2.2.1 =
    \ b eb -> idJ A.car a (\ b0 q0 -> Id (BetaIDCf[l].Cf (LT.Lab (S4.Sm A x.1)).car (S4.Sm A x.1).car) (X.trO n a b0 q0 x).2.2.1 x.2.2.1) (refl x.2.2.1) b eb ;
  trD' (n : W.N) (a : A'.car) (x : S4.OutM[ev,phi,A',top'].Out (I.step A' (o'.G Y') (o'.R Y' nilL) (n,inr a))) :
      (b : A'.car) (eb : Id A'.car a b) -> Id (BetaIDCf[l].Cf (LT.Lab (S4.Sm A' x.1)).car (S4.Sm A' x.1).car) (X'.trO n a b eb x).2.2.1 x.2.2.1 =
    \ b eb -> idJ A'.car a (\ b0 q0 -> Id (BetaIDCf[l].Cf (LT.Lab (S4.Sm A' x.1)).car (S4.Sm A' x.1).car) (X'.trO n a b0 q0 x).2.2.1 x.2.2.1) (refl x.2.2.1) b eb ;
  trH (n : W.N) (a b : A.car) (eb : Id A.car a b) (a' b' : A'.car) (eb' : Id A'.car a' b')
      (x : S4.OutM[ev,phi,A,top].Out (I.step A (o.G Y) (o.R Y nilL) (n,inr a)))
      (x' : S4.OutM[ev,phi,A',top'].Out (I.step A' (o'.G Y') (o'.R Y' nilL) (n,inr a')))
      (r : HOs n a a' x x') : HOs n b b' (X.trO n a b eb x) (X'.trO n a' b' eb' x') =
    (r.1,
     PL.subst (BetaIDCf[l].Cf (LT.Lab (S4.Sm A' x'.1)).car (S4.Sm A' x'.1).car)
       (\ z -> BH.NH[ev,phi,S4.Sm A x.1,S4.Sm A' x'.1,ST.extM A A' x.1 x'.1 beta r.1,
          S4.evMap ev evN (S4.Sm A x.1) (S4.Sm A' x'.1) (ST.extM A A' x.1 x'.1 beta r.1),inl top,inl top',ST.extTop A A' x.1 x'.1 beta r.1 top top' bt].RelF
          (X.trO n a b eb x).2.2.1 z)
       x'.2.2.1 (X'.trO n a' b' eb' x').2.2.1 (PL.sym (BetaIDCf[l].Cf (LT.Lab (S4.Sm A' x'.1)).car (S4.Sm A' x'.1).car) (X'.trO n a' b' eb' x').2.2.1 x'.2.2.1 (trD' n a' x' b' eb'))
       (PL.subst (BetaIDCf[l].Cf (LT.Lab (S4.Sm A x.1)).car (S4.Sm A x.1).car)
         (\ z -> BH.NH[ev,phi,S4.Sm A x.1,S4.Sm A' x'.1,ST.extM A A' x.1 x'.1 beta r.1,
            S4.evMap ev evN (S4.Sm A x.1) (S4.Sm A' x'.1) (ST.extM A A' x.1 x'.1 beta r.1),inl top,inl top',ST.extTop A A' x.1 x'.1 beta r.1 top top' bt].RelF z x'.2.2.1)
         x.2.2.1 (X.trO n a b eb x).2.2.1 (PL.sym (BetaIDCf[l].Cf (LT.Lab (S4.Sm A x.1)).car (S4.Sm A x.1).car) (X.trO n a b eb x).2.2.1 x.2.2.1 (trD n a x b eb))
         r.2)) ;
  ----------------------------------------------------------------------
  -- a constant stage
  CnRel (c0 : o.Cst.car) (hY : Id W.O3 (A.cmp ((o.sgi Y).1 (inl (inl c0))) (X.X0.bdZ Y)) lt)
      (hY' : Id W.O3 (A'.cmp ((o'.sgi Y').1 (inl (inl (c.1 c0)))) (X'.X0.bdZ Y')) lt)
      (n : W.N) (hm : Id W.Bool (BP.isZeroN n) true) (hm' : Id W.Bool (BP.isZeroN n) true) :
      HOs n ((o.sgi Y).1 (inl (inl c0))) ((o'.sgi Y').1 (inl (inl (c.1 c0)))) (X.X0.Cn[c0,hY].out n hm) (X'.X0.Cn[c.1 c0,hY'].out n hm') =
    ihr (inl (X.X0.Cn[c0,hY].st n hm)) (inl (X'.X0.Cn[c.1 c0,hY'].st n hm')) c tau
      (HR.PShRel[ev,phi,evN,o,o',c,tau,rl,X.X0.Cn[c0,hY].st n hm,X'.X0.Cn[c.1 c0,hY'].st n hm',
        \ Z -> PL.ap (o'.k Z).car (I.Lb (o'.k Z)) (\ q -> (n,inr q)) ((tau Z).1 ((o.sgi Z).1 (inl (inl c0)))) ((o'.sgi Z).1 (inl (inl (c.1 c0))))
          (rl.2.2.2 Z (inl c0))].rel) Y Y' wY wY' f ;
  ----------------------------------------------------------------------
  -- a variable stage
  eqwV : (v : (S4.Sm Y BA.E0).car) ->
      Id (S4.Sm o.Cst (S4.Sm Y BA.E0)).car ((O.smapC o.Cst (S4.Sm Y BA.E0) (S4.Sm Y BA.E0) (O.smapC Y BA.E0 BA.E0 (S4.Main[ev,phi,evN,hPos].e0 BA.E0))).1 (inr v)) (inr v) = split {
    inl y -> refl (inr (inl y)) ;
    inr x -> CF.efq (Id (S4.Sm o.Cst (S4.Sm Y BA.E0)).car
      ((O.smapC o.Cst (S4.Sm Y BA.E0) (S4.Sm Y BA.E0) (O.smapC Y BA.E0 BA.E0 (S4.Main[ev,phi,evN,hPos].e0 BA.E0))).1 (inr (inr x))) (inr (inr x))) x } ;
  eqw : (w : (S4.Sm o.Cst (S4.Sm Y BA.E0)).car) ->
      Id (S4.Sm o.Cst (S4.Sm Y BA.E0)).car ((O.smapC o.Cst (S4.Sm Y BA.E0) (S4.Sm Y BA.E0) (O.smapC Y BA.E0 BA.E0 (S4.Main[ev,phi,evN,hPos].e0 BA.E0))).1 w) w = split {
    inl a -> refl (inl a) ;
    inr v -> eqwV v } ;
  fZ0 : DP.Map (S4.Sm Y BA.E0) (S4.Sm Y' BA.E0) = PS.SumMap[Y,BA.E0,Y',BA.E0,f,LC.idMap BA.E0].map ;
  cfE : DP.Map (S4.Sm o.Cst (S4.Sm Y BA.E0)) (S4.Sm o'.Cst (S4.Sm Y' BA.E0)) = PS.SumMap[o.Cst,S4.Sm Y BA.E0,o'.Cst,S4.Sm Y' BA.E0,c,fZ0].map ;
  cfE0 : (w : (S4.Sm o.Cst (S4.Sm Y BA.E0)).car) ->
      Id (S4.Sm o'.Cst (S4.Sm Y' BA.E0)).car ((SH.Rel[ev,phi,evN].cZ o.Cst o'.Cst c (S4.Sm Y' BA.E0)).1 ((O.smapC o.Cst (S4.Sm Y BA.E0) (S4.Sm Y' BA.E0) fZ0).1 w)) (cfE.1 w) = split {
    inl a -> refl (inl (c.1 a)) ; inr v -> refl (inr (fZ0.1 v)) } ;
  module VrR (y : Y.car) (hY : Id W.O3 (A.cmp ((o.sgi Y).1 (inl (inr y))) (X.X0.bdZ Y)) lt)
      (hY' : Id W.O3 (A'.cmp ((o'.sgi Y').1 (inl (inr (f.1 y)))) (X'.X0.bdZ Y')) lt)
      (n : W.N) (hm : Id W.Bool (BP.isZeroN n) true) (hm' : Id W.Bool (BP.isZeroN n) true) {
    module V1 = X.Vr[y,hY] ;
    module V2 = X'.Vr[f.1 y,hY'] ;
    module ShR = SH.Rel[ev,phi,evN].ShiftRel[o,o',c,tau,rl,Y,Y',f,wY,wY',V1.lab n,(V1.st n hm).2.2.2.1,(V1.st n hm).2.2.2.2,
      V2.lab n,(V2.st n hm').2.2.2.1,(V2.st n hm').2.2.2.2] ;
    rel : SH.Rel[ev,phi,evN].RelIn ShR.S1.obj ShR.S2.obj ShR.c' ShR.tau' = ShR.Lab[ShR.varLab n y].rel ;
    childR : ST.HomOut (ShR.S1.obj.k BA.E0) (ShR.S2.obj.k BA.E0) (O.topO ShR.S1.obj BA.E0) (O.topO ShR.S2.obj BA.E0)
        (ST.baseF ShR.S1.obj ShR.S2.obj ShR.tau' BA.E0 BA.E0 (S4.Main[ev,phi,evN,hPos].e0 BA.E0))
        (ST.baseTop ShR.S1.obj ShR.S2.obj ShR.c' ShR.tau' rel BA.E0 BA.E0 (S4.Main[ev,phi,evN,hPos].e0 BA.E0))
        (ShR.S1.obj.G BA.E0) (ShR.S2.obj.G BA.E0) (V1.x0 n hm) (V2.x0 n hm') =
      ihr (inr (V1.st n hm)) (inr (V2.st n hm')) ShR.c' ShR.tau' rel BA.E0 BA.E0 BA.wfE0 BA.wfE0 (S4.Main[ev,phi,evN,hPos].e0 BA.E0) ;
    b : DP.Map (o.k (S4.Sm Y BA.E0)) (o'.k (S4.Sm Y' BA.E0)) = ST.baseF ShR.S1.obj ShR.S2.obj ShR.tau' BA.E0 BA.E0 (S4.Main[ev,phi,evN,hPos].e0 BA.E0) ;
    bTop : Id (o'.k (S4.Sm Y' BA.E0)).car (b.1 (O.topO o (S4.Sm Y BA.E0))) (O.topO o' (S4.Sm Y' BA.E0)) =
      ST.baseTop ShR.S1.obj ShR.S2.obj ShR.c' ShR.tau' rel BA.E0 BA.E0 (S4.Main[ev,phi,evN,hPos].e0 BA.E0) ;
    K0 : DP.LO = o.k (S4.Sm Y BA.E0) ;
    KY' : DP.LO = o.k (S4.Sm Y' BA.E0) ;
    K0' : DP.LO = o'.k (S4.Sm Y' BA.E0) ;
    bLow (w : (S4.Sm o.Cst (S4.Sm Y BA.E0)).car) : Id K0'.car (b.1 ((o.sgi (S4.Sm Y BA.E0)).1 (inl w))) ((o'.sgi (S4.Sm Y' BA.E0)).1 (inl (cfE.1 w))) =
      PL.trans K0'.car (b.1 ((o.sgi (S4.Sm Y BA.E0)).1 (inl w)))
        ((tau (S4.Sm Y' BA.E0)).1 ((ShR.kf BA.E0).1 ((o.sgi (S4.Sm Y BA.E0)).1 (inl w)))) ((o'.sgi (S4.Sm Y' BA.E0)).1 (inl (cfE.1 w)))
        (PL.ap K0.car K0'.car (\ q -> (tau (S4.Sm Y' BA.E0)).1 ((ShR.kf BA.E0).1 q))
          ((o.km (S4.Sm Y BA.E0) (S4.Sm Y BA.E0) (O.smapC Y BA.E0 BA.E0 (S4.Main[ev,phi,evN,hPos].e0 BA.E0))).1 ((o.sgi (S4.Sm Y BA.E0)).1 (inl w)))
          ((o.sgi (S4.Sm Y BA.E0)).1 (inl w))
          (PL.trans K0.car ((o.km (S4.Sm Y BA.E0) (S4.Sm Y BA.E0) (O.smapC Y BA.E0 BA.E0 (S4.Main[ev,phi,evN,hPos].e0 BA.E0))).1 ((o.sgi (S4.Sm Y BA.E0)).1 (inl w)))
            ((o.sgi (S4.Sm Y BA.E0)).1 (inl ((O.smapC o.Cst (S4.Sm Y BA.E0) (S4.Sm Y BA.E0) (O.smapC Y BA.E0 BA.E0 (S4.Main[ev,phi,evN,hPos].e0 BA.E0))).1 w)))
            ((o.sgi (S4.Sm Y BA.E0)).1 (inl w))
            (o.natS (S4.Sm Y BA.E0) (S4.Sm Y BA.E0) (O.smapC Y BA.E0 BA.E0 (S4.Main[ev,phi,evN,hPos].e0 BA.E0)) w)
            (PL.ap (S4.Sm o.Cst (S4.Sm Y BA.E0)).car K0.car (\ z -> (o.sgi (S4.Sm Y BA.E0)).1 (inl z))
              ((O.smapC o.Cst (S4.Sm Y BA.E0) (S4.Sm Y BA.E0) (O.smapC Y BA.E0 BA.E0 (S4.Main[ev,phi,evN,hPos].e0 BA.E0))).1 w) w (eqw w))))
        (PL.trans K0'.car ((tau (S4.Sm Y' BA.E0)).1 ((ShR.kf BA.E0).1 ((o.sgi (S4.Sm Y BA.E0)).1 (inl w))))
           ((tau (S4.Sm Y' BA.E0)).1 ((o.sgi (S4.Sm Y' BA.E0)).1 (inl ((O.smapC o.Cst (S4.Sm Y BA.E0) (S4.Sm Y' BA.E0) fZ0).1 w))))
           ((o'.sgi (S4.Sm Y' BA.E0)).1 (inl (cfE.1 w)))
          (PL.ap KY'.car K0'.car (tau (S4.Sm Y' BA.E0)).1 ((ShR.kf BA.E0).1 ((o.sgi (S4.Sm Y BA.E0)).1 (inl w)))
            ((o.sgi (S4.Sm Y' BA.E0)).1 (inl ((O.smapC o.Cst (S4.Sm Y BA.E0) (S4.Sm Y' BA.E0) fZ0).1 w))) (o.natS (S4.Sm Y BA.E0) (S4.Sm Y' BA.E0) fZ0 w))
          (PL.trans K0'.car ((tau (S4.Sm Y' BA.E0)).1 ((o.sgi (S4.Sm Y' BA.E0)).1 (inl ((O.smapC o.Cst (S4.Sm Y BA.E0) (S4.Sm Y' BA.E0) fZ0).1 w))))
             ((o'.sgi (S4.Sm Y' BA.E0)).1 (inl ((SH.Rel[ev,phi,evN].cZ o.Cst o'.Cst c (S4.Sm Y' BA.E0)).1 ((O.smapC o.Cst (S4.Sm Y BA.E0) (S4.Sm Y' BA.E0) fZ0).1 w))))
             ((o'.sgi (S4.Sm Y' BA.E0)).1 (inl (cfE.1 w)))
            (rl.2.2.2 (S4.Sm Y' BA.E0) ((O.smapC o.Cst (S4.Sm Y BA.E0) (S4.Sm Y' BA.E0) fZ0).1 w))
            (PL.ap (S4.Sm o'.Cst (S4.Sm Y' BA.E0)).car K0'.car (\ z -> (o'.sgi (S4.Sm Y' BA.E0)).1 (inl z))
              ((SH.Rel[ev,phi,evN].cZ o.Cst o'.Cst c (S4.Sm Y' BA.E0)).1 ((O.smapC o.Cst (S4.Sm Y BA.E0) (S4.Sm Y' BA.E0) fZ0).1 w)) (cfE.1 w) (cfE0 w)))) ;
    E : DP.LO = (V1.x0 n hm).1 ;
    E' : DP.LO = (V2.x0 n hm').1 ;
    module VV = TrCSquare[l].Variable[ev,phi,evN,o,o',c,Y,Y',f,b,bTop,bLow,beta,bt,betaLow,E,E',childR.1,hPos] ;
    module BK = VV.Back[X.hrJ,X'.hrJ] ;
    G0 : I.Seq A = I.step A (o.G Y) (o.R Y nilL) (n,inr V1.nu) ;
    G0' : I.Seq A' = I.step A' (o'.G Y') (o'.R Y' nilL) (n,inr V2.nu) ;
    d : S4.OutM[ev,phi,K0,O.topO o (S4.Sm Y BA.E0)].OnE E (BK.B0.MH.mS G0) =
      PL.subst (I.Seq K0) (\ Zs -> S4.OutM[ev,phi,K0,O.topO o (S4.Sm Y BA.E0)].OnE E Zs)
        (I.step K0 (o.G (S4.Sm Y BA.E0)) (o.R (S4.Sm Y BA.E0) nilL) (V1.lab n BA.E0)) (BK.B0.MH.mS G0) (V1.eS n) (V1.x0 n hm).2.2 ;
    d' : S4.OutM[ev,phi,K0',O.topO o' (S4.Sm Y' BA.E0)].OnE E' (BK.B1.MH.mS G0') =
      PL.subst (I.Seq K0') (\ Zs -> S4.OutM[ev,phi,K0',O.topO o' (S4.Sm Y' BA.E0)].OnE E' Zs)
        (I.step K0' (o'.G (S4.Sm Y' BA.E0)) (o'.R (S4.Sm Y' BA.E0) nilL) (V2.lab n BA.E0)) (BK.B1.MH.mS G0') (V2.eS n) (V2.x0 n hm').2.2 ;
    -- the derivations are unchanged by the transport of their sequents
    CfK : U l = BetaIDCf[l].Cf (LT.Lab (S4.Sm K0 E)).car (S4.Sm K0 E).car ;
    CfK' : U l = BetaIDCf[l].Cf (LT.Lab (S4.Sm K0' E')).car (S4.Sm K0' E').car ;
    dEq : Id CfK d.1 (V1.x0 n hm).2.2.1 =
      idJ (I.Seq K0) (I.step K0 (o.G (S4.Sm Y BA.E0)) (o.R (S4.Sm Y BA.E0) nilL) (V1.lab n BA.E0))
        (\ Zs q -> Id CfK (PL.subst (I.Seq K0) (\ Ws -> S4.OutM[ev,phi,K0,O.topO o (S4.Sm Y BA.E0)].OnE E Ws)
           (I.step K0 (o.G (S4.Sm Y BA.E0)) (o.R (S4.Sm Y BA.E0) nilL) (V1.lab n BA.E0)) Zs q (V1.x0 n hm).2.2).1 (V1.x0 n hm).2.2.1)
        (refl (V1.x0 n hm).2.2.1) (BK.B0.MH.mS G0) (V1.eS n) ;
    dEq' : Id CfK' d'.1 (V2.x0 n hm').2.2.1 =
      idJ (I.Seq K0') (I.step K0' (o'.G (S4.Sm Y' BA.E0)) (o'.R (S4.Sm Y' BA.E0) nilL) (V2.lab n BA.E0))
        (\ Zs q -> Id CfK' (PL.subst (I.Seq K0') (\ Ws -> S4.OutM[ev,phi,K0',O.topO o' (S4.Sm Y' BA.E0)].OnE E' Ws)
           (I.step K0' (o'.G (S4.Sm Y' BA.E0)) (o'.R (S4.Sm Y' BA.E0) nilL) (V2.lab n BA.E0)) Zs q (V2.x0 n hm').2.2).1 (V2.x0 n hm').2.2.1)
        (refl (V2.x0 n hm').2.2.1) (BK.B1.MH.mS G0') (V2.eS n) ;
    rr : BK.H.U0.RelF d.1 d'.1 =
      PL.subst CfK' (\ z -> BK.H.U0.RelF d.1 z) (V2.x0 n hm').2.2.1 d'.1 (PL.sym CfK' d'.1 (V2.x0 n hm').2.2.1 dEq')
        (PL.subst CfK (\ z -> BK.H.U0.RelF z (V2.x0 n hm').2.2.1) (V1.x0 n hm).2.2.1 d.1 (PL.sym CfK d.1 (V1.x0 n hm).2.2.1 dEq) childR.2) ;
    -- the two variable-premise outputs are related
    eV : DP.Map (S4.Sm X.Ext E) (S4.Sm X'.Ext E') = PS.SumMap[VV.V.Ext,E,VV.V'.Ext,E',VV.X.tlMap,childR.1].map ;
    out : HOs n V1.nu V2.nu (V1.out n hm) (V2.out n hm') =
      (eV,HR.RelConvT[ev,phi,VV.X.T,VV.X.T',VV.X.v,S4.evMap ev evN VV.X.T VV.X.T' VV.X.v,BK.B0.JMap.1 (inl VV.V.topE),BK.B1.JMap.1 (inl VV.V'.topE),BK.H.topSq,
          inl top,inl top',ST.extTop A A' (S4.Sm X.Ext E) (S4.Sm X'.Ext E') beta eV top top' bt].relC
        (BK.B0.back G0 d).1 (BK.B1.back G0' d').1 (BK.backRel G0 G0' d d' rr)) ;
  } ;
  ----------------------------------------------------------------------
  -- the stage dispatch: the target decomposition is the image of the source one
  PY' : DP.LO = O.P o'.Cst o'.Fp Y' ;
  sgiInj (x y : PY'.car) (h : Id A'.car ((o'.sgi Y').1 x) ((o'.sgi Y').1 y)) : Id PY'.car x y =
    PL.trans PY'.car x ((o'.sg Y').1 ((o'.sgi Y').1 y)) y
      (PL.trans PY'.car x ((o'.sg Y').1 ((o'.sgi Y').1 x)) ((o'.sg Y').1 ((o'.sgi Y').1 y))
        (PL.sym PY'.car ((o'.sg Y').1 ((o'.sgi Y').1 x)) x (o'.ret Y' x))
        (PL.ap A'.car PY'.car (o'.sg Y').1 ((o'.sgi Y').1 x) ((o'.sgi Y').1 y) h))
      (o'.ret Y' y) ;
  weq (nu : A.car) (w : (S4.Sm o.Cst Y).car) (ew : Id A.car nu ((o.sgi Y).1 (inl w)))
      (w' : (S4.Sm o'.Cst Y').car) (ew' : Id A'.car (beta.1 nu) ((o'.sgi Y').1 (inl w'))) : Id (S4.Sm o'.Cst Y').car (cf.1 w) w' =
    PS.SumLO[S4.Sm o'.Cst Y',S4.Sm LT.one (o'.Fp Y')].inl-inj (cf.1 w) w'
      (sgiInj (inl (cf.1 w)) (inl w')
        (PL.trans A'.car ((o'.sgi Y').1 (inl (cf.1 w))) (beta.1 nu) ((o'.sgi Y').1 (inl w'))
          (PL.sym A'.car (beta.1 nu) ((o'.sgi Y').1 (inl (cf.1 w)))
            (PL.trans A'.car (beta.1 nu) (beta.1 ((o.sgi Y).1 (inl w))) ((o'.sgi Y').1 (inl (cf.1 w)))
              (PL.ap A.car A'.car beta.1 nu ((o.sgi Y).1 (inl w)) ew) (betaLow w)))
          ew')) ;
  pWH0 (n : W.N) (hm hm' : Id W.Bool (BP.isZeroN n) true) (nu : A.car) (hlt : Id W.O3 (A.cmp nu (X.X0.bdZ Y)) lt)
      (hlt' : Id W.O3 (A'.cmp (beta.1 nu) (X'.X0.bdZ Y')) lt) :
      (w : (S4.Sm o.Cst Y).car) (ew : Id A.car nu ((o.sgi Y).1 (inl w))) (ew' : Id A'.car (beta.1 nu) ((o'.sgi Y').1 (inl (cf.1 w)))) ->
      HOs n nu (beta.1 nu) (X.pW n hm nu hlt w ew) (X'.pW n hm' (beta.1 nu) hlt' (cf.1 w) ew') = split {
    inl c0 -> \ ew ew' -> trH n ((o.sgi Y).1 (inl (inl c0))) nu (PL.sym A.car nu ((o.sgi Y).1 (inl (inl c0))) ew)
      ((o'.sgi Y').1 (inl (inl (c.1 c0)))) (beta.1 nu) (PL.sym A'.car (beta.1 nu) ((o'.sgi Y').1 (inl (inl (c.1 c0)))) ew')
      (X.X0.Cn[c0,PL.subst A.car (\ z -> Id W.O3 (A.cmp z (X.X0.bdZ Y)) lt) nu ((o.sgi Y).1 (inl (inl c0))) ew hlt].out n hm)
      (X'.X0.Cn[c.1 c0,PL.subst A'.car (\ z -> Id W.O3 (A'.cmp z (X'.X0.bdZ Y')) lt) (beta.1 nu) ((o'.sgi Y').1 (inl (inl (c.1 c0)))) ew' hlt'].out n hm')
      (CnRel c0 (PL.subst A.car (\ z -> Id W.O3 (A.cmp z (X.X0.bdZ Y)) lt) nu ((o.sgi Y).1 (inl (inl c0))) ew hlt)
        (PL.subst A'.car (\ z -> Id W.O3 (A'.cmp z (X'.X0.bdZ Y')) lt) (beta.1 nu) ((o'.sgi Y').1 (inl (inl (c.1 c0)))) ew' hlt') n hm hm') ;
    inr y -> \ ew ew' -> trH n ((o.sgi Y).1 (inl (inr y))) nu (PL.sym A.car nu ((o.sgi Y).1 (inl (inr y))) ew)
      ((o'.sgi Y').1 (inl (inr (f.1 y)))) (beta.1 nu) (PL.sym A'.car (beta.1 nu) ((o'.sgi Y').1 (inl (inr (f.1 y)))) ew')
      (X.Vr[y,PL.subst A.car (\ z -> Id W.O3 (A.cmp z (X.X0.bdZ Y)) lt) nu ((o.sgi Y).1 (inl (inr y))) ew hlt].out n hm)
      (X'.Vr[f.1 y,PL.subst A'.car (\ z -> Id W.O3 (A'.cmp z (X'.X0.bdZ Y')) lt) (beta.1 nu) ((o'.sgi Y').1 (inl (inr (f.1 y)))) ew' hlt'].out n hm')
      (VrR[y,PL.subst A.car (\ z -> Id W.O3 (A.cmp z (X.X0.bdZ Y)) lt) nu ((o.sgi Y).1 (inl (inr y))) ew hlt,
        PL.subst A'.car (\ z -> Id W.O3 (A'.cmp z (X'.X0.bdZ Y')) lt) (beta.1 nu) ((o'.sgi Y').1 (inl (inr (f.1 y)))) ew' hlt',n,hm,hm'].out) } ;
  pWH (n : W.N) (hm hm' : Id W.Bool (BP.isZeroN n) true) (nu : A.car) (hlt : Id W.O3 (A.cmp nu (X.X0.bdZ Y)) lt)
      (hlt' : Id W.O3 (A'.cmp (beta.1 nu) (X'.X0.bdZ Y')) lt)
      (w : (S4.Sm o.Cst Y).car) (ew : Id A.car nu ((o.sgi Y).1 (inl w)))
      (w' : (S4.Sm o'.Cst Y').car) (ew' : Id A'.car (beta.1 nu) ((o'.sgi Y').1 (inl w'))) :
      HOs n nu (beta.1 nu) (X.pW n hm nu hlt w ew) (X'.pW n hm' (beta.1 nu) hlt' w' ew') =
    PL.subst (S4.Sm o'.Cst Y').car (\ w0 -> (ew0 : Id A'.car (beta.1 nu) ((o'.sgi Y').1 (inl w0))) ->
        HOs n nu (beta.1 nu) (X.pW n hm nu hlt w ew) (X'.pW n hm' (beta.1 nu) hlt' w0 ew0))
      (cf.1 w) w' (weq nu w ew w' ew') (pWH0 n hm hm' nu hlt hlt' w ew) ew' ;
  -- the stage relation of the node
  sprP (n : W.N) (nu : A.car) (hb : Id W.Bool (I.below A (X.X0.bdZ Y) (n,inr nu)) true) (ht : Id W.O3 (A.cmp nu top) lt)
      (hb' : Id W.Bool (I.below A' (X'.X0.bdZ Y') (n,inr (beta.1 nu))) true) (ht' : Id W.O3 (A'.cmp (beta.1 nu) top') lt) :
      HOs n nu (beta.1 nu) (X.pStage n nu hb ht) (X'.pStage n (beta.1 nu) hb' ht') =
    pWH n (W.andB-l (BP.isZeroN n) (I.ltB A nu (X.X0.bdZ Y)) hb) (W.andB-l (BP.isZeroN n) (I.ltB A' (beta.1 nu) (X'.X0.bdZ Y')) hb') nu
      (W.isLt-sound (A.cmp nu (X.X0.bdZ Y)) (W.andB-r (BP.isZeroN n) (I.ltB A nu (X.X0.bdZ Y)) hb))
      (W.isLt-sound (A'.cmp (beta.1 nu) (X'.X0.bdZ Y')) (W.andB-r (BP.isZeroN n) (I.ltB A' (beta.1 nu) (X'.X0.bdZ Y')) hb'))
      (X.SY.belowW nu ht).1 (X.SY.belowW nu ht).2 (X'.SY.belowW (beta.1 nu) ht').1 (X'.SY.belowW (beta.1 nu) ht').2 ;
  hbC (n : W.N) (nu : A.car) (h : Id W.Bool (I.br A top (o.R Y nilL) (n,inr nu)) true) : Id W.Bool (I.below A (X.X0.bdZ Y) (n,inr nu)) true =
    PL.trans W.Bool (I.below A (X.X0.bdZ Y) (n,inr nu)) (I.br A top (o.R Y nilL) (n,inr nu)) true
      (PL.ap (I.Rule A) W.Bool (\ z -> I.br A top z (n,inr nu)) (xlR i (X.X0.omZ Y)) (o.R Y nilL)
        (PL.sym (I.Rule A) (o.R Y nilL) (xlR i (X.X0.omZ Y)) (X.X0.ruleZ Y))) h ;
  hbC' (n : W.N) (nu : A'.car) (h : Id W.Bool (I.br A' top' (o'.R Y' nilL) (n,inr nu)) true) : Id W.Bool (I.below A' (X'.X0.bdZ Y') (n,inr nu)) true =
    PL.trans W.Bool (I.below A' (X'.X0.bdZ Y') (n,inr nu)) (I.br A' top' (o'.R Y' nilL) (n,inr nu)) true
      (PL.ap (I.Rule A') W.Bool (\ z -> I.br A' top' z (n,inr nu)) (xlR i (X'.X0.omZ Y')) (o'.R Y' nilL)
        (PL.sym (I.Rule A') (o'.R Y' nilL) (xlR i (X'.X0.omZ Y')) (X'.X0.ruleZ Y'))) h ;
  spr : BetaIDS4HomNode[l].NodeD[ev,phi,evN,hPos,o,o',ih,ih',ihr,c,tau,rl,Y,Y',wY,wY',f].SPR
      (S4.Disp[ev,phi,evN,hPos,o,ih,Y,wY].spXl i oo0 e) (S4.Disp[ev,phi,evN,hPos,o',ih',Y',wY'].spXl i oo0' e') =
    \ n nu h ht h' ht' -> sprP n nu (hbC n nu h) (W.isLt-sound (A.cmp nu top) ht) (hbC' n (beta.1 nu) h') (W.isLt-sound (A'.cmp (beta.1 nu) top') ht') ;
} ;

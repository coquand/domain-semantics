-- A finite signature of the existing object-syntax and derivation constructors.
-- Values are the original constructors, not a second presentation of the rules.
level l ; open Base ; open Prelude[l] ; open Lib[l] ; open Syntax[l] ;
open ConstructorEnumeration[l] ; open DerivationSorts[l] ; module S = DerivationSorts[l] ;
nat-zero-type : Telescope = result (natural) ;
nat-zero-value : Value nat-zero-type = zero ;
nat-zero : State = (nat-zero-type,nat-zero-value) ;
nat-suc-type : Telescope = argument (natural) (\ n -> result (natural)) ;
nat-suc-value : Value nat-suc-type = \ n -> suc n ;
nat-suc : State = (nat-suc-type,nat-suc-value) ;
fin-zero-type : Telescope = argument (natural) (\ n -> result (variable (suc n))) ;
fin-zero-value : Value fin-zero-type = \ n -> fz n ;
fin-zero : State = (fin-zero-type,fin-zero-value) ;
fin-suc-type : Telescope = argument (natural) (\ n -> argument (variable n) (\ i -> result (variable (suc n)))) ;
fin-suc-value : Value fin-suc-type = \ n i -> fs n i ;
fin-suc : State = (fin-suc-type,fin-suc-value) ;
term-var-type : Telescope = argument (natural) (\ n -> argument (variable n) (\ i -> result (term n))) ;
term-var-value : Value term-var-type = \ n i -> var n i ;
term-var : State = (term-var-type,term-var-value) ;
term-U-type : Telescope = argument (natural) (\ n -> result (term n)) ;
term-U-value : Value term-U-type = \ n -> uu n ;
term-U : State = (term-U-type,term-U-value) ;
term-Pi-type : Telescope = argument (natural) (\ n -> argument (term n) (\ A -> argument (term (suc n)) (\ B -> result (term n)))) ;
term-Pi-value : Value term-Pi-type = \ n A B -> pp n A B ;
term-Pi : State = (term-Pi-type,term-Pi-value) ;
term-lam-type : Telescope = argument (natural) (\ n -> argument (term n) (\ A -> argument (term (suc n)) (\ M -> result (term n)))) ;
term-lam-value : Value term-lam-type = \ n A M -> lam n A M ;
term-lam : State = (term-lam-type,term-lam-value) ;
term-app-type : Telescope = argument (natural) (\ n -> argument (term n) (\ M -> argument (term n) (\ N -> result (term n)))) ;
term-app-value : Value term-app-type = \ n M N -> app n M N ;
term-app : State = (term-app-type,term-app-value) ;
ctx-empty-type : Telescope = result (context zero) ;
ctx-empty-value : Value ctx-empty-type = tt ;
ctx-empty : State = (ctx-empty-type,ctx-empty-value) ;
ctx-ext-type : Telescope = argument (natural) (\ n -> argument (context n) (\ G -> argument (term n) (\ A -> result (context (suc n))))) ;
ctx-ext-value : Value ctx-ext-type = \ n G A -> ext n G A ;
ctx-ext : State = (ctx-ext-type,ctx-ext-value) ;
rule-wf-emp-type : Telescope = result (proof (zero,(jwf tt))) ;
rule-wf-emp-value : Value rule-wf-emp-type = wf-emp ;
rule-wf-emp : State = (rule-wf-emp-type,rule-wf-emp-value) ;
rule-wf-ext-type : Telescope = argument (natural) (\ n -> argument (context n) (\ G -> argument (term n) (\ A -> argument (proof (n,(jty G A (uu n)))) (\ h -> result (proof ((suc n),(jwf (ext n G A)))))))) ;
rule-wf-ext-value : Value rule-wf-ext-type = \ n G A h -> wf-ext n G A h ;
rule-wf-ext : State = (rule-wf-ext-type,rule-wf-ext-value) ;
rule-ty-var-type : Telescope = argument (natural) (\ n -> argument (context n) (\ G -> argument (variable n) (\ i -> argument (proof (n,(jwf G))) (\ h -> result (proof (n,(jty G (var n i) (lookup n G i)))))))) ;
rule-ty-var-value : Value rule-ty-var-type = \ n G i h -> ty-var n G i h ;
rule-ty-var : State = (rule-ty-var-type,rule-ty-var-value) ;
rule-ty-conv-type : Telescope = argument (natural) (\ n -> argument (context n) (\ G -> argument (term n) (\ M -> argument (term n) (\ A -> argument (term n) (\ B -> argument (proof (n,(jty G M A))) (\ h1 -> argument (proof (n,(jeq G A B (uu n)))) (\ h2 -> argument (proof (n,(jty G B (uu n)))) (\ h3 -> result (proof (n,(jty G M B))))))))))) ;
rule-ty-conv-value : Value rule-ty-conv-type = \ n G M A B h1 h2 h3 -> ty-conv n G M A B h1 h2 h3 ;
rule-ty-conv : State = (rule-ty-conv-type,rule-ty-conv-value) ;
rule-ty-U-type : Telescope = argument (natural) (\ n -> argument (context n) (\ G -> argument (proof (n,(jwf G))) (\ h -> result (proof (n,(jty G (uu n) (uu n))))))) ;
rule-ty-U-value : Value rule-ty-U-type = \ n G h -> ty-U n G h ;
rule-ty-U : State = (rule-ty-U-type,rule-ty-U-value) ;
rule-ty-Pi-type : Telescope = argument (natural) (\ n -> argument (context n) (\ G -> argument (term n) (\ A -> argument (term (suc n)) (\ B -> argument (proof (n,(jty G A (uu n)))) (\ h1 -> argument (proof ((suc n),(jty (ext n G A) B (uu (suc n))))) (\ h2 -> result (proof (n,(jty G (pp n A B) (uu n)))))))))) ;
rule-ty-Pi-value : Value rule-ty-Pi-type = \ n G A B h1 h2 -> ty-Pi n G A B h1 h2 ;
rule-ty-Pi : State = (rule-ty-Pi-type,rule-ty-Pi-value) ;
rule-ty-Lam-type : Telescope = argument (natural) (\ n -> argument (context n) (\ G -> argument (term n) (\ A -> argument (term (suc n)) (\ B -> argument (term (suc n)) (\ M -> argument (proof (n,(jty G A (uu n)))) (\ h1 -> argument (proof ((suc n),(jty (ext n G A) B (uu (suc n))))) (\ h2 -> argument (proof ((suc n),(jty (ext n G A) M B))) (\ h3 -> result (proof (n,(jty G (lam n A M) (pp n A B)))))))))))) ;
rule-ty-Lam-value : Value rule-ty-Lam-type = \ n G A B M h1 h2 h3 -> ty-Lam n G A B M h1 h2 h3 ;
rule-ty-Lam : State = (rule-ty-Lam-type,rule-ty-Lam-value) ;
rule-ty-App-type : Telescope = argument (natural) (\ n -> argument (context n) (\ G -> argument (term n) (\ A -> argument (term (suc n)) (\ B -> argument (term n) (\ f -> argument (term n) (\ a -> argument (proof (n,(jty G A (uu n)))) (\ h1 -> argument (proof ((suc n),(jty (ext n G A) B (uu (suc n))))) (\ h2 -> argument (proof (n,(jty G f (pp n A B)))) (\ h3 -> argument (proof (n,(jty G a A))) (\ h4 -> result (proof (n,(jty G (app n f a) (subst1 n B a)))))))))))))) ;
rule-ty-App-value : Value rule-ty-App-type = \ n G A B f a h1 h2 h3 h4 -> ty-App n G A B f a h1 h2 h3 h4 ;
rule-ty-App : State = (rule-ty-App-type,rule-ty-App-value) ;
rule-eq-refl-type : Telescope = argument (natural) (\ n -> argument (context n) (\ G -> argument (term n) (\ M -> argument (term n) (\ A -> argument (proof (n,(jty G M A))) (\ h -> result (proof (n,(jeq G M M A)))))))) ;
rule-eq-refl-value : Value rule-eq-refl-type = \ n G M A h -> eq-refl n G M A h ;
rule-eq-refl : State = (rule-eq-refl-type,rule-eq-refl-value) ;
rule-eq-sym-type : Telescope = argument (natural) (\ n -> argument (context n) (\ G -> argument (term n) (\ M -> argument (term n) (\ N -> argument (term n) (\ A -> argument (proof (n,(jeq G M N A))) (\ h -> result (proof (n,(jeq G N M A))))))))) ;
rule-eq-sym-value : Value rule-eq-sym-type = \ n G M N A h -> eq-sym n G M N A h ;
rule-eq-sym : State = (rule-eq-sym-type,rule-eq-sym-value) ;
rule-eq-trans-type : Telescope = argument (natural) (\ n -> argument (context n) (\ G -> argument (term n) (\ M -> argument (term n) (\ N -> argument (term n) (\ P -> argument (term n) (\ A -> argument (proof (n,(jeq G M N A))) (\ h1 -> argument (proof (n,(jeq G N P A))) (\ h2 -> result (proof (n,(jeq G M P A))))))))))) ;
rule-eq-trans-value : Value rule-eq-trans-type = \ n G M N P A h1 h2 -> eq-trans n G M N P A h1 h2 ;
rule-eq-trans : State = (rule-eq-trans-type,rule-eq-trans-value) ;
rule-eq-conv-type : Telescope = argument (natural) (\ n -> argument (context n) (\ G -> argument (term n) (\ M -> argument (term n) (\ N -> argument (term n) (\ A -> argument (term n) (\ B -> argument (proof (n,(jeq G M N A))) (\ h1 -> argument (proof (n,(jeq G A B (uu n)))) (\ h2 -> argument (proof (n,(jty G B (uu n)))) (\ h3 -> result (proof (n,(jeq G M N B)))))))))))) ;
rule-eq-conv-value : Value rule-eq-conv-type = \ n G M N A B h1 h2 h3 -> eq-conv n G M N A B h1 h2 h3 ;
rule-eq-conv : State = (rule-eq-conv-type,rule-eq-conv-value) ;
rule-eq-beta-type : Telescope = argument (natural) (\ n -> argument (context n) (\ G -> argument (term n) (\ A -> argument (term (suc n)) (\ B -> argument (term (suc n)) (\ M -> argument (term n) (\ a -> argument (proof (n,(jty G A (uu n)))) (\ h1 -> argument (proof ((suc n),(jty (ext n G A) B (uu (suc n))))) (\ h2 -> argument (proof ((suc n),(jty (ext n G A) M B))) (\ h3 -> argument (proof (n,(jty G a A))) (\ h4 -> result (proof (n,(jeq G (app n (lam n A M) a) (subst1 n M a) (subst1 n B a)))))))))))))) ;
rule-eq-beta-value : Value rule-eq-beta-type = \ n G A B M a h1 h2 h3 h4 -> eq-beta n G A B M a h1 h2 h3 h4 ;
rule-eq-beta : State = (rule-eq-beta-type,rule-eq-beta-value) ;
rule-eq-Pi-type : Telescope = argument (natural) (\ n -> argument (context n) (\ G -> argument (term n) (\ A -> argument (term n) (\ A' -> argument (term (suc n)) (\ B -> argument (term (suc n)) (\ B' -> argument (proof (n,(jty G A (uu n)))) (\ h1 -> argument (proof ((suc n),(jty (ext n G A) B (uu (suc n))))) (\ h2 -> argument (proof ((suc n),(jty (ext n G A) B' (uu (suc n))))) (\ h3 -> argument (proof (n,(jeq G A A' (uu n)))) (\ h4 -> argument (proof ((suc n),(jeq (ext n G A) B B' (uu (suc n))))) (\ h5 -> result (proof (n,(jeq G (pp n A B) (pp n A' B') (uu n))))))))))))))) ;
rule-eq-Pi-value : Value rule-eq-Pi-type = \ n G A A' B B' h1 h2 h3 h4 h5 -> eq-Pi n G A A' B B' h1 h2 h3 h4 h5 ;
rule-eq-Pi : State = (rule-eq-Pi-type,rule-eq-Pi-value) ;
rule-eq-funext-type : Telescope = argument (natural) (\ n -> argument (context n) (\ G -> argument (term n) (\ A -> argument (term (suc n)) (\ B -> argument (term n) (\ f -> argument (term n) (\ g -> argument (proof (n,(jty G A (uu n)))) (\ h1 -> argument (proof ((suc n),(jeq (ext n G A) (app (suc n) (wk n f) (var (suc n) (fz n)))
                              (app (suc n) (wk n g) (var (suc n) (fz n))) B))) (\ h2 -> argument (proof (n,(jty G f (pp n A B)))) (\ h3 -> argument (proof (n,(jty G g (pp n A B)))) (\ h4 -> result (proof (n,(jeq G f g (pp n A B)))))))))))))) ;
rule-eq-funext-value : Value rule-eq-funext-type = \ n G A B f g h1 h2 h3 h4 -> eq-funext n G A B f g h1 h2 h3 h4 ;
rule-eq-funext : State = (rule-eq-funext-type,rule-eq-funext-value) ;
rule-eq-app-fun-type : Telescope = argument (natural) (\ n -> argument (context n) (\ G -> argument (term n) (\ A -> argument (term (suc n)) (\ B -> argument (term n) (\ f -> argument (term n) (\ f' -> argument (term n) (\ a -> argument (proof (n,(jty G A (uu n)))) (\ h1 -> argument (proof ((suc n),(jty (ext n G A) B (uu (suc n))))) (\ h2 -> argument (proof (n,(jeq G f f' (pp n A B)))) (\ h3 -> argument (proof (n,(jty G a A))) (\ h4 -> result (proof (n,(jeq G (app n f a) (app n f' a) (subst1 n B a))))))))))))))) ;
rule-eq-app-fun-value : Value rule-eq-app-fun-type = \ n G A B f f' a h1 h2 h3 h4 -> eq-app-fun n G A B f f' a h1 h2 h3 h4 ;
rule-eq-app-fun : State = (rule-eq-app-fun-type,rule-eq-app-fun-value) ;
rule-eq-app-arg-type : Telescope = argument (natural) (\ n -> argument (context n) (\ G -> argument (term n) (\ A -> argument (term (suc n)) (\ B -> argument (term n) (\ f -> argument (term n) (\ a -> argument (term n) (\ a' -> argument (proof (n,(jty G A (uu n)))) (\ h1 -> argument (proof ((suc n),(jty (ext n G A) B (uu (suc n))))) (\ h2 -> argument (proof (n,(jty G f (pp n A B)))) (\ h3 -> argument (proof (n,(jeq G a a' A))) (\ h4 -> result (proof (n,(jeq G (app n f a) (app n f a') (subst1 n B a))))))))))))))) ;
rule-eq-app-arg-value : Value rule-eq-app-arg-type = \ n G A B f a a' h1 h2 h3 h4 -> eq-app-arg n G A B f a a' h1 h2 h3 h4 ;
rule-eq-app-arg : State = (rule-eq-app-arg-type,rule-eq-app-arg-value) ;
constants : List State = cons nat-zero (cons nat-suc (cons fin-zero (cons fin-suc (cons term-var (cons term-U (cons term-Pi (cons term-lam (cons term-app (cons ctx-empty (cons ctx-ext (cons rule-wf-emp (cons rule-wf-ext (cons rule-ty-var (cons rule-ty-conv (cons rule-ty-U (cons rule-ty-Pi (cons rule-ty-Lam (cons rule-ty-App (cons rule-eq-refl (cons rule-eq-sym (cons rule-eq-trans (cons rule-eq-conv (cons rule-eq-beta (cons rule-eq-Pi (cons rule-eq-funext (cons rule-eq-app-fun (cons rule-eq-app-arg (nil)))))))))))))))))))))))))))) ;
module E = Closure[constants] ;
nat-zero-known : E.Known nat-zero = E.constant nat-zero (inl (refl nat-zero)) ;
nat-suc-known : E.Known nat-suc = E.constant nat-suc (inr (inl (refl nat-suc))) ;
fin-zero-known : E.Known fin-zero = E.constant fin-zero (inr (inr (inl (refl fin-zero)))) ;
fin-suc-known : E.Known fin-suc = E.constant fin-suc (inr (inr (inr (inl (refl fin-suc))))) ;
term-var-known : E.Known term-var = E.constant term-var (inr (inr (inr (inr (inl (refl term-var)))))) ;
term-U-known : E.Known term-U = E.constant term-U (inr (inr (inr (inr (inr (inl (refl term-U))))))) ;
term-Pi-known : E.Known term-Pi = E.constant term-Pi (inr (inr (inr (inr (inr (inr (inl (refl term-Pi)))))))) ;
term-lam-known : E.Known term-lam = E.constant term-lam (inr (inr (inr (inr (inr (inr (inr (inl (refl term-lam))))))))) ;
term-app-known : E.Known term-app = E.constant term-app (inr (inr (inr (inr (inr (inr (inr (inr (inl (refl term-app)))))))))) ;
ctx-empty-known : E.Known ctx-empty = E.constant ctx-empty (inr (inr (inr (inr (inr (inr (inr (inr (inr (inl (refl ctx-empty))))))))))) ;
ctx-ext-known : E.Known ctx-ext = E.constant ctx-ext (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inl (refl ctx-ext)))))))))))) ;
rule-wf-emp-known : E.Known rule-wf-emp = E.constant rule-wf-emp (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inl (refl rule-wf-emp))))))))))))) ;
rule-wf-ext-known : E.Known rule-wf-ext = E.constant rule-wf-ext (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inl (refl rule-wf-ext)))))))))))))) ;
rule-ty-var-known : E.Known rule-ty-var = E.constant rule-ty-var (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inl (refl rule-ty-var))))))))))))))) ;
rule-ty-conv-known : E.Known rule-ty-conv = E.constant rule-ty-conv (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inl (refl rule-ty-conv)))))))))))))))) ;
rule-ty-U-known : E.Known rule-ty-U = E.constant rule-ty-U (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inl (refl rule-ty-U))))))))))))))))) ;
rule-ty-Pi-known : E.Known rule-ty-Pi = E.constant rule-ty-Pi (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inl (refl rule-ty-Pi)))))))))))))))))) ;
rule-ty-Lam-known : E.Known rule-ty-Lam = E.constant rule-ty-Lam (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inl (refl rule-ty-Lam))))))))))))))))))) ;
rule-ty-App-known : E.Known rule-ty-App = E.constant rule-ty-App (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inl (refl rule-ty-App)))))))))))))))))))) ;
rule-eq-refl-known : E.Known rule-eq-refl = E.constant rule-eq-refl (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inl (refl rule-eq-refl))))))))))))))))))))) ;
rule-eq-sym-known : E.Known rule-eq-sym = E.constant rule-eq-sym (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inl (refl rule-eq-sym)))))))))))))))))))))) ;
rule-eq-trans-known : E.Known rule-eq-trans = E.constant rule-eq-trans (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inl (refl rule-eq-trans))))))))))))))))))))))) ;
rule-eq-conv-known : E.Known rule-eq-conv = E.constant rule-eq-conv (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inl (refl rule-eq-conv)))))))))))))))))))))))) ;
rule-eq-beta-known : E.Known rule-eq-beta = E.constant rule-eq-beta (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inl (refl rule-eq-beta))))))))))))))))))))))))) ;
rule-eq-Pi-known : E.Known rule-eq-Pi = E.constant rule-eq-Pi (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inl (refl rule-eq-Pi)))))))))))))))))))))))))) ;
rule-eq-funext-known : E.Known rule-eq-funext = E.constant rule-eq-funext (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inl (refl rule-eq-funext))))))))))))))))))))))))))) ;
rule-eq-app-fun-known : E.Known rule-eq-app-fun = E.constant rule-eq-app-fun (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inl (refl rule-eq-app-fun)))))))))))))))))))))))))))) ;
rule-eq-app-arg-known : E.Known rule-eq-app-arg = E.constant rule-eq-app-arg (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inr (inl (refl rule-eq-app-arg))))))))))))))))))))))))))))) ;

-- theta D is well-founded when D is a dilator (PLAN-THETA.md, T4).
-- Part 1: accessibility is a proposition (J and funext); the sub-order
-- TO_Q of theta D cut out by a propositional property Q of terms.
level l ;
open Base ; open Prelude[l+] ; open ScottOrder[l] ;
module W = Dilator[l] ;
module DP = DilPtyx[l] ;
module CF = CatEmbFin[l] ;
module SF = StabFun[l] ;
module PL = Prelude[l] ;
module LC = LOCat[l] ;
module LW = LOWF[l] ;
module LT = LabTree[l] ;
module TT = ThetaTerm[l] ;
module TL = ThetaLO[l] ;
module DLO = DilLO[l] ;
module PF = PtyxFinite[l] ;
module GR = Girard[l] ;
module SAm = StabAmal[l] ;
module FOE = FinOrdEx[l] ;
module T2 = ThetaLO2[l] ;
module T3 = ThetaLO3[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;

-- accessibility is a proposition
module AccProp (A : U l) (lt : A -> A -> W.Bool) {
  module AC = W.Acc[A,lt] ;
  Pt (x : A) : U l = AC.AccP x ;
  -- with the root x0 = x, the two trees agree
  module Nd (x0 : A) (f : (y : A) -> AC.Lt y x0 -> AC.AT)
    (r : (y : A) (h : AC.Lt y x0) (x : A) (g : AC.Good (f y h) x) (t' : AC.AT) (g' : AC.Good t' x) -> Id (AC.AccP x) (f y h,g) (t',g'))
    (gf : (y : A) (h : AC.Lt y x0) -> AC.Good (f y h) y) {
    St (z : A) (e : Id A x0 z) : U l = (f' : (y : A) -> AC.Lt y z -> AC.AT) (gf' : (y : A) (h : AC.Lt y z) -> AC.Good (f' y h) y) ->
      Id (AC.AccP x0) (node x0 f,(refl x0,gf)) (node z f',(PL.sym A x0 z e,gf')) ;
    base : St x0 (refl x0) = \ f' gf' ->
      PL.ap ((y : A) -> AC.Lt y x0 -> AC.AccP y) (AC.AccP x0)
        (\ G -> (node x0 (\ y h -> (G y h).1),(refl x0,\ y h -> (G y h).2)))
        (\ y h -> (f y h,gf y h)) (\ y h -> (f' y h,gf' y h))
        (FE.funext A (\ y -> AC.Lt y x0 -> AC.AccP y) (\ y h -> (f y h,gf y h)) (\ y h -> (f' y h,gf' y h))
          (\ y -> FE.funext (AC.Lt y x0) (\ h -> AC.AccP y) (\ h -> (f y h,gf y h)) (\ h -> (f' y h,gf' y h))
            (\ h -> r y h y (gf y h) (f' y h) (gf' y h)))) ;
    gen (z : A) (e : Id A x0 z) : St z e = idJ A x0 St base z e ;
  } ;
  symsym (x y : A) (p : Id A x y) : Id (Id A x y) (PL.sym A y x (PL.sym A x y p)) p =
    idJ A x (\ z q -> Id (Id A x z) (PL.sym A z x (PL.sym A x z q)) q) (refl (refl x)) y p ;
  Pr (t : AC.AT) : U l = (x : A) (g : AC.Good t x) (t' : AC.AT) (g' : AC.Good t' x) -> Id (AC.AccP x) (t,g) (t',g') ;
  sameRoot (x0 : A) (f : (y : A) -> AC.Lt y x0 -> AC.AT)
    (r : (y : A) (h : AC.Lt y x0) -> Pr (f y h)) (gf : (y : A) (h : AC.Lt y x0) -> AC.Good (f y h) y) :
      (t' : AC.AT) (g' : AC.Good t' x0) -> Id (AC.AccP x0) (node x0 f,(refl x0,gf)) (t',g') = split {
    node x1 f' -> \ g' -> PL.trans (AC.AccP x0) (node x0 f,(refl x0,gf)) (node x1 f',(PL.sym A x0 x1 (PL.sym A x1 x0 g'.1),g'.2)) (node x1 f',g')
      (Nd[x0,f,r,gf].gen x1 (PL.sym A x1 x0 g'.1) f' g'.2)
      (PL.ap (Id A x1 x0) (AC.AccP x0) (\ e -> (node x1 f',(e,g'.2))) (PL.sym A x0 x1 (PL.sym A x1 x0 g'.1)) g'.1 (symsym x1 x0 g'.1)) } ;
  prT : (t : AC.AT) -> Pr t = split {
    node x0 f | r -> \ x g t' g' ->
      idJ A x0 (\ z e -> (gf : (y : A) (h : AC.Lt y x0) -> AC.Good (f y h) y) (t2 : AC.AT) (g2 : AC.Good t2 z) ->
          Id (AC.AccP z) (node x0 f,(e,gf)) (t2,g2))
        (\ gf t2 g2 -> sameRoot x0 f r gf t2 g2) x g.1 g.2 t' g' } ;
  accProp (x : A) : PL.isProp (AC.AccP x) = \ u v -> prT u.1 x u.2 v.1 v.2 ;
} ;

-- the sub-order of theta D cut out by a property Q, and the semantic lemma
-- for it (the D-part of a comparison is the comparison of the images in
-- D(TO_Q)); a copy of ThetaLO2.SemK with the height bound replaced by Q.
module SQ (D : SF.SF[LC.ce]) {
  module T = TT.Th[D] ;
  module L = TL.ThL[D] ;
  module M2 = T2.L2[D] ;
  module TO = T3.ThetaOrd[D] ;
  Tm : U l = T.Tm ;
  cmp (s t : Tm) : W.O3 = T.cmp s t ;
  DG (n : W.N) : DP.LO = T.DG n ;
  AllQ0 (Q : Tm -> U l) (a : Tm) : U l = (x : Tm) -> LT.memG Tm x (T.elems a) -> Q x ;
  module LOQ (Q : Tm -> U l) (qP : (t : Tm) -> PL.isProp (Q t)) {
    Car : U l = (t : Tm) * ((L.NF t * Id W.Bool (L.isTh t) true) * Q t) ;
    lo : DP.LO = new DP.LO[car := Car, cmp := \ p q -> cmp p.1 q.1,
      ceq := \ p q h -> PL.Sigma-eq Tm (\ t -> (L.NF t * Id W.Bool (L.isTh t) true) * Q t) p.1 q.1 p.2 q.2
        (PL.ap TO.Car Tm (\ u -> u.1) (p.1,p.2.1) (q.1,q.2.1) (TO.lo.ceq (p.1,p.2.1) (q.1,q.2.1) h))
        (T2.prodProp (L.NF q.1 * Id W.Bool (L.isTh q.1) true) (Q q.1) (TO.nfP q.1) (qP q.1)),
      crefl := \ p -> TO.lo.crefl (p.1,p.2.1),
      cflip := \ p q -> TO.lo.cflip (p.1,p.2.1) (q.1,q.2.1),
      ctrans := \ p q r -> TO.lo.ctrans (p.1,p.2.1) (q.1,q.2.1) (r.1,r.2.1)] ;
  } ;
  module SemQ (Q : Tm -> U l) (qP : (t : Tm) -> PL.isProp (Q t)) {
    X : DP.LO = LOQ[Q,qP].lo ;
    AllQ (a : Tm) : U l = AllQ0 Q a ;
    module LX = W.LinOrd[X.car,X.cmp,X.ceq,X.cflip,X.ctrans] ;
    module S = DLO.DilOf[W.interp pId].Lst[X] ;
    LL : U l = W.List X.car ;
    -- lifting a normal list of height <= k
    liftL : (a : Tm) -> L.NF a -> AllQ a -> LL = split {
      th n z b -> \ na ha -> nilL ;
      nl -> \ na ha -> nilL ;
      cs x r | rx rr -> \ na ha -> consL (x,(((L.nfCs x r na).2.1,(L.nfCs x r na).1),ha x (inl (refl x))))
        (rr (L.nfCs x r na).2.2 (\ u mu -> ha u (inr mu))) } ;
    lenLift : (a : Tm) (na : L.NF a) (ha : AllQ a) -> Id W.N (LX.lenL (liftL a na ha)) (L.lenT a) = split {
      th n z b -> \ na ha -> refl zero ;
      nl -> \ na ha -> refl zero ;
      cs x r | rx rr -> \ na ha -> W.sucEq (LX.lenL (liftL r (L.nfCs x r na).2.2 (\ u mu -> ha u (inr mu)))) (L.lenT r)
        (rr (L.nfCs x r na).2.2 (\ u mu -> ha u (inr mu))) } ;
    -- adjacent sortedness gives sortedness
    hdAll (x : X.car) : (r : Tm) (nr : L.NF r) (hr : AllQ r) -> Id W.Bool (L.hdLt x.1 r) true ->
        Id W.Bool (LX.sortedB (liftL r nr hr)) true -> Id W.Bool (LX.allGt x (liftL r nr hr)) true = split {
      th n z b -> \ nr hr h s -> refl true ;
      nl -> \ nr hr h s -> refl true ;
      cs y r' -> \ nr hr h s -> W.andB-intro (LX.ltX x (y,(((L.nfCs y r' nr).2.1,(L.nfCs y r' nr).1),hr y (inl (refl y))))) (LX.allGt x (liftL r' (L.nfCs y r' nr).2.2 (\ u mu -> hr u (inr mu))))
        h
        (LX.allGt-trans x (y,(((L.nfCs y r' nr).2.1,(L.nfCs y r' nr).1),hr y (inl (refl y)))) h
          (liftL r' (L.nfCs y r' nr).2.2 (\ u mu -> hr u (inr mu)))
          (W.andB-l (LX.allGt (y,(((L.nfCs y r' nr).2.1,(L.nfCs y r' nr).1),hr y (inl (refl y)))) (liftL r' (L.nfCs y r' nr).2.2 (\ u mu -> hr u (inr mu))))
            (LX.sortedB (liftL r' (L.nfCs y r' nr).2.2 (\ u mu -> hr u (inr mu)))) s)) } ;
    srtLift : (a : Tm) (na : L.NF a) (ha : AllQ a) -> Id W.Bool (L.srt a) true -> Id W.Bool (LX.sortedB (liftL a na ha)) true = split {
      th n z b -> \ na ha h -> refl true ;
      nl -> \ na ha h -> refl true ;
      cs x r | rx rr -> \ na ha h ->
        W.andB-intro (LX.allGt (x,(((L.nfCs x r na).2.1,(L.nfCs x r na).1),ha x (inl (refl x)))) (liftL r (L.nfCs x r na).2.2 (\ u mu -> ha u (inr mu))))
          (LX.sortedB (liftL r (L.nfCs x r na).2.2 (\ u mu -> ha u (inr mu))))
          (hdAll (x,(((L.nfCs x r na).2.1,(L.nfCs x r na).1),ha x (inl (refl x)))) r (L.nfCs x r na).2.2 (\ u mu -> ha u (inr mu))
            (W.andB-l (L.hdLt x r) (L.srt r) h)
            (rr (L.nfCs x r na).2.2 (\ u mu -> ha u (inr mu)) (W.andB-r (L.hdLt x r) (L.srt r) h)))
          (rr (L.nfCs x r na).2.2 (\ u mu -> ha u (inr mu)) (W.andB-r (L.hdLt x r) (L.srt r) h)) } ;
    -- the merge words are those of LinOrd's merge of the lifted lists
    Wds (cv : LX.Cv) : T.P2 = (cv.2.1,cv.2.2) ;
    stpW (x y : X.car) : (c : W.O3) (p q r : T.P2) (m1 m2 m3 : LX.Cv) ->
        Id T.P2 p (Wds m1) -> Id T.P2 q (Wds m2) -> Id T.P2 r (Wds m3) ->
        Id T.P2 (T.stp c p q r) (Wds (LX.stepM x y m1 m2 m3 c)) = split {
      lt -> \ p q r m1 m2 m3 hp hq hr -> PL.ap T.P2 T.P2 (\ v -> (i v.1,o v.2)) p (Wds m1) hp ;
      eq -> \ p q r m1 m2 m3 hp hq hr -> PL.ap T.P2 T.P2 (\ v -> (i v.1,i v.2)) q (Wds m2) hq ;
      gt -> \ p q r m1 m2 m3 hp hq hr -> PL.ap T.P2 T.P2 (\ v -> (o v.1,i v.2)) r (Wds m3) hr } ;
    fsOf (a : Tm) : W.List T.CF = W.map Tm T.CF T.cmpL (T.elems a) ;
    MWT (a : Tm) (na : L.NF a) (ha : AllQ a) : U l =
      (b : Tm) (nb : L.NF b) (hb : AllQ b) -> Id T.P2 (T.mW (fsOf a) (T.elems b)) (Wds (LX.merge (liftL a na ha) (liftL b nb hb))) ;
    mwNil (b : Tm) (nb : L.NF b) (hb : AllQ b) : Id T.P2 (T.mW nilL (T.elems b)) (Wds (LX.merge nilL (liftL b nb hb))) =
      PL.ap W.N T.P2 (\ q -> (W.zeros q,W.idW q)) (L.lenT b) (LX.lenL (liftL b nb hb)) (PL.sym W.N (LX.lenL (liftL b nb hb)) (L.lenT b) (lenLift b nb hb)) ;
    module MWc (x : Tm) (r : Tm) (na : L.NF (cs x r)) (ha : AllQ (cs x r)) (ih : MWT r (L.nfCs x r na).2.2 (\ u mu -> ha u (inr mu))) {
      nr : L.NF r = (L.nfCs x r na).2.2 ;
      hr : AllQ r = (\ u mu -> ha u (inr mu)) ;
      X0 : X.car = (x,(((L.nfCs x r na).2.1,(L.nfCs x r na).1),ha x (inl (refl x)))) ;
      A0 : LL = liftL r nr hr ;
      lf : Id W.N (L.LF (fsOf r)) (LX.lenL A0) =
        PL.trans W.N (L.LF (fsOf r)) (L.lenT r) (LX.lenL A0) (L.lenMap T.cmpL (T.elems r)) (PL.sym W.N (LX.lenL A0) (L.lenT r) (lenLift r nr hr)) ;
      inner : (b : Tm) (nb : L.NF b) (hb : AllQ b) ->
          Id T.P2 (T.mWc (T.cmpL x) (fsOf r) (T.mW (fsOf r)) (T.elems b)) (Wds (LX.merge (consL X0 A0) (liftL b nb hb))) = split {
        th n z c -> \ nb hb -> PL.ap W.N T.P2 (\ q -> (W.idW (suc q),W.zeros (suc q))) (L.LF (fsOf r)) (LX.lenL A0) lf ;
        nl -> \ nb hb -> PL.ap W.N T.P2 (\ q -> (W.idW (suc q),W.zeros (suc q))) (L.LF (fsOf r)) (LX.lenL A0) lf ;
        cs y r' | ry rr' -> \ nb hb ->
          stpW X0 (y,(((L.nfCs y r' nb).2.1,(L.nfCs y r' nb).1),hb y (inl (refl y)))) (cmp x y)
            (T.mW (fsOf r) (T.elems (cs y r'))) (T.mW (fsOf r) (T.elems r')) (T.mWc (T.cmpL x) (fsOf r) (T.mW (fsOf r)) (T.elems r'))
            (LX.merge A0 (liftL (cs y r') nb hb)) (LX.merge A0 (liftL r' (L.nfCs y r' nb).2.2 (\ u mu -> hb u (inr mu))))
            (LX.merge (consL X0 A0) (liftL r' (L.nfCs y r' nb).2.2 (\ u mu -> hb u (inr mu))))
            (ih (cs y r') nb hb)
            (ih r' (L.nfCs y r' nb).2.2 (\ u mu -> hb u (inr mu)))
            (rr' (L.nfCs y r' nb).2.2 (\ u mu -> hb u (inr mu))) } ;
    } ;
    mWL : (a : Tm) (na : L.NF a) (ha : AllQ a) -> MWT a na ha = split {
      th n z c -> \ na ha b nb hb -> mwNil b nb hb ;
      nl -> \ na ha b nb hb -> mwNil b nb hb ;
      cs x r | rx rr -> \ na ha -> MWc[x,r,na,ha,rr (L.nfCs x r na).2.2 (\ u mu -> ha u (inr mu))].inner } ;

    -- the k-th element of a sublist
    nthIrr (c : LL) (q : W.N) (h h' : CF.Lt q (LX.lenL c)) : Id X.car (S.nthP c q h) (S.nthP c q h') =
      PL.ap (CF.Lt q (LX.lenL c)) X.car (S.nthP c q) h h' (W.HB.uip (W.ltN q (LX.lenL c)) true h h') ;
    nthC : (c : LL) (v : W.Wd) -> Id W.N (W.len v) (LX.lenL c) -> (q : W.N) (hk : CF.Lt q (LX.lenL (LX.compL c v))) (hk' : CF.Lt (W.sel v q) (LX.lenL c)) ->
        Id X.car (S.nthP (LX.compL c v) q hk) (S.nthP c (W.sel v q) hk') = split {
      nilL -> \ v hv q hk hk' -> W.ltN-zero-abs (Id X.car (S.nthP (LX.compL nilL v) q hk) (S.nthP nilL (W.sel v q) hk')) q hk ;
      consL x c | r -> split {
        nil -> \ hv q hk hk' -> W.absurdN (Id X.car (S.nthP (LX.compL (consL x c) nil) q hk) (S.nthP (consL x c) (W.sel nil q) hk')) (LX.lenL c) hv ;
        o v -> \ hv q hk hk' -> r v (W.sucInj (W.len v) (LX.lenL c) hv) q hk hk' ;
        i v -> \ hv -> split {
          zero -> \ hk hk' -> refl x ;
          suc q -> \ hk hk' -> r v (W.sucInj (W.len v) (LX.lenL c) hv) q hk hk' } } } ;
    -- the map of a sorted list
    mapOf (xs : LL) (N0 : W.N) (e : Id W.N (LX.lenL xs) N0) (sx : Id W.Bool (LX.sortedB xs) true) : DP.Map (LC.ord N0) X =
      (\ p -> S.nthP xs p.1 (PL.subst W.N (\ q -> CF.Lt p.1 q) N0 (LX.lenL xs) (PL.sym W.N (LX.lenL xs) N0 e) p.2),
       \ p p' -> S.nth-mono xs sx p.1 p'.1
         (PL.subst W.N (\ q -> CF.Lt p.1 q) N0 (LX.lenL xs) (PL.sym W.N (LX.lenL xs) N0 e) p.2)
         (PL.subst W.N (\ q -> CF.Lt p'.1 q) N0 (LX.lenL xs) (PL.sym W.N (LX.lenL xs) N0 e) p'.2)) ;
    -- elements of a sublist, through an equation
    nthS (c : LL) (v : W.Wd) (hv : Id W.N (W.len v) (LX.lenL c)) (A' : LL) (e : Id LL (LX.compL c v) A') (q : W.N)
      (h : CF.Lt q (LX.lenL A')) (h' : CF.Lt (W.sel v q) (LX.lenL c)) : Id X.car (S.nthP A' q h) (S.nthP c (W.sel v q) h') =
      idJ LL (LX.compL c v) (\ A1 e1 -> (h1 : CF.Lt q (LX.lenL A1)) -> Id X.car (S.nthP A1 q h1) (S.nthP c (W.sel v q) h'))
        (\ h1 -> nthC c v hv q h1 h') A' e h ;
    -- the image of a theta term of height <= k+1 in D(LO k)
    module Img (n : W.N) (z : (DG n).car) (a : Tm) (g : L.NF (th n z a) * Id W.Bool (L.isTh (th n z a)) true) (qa : AllQ a) {
      module S1 = L.NTh[n,z,a,g.1] ;
      ha : AllQ a = qa ;
      nfa : L.NF a = S1.nfa ;
      A : LL = liftL a nfa ha ;
      sA : Id W.Bool (LX.sortedB A) true = srtLift a nfa ha S1.srtA ;
      eA : Id W.N (LX.lenL A) n = PL.trans W.N (LX.lenL A) (L.lenT a) n (lenLift a nfa ha) S1.len ;
      iota : DP.Map (LC.ord n) X = mapOf A n eA sA ;
      img : (D.G X).car = (D.arr (LC.ord n) X iota).1 z ;
    } ;
    -- the semantic lemma: the D-part comparison is the comparison of the images
    module SemL (n : W.N) (z : (DG n).car) (a : Tm) (ga : L.NF (th n z a) * Id W.Bool (L.isTh (th n z a)) true) (qa : AllQ a)
      (m : W.N) (w : (DG m).car) (b : Tm) (gb : L.NF (th m w b) * Id W.Bool (L.isTh (th m w b)) true) (qb : AllQ b) {
      module I1 = Img[n,z,a,ga,qa] ;
      module I2 = Img[m,w,b,gb,qb] ;
      cv : LX.Cv = LX.merge I1.A I2.A ;
      cov : LX.Cov I1.A I2.A cv = LX.mergeOK I1.A I2.A I1.sA I2.sA ;
      u : W.Wd = cv.2.1 ;
      u' : W.Wd = cv.2.2 ;
      C : LL = cv.1 ;
      wE : Id T.P2 (T.mW (fsOf a) (T.elems b)) (u,u') = mWL a I1.nfa I1.ha b I2.nfa I2.ha ;
      e1 : Id W.N (W.ones u) n = PL.trans W.N (W.ones u) (LX.lenL I1.A) n (LX.onesOver C u I1.A (LX.mOver1 I1.A I2.A cv cov)) I1.eA ;
      e2 : Id W.N (W.ones u') m = PL.trans W.N (W.ones u') (LX.lenL I2.A) m (LX.onesOver C u' I2.A (LX.mOver2 I1.A I2.A cv cov)) I2.eA ;
      e3 : Id W.N (W.len u') (W.len u) = PL.trans W.N (W.len u') (LX.lenL C) (W.len u) cov.2.1 (PL.sym W.N (W.len u) (LX.lenL C) cov.1) ;
      iC : DP.Map (LC.ord (W.len u)) X = mapOf C (W.len u) (PL.sym W.N (W.len u) (LX.lenL C) cov.1) cov.2.2.2.2.1 ;
      fu : DP.Map (LC.ord n) (LC.ord (W.len u)) = L.fM n u e1 ;
      gu : DP.Map (LC.ord m) (LC.ord (W.len u)) = L.gM m u u' e2 e3 ;
      mA : Id (DP.Map (LC.ord n) X) (LC.compMap (LC.ord n) (LC.ord (W.len u)) X fu iC) I1.iota =
        LC.map-eq (LC.ord n) X (LC.compMap (LC.ord n) (LC.ord (W.len u)) X fu iC) I1.iota (\ p ->
          PL.sym X.car (I1.iota.1 p) (iC.1 (fu.1 p))
            (nthS C u cov.1 I1.A cov.2.2.1 p.1
              (PL.subst W.N (\ q -> CF.Lt p.1 q) n (LX.lenL I1.A) (PL.sym W.N (LX.lenL I1.A) n I1.eA) p.2)
              (PL.subst W.N (\ q -> CF.Lt (fu.1 p).1 q) (W.len u) (LX.lenL C) (PL.sym W.N (LX.lenL C) (W.len u) (PL.sym W.N (W.len u) (LX.lenL C) cov.1)) (fu.1 p).2))) ;
      mB : Id (DP.Map (LC.ord m) X) (LC.compMap (LC.ord m) (LC.ord (W.len u)) X gu iC) I2.iota =
        LC.map-eq (LC.ord m) X (LC.compMap (LC.ord m) (LC.ord (W.len u)) X gu iC) I2.iota (\ p ->
          PL.sym X.car (I2.iota.1 p) (iC.1 (gu.1 p))
            (nthS C u' cov.2.1 I2.A cov.2.2.2.1 p.1
              (PL.subst W.N (\ q -> CF.Lt p.1 q) m (LX.lenL I2.A) (PL.sym W.N (LX.lenL I2.A) m I2.eA) p.2)
              (PL.subst W.N (\ q -> CF.Lt (gu.1 p).1 q) (W.len u) (LX.lenL C) (PL.sym W.N (LX.lenL C) (W.len u) (PL.sym W.N (W.len u) (LX.lenL C) cov.1)) (gu.1 p).2))) ;
      DX : DP.LO = D.G X ;
      imA : Id DX.car ((D.arr (LC.ord (W.len u)) X iC).1 ((D.arr (LC.ord n) (LC.ord (W.len u)) fu).1 z)) I1.img =
        PL.trans DX.car ((D.arr (LC.ord (W.len u)) X iC).1 ((D.arr (LC.ord n) (LC.ord (W.len u)) fu).1 z))
          ((D.arr (LC.ord n) X (LC.compMap (LC.ord n) (LC.ord (W.len u)) X fu iC)).1 z) I1.img
          (D.arr-comp (LC.ord n) (LC.ord (W.len u)) X fu iC z)
          (PL.ap (DP.Map (LC.ord n) X) DX.car (\ h -> (D.arr (LC.ord n) X h).1 z) (LC.compMap (LC.ord n) (LC.ord (W.len u)) X fu iC) I1.iota mA) ;
      imB : Id DX.car ((D.arr (LC.ord (W.len u)) X iC).1 ((D.arr (LC.ord m) (LC.ord (W.len u)) gu).1 w)) I2.img =
        PL.trans DX.car ((D.arr (LC.ord (W.len u)) X iC).1 ((D.arr (LC.ord m) (LC.ord (W.len u)) gu).1 w))
          ((D.arr (LC.ord m) X (LC.compMap (LC.ord m) (LC.ord (W.len u)) X gu iC)).1 w) I2.img
          (D.arr-comp (LC.ord m) (LC.ord (W.len u)) X gu iC w)
          (PL.ap (DP.Map (LC.ord m) X) DX.car (\ h -> (D.arr (LC.ord m) X h).1 w) (LC.compMap (LC.ord m) (LC.ord (W.len u)) X gu iC) I2.iota mB) ;
      result : Id W.O3 (T.cmpAt n m z w (T.mW (fsOf a) (T.elems b))) (DX.cmp I1.img I2.img) =
        PL.trans W.O3 (T.cmpAt n m z w (T.mW (fsOf a) (T.elems b))) (T.cmpAt n m z w (u,u')) (DX.cmp I1.img I2.img)
          (PL.ap T.P2 W.O3 (T.cmpAt n m z w) (T.mW (fsOf a) (T.elems b)) (u,u') wE)
          (PL.trans W.O3 (T.cmpAt n m z w (u,u')) (T.cmpAtP n m z w u u' e1 e2 e3) (DX.cmp I1.img I2.img)
            (L.cAeval n m z w (u,u') e1 e2 e3)
            (PL.trans W.O3 (T.cmpAtP n m z w u u' e1 e2 e3)
                (DX.cmp ((D.arr (LC.ord (W.len u)) X iC).1 ((D.arr (LC.ord n) (LC.ord (W.len u)) fu).1 z))
                        ((D.arr (LC.ord (W.len u)) X iC).1 ((D.arr (LC.ord m) (LC.ord (W.len u)) gu).1 w)))
                (DX.cmp I1.img I2.img)
              (PL.sym W.O3 (DX.cmp ((D.arr (LC.ord (W.len u)) X iC).1 ((D.arr (LC.ord n) (LC.ord (W.len u)) fu).1 z))
                        ((D.arr (LC.ord (W.len u)) X iC).1 ((D.arr (LC.ord m) (LC.ord (W.len u)) gu).1 w)))
                (T.cmpAtP n m z w u u' e1 e2 e3)
                ((D.arr (LC.ord (W.len u)) X iC).2 ((D.arr (LC.ord n) (LC.ord (W.len u)) fu).1 z) ((D.arr (LC.ord m) (LC.ord (W.len u)) gu).1 w)))
              (W.ap2 DX.car DX.car W.O3 DX.cmp
                ((D.arr (LC.ord (W.len u)) X iC).1 ((D.arr (LC.ord n) (LC.ord (W.len u)) fu).1 z)) I1.img
                ((D.arr (LC.ord (W.len u)) X iC).1 ((D.arr (LC.ord m) (LC.ord (W.len u)) gu).1 w)) I2.img imA imB))) ;
    } ;
  } ;
} ;

-- theta D is well-founded when D is a dilator
module WFD (D : SF.SF[LC.ce]) (d : LW.IsDil D) {
  module S = SQ[D] ;
  module T = S.T ;
  module L = S.L ;
  module TO = S.TO ;
  Tm : U l = T.Tm ;
  cmp (s t : Tm) : W.O3 = T.cmp s t ;
  DG (n : W.N) : DP.LO = T.DG n ;
  NFT (t : Tm) : U l = L.NF t * Id W.Bool (L.isTh t) true ;
  module AC = W.Acc[TO.Car, W.ltO TO.Car TO.lo.cmp] ;
  module AP = AccProp[TO.Car, W.ltO TO.Car TO.lo.cmp] ;
  -- Q t: t is accessible (for every proof of normality)
  Q (t : Tm) : U l = (h : NFT t) -> AC.AccP (t,h) ;
  qP (t : Tm) : PL.isProp (Q t) = FE.isProp-Pi (NFT t) (\ h -> AC.AccP (t,h)) (\ h -> AP.accProp (t,h)) ;
  module SQQ = S.SemQ[Q,qP] ;
  X : DP.LO = SQQ.X ;
  DX : DP.LO = D.G X ;
  -- the accessible part is well-founded, hence so is D of it
  wfX : LW.WF X = \ p -> W.Pull[X.car, W.ltO X.car X.cmp, TO.Car, W.ltO TO.Car TO.lo.cmp, \ q -> (q.1,q.2.1), \ x y h -> h].pull p (p.2.2 p.2.1) ;
  wfDX : LW.WF DX = d X wfX ;
  module ADX = W.Acc[DX.car, W.ltO DX.car DX.cmp] ;
  -- elements of a normal list are normal theta terms
  elemNF : (a : Tm) -> L.NF a -> (x : Tm) -> LT.memG Tm x (T.elems a) -> NFT x = split {
    th n z b -> \ na x m -> CF.efq (NFT x) m ;
    nl -> \ na x m -> CF.efq (NFT x) m ;
    cs y r | ry rr -> \ na x m -> CF.or-elim (Id Tm y x) (LT.memG Tm x (T.elems r)) (NFT x)
      (\ e -> PL.subst Tm NFT y x e ((L.nfCs y r na).2.1,(L.nfCs y r na).1))
      (\ m' -> rr (L.nfCs y r na).2.2 x m') m } ;
  -- equal terms: transport accessibility
  accEq (t t' : Tm) (e : Id Tm t t') (h : NFT t) (h' : NFT t') (a : AC.AccP (t,h)) : AC.AccP (t',h') =
    PL.subst TO.Car AC.AccP (t,h) (t',h') (PL.Sigma-eq Tm NFT t t' h h' e (TO.nfP t')) a ;
  img (n : W.N) (z : (DG n).car) (a : Tm) (h : NFT (th n z a)) (qa : SQQ.AllQ a) : DX.car = SQQ.Img[n,z,a,h,qa].img ;
  -- the predecessors of theta(a, z), by structural induction
  module Step (y : DX.car)
    (ih : (y' : DX.car) -> ADX.Lt y' y -> (n : W.N) (z : (DG n).car) (a : Tm) (h : NFT (th n z a)) (qa : SQQ.AllQ a) ->
      Id DX.car (img n z a h qa) y' -> AC.AccP (th n z a,h))
    (n : W.N) (z : (DG n).car) (a : Tm) (h : NFT (th n z a)) (qa : SQQ.AllQ a) (e : Id DX.car (img n z a h qa) y) {
    s0 : Tm = th n z a ;
    PI (t0 : Tm) : U l = (ht : NFT t0) -> Id W.O3 (cmp t0 s0) lt -> AC.AccP (t0,ht) ;
    MI : Tm -> U l = split { th m w b -> PI (th m w b) ; nl -> W.Unit ; cs x r | rx rr -> rx * rr } ;
    thI : (x : Tm) -> MI x -> PI x = split {
      th m w b -> \ mi -> mi ;
      nl -> \ mi ht -> W.absurdB (Id W.O3 (cmp nl s0) lt -> AC.AccP (nl,ht)) ht.2 ;
      cs x r -> \ mi ht -> W.absurdB (Id W.O3 (cmp (cs x r) s0) lt -> AC.AccP (cs x r,ht)) ht.2 } ;
    getI : (b : Tm) -> MI b -> (x : Tm) -> LT.memG Tm x (T.elems b) -> PI x = split {
      th m w b -> \ mi x mx -> CF.efq (PI x) mx ;
      nl -> \ mi x mx -> CF.efq (PI x) mx ;
      cs x' r' | rx rr' -> \ mi x mx -> CF.or-elim (Id Tm x' x) (LT.memG Tm x (T.elems r')) (PI x)
        (\ e' -> PL.subst Tm PI x' x e' (thI x' mi.1))
        (\ m' -> rr' mi.2 x m') mx } ;
    -- t <= some argument of s: accessible since the arguments are
    viaArg (t0 : Tm) (ht : NFT t0) (x : Tm) (mx : LT.memG Tm x (T.elems a)) : W.Or (Id W.O3 (cmp t0 x) lt) (Id W.O3 (cmp t0 x) eq) -> AC.AccP (t0,ht) =
      CF.or-elim (Id W.O3 (cmp t0 x) lt) (Id W.O3 (cmp t0 x) eq) (AC.AccP (t0,ht))
        (\ l1 -> AC.accPred (x,elemNF a L.NTh[n,z,a,h.1].nfa x mx) (qa x mx (elemNF a L.NTh[n,z,a,h.1].nfa x mx)) (t0,ht)
          (PL.ap W.O3 W.Bool W.isLt (cmp t0 x) lt l1))
        (\ e1 -> accEq x t0 (PL.sym Tm t0 x (PL.ap TO.Car Tm (\ u -> u.1) (t0,ht) (x,elemNF a L.NTh[n,z,a,h.1].nfa x mx) (TO.lo.ceq (t0,ht) (x,elemNF a L.NTh[n,z,a,h.1].nfa x mx) e1)))
           (elemNF a L.NTh[n,z,a,h.1].nfa x mx) ht (qa x mx (elemNF a L.NTh[n,z,a,h.1].nfa x mx))) ;
    module L3 = T3.L3[D] ;
    module CoreI (m : W.N) (w : (DG m).car) (b : Tm) (ihb : MI b) (ht : NFT (th m w b)) (hlt : Id W.O3 (cmp (th m w b) s0) lt) {
      t0 : Tm = th m w b ;
      Lv : W.Bool = TT.anyB TT.leB (W.map Tm W.O3 (T.cmpL t0) (T.elems a)) ;
      Gv : W.Bool = TT.anyB TT.geB (W.map Tm W.O3 (\ x -> cmp x s0) (T.elems b)) ;
      Dv : W.O3 = T.cmpAt m n w z (T.mW (W.map Tm T.CF T.cmpL (T.elems b)) (T.elems a)) ;
      h' : Id W.O3 (TT.sel3 Lv Gv Dv) lt = PL.trans W.O3 (TT.sel3 Lv Gv Dv) (cmp t0 s0) lt (PL.sym W.O3 (cmp t0 s0) (TT.sel3 Lv Gv Dv) (T.cmpTh m w b n z a)) hlt ;
      module FF (f : Id W.Bool Lv false) {
        h2 : Id W.O3 (TT.sel3 false Gv Dv) lt = PL.subst W.Bool (\ c -> Id W.O3 (TT.sel3 c Gv Dv) lt) Lv false f h' ;
        gf : Id W.Bool Gv false = L3.s3fT Gv Dv h2 ;
        dl : Id W.O3 Dv lt = L3.s3fD Gv Dv gf h2 ;
        qb : SQQ.AllQ b = \ x mx hx -> getI b ihb x mx hx
          (L3.geF (cmp x s0) (T3.Any[Tm,TT.geB,\ u -> cmp u s0].all (T.elems b) gf x mx)) ;
        sem : Id W.O3 Dv (DX.cmp (img m w b ht qb) (img n z a h qa)) = SQQ.SemL[m,w,b,ht,qb,n,z,a,h,qa].result ;
        ltY : ADX.Lt (img m w b ht qb) y =
          PL.ap W.O3 W.Bool W.isLt (DX.cmp (img m w b ht qb) y) lt
            (PL.subst DX.car (\ v -> Id W.O3 (DX.cmp (img m w b ht qb) v) lt) (img n z a h qa) y e
              (PL.trans W.O3 (DX.cmp (img m w b ht qb) (img n z a h qa)) Dv lt (PL.sym W.O3 Dv (DX.cmp (img m w b ht qb) (img n z a h qa)) sem) dl)) ;
        res : AC.AccP (t0,ht) = ih (img m w b ht qb) ltY m w b ht qb (refl (img m w b ht qb)) ;
      } ;
      fromF (f : Id W.Bool Lv false) : AC.AccP (t0,ht) = FF[f].res ;
      res : AC.AccP (t0,ht) =
        T3.bcase (\ c -> Id W.Bool Lv c -> AC.AccP (t0,ht)) Lv
          (\ e0 et -> viaArg t0 ht (T3.Any[Tm,TT.leB,T.cmpL t0].ex (T.elems a) et).1 (T3.Any[Tm,TT.leB,T.cmpL t0].ex (T.elems a) et).2.1
             (L3.leCases (cmp t0 (T3.Any[Tm,TT.leB,T.cmpL t0].ex (T.elems a) et).1) (T3.Any[Tm,TT.leB,T.cmpL t0].ex (T.elems a) et).2.2))
          (\ e0 ef -> fromF ef)
          (refl Lv) ;
    } ;
    mainI : (t0 : Tm) -> MI t0 = split {
      th m w b | rb -> \ ht hlt -> CoreI[m,w,b,rb,ht,hlt].res ;
      nl -> tt ;
      cs x r | rx rr -> (rx,rr) } ;
    res : AC.AccP (s0,h) = AC.acc (s0,h) (\ t lt0 -> thI t.1 (mainI t.1) t.2 (W.isLt-sound (cmp t.1 s0) lt0)) ;
  } ;
  -- induction on D(accessible part)
  claim (y : DX.car) (ay : ADX.AccP y) : (n : W.N) (z : (DG n).car) (a : Tm) (h : NFT (th n z a)) (qa : SQQ.AllQ a) ->
      Id DX.car (img n z a h qa) y -> AC.AccP (th n z a,h) =
    ADX.ind (\ y1 -> (n : W.N) (z : (DG n).car) (a : Tm) (h : NFT (th n z a)) (qa : SQQ.AllQ a) -> Id DX.car (img n z a h qa) y1 -> AC.AccP (th n z a,h))
      (\ y1 ih n z a h qa e -> Step[y1,ih,n,z,a,h,qa,e].res) y ay ;
  accTh (n : W.N) (z : (DG n).car) (a : Tm) (h : NFT (th n z a)) (qa : SQQ.AllQ a) : AC.AccP (th n z a,h) =
    claim (img n z a h qa) (wfDX (img n z a h qa)) n z a h qa (refl (img n z a h qa)) ;
  -- every normal term is accessible (structural induction)
  MA : Tm -> U l = split { th n z a -> Q (th n z a) ; nl -> W.Unit ; cs x r | rx rr -> rx * rr } ;
  thA : (x : Tm) -> MA x -> Q x = split {
    th n z a -> \ ma -> ma ;
    nl -> \ ma h -> W.absurdB (AC.AccP (nl,h)) h.2 ;
    cs x r -> \ ma h -> W.absurdB (AC.AccP (cs x r,h)) h.2 } ;
  getA : (a : Tm) -> MA a -> SQQ.AllQ a = split {
    th n z b -> \ ma x mx -> CF.efq (Q x) mx ;
    nl -> \ ma x mx -> CF.efq (Q x) mx ;
    cs x' r' | rx rr' -> \ ma x mx -> CF.or-elim (Id Tm x' x) (LT.memG Tm x (T.elems r')) (Q x)
      (\ e' -> PL.subst Tm Q x' x e' (thA x' ma.1))
      (\ m' -> rr' ma.2 x m') mx } ;
  mainA : (t : Tm) -> MA t = split {
    th n z a | ra -> \ h -> accTh n z a h (getA a ra) ;
    nl -> tt ;
    cs x r | rx rr -> (rx,rr) } ;
  wfTheta : LW.WF TO.lo = \ p -> thA p.1 (mainA p.1) p.2 ;
} ;

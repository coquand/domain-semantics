          (D3.cmp (F.C.fin jj'.1) Ref[n1,h1,k,hk,jj',jj'.1,F.C.idm (F.C.fin jj'.1)].a0 Ref[n1,h1,k,hk,jj',jj'.1,F.C.idm (F.C.fin jj'.1)].b0) (tb n1 h1 k hk t' ht')
        (PL.sym W.O3 (D3.cmp (F.C.fin jj'.1) Ref[n1,h1,k,hk,jj',jj'.1,F.C.idm (F.C.fin jj'.1)].a0 Ref[n1,h1,k,hk,jj',jj'.1,F.C.idm (F.C.fin jj'.1)].b0)
            (D3.cmp (F.C.fin jj.1) Ref[n1,h1,k,hk,jj,jj.1,F.C.idm (F.C.fin jj.1)].a0 Ref[n1,h1,k,hk,jj,jj.1,F.C.idm (F.C.fin jj.1)].b0)

  ordV-real (d : F.C.Fin) : (x y : S.VT (F.C.fin d)) -> Id W.O3 (T0.ordV d x y) (D3.cmp (F.C.fin d) (imgV (F.C.fin d) x) (imgV (F.C.fin d) y)) = split {
    inl a -> split { inl b -> c11 d a b ; inr b -> c12 d a b } ;

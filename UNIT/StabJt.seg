        (PL.sym W.O3 (D3.cmp (F.C.fin d) (imgV (F.C.fin d) (inr a)) (imgV (F.C.fin d) (inl b))) (W.flip (D3.cmp (F.C.fin d) (imgV (F.C.fin d) (inl b)) (imgV (F.C.fin d) (inr a))))
          (D3.cflip (F.C.fin d) (imgV (F.C.fin d) (inl b)) (imgV (F.C.fin d) (inr a)))) ;
      inr b -> c22 d a b } } ;
  real (d : F.C.Fin) (p q : S.PS.Pt (F.C.fin d)) : Id W.O3 (T0.ordS d p q) (D3.cmp (F.C.fin d) (img (F.C.fin d) p) (img (F.C.fin d) q)) =
    PL.trans W.O3 (T0.ordS d p q) (D3.cmp (F.C.fin d) (imgV (F.C.fin d) (S.view (F.C.fin d) p)) (imgV (F.C.fin d) (S.view (F.C.fin d) q)))

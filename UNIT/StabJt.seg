              (\ u v -> D3.cmp (F.C.fin jj.1) (D3.PP.post (CV.g1 n1) (F.C.fin jj.1) u (CV.x1 n1 h1)) (D3.PP.post (F.C.fin (K2'.gen k)) (F.C.fin jj.1) v (CV.x2 k hk)))
              (F.C.comp (CV.g1 n1) (F.C.fin jj'.1) (F.C.fin jj.1) jj'.2.1 fc.1) jj.2.1 (F.C.comp (F.C.fin (K2'.gen k)) (F.C.fin jj'.1) (F.C.fin jj.1) jj'.2.2 fc.1) jj.2.2

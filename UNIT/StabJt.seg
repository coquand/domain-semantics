              (D3.cmp (F.C.fin jj.1) (D3.PP.post (CV.g1 n1) (F.C.fin jj.1) (F.C.comp (CV.g1 n1) (F.C.fin jj'.1) (F.C.fin jj.1) jj'.2.1 fc.1) (CV.x1 n1 h1))

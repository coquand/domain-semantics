-- Finite multicoproducts of decoded codes (abstract catemb over a CEF),
-- layer 7c.  MkX: a morphism from a decoded code into a stable functor X,
-- given minimal generator points of X whose comparisons realise the code.
level l ;
open Base ; open Prelude[l+] ; open ScottOrder[l] ;
module W = Dilator[l] ;
module DP = DilPtyx[l] ;
module PF = PtyxFinite[l] ;
module CE = CatEmb[l] ;
module SF = StabFun[l] ;
module CF = CatEmbFin[l] ;
module SC = StabCode[l] ;
module SDi = StabDir[l] ;
module SJ0 = StabJt0[l] ;
module SSm = StabSum[l] ;
module FL = FinList[l] ;
module PL = Prelude[l] ;
module TC = TruncationCombinators[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;

module MkX (F : CF.CEF) (K : SC.Code[F]) (X : SF.SF[F.C])
  (pts : (n : W.N) -> CF.Lt n K.m -> (X.G (F.C.fin (K.gen n))).car)
  (mn : (n : W.N) (hn : CF.Lt n K.m) -> SDi.Minimal F X (F.C.fin (K.gen n)) (pts n hn))
  (ordc : (d : F.C.Fin) (p q : SC.Pts[F,K.m,K.gen].Pt (F.C.fin d)) ->
    Id W.O3 (K.ord d p q) ((X.G (F.C.fin d)).cmp ((X.arr (F.C.fin (K.gen p.1)) (F.C.fin d) p.2.2).1 (pts p.1 p.2.1))
      ((X.arr (F.C.fin (K.gen q.1)) (F.C.fin d) q.2.2).1 (pts q.1 q.2.1)))) {
  module PP = SC.Pts[F,K.m,K.gen] ;
  module D = SC.Decode[F,K] ;
  module O = SF.Over[F.C] ;
  Pt (A : F.C.Obj) : U l = PP.Pt A ;
  g (i : W.N) : F.C.Obj = F.C.fin (K.gen i) ;
  im (A : F.C.Obj) (p : Pt A) : (X.G A).car = (X.arr (g p.1) A p.2.2).1 (pts p.1 p.2.1) ;
  pa (A B : F.C.Obj) (p : Pt A) (l0 : F.C.Mor A B) : Id (X.G B).car (im B (PP.post A B l0 p)) ((X.arr A B l0).1 (im A p)) =
    PL.sym (X.G B).car ((X.arr A B l0).1 (im A p)) (im B (PP.post A B l0 p)) (X.arr-comp (g p.1) A B p.2.2 l0 (pts p.1 p.2.1)) ;
  dref (c' : F.C.Fin) (p q : Pt (F.C.fin c')) : D.Ref (F.C.fin c') p q =
    (c',(F.C.idm (F.C.fin c'),(p.2.2,(q.2.2,(F.C.id-r (g p.1) (F.C.fin c') p.2.2,F.C.id-r (g q.1) (F.C.fin c') q.2.2))))) ;
  mmap (c' : F.C.Fin) : DP.Map (D.Gt (F.C.fin c')) (X.G (F.C.fin c')) =
    (\ p -> im (F.C.fin c') p,
     \ p q -> PL.trans W.O3 ((X.G (F.C.fin c')).cmp (im (F.C.fin c') p) (im (F.C.fin c') q)) (K.ord c' p q) (D.cmp (F.C.fin c') p q)
       (PL.sym W.O3 (K.ord c' p q) ((X.G (F.C.fin c')).cmp (im (F.C.fin c') p) (im (F.C.fin c') q)) (ordc c' p q))
       (PL.sym W.O3 (D.cmp (F.C.fin c') p q) (K.ord c' p q) (D.spec (F.C.fin c') p q (dref c' p q)))) ;
  mnat : O.Nat D.obj X mmap = \ c' d k p -> PL.sym (X.G (F.C.fin d)).car (im (F.C.fin d) (PP.post (F.C.fin c') (F.C.fin d) k p))
    ((X.arr (F.C.fin c') (F.C.fin d) k).1 (im (F.C.fin c') p)) (pa (F.C.fin c') (F.C.fin d) p k) ;
  module Cart (c' d : F.C.Fin) (k : F.C.Mor (F.C.fin c') (F.C.fin d)) (p : Pt (F.C.fin d))
    (r : SF.Im (X.G (F.C.fin c')) (X.G (F.C.fin d)) (X.arr (F.C.fin c') (F.C.fin d) k) (im (F.C.fin d) p)) {
    Fd : F.C.Obj = F.C.fin d ;
    Fc' : F.C.Obj = F.C.fin c' ;
    e0 : F.C.Obj = g p.1 ;
    x0 : (X.G e0).car = pts p.1 p.2.1 ;
    P : F.C.Obj = F.C.pb Fd e0 Fc' p.2.2 k ;
    p1 : F.C.Mor P e0 = F.C.p1 Fd e0 Fc' p.2.2 k ;
    p2 : F.C.Mor P Fc' = F.C.p2 Fd e0 Fc' p.2.2 k ;
    st : SF.Im (X.G P) (X.G Fd) (X.arr P Fd (F.C.comp P e0 Fd p1 p.2.2)) (im Fd p) =
      X.stab Fd e0 Fc' p.2.2 k (im Fd p) (x0,refl (im Fd p)) r ;
    ez : SF.Im (X.G P) (X.G e0) (X.arr P e0 p1) x0 =
      (st.1,DP.map-inj (X.G e0) (X.G Fd) (X.arr e0 Fd p.2.2) ((X.arr P e0 p1).1 st.1) x0
        (PL.trans (X.G Fd).car ((X.arr e0 Fd p.2.2).1 ((X.arr P e0 p1).1 st.1)) ((X.arr P Fd (F.C.comp P e0 Fd p1 p.2.2)).1 st.1) (im Fd p)
          (X.arr-comp P e0 Fd p1 p.2.2 st.1) st.2)) ;
    module Sec (hh : (h : F.C.Mor e0 P) * Id (F.C.Mor e0 e0) (F.C.comp e0 P e0 h p1) (F.C.idm e0)) {
      k2 : F.C.Mor e0 Fc' = F.C.comp e0 P Fc' hh.1 p2 ;
      ek : Id (F.C.Mor e0 Fd) (F.C.comp e0 Fc' Fd k2 k) p.2.2 =
        PL.trans (F.C.Mor e0 Fd) (F.C.comp e0 Fc' Fd k2 k) (F.C.comp e0 P Fd hh.1 (F.C.comp P Fc' Fd p2 k)) p.2.2
          (F.C.assoc e0 P Fc' Fd hh.1 p2 k)
          (PL.trans (F.C.Mor e0 Fd) (F.C.comp e0 P Fd hh.1 (F.C.comp P Fc' Fd p2 k)) (F.C.comp e0 P Fd hh.1 (F.C.comp P e0 Fd p1 p.2.2)) p.2.2
            (PL.ap (F.C.Mor P Fd) (F.C.Mor e0 Fd) (F.C.comp e0 P Fd hh.1) (F.C.comp P Fc' Fd p2 k) (F.C.comp P e0 Fd p1 p.2.2)
              (PL.sym (F.C.Mor P Fd) (F.C.comp P e0 Fd p1 p.2.2) (F.C.comp P Fc' Fd p2 k) (F.C.pb-sq Fd e0 Fc' p.2.2 k)))
            (PL.trans (F.C.Mor e0 Fd) (F.C.comp e0 P Fd hh.1 (F.C.comp P e0 Fd p1 p.2.2)) (F.C.comp e0 e0 Fd (F.C.comp e0 P e0 hh.1 p1) p.2.2) p.2.2
              (PL.sym (F.C.Mor e0 Fd) (F.C.comp e0 e0 Fd (F.C.comp e0 P e0 hh.1 p1) p.2.2) (F.C.comp e0 P Fd hh.1 (F.C.comp P e0 Fd p1 p.2.2))
                (F.C.assoc e0 P e0 Fd hh.1 p1 p.2.2))
              (PL.trans (F.C.Mor e0 Fd) (F.C.comp e0 e0 Fd (F.C.comp e0 P e0 hh.1 p1) p.2.2) (F.C.comp e0 e0 Fd (F.C.idm e0) p.2.2) p.2.2
                (PL.ap (F.C.Mor e0 e0) (F.C.Mor e0 Fd) (\ M -> F.C.comp e0 e0 Fd M p.2.2) (F.C.comp e0 P e0 hh.1 p1) (F.C.idm e0) hh.2)
                (F.C.id-l e0 Fd p.2.2)))) ;
      result : SF.Im (D.Gt Fc') (D.Gt Fd) (D.arr Fc' Fd k) p =
        ((p.1,(p.2.1,k2)),PP.pt3 Fd p (F.C.comp e0 Fc' Fd k2 k) ek) ;
    } ;
    result : SF.Im (D.Gt Fc') (D.Gt Fd) (D.arr Fc' Fd k) p =
      TC.rec ((h : F.C.Mor e0 P) * Id (F.C.Mor e0 e0) (F.C.comp e0 P e0 h p1) (F.C.idm e0)) @l
        (SF.Im (D.Gt Fc') (D.Gt Fd) (D.arr Fc' Fd k) p) (SF.im-prop (D.Gt Fc') (D.Gt Fd) (D.arr Fc' Fd k) p)
        (\ hh -> Sec[hh].result) (mn p.1 p.2.1 P p1 ez) ;
  } ;
  mor : O.Mor D.obj X = (mmap,(mnat,\ c' d k p r -> Cart[c',d,k,p,r].result)) ;
} ;

--------------------------------------------------------------------
-- tables: enumeration and decidable validity

module Tab (F : CF.CEF) (K1 K2 : SC.Code[F]) {
  J (n1 n2 : W.N) : W.N = F.jtN (K1.gen n1) (K2.gen n2) ;
  module In (n1 n2 : W.N) { module D = FL.DepFun[\ t -> W.O3,\ t -> FL.o3L,\ t x y -> Id W.O3 y x,J n1 n2] ; } ;
  InT (n1 n2 : W.N) : U l = In[n1,n2].D.Fn (J n1 n2) ;
  module Mi (n1 : W.N) { module D = FL.DepFun[\ n2 -> InT n1 n2,\ n2 -> In[n1,n2].D.lst (J n1 n2),\ n2 s s' -> In[n1,n2].D.Ag (J n1 n2) s s',K2.m] ; } ;
  MiT (n1 : W.N) : U l = Mi[n1].D.Fn K2.m ;
  module Ou = FL.DepFun[\ n1 -> MiT n1,\ n1 -> Mi[n1].D.lst K2.m,\ n1 s s' -> Mi[n1].D.Ag K2.m s s',K1.m] ;
  Tbl : U l = Ou.Fn K1.m ;
  tblL : W.List (CF.Opt Tbl) = Ou.lst K1.m ;
  AgT (s s' : Tbl) : U l = Ou.Ag K1.m s s' ;
  tblM (tau : Tbl) : FL.MemR Tbl AgT tblL tau =
    Ou.Cov[tau,\ n1 h1 -> Mi[n1].D.Cov[tau n1 h1,\ n2 h2 -> In[n1,n2].D.Cov[tau n1 h1 n2 h2,\ t ht -> FL.o3M (tau n1 h1 n2 h2 t ht)].full].full].full ;
  module V (tbl : Tbl) {
    module T0 = SSm.SumC[F,K1,K2,tbl] ;
    module S = T0.S ;
    JTy (n1 n2 : W.N) : U l = T0.JTy n1 n2 ;
    dSV1 : W.Or T0.SV1 (T0.SV1 -> W.Empty) =
      FL.DecAll[K1.m,\ n1 h1 -> (n2 : W.N) (h2 : CF.Lt n2 K2.m) (t : W.N) (ht : CF.Lt t (J n1 n2)) (t' : W.N) (ht' : CF.Lt t' (J n1 n2))
          (j : JTy n1 n2) (e : Id (CF.Opt (JTy n1 n2)) (F.jt (K1.gen n1) (K2.gen n2) t ht) (inl j))
          (j' : JTy n1 n2) (e' : Id (CF.Opt (JTy n1 n2)) (F.jt (K1.gen n1) (K2.gen n2) t' ht') (inl j')) ->
          CF.JFac F.C (K1.gen n1) (K2.gen n2) j.1 j.2.1 j.2.2 j' -> Id W.O3 (tbl n1 h1 n2 h2 t ht) (tbl n1 h1 n2 h2 t' ht'),
        \ n1 h1 -> FL.DecAll[K2.m,\ n2 h2 -> (t : W.N) (ht : CF.Lt t (J n1 n2)) (t' : W.N) (ht' : CF.Lt t' (J n1 n2))
            (j : JTy n1 n2) (e : Id (CF.Opt (JTy n1 n2)) (F.jt (K1.gen n1) (K2.gen n2) t ht) (inl j))
            (j' : JTy n1 n2) (e' : Id (CF.Opt (JTy n1 n2)) (F.jt (K1.gen n1) (K2.gen n2) t' ht') (inl j')) ->
            CF.JFac F.C (K1.gen n1) (K2.gen n2) j.1 j.2.1 j.2.2 j' -> Id W.O3 (tbl n1 h1 n2 h2 t ht) (tbl n1 h1 n2 h2 t' ht'),
          \ n2 h2 -> FL.DecAll[J n1 n2,\ t ht -> (t' : W.N) (ht' : CF.Lt t' (J n1 n2))
              (j : JTy n1 n2) (e : Id (CF.Opt (JTy n1 n2)) (F.jt (K1.gen n1) (K2.gen n2) t ht) (inl j))
              (j' : JTy n1 n2) (e' : Id (CF.Opt (JTy n1 n2)) (F.jt (K1.gen n1) (K2.gen n2) t' ht') (inl j')) ->
              CF.JFac F.C (K1.gen n1) (K2.gen n2) j.1 j.2.1 j.2.2 j' -> Id W.O3 (tbl n1 h1 n2 h2 t ht) (tbl n1 h1 n2 h2 t' ht'),
            \ t ht -> FL.DecAll[J n1 n2,\ t' ht' ->
                (j : JTy n1 n2) (e : Id (CF.Opt (JTy n1 n2)) (F.jt (K1.gen n1) (K2.gen n2) t ht) (inl j))
                (j' : JTy n1 n2) (e' : Id (CF.Opt (JTy n1 n2)) (F.jt (K1.gen n1) (K2.gen n2) t' ht') (inl j')) ->
                CF.JFac F.C (K1.gen n1) (K2.gen n2) j.1 j.2.1 j.2.2 j' -> Id W.O3 (tbl n1 h1 n2 h2 t ht) (tbl n1 h1 n2 h2 t' ht'),
              \ t' ht' -> FL.decOpt (JTy n1 n2) (\ j -> (j' : JTy n1 n2) (e' : Id (CF.Opt (JTy n1 n2)) (F.jt (K1.gen n1) (K2.gen n2) t' ht') (inl j')) ->
                  CF.JFac F.C (K1.gen n1) (K2.gen n2) j.1 j.2.1 j.2.2 j' -> Id W.O3 (tbl n1 h1 n2 h2 t ht) (tbl n1 h1 n2 h2 t' ht'))
                (\ j -> FL.decOpt (JTy n1 n2) (\ j' -> CF.JFac F.C (K1.gen n1) (K2.gen n2) j.1 j.2.1 j.2.2 j' -> Id W.O3 (tbl n1 h1 n2 h2 t ht) (tbl n1 h1 n2 h2 t' ht'))
                  (\ j' -> SSm.decImp (CF.JFac F.C (K1.gen n1) (K2.gen n2) j.1 j.2.1 j.2.2 j') (Id W.O3 (tbl n1 h1 n2 h2 t ht) (tbl n1 h1 n2 h2 t' ht'))
                    (SJ0.decJFac F (K1.gen n1) (K2.gen n2) j.1 j.2.1 j.2.2 j') (StabHom[l].decO3 (tbl n1 h1 n2 h2 t ht) (tbl n1 h1 n2 h2 t' ht')))
                  (F.jt (K1.gen n1) (K2.gen n2) t' ht'))
                (F.jt (K1.gen n1) (K2.gen n2) t ht)].result].result].result].result ;
    dSV2 : W.Or T0.SV2 (T0.SV2 -> W.Empty) =
      FL.DecAll[K1.m,\ n1 h1 -> (n2 : W.N) (h2 : CF.Lt n2 K2.m) (t : W.N) (ht : CF.Lt t (J n1 n2)) -> Id W.O3 (tbl n1 h1 n2 h2 t ht) eq -> W.Empty,
        \ n1 h1 -> FL.DecAll[K2.m,\ n2 h2 -> (t : W.N) (ht : CF.Lt t (J n1 n2)) -> Id W.O3 (tbl n1 h1 n2 h2 t ht) eq -> W.Empty,
          \ n2 h2 -> FL.DecAll[J n1 n2,\ t ht -> Id W.O3 (tbl n1 h1 n2 h2 t ht) eq -> W.Empty,
            \ t ht -> SSm.decNot (Id W.O3 (tbl n1 h1 n2 h2 t ht) eq) (StabHom[l].decO3 (tbl n1 h1 n2 h2 t ht) eq)].result].result].result ;
    P3 (x : W.N) (hx : CF.Lt x S.mS) (y : W.N) (hy : CF.Lt y S.mS) (z : W.N) (hz : CF.Lt z S.mS) (t1 : W.N) (h1 : CF.Lt t1 (F.jtN (S.genS x) (S.genS y)))
      (j1 : CF.JT F.C (S.genS x) (S.genS y)) : U l =
      (t2 : W.N) (h2 : CF.Lt t2 (F.jtN j1.1 (S.genS z))) (j2 : CF.JT F.C j1.1 (S.genS z))
      (e2 : Id (CF.Opt (CF.JT F.C j1.1 (S.genS z))) (F.jt j1.1 (S.genS z) t2 h2) (inl j2)) -> T0.Tr3 x hx y hy z hz j1 j2 ;
    dTr3 (x : W.N) (hx : CF.Lt x S.mS) (y : W.N) (hy : CF.Lt y S.mS) (z : W.N) (hz : CF.Lt z S.mS)
      (j1 : CF.JT F.C (S.genS x) (S.genS y)) (j2 : CF.JT F.C j1.1 (S.genS z)) : W.Or (T0.Tr3 x hx y hy z hz j1 j2) (T0.Tr3 x hx y hy z hz j1 j2 -> W.Empty) =
      SSm.decImp (Id W.O3 (T0.ordS j2.1 (x,(hx,F.C.comp (F.C.fin (S.genS x)) (F.C.fin j1.1) (F.C.fin j2.1) j1.2.1 j2.2.1))
            (y,(hy,F.C.comp (F.C.fin (S.genS y)) (F.C.fin j1.1) (F.C.fin j2.1) j1.2.2 j2.2.1))) lt)
        (Id W.O3 (T0.ordS j2.1 (y,(hy,F.C.comp (F.C.fin (S.genS y)) (F.C.fin j1.1) (F.C.fin j2.1) j1.2.2 j2.2.1)) (z,(hz,j2.2.2))) lt ->
         Id W.O3 (T0.ordS j2.1 (x,(hx,F.C.comp (F.C.fin (S.genS x)) (F.C.fin j1.1) (F.C.fin j2.1) j1.2.1 j2.2.1)) (z,(hz,j2.2.2))) lt)
        (StabHom[l].decO3 (T0.ordS j2.1 (x,(hx,F.C.comp (F.C.fin (S.genS x)) (F.C.fin j1.1) (F.C.fin j2.1) j1.2.1 j2.2.1))
            (y,(hy,F.C.comp (F.C.fin (S.genS y)) (F.C.fin j1.1) (F.C.fin j2.1) j1.2.2 j2.2.1))) lt)
        (SSm.decImp (Id W.O3 (T0.ordS j2.1 (y,(hy,F.C.comp (F.C.fin (S.genS y)) (F.C.fin j1.1) (F.C.fin j2.1) j1.2.2 j2.2.1)) (z,(hz,j2.2.2))) lt)
          (Id W.O3 (T0.ordS j2.1 (x,(hx,F.C.comp (F.C.fin (S.genS x)) (F.C.fin j1.1) (F.C.fin j2.1) j1.2.1 j2.2.1)) (z,(hz,j2.2.2))) lt)
          (StabHom[l].decO3 (T0.ordS j2.1 (y,(hy,F.C.comp (F.C.fin (S.genS y)) (F.C.fin j1.1) (F.C.fin j2.1) j1.2.2 j2.2.1)) (z,(hz,j2.2.2))) lt)
          (StabHom[l].decO3 (T0.ordS j2.1 (x,(hx,F.C.comp (F.C.fin (S.genS x)) (F.C.fin j1.1) (F.C.fin j2.1) j1.2.1 j2.2.1)) (z,(hz,j2.2.2))) lt)) ;
    dSV3 : W.Or T0.SV3 (T0.SV3 -> W.Empty) =
      FL.DecAll[S.mS,\ x hx -> (y : W.N) (hy : CF.Lt y S.mS) (z : W.N) (hz : CF.Lt z S.mS) (t1 : W.N) (h1 : CF.Lt t1 (F.jtN (S.genS x) (S.genS y)))
          (j1 : CF.JT F.C (S.genS x) (S.genS y)) (e1 : Id (CF.Opt (CF.JT F.C (S.genS x) (S.genS y))) (F.jt (S.genS x) (S.genS y) t1 h1) (inl j1)) ->
          P3 x hx y hy z hz t1 h1 j1,
        \ x hx -> FL.DecAll[S.mS,\ y hy -> (z : W.N) (hz : CF.Lt z S.mS) (t1 : W.N) (h1 : CF.Lt t1 (F.jtN (S.genS x) (S.genS y)))
            (j1 : CF.JT F.C (S.genS x) (S.genS y)) (e1 : Id (CF.Opt (CF.JT F.C (S.genS x) (S.genS y))) (F.jt (S.genS x) (S.genS y) t1 h1) (inl j1)) ->
            P3 x hx y hy z hz t1 h1 j1,
          \ y hy -> FL.DecAll[S.mS,\ z hz -> (t1 : W.N) (h1 : CF.Lt t1 (F.jtN (S.genS x) (S.genS y)))
              (j1 : CF.JT F.C (S.genS x) (S.genS y)) (e1 : Id (CF.Opt (CF.JT F.C (S.genS x) (S.genS y))) (F.jt (S.genS x) (S.genS y) t1 h1) (inl j1)) ->
              P3 x hx y hy z hz t1 h1 j1,
            \ z hz -> FL.DecAll[F.jtN (S.genS x) (S.genS y),\ t1 h1 -> (j1 : CF.JT F.C (S.genS x) (S.genS y))
                (e1 : Id (CF.Opt (CF.JT F.C (S.genS x) (S.genS y))) (F.jt (S.genS x) (S.genS y) t1 h1) (inl j1)) -> P3 x hx y hy z hz t1 h1 j1,
              \ t1 h1 -> FL.decOpt (CF.JT F.C (S.genS x) (S.genS y)) (P3 x hx y hy z hz t1 h1)
                (\ j1 -> FL.DecAll[F.jtN j1.1 (S.genS z),\ t2 h2 -> (j2 : CF.JT F.C j1.1 (S.genS z))
                    (e2 : Id (CF.Opt (CF.JT F.C j1.1 (S.genS z))) (F.jt j1.1 (S.genS z) t2 h2) (inl j2)) -> T0.Tr3 x hx y hy z hz j1 j2,
                  \ t2 h2 -> FL.decOpt (CF.JT F.C j1.1 (S.genS z)) (\ j2 -> T0.Tr3 x hx y hy z hz j1 j2) (\ j2 -> dTr3 x hx y hy z hz j1 j2)
                    (F.jt j1.1 (S.genS z) t2 h2)].result)
                (F.jt (S.genS x) (S.genS y) t1 h1)].result].result].result].result ;
    dSV : W.Or T0.SV (T0.SV -> W.Empty) =
      StabHom[l].decPair T0.SV1 (T0.SV2 * T0.SV3) dSV1 (StabHom[l].decPair T0.SV2 T0.SV3 dSV2 dSV3) ;
  } ;
} ;

--------------------------------------------------------------------
-- the listed cospans out of Decode K1 and Decode K2

module JL (F : CF.CEF) (K1 K2 : SC.Code[F]) {
  module O = SF.Over[F.C] ;
  C' : CE.CE = SDi.StabCE[F].ce ;
  JT' : U l = CF.JT C' K1 K2 ;
  Ix : U l = (w : W.Wd) * Id W.N (W.len w) K2.m ;
  toIx (j : W.N) : Ix = (FinOrd[l].bin K2.m j,FinOrd[l].len-bin K2.m j) ;
  ixL : W.List (CF.Opt Ix) = FL.mapO W.N Ix toIx (FL.fromIdx W.N (W.pow2 K2.m) (\ i h -> inl i)) ;
  ixM (p : Ix) : FL.Mem Ix ixL p =
    FL.memR-mapO W.N Ix (\ x y -> Id W.N y x) (\ x y -> Id Ix y x) toIx (FL.fromIdx W.N (W.pow2 K2.m) (\ i h -> inl i)) (FinOrd[l].code p.1) p
      (\ a' e -> PL.trans Ix (toIx a') (toIx (FinOrd[l].code p.1)) p
        (PL.ap W.N Ix toIx a' (FinOrd[l].code p.1) e)
        (PL.Sigma-eq W.Wd (\ w -> Id W.N (W.len w) K2.m) (FinOrd[l].bin K2.m (FinOrd[l].code p.1)) p.1
          (FinOrd[l].len-bin K2.m (FinOrd[l].code p.1)) p.2 (FinOrd[l].bin-code' p.1 K2.m p.2) (W.HN.uip (W.len p.1) K2.m)))
      (FL.mem-fromIdx1 W.N (W.pow2 K2.m) (\ i h -> inl i) (FinOrd[l].code p.1) (FinOrd[l].code-lt' p.1 K2.m p.2) (FinOrd[l].code p.1) (refl (inl (FinOrd[l].code p.1)))) ;
  K2r (p : Ix) : SC.Code[F] = StabSub[l].Restr[F,K2,p.1,p.2].code ;
  Tb (j : Ix) : U l = Tab[F,K1,K2r j].Tbl ;
  dS (j : Ix) (tb : Tb j) : W.Or (SSm.SumC[F,K1,K2r j,tb].SV) (SSm.SumC[F,K1,K2r j,tb].SV -> W.Empty) = Tab[F,K1,K2r j].V[tb].dSV ;
  OkS (j : Ix) (tb : Tb j) : U l = Id W.Bool (FL.isInlO (SSm.SumC[F,K1,K2r j,tb].SV) (SSm.SumC[F,K1,K2r j,tb].SV -> W.Empty) (dS j tb)) true ;
  VS (j : Ix) : U l = (tb : Tb j) * OkS j tb ;
  vsL (j : Ix) : W.List (CF.Opt (VS j)) =
    FL.filterS (Tb j) (OkS j) (\ tb -> W.decB (FL.isInlO (SSm.SumC[F,K1,K2r j,tb].SV) (SSm.SumC[F,K1,K2r j,tb].SV -> W.Empty) (dS j tb)) true)
      (Tab[F,K1,K2r j].tblL) ;
  svOf (j : Ix) (q : VS j) : SSm.SumC[F,K1,K2r j,q.1].SV =
    FL.extract (SSm.SumC[F,K1,K2r j,q.1].SV) (SSm.SumC[F,K1,K2r j,q.1].SV -> W.Empty) (dS j q.1) q.2 ;
  cd (j : Ix) (q : VS j) : SC.Code[F] = SSm.SumCode[F,K1,K2r j,q.1,svOf j q].code ;
  Pr (j : Ix) (q : VS j) : U l = O.Mor (SC.Decode[F,K1].obj) (SC.Decode[F,cd j q].obj) * O.Mor (SC.Decode[F,K2].obj) (SC.Decode[F,cd j q].obj) ;
  prL (j : Ix) (q : VS j) : W.List (CF.Opt (Pr j q)) =
    FL.prodL (O.Mor (SC.Decode[F,K1].obj) (SC.Decode[F,cd j q].obj)) (O.Mor (SC.Decode[F,K2].obj) (SC.Decode[F,cd j q].obj))
      (StabHom[l].HomE[F,K2,cd j q].homL) (StabHom[l].HomE[F,K1,cd j q].homL) ;
  E2 (j : Ix) : U l = (q : VS j) * Pr j q ;
  e2L (j : Ix) : W.List (CF.Opt (E2 j)) = FL.sigL (VS j) (Pr j) (prL j) (vsL j) ;
  E1 : U l = (p : Ix) * E2 p ;
  e1L : W.List (CF.Opt E1) = FL.sigL Ix E2 e2L ixL ;
  toJT (e : E1) : JT' = (cd e.1 e.2.1,e.2.2) ;
  jtL : W.List (CF.Opt JT') = FL.mapO E1 JT' toJT e1L ;
  jtN : W.N = FL.lenL JT' jtL ;
  jt (t : W.N) (h : CF.Lt t jtN) : CF.Opt JT' = FL.nthO JT' jtL t ;
} ;

--------------------------------------------------------------------
-- covering: every pair of maps into a decoded code factors through a listed cospan

module Cov (F : CF.CEF) (K1 K2 K3 : SC.Code[F])
  (f : SF.Over[F.C].Mor (SC.Decode[F,K1].obj) (SC.Decode[F,K3].obj)) (g : SF.Over[F.C].Mor (SC.Decode[F,K2].obj) (SC.Decode[F,K3].obj)) {
  module O = SF.Over[F.C] ;
  module D1 = SC.Decode[F,K1] ;
  module D2 = SC.Decode[F,K2] ;
  module D3 = SC.Decode[F,K3] ;
  Y : SF.SF[F.C] = D3.obj ;
  module G1 = StabFin[l].GI[F,K1,Y] ;
  module G2 = StabFin[l].GI[F,K2,Y] ;
  g1 (n : W.N) : F.C.Obj = F.C.fin (K1.gen n) ;
  g2 (n : W.N) : F.C.Obj = F.C.fin (K2.gen n) ;
  -- which K2 generators are already images of K1 points
  module H = StabHom[l].HomE[F,K2,K1] ;
  Hit (n : W.N) (hn : CF.Lt n K2.m) : U l = (v : D1.Pt (g2 n)) * Id (D3.Pt (g2 n)) ((f.1 (K2.gen n)).1 v) (G2.gimg g n hn) ;
  decHit (n : W.N) (hn : CF.Lt n K2.m) : W.Or (Hit n hn) (Hit n hn -> W.Empty) =
    CF.EnumDec[D1.Pt (g2 n),FL.lenL (D1.Pt (g2 n)) (H.imgL n),\ i h -> FL.nthO (D1.Pt (g2 n)) (H.imgL n) i,
      FL.toEnum (D1.Pt (g2 n)) (H.imgL n) (H.imgM n),
      \ v -> Id (D3.Pt (g2 n)) ((f.1 (K2.gen n)).1 v) (G2.gimg g n hn),
      \ v -> SDi.lo-dec (D3.Gt (g2 n)) ((f.1 (K2.gen n)).1 v) (G2.gimg g n hn)].result ;
  bitH (n : W.N) (hn : CF.Lt n K2.m) : W.Or (Hit n hn) (Hit n hn -> W.Empty) -> W.Bool = split { inl x -> false ; inr x -> true } ;
  bitL (n : W.N) : W.Or (CF.Lt n K2.m) (CF.Lt n K2.m -> W.Empty) -> W.Bool = split { inl hn -> bitH n hn (decHit n hn) ; inr x -> false } ;
  bit (n : W.N) : W.Bool = bitL n (W.decB (W.ltN n K2.m) true) ;
  keptH (n : W.N) (hn : CF.Lt n K2.m) : (r : W.Or (Hit n hn) (Hit n hn -> W.Empty)) -> Id W.Bool (bitH n hn r) true -> Hit n hn -> W.Empty = split {
    inl x -> \ e -> W.absurdB (Hit n hn -> W.Empty) e ; inr x -> \ e -> x } ;
  keptL (n : W.N) (hn : CF.Lt n K2.m) : (r : W.Or (CF.Lt n K2.m) (CF.Lt n K2.m -> W.Empty)) -> Id W.Bool (bitL n r) true -> Hit n hn -> W.Empty = split {
    inl hn' -> \ e -> PL.subst (CF.Lt n K2.m) (\ x -> Hit n x -> W.Empty) hn' hn (W.HB.uip (W.ltN n K2.m) true hn' hn) (keptH n hn' (decHit n hn') e) ;
    inr x -> \ e -> W.absurdB (Hit n hn -> W.Empty) e } ;
  dropH (n : W.N) (hn : CF.Lt n K2.m) : (r : W.Or (Hit n hn) (Hit n hn -> W.Empty)) -> (Id W.Bool (bitH n hn r) true -> W.Empty) -> Hit n hn = split {
    inl x -> \ ne -> x ; inr x -> \ ne -> CF.efq (Hit n hn) (ne (refl true)) } ;
  dropL (n : W.N) (hn : CF.Lt n K2.m) : (r : W.Or (CF.Lt n K2.m) (CF.Lt n K2.m -> W.Empty)) -> (Id W.Bool (bitL n r) true -> W.Empty) -> Hit n hn = split {
    inl hn' -> \ ne -> PL.subst (CF.Lt n K2.m) (Hit n) hn' hn (W.HB.uip (W.ltN n K2.m) true hn' hn) (dropH n hn' (decHit n hn') ne) ;
    inr x -> \ ne -> CF.efq (Hit n hn) (x hn) } ;
  T2 : W.Wd = StabSub[l].wordOf K2.m bit ;
  lT2 : Id W.N (W.len T2) K2.m = StabSub[l].len-wordOf K2.m bit ;
  atT (n : W.N) (hn : CF.Lt n K2.m) : Id W.Bool (W.at T2 n) (bit n) = StabSub[l].at-wordOf K2.m bit n hn ;
  module R2 = StabSub[l].Restr[F,K2,T2,lT2] ;
  K2' : SC.Code[F] = R2.code ;
  -- the generator points and the table read in Y
  x1 (n1 : W.N) (h1 : CF.Lt n1 K1.m) : D3.Pt (g1 n1) = G1.gimg f n1 h1 ;
  x2 (k : W.N) (hk : CF.Lt k K2'.m) : D3.Pt (F.C.fin (K2'.gen k)) = G2.gimg g (W.sel T2 k) (R2.ltl k hk) ;
  tv (n1 : W.N) (h1 : CF.Lt n1 K1.m) (k : W.N) (hk : CF.Lt k K2'.m) : CF.Opt (CF.JT F.C (K1.gen n1) (K2'.gen k)) -> W.O3 = split {
    inl jj -> D3.cmp (F.C.fin jj.1) (D3.PP.post (g1 n1) (F.C.fin jj.1) jj.2.1 (x1 n1 h1)) (D3.PP.post (F.C.fin (K2'.gen k)) (F.C.fin jj.1) jj.2.2 (x2 k hk)) ;
    inr u -> lt } ;
  tbl : Tab[F,K1,K2'].Tbl = \ n1 h1 k hk t ht -> tv n1 h1 k hk (F.jt (K1.gen n1) (K2'.gen k) t ht) ;
} ;

-- a table agreeing with the one read in Y is realised in Y
module Real (F : CF.CEF) (K1 K2 K3 : SC.Code[F])
  (f : SF.Over[F.C].Mor (SC.Decode[F,K1].obj) (SC.Decode[F,K3].obj)) (g : SF.Over[F.C].Mor (SC.Decode[F,K2].obj) (SC.Decode[F,K3].obj))
  (tb : Tab[F,K1,Cov[F,K1,K2,K3,f,g].K2'].Tbl) (ag : Tab[F,K1,Cov[F,K1,K2,K3,f,g].K2'].AgT Cov[F,K1,K2,K3,f,g].tbl tb) {
  module CV = Cov[F,K1,K2,K3,f,g] ;
  module D1 = CV.D1 ;
  module D2 = CV.D2 ;
  module D3 = CV.D3 ;
  module T0 = SSm.SumC[F,K1,CV.K2',tb] ;
  module S = T0.S ;
  K2' : SC.Code[F] = CV.K2' ;
  ptsC (i : W.N) (hi : CF.Lt i S.mS) : (c : S.CutT i) -> D3.Pt (F.C.fin (S.genC i c)) = split {
    inl h -> CV.x1 i h ; inr p -> CV.x2 p.1 (S.lt2i i hi p) } ;
  pts (i : W.N) (hi : CF.Lt i S.mS) : D3.Pt (F.C.fin (S.genS i)) = ptsC i hi (W.cut S.m1 i) ;
  img (A : F.C.Obj) (p : S.PS.Pt A) : D3.Pt A = D3.PP.post (F.C.fin (S.genS p.1)) A p.2.2 (pts p.1 p.2.1) ;
  imgV (A : F.C.Obj) : S.VT A -> D3.Pt A = split {
    inl a -> D3.PP.post (F.C.fin (K1.gen a.1)) A a.2.2 (CV.x1 a.1 a.2.1) ;
    inr b -> D3.PP.post (F.C.fin (K2'.gen b.1)) A b.2.2 (CV.x2 b.1 b.2.1) } ;
  imgVv (A : F.C.Obj) (i : W.N) (hi : CF.Lt i S.mS) : (c : S.CutT i) (q : F.C.Mor (F.C.fin (S.genC i c)) A) ->
      Id (D3.Pt A) (D3.PP.post (F.C.fin (S.genC i c)) A q (ptsC i hi c)) (imgV A (S.view' A i hi c q)) = split {
    inl h -> \ q -> refl (D3.PP.post (F.C.fin (K1.gen i)) A q (CV.x1 i h)) ;
    inr p -> \ q -> refl (D3.PP.post (F.C.fin (K2.gen (W.sel CV.T2 p.1))) A q (CV.x2 p.1 (S.lt2i i hi p))) } ;
  img-view (A : F.C.Obj) (p : S.PS.Pt A) : Id (D3.Pt A) (img A p) (imgV A (S.view A p)) = imgVv A p.1 p.2.1 (W.cut S.m1 p.1) p.2.2 ;
  ref (C0 : SC.Code[F]) (c : F.C.Fin) (p q : SC.Pts[F,C0.m,C0.gen].Pt (F.C.fin c)) : SC.Decode[F,C0].Ref (F.C.fin c) p q =
    (c,(F.C.idm (F.C.fin c),(p.2.2,(q.2.2,(F.C.id-r (F.C.fin (C0.gen p.1)) (F.C.fin c) p.2.2,F.C.id-r (F.C.fin (C0.gen q.1)) (F.C.fin c) q.2.2))))) ;
  c11 (d : F.C.Fin) (a b : S.P1.Pt (F.C.fin d)) : Id W.O3 (K1.ord d a b) (D3.cmp (F.C.fin d) (imgV (F.C.fin d) (inl a)) (imgV (F.C.fin d) (inl b))) =
    PL.trans W.O3 (K1.ord d a b) (D1.cmp (F.C.fin d) a b) (D3.cmp (F.C.fin d) (imgV (F.C.fin d) (inl a)) (imgV (F.C.fin d) (inl b)))
      (PL.sym W.O3 (D1.cmp (F.C.fin d) a b) (K1.ord d a b) (D1.spec (F.C.fin d) a b (ref K1 d a b)))
      (PL.trans W.O3 (D1.cmp (F.C.fin d) a b) (D3.cmp (F.C.fin d) ((f.1 d).1 a) ((f.1 d).1 b)) (D3.cmp (F.C.fin d) (imgV (F.C.fin d) (inl a)) (imgV (F.C.fin d) (inl b)))
        (PL.sym W.O3 (D3.cmp (F.C.fin d) ((f.1 d).1 a) ((f.1 d).1 b)) (D1.cmp (F.C.fin d) a b) ((f.1 d).2 a b))
        (W.ap2 (D3.Pt (F.C.fin d)) (D3.Pt (F.C.fin d)) W.O3 (D3.cmp (F.C.fin d)) ((f.1 d).1 a) (imgV (F.C.fin d) (inl a)) ((f.1 d).1 b) (imgV (F.C.fin d) (inl b))
          (CV.G1.val f d a) (CV.G1.val f d b))) ;
  c22 (d : F.C.Fin) (a b : S.P2.Pt (F.C.fin d)) : Id W.O3 (K2'.ord d a b) (D3.cmp (F.C.fin d) (imgV (F.C.fin d) (inr a)) (imgV (F.C.fin d) (inr b))) =
    PL.trans W.O3 (K2'.ord d a b) (D2.cmp (F.C.fin d) (CV.R2.lift (F.C.fin d) a) (CV.R2.lift (F.C.fin d) b))
        (D3.cmp (F.C.fin d) (imgV (F.C.fin d) (inr a)) (imgV (F.C.fin d) (inr b)))
      (PL.sym W.O3 (D2.cmp (F.C.fin d) (CV.R2.lift (F.C.fin d) a) (CV.R2.lift (F.C.fin d) b)) (K2.ord d (CV.R2.lift (F.C.fin d) a) (CV.R2.lift (F.C.fin d) b))
        (D2.spec (F.C.fin d) (CV.R2.lift (F.C.fin d) a) (CV.R2.lift (F.C.fin d) b) (ref K2 d (CV.R2.lift (F.C.fin d) a) (CV.R2.lift (F.C.fin d) b))))
      (PL.trans W.O3 (D2.cmp (F.C.fin d) (CV.R2.lift (F.C.fin d) a) (CV.R2.lift (F.C.fin d) b))
          (D3.cmp (F.C.fin d) ((g.1 d).1 (CV.R2.lift (F.C.fin d) a)) ((g.1 d).1 (CV.R2.lift (F.C.fin d) b)))
          (D3.cmp (F.C.fin d) (imgV (F.C.fin d) (inr a)) (imgV (F.C.fin d) (inr b)))
        (PL.sym W.O3 (D3.cmp (F.C.fin d) ((g.1 d).1 (CV.R2.lift (F.C.fin d) a)) ((g.1 d).1 (CV.R2.lift (F.C.fin d) b)))
          (D2.cmp (F.C.fin d) (CV.R2.lift (F.C.fin d) a) (CV.R2.lift (F.C.fin d) b)) ((g.1 d).2 (CV.R2.lift (F.C.fin d) a) (CV.R2.lift (F.C.fin d) b)))
        (W.ap2 (D3.Pt (F.C.fin d)) (D3.Pt (F.C.fin d)) W.O3 (D3.cmp (F.C.fin d))
          ((g.1 d).1 (CV.R2.lift (F.C.fin d) a)) (imgV (F.C.fin d) (inr a)) ((g.1 d).1 (CV.R2.lift (F.C.fin d) b)) (imgV (F.C.fin d) (inr b))
          (CV.G2.val g d (CV.R2.lift (F.C.fin d) a)) (CV.G2.val g d (CV.R2.lift (F.C.fin d) b)))) ;
  -- comparison of images at a listed cospan and at any refinement
  module Ref (n1 : W.N) (h1 : CF.Lt n1 K1.m) (k : W.N) (hk : CF.Lt k K2'.m) (jj : CF.JT F.C (K1.gen n1) (K2'.gen k)) (d : F.C.Fin)
    (mm : F.C.Mor (F.C.fin jj.1) (F.C.fin d)) {
    J : F.C.Obj = F.C.fin jj.1 ;
    Fd : F.C.Obj = F.C.fin d ;
    a0 : D3.Pt J = D3.PP.post (CV.g1 n1) J jj.2.1 (CV.x1 n1 h1) ;
    b0 : D3.Pt J = D3.PP.post (F.C.fin (K2'.gen k)) J jj.2.2 (CV.x2 k hk) ;
    result : Id W.O3 (D3.cmp J a0 b0)
      (D3.cmp Fd (D3.PP.post (CV.g1 n1) Fd (F.C.comp (CV.g1 n1) J Fd jj.2.1 mm) (CV.x1 n1 h1))
        (D3.PP.post (F.C.fin (K2'.gen k)) Fd (F.C.comp (F.C.fin (K2'.gen k)) J Fd jj.2.2 mm) (CV.x2 k hk))) =
      PL.trans W.O3 (D3.cmp J a0 b0) (D3.cmp Fd (D3.PP.post J Fd mm a0) (D3.PP.post J Fd mm b0))
          (D3.cmp Fd (D3.PP.post (CV.g1 n1) Fd (F.C.comp (CV.g1 n1) J Fd jj.2.1 mm) (CV.x1 n1 h1))
            (D3.PP.post (F.C.fin (K2'.gen k)) Fd (F.C.comp (F.C.fin (K2'.gen k)) J Fd jj.2.2 mm) (CV.x2 k hk)))
        (PL.sym W.O3 (D3.cmp Fd (D3.PP.post J Fd mm a0) (D3.PP.post J Fd mm b0)) (D3.cmp J a0 b0) ((D3.arr J Fd mm).2 a0 b0))
        (W.ap2 (D3.Pt Fd) (D3.Pt Fd) W.O3 (D3.cmp Fd) (D3.PP.post J Fd mm a0) (D3.PP.post (CV.g1 n1) Fd (F.C.comp (CV.g1 n1) J Fd jj.2.1 mm) (CV.x1 n1 h1))
          (D3.PP.post J Fd mm b0) (D3.PP.post (F.C.fin (K2'.gen k)) Fd (F.C.comp (F.C.fin (K2'.gen k)) J Fd jj.2.2 mm) (CV.x2 k hk))
          (D3.arr-comp (CV.g1 n1) J Fd jj.2.1 mm (CV.x1 n1 h1)) (D3.arr-comp (F.C.fin (K2'.gen k)) J Fd jj.2.2 mm (CV.x2 k hk))) ;
  } ;
  tvE (n1 : W.N) (h1 : CF.Lt n1 K1.m) (k : W.N) (hk : CF.Lt k K2'.m) (t : W.N) (ht : CF.Lt t (F.jtN (K1.gen n1) (K2'.gen k)))
    (jj : CF.JT F.C (K1.gen n1) (K2'.gen k)) (e : Id (CF.Opt (CF.JT F.C (K1.gen n1) (K2'.gen k))) (F.jt (K1.gen n1) (K2'.gen k) t ht) (inl jj)) :
      Id W.O3 (tb n1 h1 k hk t ht) (D3.cmp (F.C.fin jj.1) Ref[n1,h1,k,hk,jj,jj.1,F.C.idm (F.C.fin jj.1)].a0 Ref[n1,h1,k,hk,jj,jj.1,F.C.idm (F.C.fin jj.1)].b0) =
    PL.trans W.O3 (tb n1 h1 k hk t ht) (CV.tbl n1 h1 k hk t ht) (D3.cmp (F.C.fin jj.1) Ref[n1,h1,k,hk,jj,jj.1,F.C.idm (F.C.fin jj.1)].a0 Ref[n1,h1,k,hk,jj,jj.1,F.C.idm (F.C.fin jj.1)].b0)
      (ag n1 h1 k hk t ht)
      (PL.ap (CF.Opt (CF.JT F.C (K1.gen n1) (K2'.gen k))) W.O3 (CV.tv n1 h1 k hk) (F.jt (K1.gen n1) (K2'.gen k) t ht) (inl jj) e) ;
  c12 (d : F.C.Fin) (a : S.P1.Pt (F.C.fin d)) (b : S.P2.Pt (F.C.fin d)) :
      Id W.O3 (T0.look d a b) (D3.cmp (F.C.fin d) (imgV (F.C.fin d) (inl a)) (imgV (F.C.fin d) (inr b))) =
    PL.trans W.O3 (T0.look d a b)
        (D3.cmp (F.C.fin SJ0.FindJ[F,K1.gen a.1,K2'.gen b.1,d,a.2.2,b.2.2].j.1)
          Ref[a.1,a.2.1,b.1,b.2.1,SJ0.FindJ[F,K1.gen a.1,K2'.gen b.1,d,a.2.2,b.2.2].j,d,SJ0.FindJ[F,K1.gen a.1,K2'.gen b.1,d,a.2.2,b.2.2].fac.1].a0
          Ref[a.1,a.2.1,b.1,b.2.1,SJ0.FindJ[F,K1.gen a.1,K2'.gen b.1,d,a.2.2,b.2.2].j,d,SJ0.FindJ[F,K1.gen a.1,K2'.gen b.1,d,a.2.2,b.2.2].fac.1].b0)
        (D3.cmp (F.C.fin d) (imgV (F.C.fin d) (inl a)) (imgV (F.C.fin d) (inr b)))

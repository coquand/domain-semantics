-- Solve the concrete reflexive equation in CUSL, then transport to EP.
level l ;
open Base ;
module SD = ScottDomain[l] ;
module CU = ScottCUSL[l] ;
module EP = ScottDomainCategories[l].EmbeddingProjection ;
module K = CategoryInitialChain[l++,l+] ;
module Sol = CategoryInitialSolution[l] ;

module On (A : SD.Scott) {
  module P = ScottCUSLReflexivePreservation[l].On[A] ;
  module C = ScottCUSLFixedPoint[l].On[P.G.functor,P.omega] ;
  module T = ScottCUSLSolutionTransport[l].On[P.G.functor,P.omega] ;
  cusl : CU.CUSL = C.solution ;
  cusl-equation : Id CU.CUSL cusl (P.G.functor.object cusl) =
    C.equation ;
  ep-functor : K.Endofunctor[EP.pre] = T.functor ;
  ep-preservation : K.OmegaContinuous[EP.pre,ep-functor] =
    T.preservation ;
  ep-solution : Sol.InitialSolution[EP.category,ep-functor] =
    T.solution ;
  ep-equation : Id EP.pre.ob ep-solution.object
    (ep-functor.object ep-solution.object) = T.equation ;
} ;

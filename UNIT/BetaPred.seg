-- Girard 10.2.9: the predecessor relation between homogeneous proofs
-- (as wholes) is well-founded -- classically.
--
-- Objects: prefixed homogeneous tree families.  An object is a functor-like
-- k : LO -> LO (with action km on embeddings) and a family of trees
-- X |-> P X over the labels of k X, natural in X (k X = X for beta-proofs,
-- k X = a + X for Girard's a+Id-proofs).
-- Immediate predecessors (Step, shift): for a well-order D and a natural
-- family of labels lab X in k (D + X) at which the tree has a node, the
-- subtree family  X |-> (subtree of P (D + X) at lab X), with prefix
-- k (D + -).  With D empty this covers the premises of unary, binary and
-- omega-rules; with D = beta + 1 Girard's chi^beta of the ordinal rules.
--
-- Theorem (Cl.main, induction along predecessors): with excluded middle and
-- dependent choice for LARGE types (parameters LEM2, DC2), every property
-- of objects (proposition-valued) closed under predecessors holds of every
-- CORRECT object (well-founded trees at all well-orders).
-- Proof (Chain): an infinite chain of predecessors with shifts D_n is
-- evaluated at the single well-order  X_0 = Sum_n D_n  (NSumLO; no supremum
-- of ordinals is needed): X_n = Sum_{m >= n} D_m embeds D_n + X_(n+1) into
-- X_n, and the chain becomes an infinite branch of the tree of the first
-- object at X_0, contradicting its Brouwer bound.
-- The classical principles are used only to produce the chain.
level l ;
open Base ; open Prelude[l+] ; open ScottOrder[l] ;
module W = Dilator[l] ;
module W1 = Dilator[l+] ;
module DP = DilPtyx[l] ;
module CF = CatEmbFin[l] ;
module PL = Prelude[l] ;
module P1 = Prelude[l+] ;
module LT = LabTree[l] ;
module LW = LOWF[l] ;
module KT = KBTree[l] ;
module LC = LOCat[l] ;
module PS = PtyxSum[l] ;
module NS = NSumLO[l] ;
module SO1 = ScottOrder[l+] ;
module TC1 = TruncationCombinators[l+] ;
module BP = BetaProof[l] ;

Obj : U l+ = (k : DP.LO -> DP.LO) * ((km : (X Y : DP.LO) -> DP.Map X Y -> DP.Map (k X) (k Y)) *
  ((P : (X : DP.LO) -> LT.LL (k X) -> W.Bool) *
   ((X Y : DP.LO) (g : DP.Map X Y) (ys : LT.LL (k X)) -> Id W.Bool (P Y (LT.mapL (k X) (k Y) (km X Y g) ys)) (P X ys)))) ;
kO (o : Obj) : DP.LO -> DP.LO = o.1 ;
kmO (o : Obj) : (X Y : DP.LO) -> DP.Map X Y -> DP.Map (kO o X) (kO o Y) = o.2.1 ;
PO (o : Obj) : (X : DP.LO) -> LT.LL (kO o X) -> W.Bool = o.2.2.1 ;
natO (o : Obj) : (X Y : DP.LO) (g : DP.Map X Y) (ys : LT.LL (kO o X)) ->
    Id W.Bool (PO o Y (LT.mapL (kO o X) (kO o Y) (kmO o X Y g) ys)) (PO o X ys) = o.2.2.2 ;
Sm (D X : DP.LO) : DP.LO = PS.SumLO[D,X].lo ;
smap (D X Y : DP.LO) (g : DP.Map X Y) : DP.Map (Sm D X) (Sm D Y) = PS.SumMap[D,X,D,Y,LC.idMap D,g].map ;
LbO (o : Obj) (X : DP.LO) : U l = (LT.Lab (kO o X)).car ;

-- immediate predecessors
Step (o : Obj) : U l+ = (D : DP.LO) * (LW.WF D * ((lab : (X : DP.LO) -> LbO o (Sm D X)) *
  (((X Y : DP.LO) (g : DP.Map X Y) ->
      Id (LbO o (Sm D Y)) (LT.lm (kO o (Sm D X)) (kO o (Sm D Y)) (kmO o (Sm D X) (Sm D Y) (smap D X Y g)) (lab X)) (lab Y)) *
   ((X : DP.LO) -> Id W.Bool (PO o (Sm D X) (consL (lab X) nilL)) true)))) ;
module Sh (o : Obj) (st : Step o) {
  D : DP.LO = st.1 ;
  lab (X : DP.LO) : LbO o (Sm D X) = st.2.2.1 X ;
  k (X : DP.LO) : DP.LO = kO o (Sm D X) ;
  km (X Y : DP.LO) (g : DP.Map X Y) : DP.Map (k X) (k Y) = kmO o (Sm D X) (Sm D Y) (smap D X Y g) ;
  P (X : DP.LO) (ys : LT.LL (k X)) : W.Bool = PO o (Sm D X) (consL (lab X) ys) ;
  nat (X Y : DP.LO) (g : DP.Map X Y) (ys : LT.LL (k X)) : Id W.Bool (P Y (LT.mapL (k X) (k Y) (km X Y g) ys)) (P X ys) =
    PL.trans W.Bool (P Y (LT.mapL (k X) (k Y) (km X Y g) ys)) (PO o (Sm D Y) (LT.mapL (k X) (k Y) (km X Y g) (consL (lab X) ys))) (P X ys)
      (PL.ap (LbO o (Sm D Y)) W.Bool (\ z -> PO o (Sm D Y) (consL z (LT.mapL (k X) (k Y) (km X Y g) ys))) (lab Y)
        (LT.lm (k X) (k Y) (km X Y g) (lab X)) (PL.sym (LbO o (Sm D Y)) (LT.lm (k X) (k Y) (km X Y g) (lab X)) (lab Y) (st.2.2.2.1 X Y g)))
      (natO o (Sm D X) (Sm D Y) (smap D X Y g) (consL (lab X) ys)) ;
  obj : Obj = (k,(km,(P,nat))) ;
} ;
shift (o : Obj) (st : Step o) : Obj = Sh[o,st].obj ;

-- correct objects: the trees are well-founded at well-orders
CorrO (o : Obj) : U l+ = (X : DP.LO) -> LW.WF X -> KT.KB[LT.Lab (kO o X)].WFT (PO o X) ;

------------------------------------------------------------------------
-- a bounded tree has no infinite branch
preS (Z : U l) (g : W.N -> Z) : W.N -> W.List Z = split {
  zero -> nilL ; suc n | r -> KT.appL Z r (consL (g n) nilL) } ;
preCons (Z : U l) (g : W.N -> Z) : (n : W.N) -> Id (W.List Z) (preS Z g (suc n)) (consL (g zero) (preS Z (\ m -> g (suc m)) n)) = split {
  zero -> refl (consL (g zero) nilL) ;
  suc n | r -> PL.ap (W.List Z) (W.List Z) (\ t -> KT.appL Z t (consL (g (suc n)) nilL)) (preS Z g (suc n))
    (consL (g zero) (preS Z (\ m -> g (suc m)) n)) r } ;
module NB (L : DP.LO) {
  module K = KT.KB[L] ;
  noBranch : (b : K.BT) (P : K.Tr) -> K.Bnd b P -> (g : W.N -> L.car) ->
      ((n : W.N) -> Id W.Bool (P (preS L.car g (suc n))) true) -> W.Empty = split {
    leaf -> \ P hb g h -> W.absurdB W.Empty (PL.trans W.Bool false (P (preS L.car g (suc zero))) true
      (PL.sym W.Bool (P (preS L.car g (suc zero))) false (hb (preS L.car g (suc zero)))) (h zero)) ;
    node f | r -> \ P hb g h -> r (g zero) (K.sub P (g zero)) (hb (g zero)) (\ m -> g (suc m))
      (\ n -> PL.subst (W.List L.car) (\ z -> Id W.Bool (P z) true) (preS L.car g (suc (suc n)))
        (consL (g zero) (preS L.car (\ m -> g (suc m)) (suc n))) (preCons L.car g (suc n)) (h (suc n))) } ;
} ;

------------------------------------------------------------------------
-- an infinite chain of predecessors contradicts correctness
trS (x : Obj) (y : Obj) (e : Id Obj x y) (st : Step y) : Step x = idJ Obj x (\ z q -> Step z -> Step x) (\ s0 -> s0) y e st ;
shiftTr (x : Obj) (y : Obj) (e : Id Obj x y) : (st : Step y) -> Id Obj (shift x (trS x y e st)) (shift y st) =
  idJ Obj x (\ z q -> (st : Step z) -> Id Obj (shift x (trS x z q st)) (shift z st)) (\ st -> refl (shift x st)) y e ;
fK : W.N -> W.N -> W.N = split { zero -> \ n -> n ; suc k | r -> \ n -> r (suc n) } ;
module Chain (s : W.N -> Obj) (rel : (n : W.N) -> (st : Step (s n)) * Id Obj (s (suc n)) (shift (s n) st)) (c0 : CorrO (s zero)) {
  -- the chain with definitional shifts
  tt : (n : W.N) -> (o : Obj) * Id Obj o (s n) = split {
    zero -> (s zero,refl (s zero)) ;
    suc n | r -> (shift r.1 (trS r.1 (s n) r.2 (rel n).1),
      P1.trans Obj (shift r.1 (trS r.1 (s n) r.2 (rel n).1)) (shift (s n) (rel n).1) (s (suc n))
        (shiftTr r.1 (s n) r.2 (rel n).1) (P1.sym Obj (s (suc n)) (shift (s n) (rel n).1) (rel n).2)) } ;
  t (n : W.N) : Obj = (tt n).1 ;
  stp (n : W.N) : Step (t n) = trS (t n) (s n) (tt n).2 (rel n).1 ;
  -- the well-order Sum_{m >= n} D_m
  B : NS.NFam = \ n -> (stp n).1 ;
  Xs (n : W.N) : NS.NFam = \ k -> B (fK k n) ;
  XL (n : W.N) : DP.LO = NS.NSum[Xs n].lo ;
  wfX (n : W.N) : LW.WF (XL n) = NS.nsWF (Xs n) (\ k -> (stp (fK k n)).2.1) ;
  eF (n : W.N) : W.Or (B n).car (NS.NCar (Xs (suc n))) -> NS.NCar (Xs n) = split {
    inl d -> (zero,d) ; inr p -> NS.nup (Xs n) p } ;
  eM (n : W.N) : (x y : W.Or (B n).car (NS.NCar (Xs (suc n)))) ->
      Id W.O3 (NS.NSum[Xs n].cmp (eF n x) (eF n y)) (PS.SumLO[B n,XL (suc n)].cmp x y) = split {
    inl x -> split { inl y -> refl ((B n).cmp x y) ; inr q -> refl lt } ;
    inr p -> split { inl y -> refl gt ; inr q -> refl (NS.nsCmp p.1 (Xs (suc n)) q.1 p.2 q.2) } } ;
  e (n : W.N) : DP.Map (Sm (B n) (XL (suc n))) (XL n) = (eF n,eM n) ;
  -- the evaluations of the chain inside the first object at X_0
  phi : (n : W.N) -> DP.Map (kO (t n) (XL n)) (kO (t zero) (XL zero)) = split {
    zero -> LC.idMap (kO (t zero) (XL zero)) ;
    suc n | r -> LC.compMap (kO (t (suc n)) (XL (suc n))) (kO (t n) (XL n)) (kO (t zero) (XL zero))
      (kmO (t n) (Sm (B n) (XL (suc n))) (XL n) (e n)) r } ;
  L0 : DP.LO = LT.Lab (kO (t zero) (XL zero)) ;
  x (n : W.N) : L0.car = LT.lm (kO (t (suc n)) (XL (suc n))) (kO (t zero) (XL zero)) (phi (suc n)) ((stp n).2.2.1 (XL (suc n))) ;
  P0 (ys : LT.LL (kO (t zero) (XL zero))) : W.Bool = PO (t zero) (XL zero) ys ;
  inv : (n : W.N) (ys : LT.LL (kO (t n) (XL n))) ->
      Id W.Bool (PO (t n) (XL n) ys) (P0 (KT.appL L0.car (preS L0.car x n) (LT.mapL (kO (t n) (XL n)) (kO (t zero) (XL zero)) (phi n) ys))) = split {
    zero -> \ ys -> PL.ap (LT.LL (kO (t zero) (XL zero))) W.Bool P0 ys (LT.mapL (kO (t zero) (XL zero)) (kO (t zero) (XL zero)) (phi zero) ys)
      (PL.sym (LT.LL (kO (t zero) (XL zero))) (LT.mapL (kO (t zero) (XL zero)) (kO (t zero) (XL zero)) (phi zero) ys) ys
        (LT.mapL-id (kO (t zero) (XL zero)) ys)) ;
    suc n | r -> \ ys ->
      PL.trans W.Bool (PO (t (suc n)) (XL (suc n)) ys)
          (PO (t n) (XL n) (LT.mapL (kO (t (suc n)) (XL (suc n))) (kO (t n) (XL n)) (kmO (t n) (Sm (B n) (XL (suc n))) (XL n) (e n))
            (consL ((stp n).2.2.1 (XL (suc n))) ys)))
          (P0 (KT.appL L0.car (preS L0.car x (suc n)) (LT.mapL (kO (t (suc n)) (XL (suc n))) (kO (t zero) (XL zero)) (phi (suc n)) ys)))
        (PL.sym W.Bool (PO (t n) (XL n) (LT.mapL (kO (t (suc n)) (XL (suc n))) (kO (t n) (XL n)) (kmO (t n) (Sm (B n) (XL (suc n))) (XL n) (e n))
            (consL ((stp n).2.2.1 (XL (suc n))) ys))) (PO (t (suc n)) (XL (suc n)) ys)
          (natO (t n) (Sm (B n) (XL (suc n))) (XL n) (e n) (consL ((stp n).2.2.1 (XL (suc n))) ys)))
        (PL.trans W.Bool
            (PO (t n) (XL n) (LT.mapL (kO (t (suc n)) (XL (suc n))) (kO (t n) (XL n)) (kmO (t n) (Sm (B n) (XL (suc n))) (XL n) (e n))
              (consL ((stp n).2.2.1 (XL (suc n))) ys)))
            (P0 (KT.appL L0.car (preS L0.car x n) (LT.mapL (kO (t n) (XL n)) (kO (t zero) (XL zero)) (phi n)
              (LT.mapL (kO (t (suc n)) (XL (suc n))) (kO (t n) (XL n)) (kmO (t n) (Sm (B n) (XL (suc n))) (XL n) (e n))
                (consL ((stp n).2.2.1 (XL (suc n))) ys)))))
            (P0 (KT.appL L0.car (preS L0.car x (suc n)) (LT.mapL (kO (t (suc n)) (XL (suc n))) (kO (t zero) (XL zero)) (phi (suc n)) ys)))
          (r (LT.mapL (kO (t (suc n)) (XL (suc n))) (kO (t n) (XL n)) (kmO (t n) (Sm (B n) (XL (suc n))) (XL n) (e n))
            (consL ((stp n).2.2.1 (XL (suc n))) ys)))
          (PL.ap (LT.LL (kO (t zero) (XL zero))) W.Bool P0
            (KT.appL L0.car (preS L0.car x n) (LT.mapL (kO (t n) (XL n)) (kO (t zero) (XL zero)) (phi n)
              (LT.mapL (kO (t (suc n)) (XL (suc n))) (kO (t n) (XL n)) (kmO (t n) (Sm (B n) (XL (suc n))) (XL n) (e n))
                (consL ((stp n).2.2.1 (XL (suc n))) ys))))
            (KT.appL L0.car (preS L0.car x (suc n)) (LT.mapL (kO (t (suc n)) (XL (suc n))) (kO (t zero) (XL zero)) (phi (suc n)) ys))
            (PL.trans (LT.LL (kO (t zero) (XL zero)))
                (KT.appL L0.car (preS L0.car x n) (LT.mapL (kO (t n) (XL n)) (kO (t zero) (XL zero)) (phi n)
                  (LT.mapL (kO (t (suc n)) (XL (suc n))) (kO (t n) (XL n)) (kmO (t n) (Sm (B n) (XL (suc n))) (XL n) (e n))
                    (consL ((stp n).2.2.1 (XL (suc n))) ys))))
                (KT.appL L0.car (preS L0.car x n) (consL (x n) (LT.mapL (kO (t (suc n)) (XL (suc n))) (kO (t zero) (XL zero)) (phi (suc n)) ys)))
                (KT.appL L0.car (preS L0.car x (suc n)) (LT.mapL (kO (t (suc n)) (XL (suc n))) (kO (t zero) (XL zero)) (phi (suc n)) ys))
              (PL.ap (LT.LL (kO (t zero) (XL zero))) (LT.LL (kO (t zero) (XL zero))) (KT.appL L0.car (preS L0.car x n))
                (LT.mapL (kO (t n) (XL n)) (kO (t zero) (XL zero)) (phi n)
                  (LT.mapL (kO (t (suc n)) (XL (suc n))) (kO (t n) (XL n)) (kmO (t n) (Sm (B n) (XL (suc n))) (XL n) (e n))
                    (consL ((stp n).2.2.1 (XL (suc n))) ys)))
                (LT.mapL (kO (t (suc n)) (XL (suc n))) (kO (t zero) (XL zero)) (phi (suc n)) (consL ((stp n).2.2.1 (XL (suc n))) ys))
                (LT.mapL-comp (kO (t (suc n)) (XL (suc n))) (kO (t n) (XL n)) (kO (t zero) (XL zero))
                  (kmO (t n) (Sm (B n) (XL (suc n))) (XL n) (e n)) (phi n) (consL ((stp n).2.2.1 (XL (suc n))) ys)))
              (PL.sym (LT.LL (kO (t zero) (XL zero)))
                (KT.appL L0.car (preS L0.car x (suc n)) (LT.mapL (kO (t (suc n)) (XL (suc n))) (kO (t zero) (XL zero)) (phi (suc n)) ys))
                (KT.appL L0.car (preS L0.car x n) (consL (x n) (LT.mapL (kO (t (suc n)) (XL (suc n))) (kO (t zero) (XL zero)) (phi (suc n)) ys)))
                (KT.appL-assoc L0.car (preS L0.car x n) (consL (x n) nilL)
                  (LT.mapL (kO (t (suc n)) (XL (suc n))) (kO (t zero) (XL zero)) (phi (suc n)) ys)))))) } ;
  -- the labels x n form an infinite branch of the first tree at X_0
  onBranch (n : W.N) : Id W.Bool (P0 (preS L0.car x (suc n))) true =
    PL.trans W.Bool (P0 (preS L0.car x (suc n))) (PO (t (suc n)) (XL (suc n)) nilL) true
      (PL.trans W.Bool (P0 (preS L0.car x (suc n))) (P0 (KT.appL L0.car (preS L0.car x (suc n)) nilL)) (PO (t (suc n)) (XL (suc n)) nilL)
        (PL.ap (LT.LL (kO (t zero) (XL zero))) W.Bool P0 (preS L0.car x (suc n)) (KT.appL L0.car (preS L0.car x (suc n)) nilL)
          (PL.sym (LT.LL (kO (t zero) (XL zero))) (KT.appL L0.car (preS L0.car x (suc n)) nilL) (preS L0.car x (suc n))
            (KT.appL-nil L0.car (preS L0.car x (suc n)))))
        (PL.sym W.Bool (PO (t (suc n)) (XL (suc n)) nilL) (P0 (KT.appL L0.car (preS L0.car x (suc n)) nilL)) (inv (suc n) nilL)))
      ((stp n).2.2.2.2 (XL (suc n))) ;
  contra : W.Empty = NB[L0].noBranch (c0 (XL zero) (wfX zero)).1 P0 (c0 (XL zero) (wfX zero)).2 x onBranch ;
} ;

------------------------------------------------------------------------
-- the classical theorem
LEM2 : U l++ = (P : U l+) -> P1.isProp P -> W1.Or P (P -> W.Empty) ;
DC2 : U l++ = (A : U l+) (R : A -> A -> U l+) (a0 : A) -> ((x : A) -> SO1.Ex ((y : A) * R x y)) ->
  SO1.Ex ((s : W.N -> A) * (Id A (s zero) a0 * ((n : W.N) -> R (s n) (s (suc n))))) ;
orE (A B C : U l+) (f : A -> C) (g : B -> C) : W1.Or A B -> C = split { inl a -> f a ; inr b -> g b } ;
efq1 (A : U l+) : W.Empty -> A = split { } ;
module Cl (lem : LEM2) (dc : DC2) (Q : Obj -> U l+) (qp : (x : Obj) -> P1.isProp (Q x))
  (cl : (x : Obj) -> ((st : Step x) -> Q (shift x st)) -> Q x) {
  Bad : U l+ = (x : Obj) * (Q x -> W.Empty) ;
  R (b b' : Bad) : U l+ = (st : Step b.1) * Id Obj b'.1 (shift b.1 st) ;
  E (b : Bad) : U l+ = (st : Step b.1) * (Q (shift b.1 st) -> W.Empty) ;
  -- a bad object has a bad predecessor
  tot (b : Bad) : SO1.Ex ((b' : Bad) * R b b') =
    orE (SO1.Ex (E b)) (SO1.Ex (E b) -> W.Empty) (SO1.Ex ((b' : Bad) * R b b'))
      (TC1.map (E b) ((b' : Bad) * R b b') (\ z -> ((shift b.1 z.1,z.2),(z.1,refl (shift b.1 z.1)))))
      (\ ne -> efq1 (SO1.Ex ((b' : Bad) * R b b')) (b.2 (cl b.1 (\ st ->
        orE (Q (shift b.1 st)) (Q (shift b.1 st) -> W.Empty) (Q (shift b.1 st)) (\ q -> q)
          (\ nq -> efq1 (Q (shift b.1 st)) (ne (SO1.inc (E b) (st,nq))))
          (lem (Q (shift b.1 st)) (qp (shift b.1 st)))))))
      (lem (SO1.Ex (E b)) (SO1.prop (E b))) ;
  noChain (x0 : Obj) (c0 : CorrO x0) (nq : Q x0 -> W.Empty)
    (sq : (s : W.N -> Bad) * (Id Bad (s zero) (x0,nq) * ((n : W.N) -> R (s n) (s (suc n))))) : W.Empty =
    Chain[\ n -> (sq.1 n).1,sq.2.2,
      P1.subst Obj CorrO x0 (sq.1 zero).1 (P1.ap Bad Obj (\ b -> b.1) (x0,nq) (sq.1 zero) (P1.sym Bad (sq.1 zero) (x0,nq) sq.2.1)) c0].contra ;
  -- 10.2.9: induction along predecessors, for correct objects
  main (x0 : Obj) (c0 : CorrO x0) : Q x0 =
    orE (Q x0) (Q x0 -> W.Empty) (Q x0) (\ q -> q)
      (\ nq -> efq1 (Q x0) (TC1.rec ((s : W.N -> Bad) * (Id Bad (s zero) (x0,nq) * ((n : W.N) -> R (s n) (s (suc n))))) @l
        W.Empty CF.empty-prop (noChain x0 c0 nq) (dc Bad R (x0,nq) tot)))
      (lem (Q x0) (qp x0)) ;
} ;

------------------------------------------------------------------------
-- homogeneous beta-proofs are objects (k = identity)
module BetaObj (ev : (A : DP.LO) -> W.N -> LT.LL A -> W.Bool)
  (Gs : (C : DP.LO) -> BP.Beta[ev].Seq C) (Rs : (C : DP.LO) -> BP.Beta[ev].Rl C)
  (ng : (C D : DP.LO) (g : DP.Map C D) -> Id (BP.Beta[ev].Seq D) (Gs D) (BP.Beta[ev].Map[C,D,g].mS (Gs C)))
  (nr : (C D : DP.LO) (g : DP.Map C D) (ys : LT.LL C) -> Id (BP.Beta[ev].Rule D) (Rs D (LT.mapL C D g ys)) (BP.Beta[ev].Map[C,D,g].mR (Rs C ys))) {
  obj : Obj = (\ X -> X,(\ X Y g -> g,(\ X ys -> BP.Beta[ev].inTree X ys (Rs X) (Gs X),
    \ X Y g ys -> BP.Beta[ev].Map[X,Y,g].treeMap ys (Rs X) (Rs Y) (Gs X) (Gs Y) (nr X Y g) (ng X Y g)))) ;
  -- correctness of the beta-proof is correctness of the object
  corr (lo : (C : DP.LO) -> BP.Beta[ev].LocOK C (Rs C) (Gs C)) (c : BP.Beta[ev].Pre[Gs,Rs,lo].Correct) : CorrO obj = c ;
} ;

------------------------------------------------------------------------
-- CONSTRUCTIVE version: predecessors absorbed by a well-order Z.
-- If Z is a well-order such that the shifts considered embed as D + Z -> Z
-- (an "absorption"), induction along these predecessors holds for every
-- object whose tree at Z is well-founded, for ANY (data-valued) property,
-- without excluded middle or choice: induction on the Brouwer bound of the
-- tree at Z, following each predecessor inside it.
-- (Girard's full 10.2.9 has shifts by ALL well-orders; no small Z absorbs
-- them all, so this needs evaluation at a large well-order, e.g. the
-- ordinal of all small well-orders, one universe up.)
module Cons (Z : DP.LO) (Q : Obj -> U l+)
  (cl : (x : Obj) -> ((st : Step x) -> DP.Map (Sm st.1 Z) Z -> Q (shift x st)) -> Q x) (x0 : Obj) {
  module K = KT.KB[LT.Lab (kO x0 Z)] ;
  L0 : DP.LO = LT.Lab (kO x0 Z) ;
  P0 (ys : LT.LL (kO x0 Z)) : W.Bool = PO x0 Z ys ;
  From (s : LT.LL (kO x0 Z)) : K.Tr = \ ys -> P0 (KT.appL L0.car s ys) ;
  Inv (o : Obj) (phi : DP.Map (kO o Z) (kO x0 Z)) (s : LT.LL (kO x0 Z)) : U l =
    (ys : LT.LL (kO o Z)) -> Id W.Bool (PO o Z ys) (P0 (KT.appL L0.car s (LT.mapL (kO o Z) (kO x0 Z) phi ys))) ;
  -- following a predecessor inside the tree at Z
  module Pr (o : Obj) (phi : DP.Map (kO o Z) (kO x0 Z)) (s : LT.LL (kO x0 Z)) (inv : Inv o phi s)
    (st : Step o) (ab : DP.Map (Sm st.1 Z) Z) {
    o' : Obj = shift o st ;
    D : DP.LO = st.1 ;
    lab : LbO o (Sm D Z) = st.2.2.1 Z ;
    psi : DP.Map (kO o (Sm D Z)) (kO o Z) = kmO o (Sm D Z) Z ab ;
    phi' : DP.Map (kO o' Z) (kO x0 Z) = LC.compMap (kO o (Sm D Z)) (kO o Z) (kO x0 Z) psi phi ;
    a : L0.car = LT.lm (kO o (Sm D Z)) (kO x0 Z) phi' lab ;
    s' : LT.LL (kO x0 Z) = KT.appL L0.car s (consL a nilL) ;
    inv' : Inv o' phi' s' = \ ys ->
      PL.trans W.Bool (PO o' Z ys) (PO o Z (LT.mapL (kO o (Sm D Z)) (kO o Z) psi (consL lab ys)))
          (P0 (KT.appL L0.car s' (LT.mapL (kO o' Z) (kO x0 Z) phi' ys)))
        (PL.sym W.Bool (PO o Z (LT.mapL (kO o (Sm D Z)) (kO o Z) psi (consL lab ys))) (PO o' Z ys) (natO o (Sm D Z) Z ab (consL lab ys)))
        (PL.trans W.Bool (PO o Z (LT.mapL (kO o (Sm D Z)) (kO o Z) psi (consL lab ys)))
            (P0 (KT.appL L0.car s (LT.mapL (kO o Z) (kO x0 Z) phi (LT.mapL (kO o (Sm D Z)) (kO o Z) psi (consL lab ys)))))
            (P0 (KT.appL L0.car s' (LT.mapL (kO o' Z) (kO x0 Z) phi' ys)))
          (inv (LT.mapL (kO o (Sm D Z)) (kO o Z) psi (consL lab ys)))
          (PL.ap (LT.LL (kO x0 Z)) W.Bool P0
            (KT.appL L0.car s (LT.mapL (kO o Z) (kO x0 Z) phi (LT.mapL (kO o (Sm D Z)) (kO o Z) psi (consL lab ys))))
            (KT.appL L0.car s' (LT.mapL (kO o' Z) (kO x0 Z) phi' ys))
            (PL.trans (LT.LL (kO x0 Z))
                (KT.appL L0.car s (LT.mapL (kO o Z) (kO x0 Z) phi (LT.mapL (kO o (Sm D Z)) (kO o Z) psi (consL lab ys))))
                (KT.appL L0.car s (consL a (LT.mapL (kO o' Z) (kO x0 Z) phi' ys)))
                (KT.appL L0.car s' (LT.mapL (kO o' Z) (kO x0 Z) phi' ys))
              (PL.ap (LT.LL (kO x0 Z)) (LT.LL (kO x0 Z)) (KT.appL L0.car s)
                (LT.mapL (kO o Z) (kO x0 Z) phi (LT.mapL (kO o (Sm D Z)) (kO o Z) psi (consL lab ys)))
                (LT.mapL (kO o (Sm D Z)) (kO x0 Z) phi' (consL lab ys))
                (LT.mapL-comp (kO o (Sm D Z)) (kO o Z) (kO x0 Z) psi phi (consL lab ys)))
              (PL.sym (LT.LL (kO x0 Z)) (KT.appL L0.car s' (LT.mapL (kO o' Z) (kO x0 Z) phi' ys))
                (KT.appL L0.car s (consL a (LT.mapL (kO o' Z) (kO x0 Z) phi' ys)))
                (KT.appL-assoc L0.car s (consL a nilL) (LT.mapL (kO o' Z) (kO x0 Z) phi' ys)))))) ;
    -- the node of the predecessor is in the tree
    rootIn : Id W.Bool (From s (consL a nilL)) true =
      PL.trans W.Bool (From s (consL a nilL)) (PO o' Z nilL) true
        (PL.trans W.Bool (From s (consL a nilL)) (P0 (KT.appL L0.car s' nilL)) (PO o' Z nilL)
          (PL.ap (LT.LL (kO x0 Z)) W.Bool P0 (KT.appL L0.car s (consL a nilL)) (KT.appL L0.car s' nilL)
            (PL.sym (LT.LL (kO x0 Z)) (KT.appL L0.car s' nilL) s' (KT.appL-nil L0.car s')))
          (PL.sym W.Bool (PO o' Z nilL) (P0 (KT.appL L0.car s' nilL)) (inv' nilL)))
        (st.2.2.2.2 Z) ;
    bndT (b : K.BT) (h : K.Bnd b (K.sub (From s) a)) : K.Bnd b (From s') =
      K.bnd-ext b (K.sub (From s) a) (From s')
        (\ ys -> PL.ap (LT.LL (kO x0 Z)) W.Bool P0 (KT.appL L0.car s (consL a ys)) (KT.appL L0.car s' ys)
          (PL.sym (LT.LL (kO x0 Z)) (KT.appL L0.car s' ys) (KT.appL L0.car s (consL a ys)) (KT.appL-assoc L0.car s (consL a nilL) ys))) h ;
  } ;
  ind : (b : K.BT) (o : Obj) (phi : DP.Map (kO o Z) (kO x0 Z)) (s : LT.LL (kO x0 Z)) -> Inv o phi s -> K.Bnd b (From s) -> Q o = split {
    leaf -> \ o phi s inv hb -> cl o (\ st ab -> efq1 (Q (shift o st)) (W.absurdB W.Empty
      (PL.trans W.Bool false (From s (consL Pr[o,phi,s,inv,st,ab].a nilL)) true
        (PL.sym W.Bool (From s (consL Pr[o,phi,s,inv,st,ab].a nilL)) false (hb (consL Pr[o,phi,s,inv,st,ab].a nilL)))
        Pr[o,phi,s,inv,st,ab].rootIn))) ;
    node f | r -> \ o phi s inv hb -> cl o (\ st ab ->
      r Pr[o,phi,s,inv,st,ab].a (shift o st) Pr[o,phi,s,inv,st,ab].phi' Pr[o,phi,s,inv,st,ab].s' Pr[o,phi,s,inv,st,ab].inv'
        (Pr[o,phi,s,inv,st,ab].bndT (f Pr[o,phi,s,inv,st,ab].a) (hb Pr[o,phi,s,inv,st,ab].a))) } ;
  -- the induction principle, constructively
  main (w : K.WFT P0) : Q x0 =
    ind w.1 x0 (LC.idMap (kO x0 Z)) nilL
      (\ ys -> PL.ap (LT.LL (kO x0 Z)) W.Bool P0 ys (LT.mapL (kO x0 Z) (kO x0 Z) (LC.idMap (kO x0 Z)) ys)
        (PL.sym (LT.LL (kO x0 Z)) (LT.mapL (kO x0 Z) (kO x0 Z) (LC.idMap (kO x0 Z)) ys) ys (LT.mapL-id (kO x0 Z) ys))) w.2 ;
  mainCorr (c : CorrO x0) (wZ : LW.WF Z) : Q x0 = main (c Z wZ) ;
} ;

-- The CUSL colimits transport to all unpresented Scott EP chains.
-- Thus an arbitrary colimit-preserving EP endofunctor has an initial
-- algebra without a separately supplied initial-chain colimit.
level l ;
open Base ; open Prelude[l+] ;
module CU = ScottCUSL[l] ;
module EP = ScottDomainCategories[l].EmbeddingProjection ;
module K = CategoryInitialChain[l++,l+] ;
module Transfer = CategoryEquivalenceColimits[l++,l+] ;

cocomplete : K.OmegaCocomplete[EP.pre] =
  Transfer.On[
    CU.CategoryUnivalence.category,EP.category,
    ScottCUSLEquivalence[l].equivalence,
    ScottCUSLColimit[l].cocomplete].transported ;

module On (F : K.Endofunctor[EP.pre])
  (omega : K.OmegaContinuous[EP.pre,F]) {
  module R = ScottEPInitialChain[l].WithAllColimits[
    F,omega,cocomplete] ;
  solution : EP.pre.ob = R.G.c.vertex ;
  fold : EP.pre.hom (F.object solution) solution = R.fold ;
  unfold : EP.pre.hom solution (F.object solution) = R.unfold ;
  isomorphism : EP.pre.Iso (F.object solution) solution =
    R.isomorphism ;
  equation : Id EP.pre.ob solution (F.object solution) =
    R.equation ;
  module Algebra (Y : EP.pre.ob)
    (a : EP.pre.hom (F.object Y) Y) {
    module A = R.Algebra[Y,a] ;
    Morphism : U l+ = A.Morphism ;
    canonical : Morphism = A.canonical ;
    initial : (w : Morphism) -> Id Morphism w canonical =
      A.initial ;
  } ;
} ;

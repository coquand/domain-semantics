-- Dilators are monotone, constructively (Girard's theorem without
-- classical logic).
--
-- For a pre-dilator X preserving well-orders, a point x of X([n]) and
-- embeddings k <= k' pointwise, X(k)x <= X(k')x.  The comparison is
-- decidable, so it suffices to refute X(k)x > X(k')x:
--  1. reduce to a finite level [c] (directedness);
--  2. go from k to k' one coordinate at a time (top down), and use
--     transitivity;
--  3. single step: w, w' agree except at one coordinate, a = w(r) < b =
--     w'(r).  In the well-order B = omega x omega x omega (lex) the
--     embeddings psi_i : [c] -> B,
--        v < a or v > b : (v, 0, v)
--        a <= v < b     : (a, i, v)
--        v = b          : (a, i+1, a)
--     satisfy psi_i . w' = psi_(i+1) . w, so X(psi_i . w) x is an
--     infinite descending sequence in X(B) if X(w)x > X(w')x.
level l ;
open Base ; open Prelude[l+] ; open ScottOrder[l] ;
module W = Dilator[l] ;
module DP = DilPtyx[l] ;
module CF = CatEmbFin[l] ;
module PL = Prelude[l] ;
module LC = LOCat[l] ;
module LW = LOWF[l] ;
module LT = LabTree[l] ;
module ST = StabTab[l] ;
module SF = StabFun[l] ;
module TC = TruncationCombinators[l] ;
module AFm = AlmostFull[l] ;

--------------------------------------------------------------------
-- arithmetic on N

CL (x y : W.N) : U l = Id W.O3 (W.cmpN x y) lt ;
contra (A : U l) (z : W.N) (h : CL z z) : A =
  W.absurdB A (PL.trans W.Bool false (W.isLt (W.cmpN z z)) true
    (PL.sym W.Bool (W.isLt (W.cmpN z z)) false (PL.ap W.O3 W.Bool W.isLt (W.cmpN z z) eq (W.cmpN-refl z)))
    (PL.ap W.O3 W.Bool W.isLt (W.cmpN z z) lt h)) ;
trN (x y z : W.N) (h : CL x y) (k : CL y z) : CL x z = W.cmpN-trans x y z h k ;
gtL (x y : W.N) (h : Id W.O3 (W.cmpN x y) gt) : CL y x =
  PL.trans W.O3 (W.cmpN y x) (W.flip (W.cmpN x y)) lt (W.cmpN-flip x y) (PL.ap W.O3 W.O3 W.flip (W.cmpN x y) gt h) ;
LeN (x y : W.N) : U l = W.Or (CL x y) (Id W.N x y) ;
leLt (x y z : W.N) : LeN x y -> CL y z -> CL x z = split {
  inl h -> \ k -> trN x y z h k ;
  inr e -> \ k -> PL.subst W.N (\ u -> CL u z) y x (PL.sym W.N x y e) k } ;
ltSuc (i : W.N) : CL i (suc i) = W.isLt-sound (W.cmpN i (suc i))
  (PL.trans W.Bool (W.isLt (W.cmpN i (suc i))) (W.ltN i (suc i)) true (W.ltN-cmp i (suc i)) (W.ltN-suc i)) ;

--------------------------------------------------------------------
-- the embeddings psi_i

T3 : U l = (W.N * W.N) * W.N ;
L1 : DP.LO = LT.Lex[LW.omega,LW.omega].lo ;
B : DP.LO = LT.Lex[L1,LW.omega].lo ;
wfB : LW.WF B =
  W.LexOrd[L1.car,L1.cmp,L1.ceq,W.N,W.cmpN].wfP (W.LexOrd[W.N,W.cmpN,W.cmpN-eq,W.N,W.cmpN].wfP W.wfN W.wfN) W.wfN ;
cmp3 (h h' l l' t t' : W.N) : W.O3 = W.lexO3 (W.lexO3 (W.cmpN h h') (W.cmpN l l')) (W.cmpN t t') ;
first-lt (h h' l l' t t' : W.N) (e : CL h h') : Id W.O3 (cmp3 h h' l l' t t') lt =
  PL.ap W.O3 W.O3 (\ o -> W.lexO3 (W.lexO3 o (W.cmpN l l')) (W.cmpN t t')) (W.cmpN h h') lt e ;
second-lt (h l l' t t' : W.N) (e : CL l l') : Id W.O3 (cmp3 h h l l' t t') lt =
  W.ap2 W.O3 W.O3 W.O3 (\ o o' -> W.lexO3 (W.lexO3 o o') (W.cmpN t t')) (W.cmpN h h) eq (W.cmpN l l') lt (W.cmpN-refl h) e ;
third-lt (h l t t' : W.N) (e : CL t t') : Id W.O3 (cmp3 h h l l t t') lt =
  PL.trans W.O3 (cmp3 h h l l t t') (W.lexO3 (W.lexO3 eq eq) (W.cmpN t t')) lt
    (W.ap2 W.O3 W.O3 W.O3 (\ o o' -> W.lexO3 (W.lexO3 o o') (W.cmpN t t')) (W.cmpN h h) eq (W.cmpN l l) eq (W.cmpN-refl h) (W.cmpN-refl l))
    (PL.ap W.O3 W.O3 (\ o -> W.lexO3 (W.lexO3 eq eq) o) (W.cmpN t t') lt e) ;

data Reg : U l = rLo | rMid | rTop | rHi ;
module Psi (a b : W.N) (hab : CL a b) {
  regB : W.O3 -> Reg = split { lt -> rMid ; eq -> rTop ; gt -> rHi } ;
  regOf : W.O3 -> W.O3 -> Reg = split { lt -> \ o2 -> rLo ; eq -> regB ; gt -> regB } ;
  reg (v : W.N) : Reg = regOf (W.cmpN v a) (W.cmpN v b) ;
  Fact (v : W.N) : Reg -> U l = split {
    rLo -> CL v a ; rMid -> LeN a v * CL v b ; rTop -> Id W.N v b ; rHi -> CL b v } ;
  factB (v : W.N) (la : LeN a v) : (o2 : W.O3) -> Id W.O3 (W.cmpN v b) o2 -> Fact v (regB o2) = split {
    lt -> \ e -> (la,e) ; eq -> \ e -> W.cmpN-eq v b e ; gt -> \ e -> gtL v b e } ;
  factO (v : W.N) : (o1 : W.O3) -> Id W.O3 (W.cmpN v a) o1 -> (o2 : W.O3) -> Id W.O3 (W.cmpN v b) o2 -> Fact v (regOf o1 o2) = split {
    lt -> \ e1 o2 e2 -> e1 ;
    eq -> \ e1 -> factB v (inr (PL.sym W.N v a (W.cmpN-eq v a e1))) ;
    gt -> \ e1 -> factB v (inl (gtL v a e1)) } ;
  fact (v : W.N) : Fact v (reg v) = factO v (W.cmpN v a) (refl (W.cmpN v a)) (W.cmpN v b) (refl (W.cmpN v b)) ;
  psiR (i v : W.N) : Reg -> T3 = split {
    rLo -> ((v,zero),v) ; rMid -> ((a,i),v) ; rTop -> ((a,suc i),a) ; rHi -> ((v,zero),v) } ;
  psi (i v : W.N) : T3 = psiR i v (reg v) ;
  -- psi_i is strictly increasing
  incR (i y y' : W.N) (hy : CL y y') : (r r' : Reg) -> Fact y r -> Fact y' r' -> Id W.O3 (B.cmp (psiR i y r) (psiR i y' r')) lt = split {
    rLo -> split {
      rLo -> \ f f' -> first-lt y y' zero zero y y' hy ;
      rMid -> \ f f' -> first-lt y a zero i y y' f ;
      rTop -> \ f f' -> first-lt y a zero (suc i) y a f ;
      rHi -> \ f f' -> first-lt y y' zero zero y y' hy } ;
    rMid -> split {
      rLo -> \ f f' -> contra (Id W.O3 (B.cmp ((a,i),y) ((y',zero),y')) lt) a (leLt a y a f.1 (trN y y' a hy f')) ;
      rMid -> \ f f' -> third-lt a i y y' hy ;
      rTop -> \ f f' -> second-lt a i (suc i) y a (ltSuc i) ;
      rHi -> \ f f' -> first-lt a y' i zero y y' (leLt a y y' f.1 hy) } ;
    rTop -> split {
      rLo -> \ f f' -> contra (Id W.O3 (B.cmp ((a,suc i),a) ((y',zero),y')) lt) a
        (trN a y a (PL.subst W.N (\ u -> CL a u) b y (PL.sym W.N y b f) hab) (trN y y' a hy f')) ;
      rMid -> \ f f' -> contra (Id W.O3 (B.cmp ((a,suc i),a) ((a,i),y')) lt) y
        (trN y y' y hy (PL.subst W.N (\ u -> CL y' u) b y (PL.sym W.N y b f) f'.2)) ;
      rTop -> \ f f' -> contra (Id W.O3 (B.cmp ((a,suc i),a) ((a,suc i),a)) lt) y
        (PL.subst W.N (\ u -> CL y u) y' y (PL.trans W.N y' b y f' (PL.sym W.N y b f)) hy) ;
      rHi -> \ f f' -> first-lt a y' (suc i) zero a y' (trN a b y' hab f') } ;
    rHi -> split {
      rLo -> \ f f' -> contra (Id W.O3 (B.cmp ((y,zero),y) ((y',zero),y')) lt) y'
        (trN y' a y' f' (trN a b y' hab (trN b y y' f hy))) ;
      rMid -> \ f f' -> contra (Id W.O3 (B.cmp ((y,zero),y) ((a,i),y')) lt) y'
        (trN y' b y' f'.2 (trN b y y' f hy)) ;
      rTop -> \ f f' -> contra (Id W.O3 (B.cmp ((y,zero),y) ((a,suc i),a)) lt) y
        (trN y y' y hy (PL.subst W.N (\ u -> CL u y) b y' (PL.sym W.N y' b f') f)) ;
      rHi -> \ f f' -> first-lt y y' zero zero y y' hy } } ;
  inc (i y y' : W.N) (hy : CL y y') : Id W.O3 (B.cmp (psi i y) (psi i y')) lt =
    incR i y y' hy (reg y) (reg y') (fact y) (fact y') ;
} ;

--------------------------------------------------------------------
-- strictly increasing maps are embeddings; descending sequences

incO (P Q : DP.LO) (f : P.car -> Q.car) (inc : (y y' : P.car) -> Id W.O3 (P.cmp y y') lt -> Id W.O3 (Q.cmp (f y) (f y')) lt)
  (y y' : P.car) : (o : W.O3) -> Id W.O3 (P.cmp y y') o -> Id W.O3 (Q.cmp (f y) (f y')) (P.cmp y y') = split {
  lt -> \ e -> PL.trans W.O3 (Q.cmp (f y) (f y')) lt (P.cmp y y') (inc y y' e) (PL.sym W.O3 (P.cmp y y') lt e) ;
  eq -> \ e -> PL.subst P.car (\ z -> Id W.O3 (Q.cmp (f y) (f z)) (P.cmp y z)) y y' (P.ceq y y' e)
    (PL.trans W.O3 (Q.cmp (f y) (f y)) eq (P.cmp y y) (Q.crefl (f y)) (PL.sym W.O3 (P.cmp y y) eq (P.crefl y))) ;
  gt -> \ e -> PL.trans W.O3 (Q.cmp (f y) (f y')) (W.flip (Q.cmp (f y') (f y))) (P.cmp y y')
    (Q.cflip (f y') (f y))
    (PL.trans W.O3 (W.flip (Q.cmp (f y') (f y))) gt (P.cmp y y')
      (PL.ap W.O3 W.O3 W.flip (Q.cmp (f y') (f y)) lt
        (inc y' y (PL.trans W.O3 (P.cmp y' y) (W.flip (P.cmp y y')) lt (P.cflip y y') (PL.ap W.O3 W.O3 W.flip (P.cmp y y') gt e))))
      (PL.sym W.O3 (P.cmp y y') gt e)) } ;
incMap (P Q : DP.LO) (f : P.car -> Q.car) (inc : (y y' : P.car) -> Id W.O3 (P.cmp y y') lt -> Id W.O3 (Q.cmp (f y) (f y')) lt) :
    DP.Map P Q = (f,\ y y' -> incO P Q f inc y y' (P.cmp y y') (refl (P.cmp y y'))) ;
noDesc (L : DP.LO) (w : LW.WF L) (s : W.N -> L.car) (d : (i : W.N) -> Id W.O3 (L.cmp (s (suc i)) (s i)) lt) : W.Empty =
  W.Acc[L.car,W.ltO L.car L.cmp].ind (\ x -> (i : W.N) -> Id L.car (s i) x -> W.Empty)
    (\ x ih i e -> ih (s (suc i))
      (PL.subst L.car (\ z -> Id W.Bool (W.isLt (L.cmp (s (suc i)) z)) true) (s i) x e (PL.ap W.O3 W.Bool W.isLt (L.cmp (s (suc i)) (s i)) lt (d i)))
      (suc i) (refl (s (suc i))))
    (s zero) (w (s zero)) zero (refl (s zero)) ;

--------------------------------------------------------------------
-- values of psi

module PsiV (a b : W.N) (hab : CL a b) {
  module P = Psi[a,b,hab] ;
  lo (i v : W.N) (h : CL v a) : Id T3 (P.psi i v) ((v,zero),v) =
    PL.ap W.O3 T3 (\ o -> P.psiR i v (P.regOf o (W.cmpN v b))) (W.cmpN v a) lt h ;
  hi (i v : W.N) (h : CL b v) : Id T3 (P.psi i v) ((v,zero),v) =
    W.ap2 W.O3 W.O3 T3 (\ o o' -> P.psiR i v (P.regOf o o')) (W.cmpN v a) gt (W.cmpN v b) gt
      (PL.trans W.O3 (W.cmpN v a) (W.flip (W.cmpN a v)) gt (W.cmpN-flip a v) (PL.ap W.O3 W.O3 W.flip (W.cmpN a v) lt (trN a b v hab h)))
      (PL.trans W.O3 (W.cmpN v b) (W.flip (W.cmpN b v)) gt (W.cmpN-flip b v) (PL.ap W.O3 W.O3 W.flip (W.cmpN b v) lt h)) ;
  atA (i : W.N) : Id T3 (P.psi i a) ((a,i),a) =
    W.ap2 W.O3 W.O3 T3 (\ o o' -> P.psiR i a (P.regOf o o')) (W.cmpN a a) eq (W.cmpN a b) lt (W.cmpN-refl a) hab ;
  atB (i : W.N) : Id T3 (P.psi i b) ((a,suc i),a) =
    W.ap2 W.O3 W.O3 T3 (\ o o' -> P.psiR i b (P.regOf o o')) (W.cmpN b a) gt (W.cmpN b b) eq
      (PL.trans W.O3 (W.cmpN b a) (W.flip (W.cmpN a b)) gt (W.cmpN-flip a b) (PL.ap W.O3 W.O3 W.flip (W.cmpN a b) lt hab)) (W.cmpN-refl b) ;
  shift (i : W.N) : Id T3 (P.psi i b) (P.psi (suc i) a) =
    PL.trans T3 (P.psi i b) ((a,suc i),a) (P.psi (suc i) a) (atB i) (PL.sym T3 (P.psi (suc i) a) ((a,suc i),a) (atA (suc i))) ;
  psiMap (c i : W.N) : DP.Map (LC.ord c) B = incMap (LC.ord c) B (\ v -> P.psi i v.1) (\ y y' h -> P.inc i y.1 y'.1 h) ;
} ;

--------------------------------------------------------------------
-- the chain of single steps at a finite level

ltT (x y : W.N) (h : CL x y) : Id W.Bool (W.ltN x y) true =
  PL.trans W.Bool (W.ltN x y) (W.isLt (W.cmpN x y)) true (PL.sym W.Bool (W.isLt (W.cmpN x y)) (W.ltN x y) (W.ltN-cmp x y))
    (PL.ap W.O3 W.Bool W.isLt (W.cmpN x y) lt h) ;
ltC (x y : W.N) (h : Id W.Bool (W.ltN x y) true) : CL x y =
  W.isLt-sound (W.cmpN x y) (PL.trans W.Bool (W.isLt (W.cmpN x y)) (W.ltN x y) true (W.ltN-cmp x y) h) ;
ltF (x y : W.N) (o : W.O3) (e : Id W.O3 (W.cmpN x y) o) (ho : Id W.Bool (W.isLt o) false) : Id W.Bool (W.ltN x y) false =
  PL.trans W.Bool (W.ltN x y) (W.isLt o) false
    (PL.trans W.Bool (W.ltN x y) (W.isLt (W.cmpN x y)) (W.isLt o) (PL.sym W.Bool (W.isLt (W.cmpN x y)) (W.ltN x y) (W.ltN-cmp x y))
      (PL.ap W.O3 W.Bool W.isLt (W.cmpN x y) o e)) ho ;
ltLe (x y z : W.N) (h : CL x y) : LeN y z -> CL x z = split {
  inl k -> trN x y z h k ;
  inr e -> PL.subst W.N (\ u -> CL x u) y z e h } ;
leOLe (x y : W.N) : (o : W.O3) -> Id W.O3 (W.cmpN x y) o -> Id W.Bool (AFm.leO o) true -> LeN x y = split {
  lt -> \ e h -> inl e ; eq -> \ e h -> inr (W.cmpN-eq x y e) ; gt -> \ e h -> W.absurdB (LeN x y) h } ;
-- y < n and not (r < n)  =>  y < r
ltNR (y n r : W.N) (hy : CL y n) (hr : Id W.Bool (W.ltN r n) false) : (o : W.O3) -> Id W.O3 (W.cmpN r n) o -> CL y r = split {
  lt -> \ e -> W.absurdB (CL y r) (PL.trans W.Bool false (W.ltN r n) true (PL.sym W.Bool (W.ltN r n) false hr) (ltT r n e)) ;
  eq -> \ e -> PL.subst W.N (\ u -> CL y u) n r (PL.sym W.N r n (W.cmpN-eq r n e)) hy ;
  gt -> \ e -> trN y n r hy (gtL r n e) } ;

sucF (y r : W.N) (h : CL r y) : Id W.Bool (W.ltN y (suc r)) false =
  StabJt[l].bool-nt (W.ltN y (suc r)) (\ k -> CF.or-elim (CF.Lt y r) (Id W.N y r) W.Empty
    (\ a -> contra W.Empty y (trN y r y (ltC y r a) h))
    (\ e -> contra W.Empty r (PL.subst W.N (\ u -> CL r u) y r e h))
    (CF.lt-split y r k)) ;
module Mono (X : SF.SF[LC.ce]) (dx : LW.IsDil X) (n c : W.N) (x : (X.G (LC.ord n)).car)
  (kk kk' : DP.Map (LC.ord n) (LC.ord c)) (pw : (y : (LC.ord n).car) -> LeN (kk.1 y).1 (kk'.1 y).1) {
  Pn : U l = (LC.ord n).car ;
  Pc : U l = (LC.ord c).car ;
  XC : DP.LO = X.G (LC.ord c) ;
  module OX = UnionWF[l].OF[XC] ;
  ev (h : DP.Map (LC.ord n) (LC.ord c)) : XC.car = (X.arr (LC.ord n) (LC.ord c) h).1 x ;
  ev-eq (h h' : DP.Map (LC.ord n) (LC.ord c)) (e : (y : Pn) -> Id Pc (h.1 y) (h'.1 y)) : Id XC.car (ev h) (ev h') =
    PL.ap (DP.Map (LC.ord n) (LC.ord c)) XC.car ev h h' (LC.map-eq (LC.ord n) (LC.ord c) h h' e) ;
  ptEq (p q : Pc) (e : Id W.N p.1 q.1) : Id Pc p q =
    (LC.ord c).ceq p q (PL.subst W.N (\ u -> Id W.O3 (W.cmpN p.1 u) eq) p.1 q.1 e (W.cmpN-refl p.1)) ;
  ptEqN (p q : Pn) (e : Id W.N p.1 q.1) : Id Pn p q =
    (LC.ord n).ceq p q (PL.subst W.N (\ u -> Id W.O3 (W.cmpN p.1 u) eq) p.1 q.1 e (W.cmpN-refl p.1)) ;
  rw (u u' v v' : Pc) (e : Id Pc u' u) (e' : Id Pc v' v) (h : CL u.1 v.1) : CL u'.1 v'.1 =
    PL.trans W.O3 (W.cmpN u'.1 v'.1) (W.cmpN u.1 v.1) lt (W.ap2 Pc Pc W.O3 (\ p q -> W.cmpN p.1 q.1) u' u v' v e e') h ;
  -- the maps between kk and kk'
  mix (r : W.N) (y : Pn) : Pc = W.ifW Pc (W.ltN y.1 r) (kk.1 y) (kk'.1 y) ;
  mixT (r : W.N) (y : Pn) (h : Id W.Bool (W.ltN y.1 r) true) : Id Pc (mix r y) (kk.1 y) =
    PL.ap W.Bool Pc (\ b0 -> W.ifW Pc b0 (kk.1 y) (kk'.1 y)) (W.ltN y.1 r) true h ;
  mixF (r : W.N) (y : Pn) (h : Id W.Bool (W.ltN y.1 r) false) : Id Pc (mix r y) (kk'.1 y) =
    PL.ap W.Bool Pc (\ b0 -> W.ifW Pc b0 (kk.1 y) (kk'.1 y)) (W.ltN y.1 r) false h ;
  kkL (y y' : Pn) (h : CL y.1 y'.1) : CL (kk.1 y).1 (kk.1 y').1 =
    PL.trans W.O3 (W.cmpN (kk.1 y).1 (kk.1 y').1) (W.cmpN y.1 y'.1) lt (kk.2 y y') h ;
  kkL' (y y' : Pn) (h : CL y.1 y'.1) : CL (kk'.1 y).1 (kk'.1 y').1 =
    PL.trans W.O3 (W.cmpN (kk'.1 y).1 (kk'.1 y').1) (W.cmpN y.1 y'.1) lt (kk'.2 y y') h ;
  incMixO (r : W.N) (y y' : Pn) (h : CL y.1 y'.1) : (bb bb' : W.Bool) -> Id W.Bool (W.ltN y.1 r) bb -> Id W.Bool (W.ltN y'.1 r) bb' ->
      CL (mix r y).1 (mix r y').1 = split {
    true -> split {
      true -> \ e e' -> rw (kk.1 y) (mix r y) (kk.1 y') (mix r y') (mixT r y e) (mixT r y' e') (kkL y y' h) ;
      false -> \ e e' -> rw (kk.1 y) (mix r y) (kk'.1 y') (mix r y') (mixT r y e) (mixF r y' e')
        (ltLe (kk.1 y).1 (kk.1 y').1 (kk'.1 y').1 (kkL y y' h) (pw y')) } ;
    false -> split {
      true -> \ e e' -> W.absurdB (CL (mix r y).1 (mix r y').1)
        (PL.trans W.Bool false (W.ltN y.1 r) true (PL.sym W.Bool (W.ltN y.1 r) false e) (ltT y.1 r (trN y.1 y'.1 r h (ltC y'.1 r e')))) ;
      false -> \ e e' -> rw (kk'.1 y) (mix r y) (kk'.1 y') (mix r y') (mixF r y e) (mixF r y' e') (kkL' y y' h) } } ;
  mixMap (r : W.N) : DP.Map (LC.ord n) (LC.ord c) =
    incMap (LC.ord n) (LC.ord c) (mix r) (\ y y' h -> incMixO r y y' h (W.ltN y.1 r) (W.ltN y'.1 r) (refl (W.ltN y.1 r)) (refl (W.ltN y'.1 r))) ;
  -- one step: mix (r+1) <= mix r
  Le (u v : XC.car) : U l = OX.Le u v ;
  leFrom (u v : XC.car) : (o : W.O3) -> Id W.O3 (XC.cmp u v) o -> (Id W.O3 o gt -> W.Empty) -> Le u v = split {
    lt -> \ e k -> PL.ap W.O3 W.Bool AFm.leO (XC.cmp u v) lt e ;
    eq -> \ e k -> PL.ap W.O3 W.Bool AFm.leO (XC.cmp u v) eq e ;
    gt -> \ e k -> CF.efq (Le u v) (k (refl gt)) } ;
  leEq (u v : XC.car) (e : Id XC.car u v) : Le u v = PL.subst XC.car (\ z -> Le u z) u v e (OX.leRefl u) ;
  module Big (r : W.N) (hr : CL r n) (hab : CL (kk.1 (r,ltT r n hr)).1 (kk'.1 (r,ltT r n hr)).1) {
    ry : Pn = (r,ltT r n hr) ;
    a : W.N = (kk.1 ry).1 ;
    b : W.N = (kk'.1 ry).1 ;
    module V = PsiV[a,b,hab] ;
    w : DP.Map (LC.ord n) (LC.ord c) = mixMap (suc r) ;
    w' : DP.Map (LC.ord n) (LC.ord c) = mixMap r ;
    eqO (i : W.N) (y : Pn) : (o : W.O3) -> Id W.O3 (W.cmpN y.1 r) o -> Id T3 (V.P.psi i (w'.1 y).1) (V.P.psi (suc i) (w.1 y).1) = split {
      lt -> \ e -> PL.trans T3 (V.P.psi i (w'.1 y).1) (((w'.1 y).1,zero),(w'.1 y).1) (V.P.psi (suc i) (w.1 y).1)
          (V.lo i (w'.1 y).1 (rw (kk.1 y) (w'.1 y) (kk.1 ry) (kk.1 ry) (mixT r y (ltT y.1 r e)) (refl (kk.1 ry)) (kkL y ry e)))
          (PL.trans T3 (((w'.1 y).1,zero),(w'.1 y).1) (((w.1 y).1,zero),(w.1 y).1) (V.P.psi (suc i) (w.1 y).1)
            (PL.ap Pc T3 (\ p -> ((p.1,zero),p.1)) (w'.1 y) (w.1 y)
              (PL.trans Pc (w'.1 y) (kk.1 y) (w.1 y) (mixT r y (ltT y.1 r e))
                (PL.sym Pc (w.1 y) (kk.1 y) (mixT (suc r) y (W.ltN-sucR y.1 r (ltT y.1 r e))))))
            (PL.sym T3 (V.P.psi (suc i) (w.1 y).1) (((w.1 y).1,zero),(w.1 y).1)
              (V.lo (suc i) (w.1 y).1 (rw (kk.1 y) (w.1 y) (kk.1 ry) (kk.1 ry) (mixT (suc r) y (W.ltN-sucR y.1 r (ltT y.1 r e)))
                (refl (kk.1 ry)) (kkL y ry e))))) ;
      eq -> \ e -> PL.trans T3 (V.P.psi i (w'.1 y).1) (V.P.psi i b) (V.P.psi (suc i) (w.1 y).1)
          (PL.ap Pc T3 (\ p -> V.P.psi i p.1) (w'.1 y) (kk'.1 ry)
            (PL.trans Pc (w'.1 y) (kk'.1 y) (kk'.1 ry)
              (mixF r y (ltF y.1 r eq e (refl false)))
              (PL.ap Pn Pc kk'.1 y ry (ptEqN y ry (W.cmpN-eq y.1 r e)))))
          (PL.trans T3 (V.P.psi i b) (V.P.psi (suc i) a) (V.P.psi (suc i) (w.1 y).1) (V.shift i)
            (PL.ap Pc T3 (\ p -> V.P.psi (suc i) p.1) (kk.1 ry) (w.1 y)
              (PL.sym Pc (w.1 y) (kk.1 ry)
                (PL.trans Pc (w.1 y) (kk.1 y) (kk.1 ry)
                  (mixT (suc r) y (PL.subst W.N (\ u -> Id W.Bool (W.ltN u (suc r)) true) r y.1
                    (PL.sym W.N y.1 r (W.cmpN-eq y.1 r e)) (W.ltN-suc r)))
                  (PL.ap Pn Pc kk.1 y ry (ptEqN y ry (W.cmpN-eq y.1 r e))))))) ;
      gt -> \ e -> PL.trans T3 (V.P.psi i (w'.1 y).1) (((w'.1 y).1,zero),(w'.1 y).1) (V.P.psi (suc i) (w.1 y).1)
          (V.hi i (w'.1 y).1 (rw (kk'.1 ry) (kk'.1 ry) (kk'.1 y) (w'.1 y) (refl (kk'.1 ry)) (mixF r y (ltF y.1 r gt e (refl false)))
            (kkL' ry y (gtL y.1 r e))))
          (PL.trans T3 (((w'.1 y).1,zero),(w'.1 y).1) (((w.1 y).1,zero),(w.1 y).1) (V.P.psi (suc i) (w.1 y).1)
            (PL.ap Pc T3 (\ p -> ((p.1,zero),p.1)) (w'.1 y) (w.1 y)
              (PL.trans Pc (w'.1 y) (kk'.1 y) (w.1 y) (mixF r y (ltF y.1 r gt e (refl false)))
                (PL.sym Pc (w.1 y) (kk'.1 y) (mixF (suc r) y (sucF y.1 r (gtL y.1 r e))))))
            (PL.sym T3 (V.P.psi (suc i) (w.1 y).1) (((w.1 y).1,zero),(w.1 y).1)
              (V.hi (suc i) (w.1 y).1 (rw (kk'.1 ry) (kk'.1 ry) (kk'.1 y) (w.1 y) (refl (kk'.1 ry)) (mixF (suc r) y (sucF y.1 r (gtL y.1 r e)))
                (kkL' ry y (gtL y.1 r e)))))) } ;
    eqStep (i : W.N) (y : Pn) : Id T3 (V.P.psi i (w'.1 y).1) (V.P.psi (suc i) (w.1 y).1) = eqO i y (W.cmpN y.1 r) (refl (W.cmpN y.1 r)) ;
    -- the descending sequence
    XB : DP.LO = X.G B ;
    seq (i : W.N) : XB.car = (X.arr (LC.ord c) B (V.psiMap c i)).1 (ev w) ;
    claim (i : W.N) : Id XB.car ((X.arr (LC.ord c) B (V.psiMap c i)).1 (ev w')) (seq (suc i)) =
      PL.trans XB.car ((X.arr (LC.ord c) B (V.psiMap c i)).1 (ev w')) ((X.arr (LC.ord n) B (LC.compMap (LC.ord n) (LC.ord c) B w' (V.psiMap c i))).1 x)
          (seq (suc i))
        (X.arr-comp (LC.ord n) (LC.ord c) B w' (V.psiMap c i) x)
        (PL.trans XB.car ((X.arr (LC.ord n) B (LC.compMap (LC.ord n) (LC.ord c) B w' (V.psiMap c i))).1 x)
            ((X.arr (LC.ord n) B (LC.compMap (LC.ord n) (LC.ord c) B w (V.psiMap c (suc i)))).1 x) (seq (suc i))
          (PL.ap (DP.Map (LC.ord n) B) XB.car (\ h -> (X.arr (LC.ord n) B h).1 x)
            (LC.compMap (LC.ord n) (LC.ord c) B w' (V.psiMap c i)) (LC.compMap (LC.ord n) (LC.ord c) B w (V.psiMap c (suc i)))
            (LC.map-eq (LC.ord n) B (LC.compMap (LC.ord n) (LC.ord c) B w' (V.psiMap c i)) (LC.compMap (LC.ord n) (LC.ord c) B w (V.psiMap c (suc i)))
              (eqStep i)))
          (PL.sym XB.car (seq (suc i)) ((X.arr (LC.ord n) B (LC.compMap (LC.ord n) (LC.ord c) B w (V.psiMap c (suc i)))).1 x)
            (X.arr-comp (LC.ord n) (LC.ord c) B w (V.psiMap c (suc i)) x))) ;
    noGt (g : Id W.O3 (XC.cmp (ev w) (ev w')) gt) : W.Empty =
      noDesc XB (dx B wfB) seq (\ i ->
        PL.trans W.O3 (XB.cmp (seq (suc i)) (seq i)) (XB.cmp ((X.arr (LC.ord c) B (V.psiMap c i)).1 (ev w')) (seq i)) lt
          (PL.ap XB.car W.O3 (\ z -> XB.cmp z (seq i)) (seq (suc i)) ((X.arr (LC.ord c) B (V.psiMap c i)).1 (ev w'))
            (PL.sym XB.car ((X.arr (LC.ord c) B (V.psiMap c i)).1 (ev w')) (seq (suc i)) (claim i)))
          (PL.trans W.O3 (XB.cmp ((X.arr (LC.ord c) B (V.psiMap c i)).1 (ev w')) (seq i)) (XC.cmp (ev w') (ev w)) lt
            ((X.arr (LC.ord c) B (V.psiMap c i)).2 (ev w') (ev w))
            (PL.trans W.O3 (XC.cmp (ev w') (ev w)) (W.flip (XC.cmp (ev w) (ev w'))) lt (XC.cflip (ev w) (ev w'))
              (PL.ap W.O3 W.O3 W.flip (XC.cmp (ev w) (ev w')) gt g)))) ;
    result : Le (ev w) (ev w') =
      leFrom (ev w) (ev w') (XC.cmp (ev w) (ev w')) (refl (XC.cmp (ev w) (ev w')))
        (\ k -> noGt k) ;
  } ;
  -- every step, and the chain
  eqStepO (r : W.N) (hr : CL r n) (eab : Id W.N (kk.1 (r,ltT r n hr)).1 (kk'.1 (r,ltT r n hr)).1) (y : Pn) :
      (o : W.O3) -> Id W.O3 (W.cmpN y.1 r) o -> Id Pc (mix (suc r) y) (mix r y) = split {
    lt -> \ e -> PL.trans Pc (mix (suc r) y) (kk.1 y) (mix r y) (mixT (suc r) y (W.ltN-sucR y.1 r (ltT y.1 r e)))
      (PL.sym Pc (mix r y) (kk.1 y) (mixT r y (ltT y.1 r e))) ;
    eq -> \ e -> PL.trans Pc (mix (suc r) y) (kk.1 y) (mix r y)
      (mixT (suc r) y (PL.subst W.N (\ u -> Id W.Bool (W.ltN u (suc r)) true) r y.1 (PL.sym W.N y.1 r (W.cmpN-eq y.1 r e)) (W.ltN-suc r)))
      (PL.trans Pc (kk.1 y) (kk'.1 y) (mix r y)
        (ptEq (kk.1 y) (kk'.1 y)
          (PL.trans W.N (kk.1 y).1 (kk.1 (r,ltT r n hr)).1 (kk'.1 y).1
            (PL.ap Pn W.N (\ p -> (kk.1 p).1) y (r,ltT r n hr) (ptEqN y (r,ltT r n hr) (W.cmpN-eq y.1 r e)))
            (PL.trans W.N (kk.1 (r,ltT r n hr)).1 (kk'.1 (r,ltT r n hr)).1 (kk'.1 y).1 eab
              (PL.ap Pn W.N (\ p -> (kk'.1 p).1) (r,ltT r n hr) y (PL.sym Pn y (r,ltT r n hr) (ptEqN y (r,ltT r n hr) (W.cmpN-eq y.1 r e)))))))
        (PL.sym Pc (mix r y) (kk'.1 y) (mixF r y (ltF y.1 r eq e (refl false))))) ;
    gt -> \ e -> PL.trans Pc (mix (suc r) y) (kk'.1 y) (mix r y) (mixF (suc r) y (sucF y.1 r (gtL y.1 r e)))
      (PL.sym Pc (mix r y) (kk'.1 y) (mixF r y (ltF y.1 r gt e (refl false)))) } ;
  stepP (r : W.N) (hr : CL r n) : LeN (kk.1 (r,ltT r n hr)).1 (kk'.1 (r,ltT r n hr)).1 -> Le (ev (mixMap (suc r))) (ev (mixMap r)) = split {
    inl hab -> Big[r,hr,hab].result ;
    inr eab -> leEq (ev (mixMap (suc r))) (ev (mixMap r))
      (ev-eq (mixMap (suc r)) (mixMap r) (\ y -> eqStepO r hr eab y (W.cmpN y.1 r) (refl (W.cmpN y.1 r)))) } ;
  stepO (r : W.N) : (bb : W.Bool) -> Id W.Bool (W.ltN r n) bb -> Le (ev (mixMap (suc r))) (ev (mixMap r)) = split {
    true -> \ e -> stepP r (ltC r n e) (pw (r,ltT r n (ltC r n e))) ;
    false -> \ e -> leEq (ev (mixMap (suc r))) (ev (mixMap r))
      (ev-eq (mixMap (suc r)) (mixMap r) (\ y ->
        PL.trans Pc (mix (suc r) y) (kk.1 y) (mix r y)
          (mixT (suc r) y (W.ltN-sucR y.1 r (ltT y.1 r (ltNR y.1 n r (ltC y.1 n y.2) e (W.cmpN r n) (refl (W.cmpN r n))))))
          (PL.sym Pc (mix r y) (kk.1 y) (mixT r y (ltT y.1 r (ltNR y.1 n r (ltC y.1 n y.2) e (W.cmpN r n) (refl (W.cmpN r n)))))))) } ;
  step (r : W.N) : Le (ev (mixMap (suc r))) (ev (mixMap r)) = stepO r (W.ltN r n) (refl (W.ltN r n)) ;
  chain : (r : W.N) -> Le (ev (mixMap r)) (ev kk') = split {
    zero -> leEq (ev (mixMap zero)) (ev kk') (ev-eq (mixMap zero) kk' (\ y -> mixF zero y (W.ltN-zero y.1))) ;
    suc r | ih -> OX.le-tr (ev (mixMap (suc r))) (ev (mixMap r)) (ev kk') (step r) ih } ;
  result : Le (ev kk) (ev kk') =
    PL.subst XC.car (\ z -> Le z (ev kk')) (ev (mixMap n)) (ev kk) (ev-eq (mixMap n) kk (\ y -> mixT n y y.2)) (chain n) ;
} ;

--------------------------------------------------------------------
-- the theorem: dilators are monotone

leT (o o' : W.O3) (e : Id W.O3 o o') (h : Id W.Bool (AFm.leO o') true) : Id W.Bool (AFm.leO o) true =
  PL.subst W.O3 (\ z -> Id W.Bool (AFm.leO z) true) o' o (PL.sym W.O3 o o' e) h ;
module MD (X : SF.SF[LC.ce]) (dx : LW.IsDil X) (A : DP.LO) (n : W.N) (x : (X.G (LC.ord n)).car)
  (k k' : DP.Map (LC.ord n) A) (pw : DilCat[l].PwLe n A k k')
  (wd : (d : W.N) * ((j : DP.Map (LC.ord d) A) * ((kk : DP.Map (LC.ord n) (LC.ord d)) * ((kk' : DP.Map (LC.ord n) (LC.ord d)) *
    (Id (DP.Map (LC.ord n) A) (LC.compMap (LC.ord n) (LC.ord d) A kk j) k * Id (DP.Map (LC.ord n) A) (LC.compMap (LC.ord n) (LC.ord d) A kk' j) k'))))) {
  d : W.N = wd.1 ;
  j : DP.Map (LC.ord d) A = wd.2.1 ;
  kk : DP.Map (LC.ord n) (LC.ord d) = wd.2.2.1 ;
  kk' : DP.Map (LC.ord n) (LC.ord d) = wd.2.2.2.1 ;
  pt (M M' : DP.Map (LC.ord n) A) (e : Id (DP.Map (LC.ord n) A) M M') (y : (LC.ord n).car) : Id A.car (M.1 y) (M'.1 y) =
    PL.ap (DP.Map (LC.ord n) A) A.car (\ N -> N.1 y) M M' e ;
  pwd (y : (LC.ord n).car) : LeN (kk.1 y).1 (kk'.1 y).1 =
    leOLe (kk.1 y).1 (kk'.1 y).1 (W.cmpN (kk.1 y).1 (kk'.1 y).1) (refl (W.cmpN (kk.1 y).1 (kk'.1 y).1))
      (leT (W.cmpN (kk.1 y).1 (kk'.1 y).1) (A.cmp (k.1 y) (k'.1 y))
        (PL.trans W.O3 (W.cmpN (kk.1 y).1 (kk'.1 y).1) (A.cmp (j.1 (kk.1 y)) (j.1 (kk'.1 y))) (A.cmp (k.1 y) (k'.1 y))
          (PL.sym W.O3 (A.cmp (j.1 (kk.1 y)) (j.1 (kk'.1 y))) (W.cmpN (kk.1 y).1 (kk'.1 y).1) (j.2 (kk.1 y) (kk'.1 y)))
          (W.ap2 A.car A.car W.O3 A.cmp (j.1 (kk.1 y)) (k.1 y) (j.1 (kk'.1 y)) (k'.1 y)
            (pt (LC.compMap (LC.ord n) (LC.ord d) A kk j) k wd.2.2.2.2.1 y) (pt (LC.compMap (LC.ord n) (LC.ord d) A kk' j) k' wd.2.2.2.2.2 y)))
        (pw y)) ;
  module M = Mono[X,dx,n,d,x,kk,kk',pwd] ;
  XA : DP.LO = X.G A ;
  ev (M0 : DP.Map (LC.ord n) A) : XA.car = (X.arr (LC.ord n) A M0).1 x ;
  thru (kk0 : DP.Map (LC.ord n) (LC.ord d)) (k0 : DP.Map (LC.ord n) A) (e : Id (DP.Map (LC.ord n) A) (LC.compMap (LC.ord n) (LC.ord d) A kk0 j) k0) :
      Id XA.car (ev k0) ((X.arr (LC.ord d) A j).1 (M.ev kk0)) =
    PL.trans XA.car (ev k0) (ev (LC.compMap (LC.ord n) (LC.ord d) A kk0 j)) ((X.arr (LC.ord d) A j).1 (M.ev kk0))
      (PL.ap (DP.Map (LC.ord n) A) XA.car ev k0 (LC.compMap (LC.ord n) (LC.ord d) A kk0 j)
        (PL.sym (DP.Map (LC.ord n) A) (LC.compMap (LC.ord n) (LC.ord d) A kk0 j) k0 e))
      (PL.sym XA.car ((X.arr (LC.ord d) A j).1 (M.ev kk0)) (ev (LC.compMap (LC.ord n) (LC.ord d) A kk0 j))
        (X.arr-comp (LC.ord n) (LC.ord d) A kk0 j x)) ;
  result : Id W.Bool (AFm.leO (XA.cmp (ev k) (ev k'))) true =
    leT (XA.cmp (ev k) (ev k')) (M.XC.cmp (M.ev kk) (M.ev kk'))
      (PL.trans W.O3 (XA.cmp (ev k) (ev k')) (XA.cmp ((X.arr (LC.ord d) A j).1 (M.ev kk)) ((X.arr (LC.ord d) A j).1 (M.ev kk')))
          (M.XC.cmp (M.ev kk) (M.ev kk'))
        (W.ap2 XA.car XA.car W.O3 XA.cmp (ev k) ((X.arr (LC.ord d) A j).1 (M.ev kk)) (ev k') ((X.arr (LC.ord d) A j).1 (M.ev kk'))
          (thru kk k wd.2.2.2.2.1) (thru kk' k' wd.2.2.2.2.2))
        ((X.arr (LC.ord d) A j).2 (M.ev kk) (M.ev kk')))
      M.result ;
} ;

monoDil (X : SF.SF[LC.ce]) (dx : LW.IsDil X) : DilCat[l].MonoSF X = \ A n x k k' pw ->
  TC.rec ((d : W.N) * ((j : DP.Map (LC.ord d) A) * ((kk : DP.Map (LC.ord n) (LC.ord d)) * ((kk' : DP.Map (LC.ord n) (LC.ord d)) *
      (Id (DP.Map (LC.ord n) A) (LC.compMap (LC.ord n) (LC.ord d) A kk j) k * Id (DP.Map (LC.ord n) A) (LC.compMap (LC.ord n) (LC.ord d) A kk' j) k')))))
    @l (Id W.Bool (AFm.leO ((X.G A).cmp ((X.arr (LC.ord n) A k).1 x) ((X.arr (LC.ord n) A k').1 x))) true)
    (W.HB.uip (AFm.leO ((X.G A).cmp ((X.arr (LC.ord n) A k).1 x) ((X.arr (LC.ord n) A k').1 x))) true)
    (\ wd -> MD[X,dx,A,n,x,k,k',pw,wd].result)
    (LC.ce.dir A n n k k') ;

-- consequences: Girard's dilators are the dilators; finite dilators are monotone codes
girard-dil (X : SF.SF[LC.ce]) (dx : LW.IsDil X) : DilCat[l].Ob = (X,(dx,monoDil X dx)) ;
code-mono (K : StabCode[l].Code[DilCat[l].F]) (dK : LW.IsDil (DilCat[l].D K)) : MonoEnum[l].MonoFinK K =
  DilCat[l].monoFin-SF K (monoDil (DilCat[l].D K) dK) ;
-- every finite dilator is iso to a member of the canonical sequence
complete-dil (K : StabCode[l].Code[DilCat[l].F]) (dK : LW.IsDil (DilCat[l].D K)) :
    (n : W.N) * StabEnum[l].CovK[DilCat[l].F,MonoEnum[l].enumLO,K].IsoS K (MonoEnum[l].code n) =
  MonoEnum[l].complete K (MonoEnum[l].MSound[K,code-mono K dK].mono) ;

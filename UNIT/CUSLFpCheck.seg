import FunExtUA ;
import Replacement ;
module Theory
 (ua : [l] Axioms[l].Univalence)
 (images : [l] [k] Replacement[l,k].Images)
 (surjections : [l] [k] [j] (Replacement[l,k].Surjectivity (images @l @k)) @j) {
 fe : [l] Axioms[l].FunExt = <l> FunExtUA[l].FE[ua @l].fe ;
 propUA : [l] Axioms[l].PropUnivalence = <l> Axioms[l].UnivalenceLemmas[ua @l].prop-univ ;

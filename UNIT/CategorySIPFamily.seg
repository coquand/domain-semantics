-- Fiberwise univalence and equivalence induction for hom families.
level l ;
open Base ;
module P = Prelude[l++] ;
module PH = Prelude[l+++] ;
module L = Prelude[l+] ;
module H = Axioms[l++].FunExtLemmas[fe @l++] ;
module UA = Axioms[l+].UnivalenceLemmas[ua @l+] ;

module On (I : U l++) (F : I -> U l+) {
  Family : U l++ = I -> U l+ ;
  FiberEquiv (G : Family) : U l++ =
    (i : I) -> L.Equiv (F i) (G i) ;
  idto (G : Family) (p : Id Family F G) : FiberEquiv G =
    idJ Family F (\ X q -> FiberEquiv X)
      (\ i -> L.idEquiv (F i)) G p ;
  path (G : Family) (e : FiberEquiv G) :
    Id Family F G =
    H.funext I (\ _ -> U l+) F G
      (\ i -> UA.ua (F i) (G i) (e i)) ;
  idto-ap (G : Family) (p : Id Family F G)
    (i : I) :
    Id (L.Equiv (F i) (G i)) (idto G p i)
      (Axioms[l+].idtoeqv (F i) (G i)
        (P.ap Family (U l+) (\ X -> X i) F G p)) =
    idJ Family F
      (\ X q -> (i : I) ->
        Id (L.Equiv (F i) (X i)) (idto X q i)
          (Axioms[l+].idtoeqv (F i) (X i)
            (P.ap Family (U l+) (\ T -> T i) F X q)))
      (\ i -> refl (L.idEquiv (F i))) G p i ;
  beta (G : Family) (e : FiberEquiv G) :
    Id (FiberEquiv G) (idto G (path G e)) e =
    H.funext I (\ i -> L.Equiv (F i) (G i))
      (idto G (path G e)) e (\ i ->
        P.trans (L.Equiv (F i) (G i))
          (idto G (path G e) i)
          (Axioms[l+].idtoeqv (F i) (G i)
            (P.ap Family (U l+) (\ X -> X i) F G
              (path G e)))
          (e i)
          (idto-ap G (path G e) i)
          (P.trans (L.Equiv (F i) (G i))
            (Axioms[l+].idtoeqv (F i) (G i)
              (P.ap Family (U l+) (\ X -> X i) F G
                (path G e)))
            (Axioms[l+].idtoeqv (F i) (G i)
              (UA.ua (F i) (G i) (e i)))
            (e i)
            (P.ap (Id (U l+) (F i) (G i))
              (L.Equiv (F i) (G i))
              (Axioms[l+].idtoeqv (F i) (G i))
              (P.ap Family (U l+) (\ X -> X i) F G
                (path G e))
              (UA.ua (F i) (G i) (e i))
              (P.ap ((j : I) -> Id (U l+) (F j) (G j))
                (Id (U l+) (F i) (G i))
                (\ h -> h i)
                (P.happly I (\ _ -> U l+) F G (path G e))
                (\ j -> UA.ua (F j) (G j) (e j))
                (H.happly-funext I (\ _ -> U l+) F G
                  (\ j -> UA.ua (F j) (G j) (e j)))))
            ((ua @l+ (F i) (G i)).sec-eq (e i)))) ;
  ua-id (i : I) :
    Id (Id (U l+) (F i) (F i))
      (UA.ua (F i) (F i) (L.idEquiv (F i)))
      (refl (F i)) =
    P.trans (Id (U l+) (F i) (F i))
      (UA.ua (F i) (F i) (L.idEquiv (F i)))
      ((ua @l+ (F i) (F i)).ret
        (L.idEquiv (F i)))
      (refl (F i))
      (P.sym (Id (U l+) (F i) (F i))
        ((ua @l+ (F i) (F i)).ret
          (L.idEquiv (F i)))
        (UA.ua (F i) (F i) (L.idEquiv (F i)))
        (P.trans (Id (U l+) (F i) (F i))
          ((ua @l+ (F i) (F i)).ret
            (L.idEquiv (F i)))
          ((ua @l+ (F i) (F i)).ret
            (Axioms[l+].idtoeqv (F i) (F i)
              (UA.ua (F i) (F i) (L.idEquiv (F i)))))
          (UA.ua (F i) (F i) (L.idEquiv (F i)))
          (P.sym (Id (U l+) (F i) (F i))
            ((ua @l+ (F i) (F i)).ret
              (Axioms[l+].idtoeqv (F i) (F i)
                (UA.ua (F i) (F i) (L.idEquiv (F i)))))
            ((ua @l+ (F i) (F i)).ret
              (L.idEquiv (F i)))
            (P.ap (L.Equiv (F i) (F i))
              (Id (U l+) (F i) (F i))
              ((ua @l+ (F i) (F i)).ret)
              (Axioms[l+].idtoeqv (F i) (F i)
                (UA.ua (F i) (F i) (L.idEquiv (F i))))
              (L.idEquiv (F i))
              ((ua @l+ (F i) (F i)).sec-eq
                (L.idEquiv (F i)))))
          ((ua @l+ (F i) (F i)).ret-eq
            (UA.ua (F i) (F i) (L.idEquiv (F i))))))
      ((ua @l+ (F i) (F i)).ret-eq (refl (F i))) ;
  base-ret : Id (Id Family F F)
    (path F (\ i -> L.idEquiv (F i))) (refl F) =
    P.trans (Id Family F F)
      (path F (\ i -> L.idEquiv (F i)))
      (H.funext I (\ _ -> U l+) F F
        (\ i -> refl (F i)))
      (refl F)
      (P.ap ((i : I) -> Id (U l+) (F i) (F i))
        (Id Family F F)
        (H.funext I (\ _ -> U l+) F F)
        (\ i -> UA.ua (F i) (F i) (L.idEquiv (F i)))
        (\ i -> refl (F i))
        (H.funext I
          (\ i -> Id (U l+) (F i) (F i))
          (\ i -> UA.ua (F i) (F i) (L.idEquiv (F i)))
          (\ i -> refl (F i)) ua-id))
      (H.funext-happly I (\ _ -> U l+) F F (refl F)) ;
  ret (G : Family) (p : Id Family F G) :
    Id (Id Family F G) (path G (idto G p)) p =
    idJ Family F
      (\ X q -> Id (Id Family F X)
        (path X (idto X q)) q)
      base-ret G p ;
  equivalence (G : Family) :
    P.Equiv (Id Family F G) (FiberEquiv G) =
    (idto G,
      P.qinv (Id Family F G) (FiberEquiv G)
        (idto G) (path G) (beta G) (ret G)) ;
  eqind (M : (G : Family) -> FiberEquiv G -> U l+++)
    (d : M F (\ i -> L.idEquiv (F i)))
    (G : Family) (e : FiberEquiv G) : M G e =
    PH.subst (FiberEquiv G) (M G)
      (idto G (path G e)) e (beta G e)
      (idJ Family F
        (\ X q -> M X (idto X q))
        d G (path G e)) ;
} ;

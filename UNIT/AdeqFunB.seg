-- AdeqFunB.seg: the budgeted adequacy, case funext (AdeqFunP.FunCase at the
-- bound K).  The representative f0, its keys and values come from the
-- bounded typing derivation (key-tpK, sel-valK); all induction hypotheses
-- are used at K.

level l ;
open Base ; open Prelude[l] ; open Lib[l] ; open Types[l] ; open Consistency[l] ; open Typing[l] ;
open Syntax[l] ; open SynLemmas[l] ; open Weaken[l] ; open Subst[l] ; open Presup[l] ; open Cross[l] ;
open Filter[l] ; open Sem[l] ; open Sound[l] ; open Reduction[l] ; open RelC[l] ; open LawsC[l] ; open AdeqBase[l] ;
open PrinEnv[l] ; open AdeqPiP[l] ; open AdeqLamP[l] ;
open TypingK[l] ; open SemK[l] ; open SoundK[l] ; open LawsK[l] ; open AdeqBaseB[l] ; open AdeqPiB[l] ;

-- the family part of an element of piFK at a key d with phic <= d -> y
fam-mem-leK (K : Nat) (m : Nat) (A : Tm m) (B : Tm (suc m)) (rho : Env m) (Ac phic : Ty)
    (pin : PiInK K (semK K m A rho) (famK K m B rho) Ac phic) (d y : Ty) (le : Le phic (arr d y)) : (famK K m B rho d).mem y =
  (famK K m B rho d).fup i.2.1 y i.2.2.2.2
    (Entries[famK K m B rho, famK-anti K m B rho, EntRK K (semK K m A rho) (famK K m B rho), \ x v r -> r.2].sel
       pin.b i.1 i.2.1 i.2.2.1 pin.ents d i.2.2.2.1)
  where { i : InvArr pin.b d y = inv-arr pin.b d y (le-trans pin.b phic (arr d y) pin.leb le) ; } ;

module AdeqFB (n : Nat) (D : Ctx n) (wD : Der n (jwf D)) (Kmax : Nat) {
  open RelCD[n, D] ;
  open LawsCD[n, D] ;
  open AdeqB[n, D] ;
  open AdeqBB[n, D, Kmax] ;
  open AdeqPP[n, D, wD] ;
  open AdeqLP[n, D, wD] ;
  open AdeqPB[n, D, wD, Kmax] ;

  module FunCaseB (m : Nat) (G : Ctx m) (A : Tm m) (B : Tm (suc m)) (f g : Tm m)
      (h1 : Der m (jty G A (uu m))) (K : Nat)
      (r1 : AdB0 K m G A A (uu m))
      (r2 : AdB0 K (suc m) (ext m G A) (app (suc m) (wk m f) (var (suc m) (fz m))) (app (suc m) (wk m g) (var (suc m) (fz m))) B)
      (r3 : AdB0 K m G f f (pp m A B))
      (rho : Env m) (fi : FitsKP K m G rho) (s s' : Fin m -> Tm n) (rs : RelSB m G rho s s') {

    As : Tm n = Sub.trav m A n s ;
    As' : Tm n = Sub.trav m A n s' ;
    Bs : Tm (suc n) = Sub.trav (suc m) B (suc n) (Sub.lift m n s) ;
    fs : Tm n = Sub.trav m f n s ;
    gs' : Tm n = Sub.trav m g n s' ;
    Fx (s1 : Fin m -> Tm n) (Q : Tm n) : Tm n = Sub.trav (suc m) (app (suc m) (wk m f) (var (suc m) (fz m))) n (consS m n s1 Q) ;
    Gx (s1 : Fin m -> Tm n) (Q : Tm n) : Tm n = Sub.trav (suc m) (app (suc m) (wk m g) (var (suc m) (fz m))) n (consS m n s1 Q) ;
    AK : Filt = semK K m A rho ;
    GK (x : Ty) : Filt = famK K m B rho x ;

    eA : Der n (jeq D As As' (uu n)) = subst-cross m n G D s s' A (uu m) h1 rs.ok rs.ok' rs.eq wD ;

    fx-eq (h : Tm m) (s1 : Fin m -> Tm n) (Q : Tm n) :
        Id (Tm n) (Sub.trav (suc m) (app (suc m) (wk m h) (var (suc m) (fz m))) n (consS m n s1 Q)) (app n (Sub.trav m h n s1) Q) =
      cong-app n (Sub.trav (suc m) (wk m h) n (consS m n s1 Q)) (Sub.trav m h n s1) Q Q (consS-wk m n s1 Q h) (refl Q) ;

    module At (u c : Ty) (mu : (semK K m f rho).mem u) (mc : (semK K m (pp m A B) rho).mem c) (hc : TpK K (el u c))
        (Ac phic f0 : Ty) (e1 : Eqv u f0) (e2 : Eqv c (pi Ac phic))
        (hpi : TpK K (el (pi Ac phic) univ)) (h2' : TpK K (ent f0 Ac phic)) (cf : Cons f0)
        (d t : Ty) (q : ASel u d t) (P P' : Tm n) (a : Arg Can d As P P') {

      i : InvArr f0 d t = inv-arr f0 d t (le-trans f0 u (arr d t) e1.2 (asel-le u d t q)) ;
      cd2 : Cons i.1 = cons-down d i.1 i.2.2.2.1 a.cd ;
      hd2 : TpK K (el i.1 Ac) = key-tpK K f0 i.1 i.2.1 i.2.2.1 Ac phic h2' (pi-domK K Ac phic hpi) cd2 ;
      sv : SelTK K phic i.1 i.2.1 = sel-valK K f0 Ac phic i.1 i.2.1 h2' cf hpi i.2.2.1 cd2 ;
      pin : PiInK K AK GK Ac phic = pi-in-piK K AK GK c Ac phic e2.1 mc ;
      rho' : Env (suc m) = extE m rho (prin i.1) ;
      fi' : FitsKP K (suc m) (ext m G A) rho' =
        fitskp-ext K m G A rho i.1 fi (new TyInKR[K, AK, i.1, a := Ac, ina := pin.inA1, tp := hd2]) ;
      my : (semK K (suc m) B rho').mem sv.1 = fam-mem-leK K m A B rho Ac phic pin i.1 sv.1 sv.2.1 ;
      mt2 : (semK K (suc m) (app (suc m) (wk m f) (var (suc m) (fz m))) rho').mem i.2.1 =
        new AppWKR[K, semK K (suc m) (wk m f) rho', prin i.1, i.2.1, g := f0, x := i.1,
                  ing := (wkK-sem K m f rho (prin i.1)).2 f0 ((semK K m f rho).fup u f0 e1.1 mu),
                  inx := le-refl i.1, le := asel-le f0 i.1 i.2.1 i.2.2.1,
                  bg := (tpk-bd-ent K f0 Ac phic h2').1, bx := (tpk-bd-el K i.1 Ac hd2).1] ;
      tyA : TyR Ac As As' = ad-tyB K m G A A r1 rho fi s s' rs Ac pin.inA1 (pi-domK K Ac phic hpi) ;

      at2 (Q Q' : Tm n) (aQ : TmR d As Q Q') : TmR i.1 As Q Q' = cmono-tm d i.1 i.2.2.2.1 As Q Q' aQ ;
      ar (Q Q' : Tm n) (aQ : TmR d As Q Q') : ArgRB m A rho (prin i.1) s s' Q Q' =
        argr-at m A rho i.1 s s' Q Q' (at2 Q Q' aQ) (cl5 i.1 Ac (tpk-tp K i.1 Ac hd2) As As' Q Q' tyA (at2 Q Q' aQ)) ;

      dP : Der n (jty D P As) = (eq-pre n (jeq D P P' As) a.cv).1 ;
      eP1 : Der n (jeq D P P' As') = eq-conv n D P P' As As' a.cv eA (eq-pre n (jeq D As As' (uu n)) eA).2 ;
      dP1 : Der n (jty D P As') = (eq-pre n (jeq D P P' As') eP1).1 ;
      tpv : Tp (el i.2.1 sv.1) = tpk-tp K i.2.1 sv.1 sv.2.2 ;

      body (Q Q' : Tm n) (eQ : Der n (jeq D Q Q' As)) (eQ' : Der n (jeq D Q' Q As')) (arQ : ArgRB m A rho (prin i.1) s s' Q Q') :
          TmR i.2.1 (Sub.trav (suc m) B n (consS m n s Q)) (Fx s Q) (Gx s' Q') =
        (r2 rho' fi' (consS m n s Q) (consS m n s' Q') (rels-extB m G A rho (prin i.1) s s' Q Q' rs eQ eQ' arQ)
           i.2.1 sv.1 mt2 my sv.2.2).1 ;

      b3 : TmR i.2.1 (Sub.trav (suc m) B n (consS m n s P)) (Fx s P) (Gx s' P') =
        body P P' a.cv (eq-sym n D P P' As' eP1) (ar P P' a.rel) ;
      b0 : TmR i.2.1 (Sub.trav (suc m) B n (consS m n s P)) (Fx s P) (Gx s' P) =
        body P P (eq-refl n D P As dP) (eq-refl n D P As' dP1) (ar P P (cl2 d As P P' a.rel)) ;
      b2 : TmR i.2.1 (Sub.trav (suc m) B n (consS m n s P)) (Gx s' P) (Gx s' P') =
        cl6 i.2.1 sv.1 tpv (Sub.trav (suc m) B n (consS m n s P)) (Gx s' P) (Fx s P) (Gx s' P')
          (cl4 i.2.1 sv.1 tpv (Sub.trav (suc m) B n (consS m n s P)) (Fx s P) (Gx s' P) b0) b3 ;

      fin (X1 X2 : Tm n) (h1' h2'' : Tm m) (s1 s2 : Fin m -> Tm n) (Q Q' : Tm n)
          (ex1 : Id (Tm n) X1 (app n (Sub.trav m h1' n s1) Q)) (ex2 : Id (Tm n) X2 (app n (Sub.trav m h2'' n s2) Q'))
          (b : TmR i.2.1 (Sub.trav (suc m) B n (consS m n s P)) X1 X2) :
          TmR t (subst1 n Bs P) (app n (Sub.trav m h1' n s1) Q) (app n (Sub.trav m h2'' n s2) Q') =
        cmono-tm i.2.1 t i.2.2.2.2 (subst1 n Bs P) (app n (Sub.trav m h1' n s1) Q) (app n (Sub.trav m h2'' n s2) Q')
          (tmr-tr i.2.1 (Sub.trav (suc m) B n (consS m n s P)) (subst1 n Bs P) (eq-cons m n s P B)
             (app n (Sub.trav m h1' n s1) Q) (app n (Sub.trav m h2'' n s2) Q')
             (tmr-trr i.2.1 (Sub.trav (suc m) B n (consS m n s P)) (app n (Sub.trav m h1' n s1) Q) X2
                (app n (Sub.trav m h2'' n s2) Q') ex2
                (tmr-trl i.2.1 (Sub.trav (suc m) B n (consS m n s P)) X1 (app n (Sub.trav m h1' n s1) Q) X2 ex1 b))) ;

      c1 : TmR t (subst1 n Bs P) (app n fs P) (app n fs P') =
        (((tmr-unfold u (pp n As Bs) fs fs).1 (r3 rho fi s s (rels-diagB m G rho s s' rs) u c mu mc hc).1).fn
           As Bs (rrefl n (pp n As Bs)) d t q P P' a).c1 ;

      appc : AppC Can t (subst1 n Bs P) fs gs' P P' =
        new AppRC[Can, t, subst1 n Bs P, fs, gs', P, P', c1 := c1,
                 c2 := fin (Gx s' P) (Gx s' P') g g s' s' P P' (fx-eq g s' P) (fx-eq g s' P') b2,
                 c3 := fin (Fx s P) (Gx s' P') f g s s' P P' (fx-eq f s P) (fx-eq g s' P') b3] ;
    } ;

    tyc-by (u c : Ty) (mc : (semK K m (pp m A B) rho).mem c) : ShapeK K u c -> TyC Can u fs gs' = split {
      sk-bot e h -> tyc-om Can u e fs gs' ;
      sk-univ e1 e2 -> absurd (TyC Can u fs gs') (piK-univ-clash K AK GK c e2.1 mc) ;
      sk-pi Ac phic bpi e1 e2 h1' h2' cp -> absurd (TyC Can u fs gs') (piK-univ-clash K AK GK c e2.1 mc) ;
      sk-lam Ac phic f0 e1 e2 hpi h2' cf -> tyc-fun Can u f0 Ac phic e1.2 (tpk-tp-ent K f0 Ac phic h2') fs gs' } ;

    appc-by (u c : Ty) (mu : (semK K m f rho).mem u) (mc : (semK K m (pp m A B) rho).mem c) (hc : TpK K (el u c))
        (d t : Ty) (q : ASel u d t) (P P' : Tm n) (a : Arg Can d As P P') :
        ShapeK K u c -> AppC Can t (subst1 n Bs P) fs gs' P P' = split {
      sk-bot e h -> appc-all Can t (\ T1 M1 M1' -> tmr-om t (app-bot u d t e q) T1 M1 M1') (subst1 n Bs P) fs gs' P P' ;
      sk-univ e1 e2 -> absurd (AppC Can t (subst1 n Bs P) fs gs' P P') (piK-univ-clash K AK GK c e2.1 mc) ;
      sk-pi Ac phic bpi e1 e2 h1' h2' cp ->
        absurd (AppC Can t (subst1 n Bs P) fs gs' P P') (piK-univ-clash K AK GK c e2.1 mc) ;
      sk-lam Ac phic f0 e1 e2 hpi h2' cf -> At[u, c, mu, mc, hc, Ac, phic, f0, e1, e2, hpi, h2', cf, d, t, q, P, P', a].appc } ;

    tm1 (u c : Ty) (mu : (semK K m f rho).mem u) (mc : (semK K m (pp m A B) rho).mem c) (hc : TpK K (el u c)) :
        TmR u (pp n As Bs) fs gs' =
      (tmr-unfold u (pp n As Bs) fs gs').2
        (new TmCR[Can, u, pp n As Bs, fs, gs', ty := tyc-by u c mc (shapek K u c hc),
                  fn := fun-at-pp u As Bs fs gs' (\ d t q P P' a -> appc-by u c mu mc hc d t q P P' a (shapek K u c hc))]) ;
  } ;

  ad-funext-atB (m : Nat) (G : Ctx m) (A : Tm m) (B : Tm (suc m)) (f g : Tm m)
      (h1 : Der m (jty G A (uu m))) (w1 w2 w3 : Nat)
      (r1 : AdW w1 m G A A (uu m))
      (r2 : AdW w2 (suc m) (ext m G A) (app (suc m) (wk m f) (var (suc m) (fz m))) (app (suc m) (wk m g) (var (suc m) (fz m))) B)
      (r3 : AdW w3 m G f f (pp m A B)) (K : Nat) (hB : LeN (add (add w1 (add w2 w3)) K) Kmax) :
      AdB0 K m G f g (pp m A B) =
    \ rho fi s s' rs u c mu mc hc ->
      (FunCaseB[m, G, A, B, f, g, h1, K, a1, a2, a3, rho, fi, s, s', rs].tm1 u c mu mc hc,
       cl6 u c (tpk-tp K u c hc) (Sub.trav m (pp m A B) n s') (Sub.trav m f n s) (Sub.trav m f n s') (Sub.trav m g n s')
         (a3 rho fi s s' rs u c mu mc hc).2
         (FunCaseB[m, G, A, B, f, g, h1, K, a1, a2, a3, rho, fi, s', s', rels-diagB m G rho s' s (rels-symB m G rho s s' rs)].tm1
            u c mu mc hc))
    where {
      W : Nat = add w1 (add w2 w3) ;
      a1 : AdB0 K m G A A (uu m) = r1 K (wstep0 Kmax w1 W K (le-sum-l w1 (add w2 w3)) hB) ;
      a2 : AdB0 K (suc m) (ext m G A) (app (suc m) (wk m f) (var (suc m) (fz m))) (app (suc m) (wk m g) (var (suc m) (fz m))) B =
        r2 K (wstep0 Kmax w2 W K (leN-trans w2 (add w2 w3) W (le-sum-l w2 w3) (le-sum-r w1 (add w2 w3))) hB) ;
      a3 : AdB0 K m G f f (pp m A B) =
        r3 K (wstep0 Kmax w3 W K (leN-trans w3 (add w2 w3) W (le-sum-r w2 w3) (le-sum-r w1 (add w2 w3))) hB) ; } ;
} ;

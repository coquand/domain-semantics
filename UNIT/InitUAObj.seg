-- InitUAObj.seg (PLAN-UAMOD, Phase 0, interface): models of level N as a
-- nested Sigma type TEModelS (records have no eta in the checker), in
-- the block order used for the contraction:
--   TEModelS = (s : Srt) * (h : Sets s) * (c1 : Ops1 s) * (c2 : Ops2 s c1)
--              * (pp : OpsP s c1 c2) * (v : OpsV s c1 c2 pp) * Eqs s c1 c2 pp v
--   Srt   the four sorts Ctx, Sub, Ty, El
--   Sets  the four set-ness conditions
--   Ops1  nil id o eps subT subt
--   Ops2  ext p q lift sec
--   OpsP  Pi, the Pi-iso (fun, inv) and its two laws fun-inv, inv-fun
--   OpsV  univ decode pic uc lf
--   Eqs   all remaining equations of CwF, PiStr, TEModel
-- toRec : TEModelS -> TEModel[N],  fromRec : TEModel[N] -> TEModelS,
-- fromRec (toRec y) = y by refl.
-- The modules S0, S1, S2, SP, SV name the components of a prefix of the
-- Sigma (they are definitions: e.g. S1[s,c1].subT = c1.2.2.2.2.1).
-- Segment with free N.
level l ;
open Base ; open Prelude[l] ;
open EhrhardCwF ;
module EM = EhrhardTEModel[l] ;

Srt : U l+ = (Ctx : U l) * (Sub : Ctx -> Ctx -> U l) * (Ty : Ctx -> U l) * ((G : Ctx) -> Ty G -> U l) ;

module S0 (s : Srt) {
  Ctx : U l = s.1 ;
  Sub (D G : Ctx) : U l = s.2.1 D G ;
  Ty (G : Ctx) : U l = s.2.2.1 G ;
  El (G : Ctx) (A : Ty G) : U l = s.2.2.2 G A ;
  Sets : U l = isSet Ctx * ((D G : Ctx) -> isSet (Sub D G)) * ((G : Ctx) -> isSet (Ty G))
             * ((G : Ctx) (A : Ty G) -> isSet (El G A)) ;
  SubTyT : U l = (D G : Ctx) -> Ty G -> Sub D G -> Ty D ;
  Ops1 : U l =
    (nil : Ctx) * (id : (G : Ctx) -> Sub G G)
    * (o : (T D G : Ctx) -> Sub D G -> Sub T D -> Sub T G)
    * (eps : (G : Ctx) -> Sub G nil)
    * (subT : SubTyT)
    * ((D G : Ctx) (A : Ty G) (a : El G A) (s0 : Sub D G) -> El D (subT D G A s0)) ;
} ;
Sets (s : Srt) : U l = S0[s].Sets ;
Ops1 (s : Srt) : U l = S0[s].Ops1 ;

module S1 (s : Srt) (c1 : Ops1 s) {
  open S0[s] ;
  nil : Ctx = c1.1 ;
  id (G : Ctx) : Sub G G = c1.2.1 G ;
  o (T D G : Ctx) (s0 : Sub D G) (s1 : Sub T D) : Sub T G = c1.2.2.1 T D G s0 s1 ;
  eps (G : Ctx) : Sub G nil = c1.2.2.2.1 G ;
  subT (D G : Ctx) (A : Ty G) (s0 : Sub D G) : Ty D = c1.2.2.2.2.1 D G A s0 ;
  subt (D G : Ctx) (A : Ty G) (a : El G A) (s0 : Sub D G) : El D (subT D G A s0) = c1.2.2.2.2.2 D G A a s0 ;
  Ops2 : U l =
    (ext : (G : Ctx) -> Ty G -> Ctx)
    * (p : (G : Ctx) (A : Ty G) -> Sub (ext G A) G)
    * (q : (G : Ctx) (A : Ty G) -> El (ext G A) (subT (ext G A) G A (p G A)))
    * (lift : (D G : Ctx) (A : Ty G) (s0 : Sub D G) -> Sub (ext D (subT D G A s0)) (ext G A))
    * ((G : Ctx) (A : Ty G) (a : El G A) -> Sub G (ext G A)) ;
} ;
Ops2 (s : Srt) (c1 : Ops1 s) : U l = S1[s,c1].Ops2 ;

module S2 (s : Srt) (c1 : Ops1 s) (c2 : Ops2 s c1) {
  open S0[s] ; open S1[s,c1] ;
  ext (G : Ctx) (A : Ty G) : Ctx = c2.1 G A ;
  p (G : Ctx) (A : Ty G) : Sub (ext G A) G = c2.2.1 G A ;
  q (G : Ctx) (A : Ty G) : El (ext G A) (subT (ext G A) G A (p G A)) = c2.2.2.1 G A ;
  lift (D G : Ctx) (A : Ty G) (s0 : Sub D G) : Sub (ext D (subT D G A s0)) (ext G A) = c2.2.2.2.1 D G A s0 ;
  sec (G : Ctx) (A : Ty G) (a : El G A) : Sub G (ext G A) = c2.2.2.2.2 G A a ;
  OpsP : U l =
    (Pi : (G : Ctx) (A : Ty G) -> Ty (ext G A) -> Ty G)
    * (fun : (G : Ctx) (A : Ty G) (B : Ty (ext G A)) -> El G (Pi G A B) -> El (ext G A) B)
    * (inv : (G : Ctx) (A : Ty G) (B : Ty (ext G A)) -> El (ext G A) B -> El G (Pi G A B))
    * (fun-inv : (G : Ctx) (A : Ty G) (B : Ty (ext G A)) (b : El (ext G A) B)
                 -> Id (El (ext G A) B) (fun G A B (inv G A B b)) b)
    * ((G : Ctx) (A : Ty G) (B : Ty (ext G A)) (f : El G (Pi G A B))
                 -> Id (El G (Pi G A B)) (inv G A B (fun G A B f)) f) ;
} ;
OpsP (s : Srt) (c1 : Ops1 s) (c2 : Ops2 s c1) : U l = S2[s,c1,c2].OpsP ;

module SP (s : Srt) (c1 : Ops1 s) (c2 : Ops2 s c1) (pp : OpsP s c1 c2) {
  open S0[s] ; open S1[s,c1] ; open S2[s,c1,c2] ;
  Pi (G : Ctx) (A : Ty G) (B : Ty (ext G A)) : Ty G = pp.1 G A B ;
  fun (G : Ctx) (A : Ty G) (B : Ty (ext G A)) (f : El G (Pi G A B)) : El (ext G A) B = pp.2.1 G A B f ;
  inv (G : Ctx) (A : Ty G) (B : Ty (ext G A)) (b : El (ext G A) B) : El G (Pi G A B) = pp.2.2.1 G A B b ;
  fun-inv (G : Ctx) (A : Ty G) (B : Ty (ext G A)) (b : El (ext G A) B)
    : Id (El (ext G A) B) (fun G A B (inv G A B b)) b = pp.2.2.2.1 G A B b ;
  inv-fun (G : Ctx) (A : Ty G) (B : Ty (ext G A)) (f : El G (Pi G A B))
    : Id (El G (Pi G A B)) (inv G A B (fun G A B f)) f = pp.2.2.2.2 G A B f ;
  OpsV : U l =
    (univ : EM.LevelAt N -> (G : Ctx) -> Ty G)
    * (decode : (n : EM.LevelAt N) (G : Ctx) -> El G (univ n G) -> Ty G)
    * (pic : (n : EM.LevelAt N) (G : Ctx) (a : El G (univ n G))
             -> El (ext G (decode n G a)) (univ n (ext G (decode n G a))) -> El G (univ n G))
    * (uc : (m n : EM.LevelAt N) -> EM.StrictAt N m n -> (G : Ctx) -> El G (univ n G))
    * ((m n : EM.LevelAt N) -> EM.StrictAt N m n -> (G : Ctx) -> El G (univ m G) -> El G (univ n G)) ;
} ;
OpsV (s : Srt) (c1 : Ops1 s) (c2 : Ops2 s c1) (pp : OpsP s c1 c2) : U l = SP[s,c1,c2,pp].OpsV ;

module SV (s : Srt) (c1 : Ops1 s) (c2 : Ops2 s c1) (pp : OpsP s c1 c2) (v : OpsV s c1 c2 pp) {
  open S0[s] ; open S1[s,c1] ; open S2[s,c1,c2] ; open SP[s,c1,c2,pp] ;
  univ (n : EM.LevelAt N) (G : Ctx) : Ty G = v.1 n G ;
  decode (n : EM.LevelAt N) (G : Ctx) (a : El G (univ n G)) : Ty G = v.2.1 n G a ;
  pic (n : EM.LevelAt N) (G : Ctx) (a : El G (univ n G))
      (b : El (ext G (decode n G a)) (univ n (ext G (decode n G a)))) : El G (univ n G) = v.2.2.1 n G a b ;
  uc (m n : EM.LevelAt N) (lt : EM.StrictAt N m n) (G : Ctx) : El G (univ n G) = v.2.2.2.1 m n lt G ;
  lf (m n : EM.LevelAt N) (lt : EM.StrictAt N m n) (G : Ctx) (a : El G (univ m G)) : El G (univ n G) =
    v.2.2.2.2 m n lt G a ;
} ;

------------------------------------------------------------------------
-- the equations (copied from InitModelShape.Eqs, as a Sigma; derived
-- members as functions of the equations they use)

module SE (s : Srt) (c1 : Ops1 s) (c2 : Ops2 s c1) (pp : OpsP s c1 c2) (v : OpsV s c1 c2 pp) {
  open S0[s] ; open S1[s,c1] ; open S2[s,c1,c2] ; open SP[s,c1,c2,pp] ; open SV[s,c1,c2,pp,v] ;

  OIdl : U l = (D G : Ctx) (s0 : Sub D G) -> Id (Sub D G) (o D G G (id G) s0) s0 ;
  OIdr : U l = (D G : Ctx) (s0 : Sub D G) -> Id (Sub D G) (o D D G s0 (id D)) s0 ;
  OAssoc : U l = (Q T D G : Ctx) (s0 : Sub D G) (s1 : Sub T D) (s2 : Sub Q T)
    -> Id (Sub Q G) (o Q T G (o T D G s0 s1) s2) (o Q D G s0 (o Q T D s1 s2)) ;
  EpsUniq : U l = (G : Ctx) (s0 : Sub G nil) -> Id (Sub G nil) s0 (eps G) ;
  SubTIdT : U l = (G : Ctx) (A : Ty G) -> Id (Ty G) (subT G G A (id G)) A ;
  SubTOT : U l = (T D G : Ctx) (A : Ty G) (s0 : Sub D G) (s1 : Sub T D)
    -> Id (Ty T) (subT T G A (o T D G s0 s1)) (subT T D (subT D G A s0) s1) ;
  SubtIdT (subT-id : SubTIdT) : U l = (G : Ctx) (A : Ty G) (a : El G A)
    -> Id (El G A) (subst (Ty G) (El G) (subT G G A (id G)) A (subT-id G A) (subt G G A a (id G))) a ;
  SubtOT (subT-o : SubTOT) : U l = (T D G : Ctx) (A : Ty G) (a : El G A) (s0 : Sub D G) (s1 : Sub T D)
    -> Id (El T (subT T D (subT D G A s0) s1))
         (subst (Ty T) (El T) (subT T G A (o T D G s0 s1)) (subT T D (subT D G A s0) s1)
                (subT-o T D G A s0 s1) (subt T G A a (o T D G s0 s1)))
         (subt T D (subT D G A s0) (subt D G A a s0) s1) ;
  LiftIdT (subT-id : SubTIdT) : U l = (G : Ctx) (A : Ty G)
    -> Id (Sub (ext G A) (ext G A))
         (subst (Ty G) (\ B -> Sub (ext G B) (ext G A)) (subT G G A (id G)) A (subT-id G A)
                (lift G G A (id G)))
         (id (ext G A)) ;
  LiftOT (subT-o : SubTOT) : U l = (T D G : Ctx) (A : Ty G) (s0 : Sub D G) (s1 : Sub T D)
    -> Id (Sub (ext T (subT T D (subT D G A s0) s1)) (ext G A))
         (subst (Ty T) (\ B -> Sub (ext T B) (ext G A))
                (subT T G A (o T D G s0 s1)) (subT T D (subT D G A s0) s1)
                (subT-o T D G A s0 s1) (lift T G A (o T D G s0 s1)))
         (o (ext T (subT T D (subT D G A s0) s1)) (ext D (subT D G A s0)) (ext G A)
            (lift D G A s0) (lift T D (subT D G A s0) s1)) ;
  PLiftT : U l = (D G : Ctx) (A : Ty G) (s0 : Sub D G)
    -> Id (Sub (ext D (subT D G A s0)) G)
         (o (ext D (subT D G A s0)) (ext G A) G (p G A) (lift D G A s0))
         (o (ext D (subT D G A s0)) D G s0 (p D (subT D G A s0))) ;
  PSecT : U l = (G : Ctx) (A : Ty G) (a : El G A)
    -> Id (Sub G G) (o G (ext G A) G (p G A) (sec G A a)) (id G) ;
  SecOT : U l = (D G : Ctx) (A : Ty G) (a : El G A) (s0 : Sub D G)
    -> Id (Sub D (ext G A)) (o D G (ext G A) (sec G A a) s0)
         (o D (ext D (subT D G A s0)) (ext G A) (lift D G A s0)
            (sec D (subT D G A s0) (subt D G A a s0))) ;
  LiftPSecQT : U l = (G : Ctx) (A : Ty G)
    -> Id (Sub (ext G A) (ext G A))
         (o (ext G A) (ext (ext G A) (subT (ext G A) G A (p G A))) (ext G A)
            (lift (ext G A) G A (p G A))
            (sec (ext G A) (subT (ext G A) G A (p G A)) (q G A)))
         (id (ext G A)) ;

  -- derived: as CwF.p-lift-T, CwF.p-sec-T
  p-lift-T (subT-o : SubTOT) (p-lift : PLiftT) (D G : Ctx) (A B : Ty G) (s0 : Sub D G)
    : Id (Ty (ext D (subT D G A s0)))
         (subT (ext D (subT D G A s0)) (ext G A) (subT (ext G A) G B (p G A)) (lift D G A s0))
         (subT (ext D (subT D G A s0)) D (subT D G B s0) (p D (subT D G A s0))) =
    trans (Ty E)
      (subT E (ext G A) (subT (ext G A) G B (p G A)) (lift D G A s0))
      (subT E G B (o E (ext G A) G (p G A) (lift D G A s0)))
      (subT E D (subT D G B s0) (p D (subT D G A s0)))
      (sym (Ty E) (subT E G B (o E (ext G A) G (p G A) (lift D G A s0)))
                  (subT E (ext G A) (subT (ext G A) G B (p G A)) (lift D G A s0))
                  (subT-o E (ext G A) G B (p G A) (lift D G A s0)))
      (trans (Ty E)
         (subT E G B (o E (ext G A) G (p G A) (lift D G A s0)))
         (subT E G B (o E D G s0 (p D (subT D G A s0))))
         (subT E D (subT D G B s0) (p D (subT D G A s0)))
         (ap (Sub E G) (Ty E) (\ s' -> subT E G B s')
             (o E (ext G A) G (p G A) (lift D G A s0)) (o E D G s0 (p D (subT D G A s0)))
             (p-lift D G A s0))
         (subT-o E D G B s0 (p D (subT D G A s0))))
   where { E : Ctx = ext D (subT D G A s0) ; } ;

  p-sec-T (subT-id : SubTIdT) (subT-o : SubTOT) (p-sec : PSecT) (G : Ctx) (A B : Ty G) (a : El G A)
    : Id (Ty G) (subT G (ext G A) (subT (ext G A) G B (p G A)) (sec G A a)) B =
    trans (Ty G)
      (subT G (ext G A) (subT (ext G A) G B (p G A)) (sec G A a))
      (subT G G B (o G (ext G A) G (p G A) (sec G A a)))
      B
      (sym (Ty G) (subT G G B (o G (ext G A) G (p G A) (sec G A a)))
                  (subT G (ext G A) (subT (ext G A) G B (p G A)) (sec G A a))
                  (subT-o G (ext G A) G B (p G A) (sec G A a)))
      (trans (Ty G) (subT G G B (o G (ext G A) G (p G A) (sec G A a))) (subT G G B (id G)) B
         (ap (Sub G G) (Ty G) (\ s' -> subT G G B s')
             (o G (ext G A) G (p G A) (sec G A a)) (id G) (p-sec G A a))
         (subT-id G B)) ;

  QLiftT (subT-o : SubTOT) (p-lift : PLiftT) : U l = (D G : Ctx) (A : Ty G) (s0 : Sub D G)
    -> Id (El (ext D (subT D G A s0)) (subT (ext D (subT D G A s0)) D (subT D G A s0) (p D (subT D G A s0))))
         (subst (Ty (ext D (subT D G A s0))) (El (ext D (subT D G A s0)))
                (subT (ext D (subT D G A s0)) (ext G A) (subT (ext G A) G A (p G A)) (lift D G A s0))
                (subT (ext D (subT D G A s0)) D (subT D G A s0) (p D (subT D G A s0)))
                (p-lift-T subT-o p-lift D G A A s0)
                (subt (ext D (subT D G A s0)) (ext G A) (subT (ext G A) G A (p G A)) (q G A) (lift D G A s0)))
         (q D (subT D G A s0)) ;
  QSecT (subT-id : SubTIdT) (subT-o : SubTOT) (p-sec : PSecT) : U l = (G : Ctx) (A : Ty G) (a : El G A)
    -> Id (El G A)
         (subst (Ty G) (El G) (subT G (ext G A) (subT (ext G A) G A (p G A)) (sec G A a)) A
                (p-sec-T subT-id subT-o p-sec G A A a)
                (subt G (ext G A) (subT (ext G A) G A (p G A)) (q G A) (sec G A a)))
         a ;

  PiNatT : U l = (D G : Ctx) (A : Ty G) (B : Ty (ext G A)) (s0 : Sub D G)
    -> Id (Ty D) (subT D G (Pi G A B) s0)
                 (Pi D (subT D G A s0) (subT (ext D (subT D G A s0)) (ext G A) B (lift D G A s0))) ;
  PiIsoNatT (Pi-nat : PiNatT) : U l = (D G : Ctx) (A : Ty G) (B : Ty (ext G A)) (f : El (ext G A) B) (s0 : Sub D G)
    -> Id (El D (Pi D (subT D G A s0) (subT (ext D (subT D G A s0)) (ext G A) B (lift D G A s0))))
         (subst (Ty D) (El D) (subT D G (Pi G A B) s0)
                (Pi D (subT D G A s0) (subT (ext D (subT D G A s0)) (ext G A) B (lift D G A s0)))
                (Pi-nat D G A B s0)
                (subt D G (Pi G A B) (inv G A B f) s0))
         (inv D (subT D G A s0) (subT (ext D (subT D G A s0)) (ext G A) B (lift D G A s0))
            (subt (ext D (subT D G A s0)) (ext G A) B f (lift D G A s0))) ;

  UnivNatT : U l = (n : EM.LevelAt N) (D G : Ctx) (s0 : Sub D G) ->
      Id (Ty D) (subT D G (univ n G) s0) (univ n D) ;
  code-sub (univ-nat : UnivNatT) (n : EM.LevelAt N) (D G : Ctx) (a : El G (univ n G)) (s0 : Sub D G)
    : El D (univ n D) =
    subst (Ty D) (El D) (subT D G (univ n G) s0) (univ n D) (univ-nat n D G s0)
      (subt D G (univ n G) a s0) ;
  DecodeNatT (univ-nat : UnivNatT) : U l = (n : EM.LevelAt N) (D G : Ctx) (a : El G (univ n G)) (s0 : Sub D G) ->
      Id (Ty D) (subT D G (decode n G a) s0) (decode n D (code-sub univ-nat n D G a s0)) ;
  up-code (univ-nat : UnivNatT) (decode-nat : DecodeNatT univ-nat)
      (n : EM.LevelAt N) (D G : Ctx) (a : El G (univ n G)) (s0 : Sub D G) :
      Sub (ext D (decode n D (code-sub univ-nat n D G a s0))) (ext G (decode n G a)) =
    subst (Ty D) (\ B -> Sub (ext D B) (ext G (decode n G a)))
      (subT D G (decode n G a) s0) (decode n D (code-sub univ-nat n D G a s0)) (decode-nat n D G a s0)
      (lift D G (decode n G a) s0) ;
  ElLfT : U l = (m n : EM.LevelAt N) (lt : EM.StrictAt N m n) (G : Ctx) (a : El G (univ m G)) ->
      Id (Ty G) (decode n G (lf m n lt G a)) (decode m G a) ;
  ElPicT : U l = (n : EM.LevelAt N) (G : Ctx) (a : El G (univ n G))
      (b : El (ext G (decode n G a)) (univ n (ext G (decode n G a)))) ->
      Id (Ty G) (decode n G (pic n G a b)) (Pi G (decode n G a) (decode n (ext G (decode n G a)) b)) ;
  ElUcT : U l = (m n : EM.LevelAt N) (lt : EM.StrictAt N m n) (G : Ctx) ->
      Id (Ty G) (decode n G (uc m n lt G)) (univ m G) ;
  lift-binder (el-lf : ElLfT) (m n : EM.LevelAt N) (lt : EM.StrictAt N m n) (G : Ctx) (a : El G (univ m G)) :
      Sub (ext G (decode n G (lf m n lt G a))) (ext G (decode m G a)) =
    idJ (Ty G) (decode n G (lf m n lt G a)) (\ B' e' -> Sub (ext G (decode n G (lf m n lt G a))) (ext G B'))
      (id (ext G (decode n G (lf m n lt G a)))) (decode m G a) (el-lf m n lt G a) ;
  LfPicT (univ-nat : UnivNatT) (el-lf : ElLfT) : U l =
      (m n : EM.LevelAt N) (lt : EM.StrictAt N m n) (G : Ctx) (a : El G (univ m G))
      (b : El (ext G (decode m G a)) (univ m (ext G (decode m G a)))) ->
      Id (El G (univ n G)) (lf m n lt G (pic m G a b))
        (pic n G (lf m n lt G a)
          (lf m n lt (ext G (decode n G (lf m n lt G a)))
            (code-sub univ-nat m (ext G (decode n G (lf m n lt G a))) (ext G (decode m G a)) b
               (lift-binder el-lf m n lt G a)))) ;
  LfUcT : U l = (m n p0 : EM.LevelAt N) (mn : EM.StrictAt N m n) (np : EM.StrictAt N n p0)
      (mp : EM.StrictAt N m p0) (G : Ctx) ->
      Id (El G (univ p0 G)) (lf n p0 np G (uc m n mn G)) (uc m p0 mp G) ;
  LfLfT : U l = (m n p0 : EM.LevelAt N) (mn : EM.StrictAt N m n) (np : EM.StrictAt N n p0)
      (mp : EM.StrictAt N m p0) (G : Ctx) (a : El G (univ m G)) ->
      Id (El G (univ p0 G)) (lf n p0 np G (lf m n mn G a)) (lf m p0 mp G a) ;
  PicNatT (univ-nat : UnivNatT) (decode-nat : DecodeNatT univ-nat) : U l =
      (n : EM.LevelAt N) (D G : Ctx) (s0 : Sub D G) (a : El G (univ n G))
      (b : El (ext G (decode n G a)) (univ n (ext G (decode n G a)))) ->
      Id (El D (univ n D)) (code-sub univ-nat n D G (pic n G a b) s0)
        (pic n D (code-sub univ-nat n D G a s0)
          (code-sub univ-nat n (ext D (decode n D (code-sub univ-nat n D G a s0))) (ext G (decode n G a)) b
             (up-code univ-nat decode-nat n D G a s0))) ;
  UcNatT (univ-nat : UnivNatT) : U l =
      (m n : EM.LevelAt N) (lt : EM.StrictAt N m n) (D G : Ctx) (s0 : Sub D G) ->
      Id (El D (univ n D)) (code-sub univ-nat n D G (uc m n lt G) s0) (uc m n lt D) ;
  LfNatT (univ-nat : UnivNatT) : U l =
      (m n : EM.LevelAt N) (lt : EM.StrictAt N m n) (D G : Ctx) (s0 : Sub D G) (a : El G (univ m G)) ->
      Id (El D (univ n D)) (code-sub univ-nat n D G (lf m n lt G a) s0) (lf m n lt D (code-sub univ-nat m D G a s0)) ;

  -- the 29 equations, in this order
  Eqs : U l =
    (o-idl : OIdl) * (o-idr : OIdr) * (o-assoc : OAssoc) * (eps-uniq : EpsUniq)
    * (subT-id : SubTIdT) * (subT-o : SubTOT)
    * (subt-id : SubtIdT subT-id) * (subt-o : SubtOT subT-o)
    * (lift-id : LiftIdT subT-id) * (lift-o : LiftOT subT-o)
    * (p-lift : PLiftT) * (p-sec : PSecT) * (sec-o : SecOT) * (lift-p-sec-q : LiftPSecQT)
    * (q-lift : QLiftT subT-o p-lift) * (q-sec : QSecT subT-id subT-o p-sec)
    * (Pi-nat : PiNatT) * (Pi-iso-nat : PiIsoNatT Pi-nat)
    * (univ-nat : UnivNatT) * (decode-nat : DecodeNatT univ-nat)
    * (el-lf : ElLfT) * (el-pic : ElPicT) * (el-uc : ElUcT)
    * (lf-pic : LfPicT univ-nat el-lf) * (lf-uc : LfUcT) * (lf-lf : LfLfT)
    * (pic-nat : PicNatT univ-nat decode-nat) * (uc-nat : UcNatT univ-nat) * LfNatT univ-nat ;
} ;
Eqs (s : Srt) (c1 : Ops1 s) (c2 : Ops2 s c1) (pp : OpsP s c1 c2) (v : OpsV s c1 c2 pp) : U l =
  SE[s,c1,c2,pp,v].Eqs ;

TEModelS : U l+ =
  (s : Srt) * (h : Sets s) * (c1 : Ops1 s) * (c2 : Ops2 s c1) * (pp : OpsP s c1 c2)
  * (v : OpsV s c1 c2 pp) * Eqs s c1 c2 pp v ;

------------------------------------------------------------------------
-- unpacking an element of TEModelS; the record; and back

module Y (y : TEModelS) {
  s : Srt = y.1 ;
  h : Sets s = y.2.1 ;
  c1 : Ops1 s = y.2.2.1 ;
  c2 : Ops2 s c1 = y.2.2.2.1 ;
  pp : OpsP s c1 c2 = y.2.2.2.2.1 ;
  v : OpsV s c1 c2 pp = y.2.2.2.2.2.1 ;
  e : Eqs s c1 c2 pp v = y.2.2.2.2.2.2 ;
  open S0[s] ; open S1[s,c1] ; open S2[s,c1,c2] ; open SP[s,c1,c2,pp] ; open SV[s,c1,c2,pp,v] ;
  module E = SE[s,c1,c2,pp,v] ;
  isSetCtx : isSet Ctx = h.1 ;
  isSetSub (D G : Ctx) : isSet (Sub D G) = h.2.1 D G ;
  isSetTy (G : Ctx) : isSet (Ty G) = h.2.2.1 G ;
  isSetEl (G : Ctx) (A : Ty G) : isSet (El G A) = h.2.2.2 G A ;
  o-idl : E.OIdl = e.1 ;
  o-idr : E.OIdr = e.2.1 ;
  o-assoc : E.OAssoc = e.2.2.1 ;
  eps-uniq : E.EpsUniq = e.2.2.2.1 ;
  subT-id : E.SubTIdT = e.2.2.2.2.1 ;
  subT-o : E.SubTOT = e.2.2.2.2.2.1 ;
  subt-id : E.SubtIdT subT-id = e.2.2.2.2.2.2.1 ;
  subt-o : E.SubtOT subT-o = e.2.2.2.2.2.2.2.1 ;
  lift-id : E.LiftIdT subT-id = e.2.2.2.2.2.2.2.2.1 ;
  lift-o : E.LiftOT subT-o = e.2.2.2.2.2.2.2.2.2.1 ;
  p-lift : E.PLiftT = e.2.2.2.2.2.2.2.2.2.2.1 ;
  p-sec : E.PSecT = e.2.2.2.2.2.2.2.2.2.2.2.1 ;
  sec-o : E.SecOT = e.2.2.2.2.2.2.2.2.2.2.2.2.1 ;
  lift-p-sec-q : E.LiftPSecQT = e.2.2.2.2.2.2.2.2.2.2.2.2.2.1 ;
  q-lift : E.QLiftT subT-o p-lift = e.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 ;
  q-sec : E.QSecT subT-id subT-o p-sec = e.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 ;
  Pi-nat : E.PiNatT = e.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 ;
  Pi-iso-nat : E.PiIsoNatT Pi-nat = e.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 ;
  univ-nat : E.UnivNatT = e.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 ;
  decode-nat : E.DecodeNatT univ-nat = e.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 ;
  el-lf : E.ElLfT = e.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 ;
  el-pic : E.ElPicT = e.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 ;
  el-uc : E.ElUcT = e.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 ;
  lf-pic : E.LfPicT univ-nat el-lf = e.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 ;
  lf-uc : E.LfUcT = e.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 ;
  lf-lf : E.LfLfT = e.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 ;
  pic-nat : E.PicNatT univ-nat decode-nat = e.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 ;
  uc-nat : E.UcNatT univ-nat = e.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 ;
  lf-nat : E.LfNatT univ-nat = e.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2 ;

  iso (G : Ctx) (A : Ty G) (B : Ty (ext G A)) : Iso (El G (Pi G A B)) (El (ext G A) B) =
    new IsoData[El G (Pi G A B), El (ext G A) B,
      fun := fun G A B, inv := inv G A B,
      fun-inv := fun-inv G A B, inv-fun := inv-fun G A B] ;

  cwf : CwF[l] =
    new CwF[l,
      Ctx := Ctx, Sub := Sub, isSetSub := isSetSub, id := id, o := o,
      o-idl := o-idl, o-idr := o-idr, o-assoc := o-assoc,
      nil := nil, eps := eps, eps-uniq := eps-uniq,
      Ty := Ty, isSetTy := isSetTy, subT := subT, subT-id := subT-id, subT-o := subT-o,
      El := El, isSetEl := isSetEl, subt := subt, subt-id := subt-id, subt-o := subt-o,
      ext := ext, p := p, q := q, lift := lift, sec := sec,
      lift-id := lift-id, lift-o := lift-o, p-lift := p-lift, p-sec := p-sec,
      sec-o := sec-o, lift-p-sec-q := lift-p-sec-q,
      q-lift := q-lift, q-sec := q-sec] ;

  products : PiStr[l, cwf] =
    new PiStr[l, cwf, Pi := Pi, Pi-nat := Pi-nat, Pi-iso := iso, Pi-iso-nat := Pi-iso-nat] ;

  rec : EM.TEModel[N] =
    new EM.TEModel[N,
      cwf := cwf, isSetCtx := isSetCtx, products := products,
      univ := univ, univ-nat := univ-nat,
      decode := decode, decode-nat := decode-nat,
      pic := pic, uc := uc, lf := lf,
      el-lf := el-lf, el-pic := el-pic, el-uc := el-uc,
      lf-pic := lf-pic, lf-uc := lf-uc, lf-lf := lf-lf,
      pic-nat := pic-nat, uc-nat := uc-nat, lf-nat := lf-nat] ;
} ;

toRec (y : TEModelS) : EM.TEModel[N] = Y[y].rec ;

fromRec (M : EM.TEModel[N]) : TEModelS =
  ((M.cwf.Ctx, (M.cwf.Sub, (M.cwf.Ty, M.cwf.El))),
   ((M.isSetCtx, (M.cwf.isSetSub, (M.cwf.isSetTy, M.cwf.isSetEl))),
   ((M.cwf.nil, (M.cwf.id, (M.cwf.o, (M.cwf.eps, (M.cwf.subT, M.cwf.subt))))),
   ((M.cwf.ext, (M.cwf.p, (M.cwf.q, (M.cwf.lift, M.cwf.sec)))),
   ((M.products.Pi, (\ G A B -> (M.products.Pi-iso G A B).fun, (\ G A B -> (M.products.Pi-iso G A B).inv,
     (\ G A B -> (M.products.Pi-iso G A B).fun-inv, \ G A B -> (M.products.Pi-iso G A B).inv-fun)))),
   ((M.univ, (M.decode, (M.pic, (M.uc, M.lf)))),
   (M.cwf.o-idl, (M.cwf.o-idr, (M.cwf.o-assoc, (M.cwf.eps-uniq, (M.cwf.subT-id, (M.cwf.subT-o, (M.cwf.subt-id, (M.cwf.subt-o, (M.cwf.lift-id, (M.cwf.lift-o, (M.cwf.p-lift, (M.cwf.p-sec, (M.cwf.sec-o, (M.cwf.lift-p-sec-q, (M.cwf.q-lift, (M.cwf.q-sec, (M.products.Pi-nat, (M.products.Pi-iso-nat, (M.univ-nat, (M.decode-nat, (M.el-lf, (M.el-pic, (M.el-uc, (M.lf-pic, (M.lf-uc, (M.lf-lf, (M.pic-nat, (M.uc-nat, M.lf-nat)))))))))))))))))))))))))))))))))) ;

-- round trip
from-to (y : TEModelS) : Id TEModelS (fromRec (toRec y)) y = refl y ;

-- InitUALib.seg (PLAN-UAMOD, Phase 0): contraction lemmas, "centred" form:
-- a type A is contracted to a0 by  (u : A) -> Id A a0 u.
level l ;
open Base ; open Prelude[l] ;

Centred (A : U l) (a0 : A) : U l = (u : A) -> Id A a0 u ;

-- based path spaces (both orientations)
sing-l (A : U l) (a : A) : Centred ((b : A) * Id A a b) (a, refl a) = \ u ->
  idJ A a (\ b p -> Id ((b1 : A) * Id A a b1) (a, refl a) (b, p)) (refl (a, refl a)) u.1 u.2 ;

sing-r (A : U l) (a : A) : Centred ((b : A) * Id A b a) (a, refl a) = \ u ->
  idJ A u.1 (\ b p -> Id ((b1 : A) * Id A b1 b) (b, refl b) (u.1, p))
    (refl (u.1, refl u.1)) a u.2 ;

-- a Sigma over a centred base whose fibre at the centre is centred
sigma (A : U l) (F : A -> U l) (a0 : A) (hA : Centred A a0) (b0 : F a0) (hB : Centred (F a0) b0)
  : Centred ((a : A) * F a) (a0, b0) = \ u ->
  idJ A a0 (\ a p -> (b : F a) -> Id ((a1 : A) * F a1) (a0, b0) (a, b))
    (\ b -> ap (F a0) ((a1 : A) * F a1) (\ z -> (a0, z)) b0 b (hB b)) u.1 (hA u.1) u.2 ;

-- a product of centred types (function extensionality)
pi (fe : Axioms[l].FunExt) (A : U l) (F : A -> U l) (c : (a : A) -> F a)
    (h : (a : A) -> Centred (F a) (c a)) : Centred ((a : A) -> F a) c = \ f ->
  Axioms[l].FunExtLemmas[fe].funext A F c f (\ a -> h a (f a)) ;

-- choice (Pi over Sigma), both directions definitional
pi-sigma (A : U l) (F : A -> U l) (R : (a : A) -> F a -> U l)
    (u : (a : A) -> (b : F a) * R a b) : (f : (a : A) -> F a) * ((a : A) -> R a (f a)) =
  (\ a -> (u a).1, \ a -> (u a).2) ;
sigma-pi (A : U l) (F : A -> U l) (R : (a : A) -> F a -> U l)
    (w : (f : (a : A) -> F a) * ((a : A) -> R a (f a))) : (a : A) -> (b : F a) * R a b =
  \ a -> (w.1 a, w.2 a) ;

-- a retract of a centred type is centred (at the image of the centre)
retract (A B : U l) (s : A -> B) (r : B -> A) (rs : (a : A) -> Id A (r (s a)) a)
    (b0 : B) (hB : Centred B b0) : Centred A (r b0) = \ a ->
  trans A (r b0) (r (s a)) a (ap B A r b0 (s a) (hB (s a))) (rs a) ;

-- an inhabited proposition is centred
prop (A : U l) (pA : isProp A) (a0 : A) : Centred A a0 = \ u -> pA a0 u ;

-- heterogeneous Sigma (no cumulativity in the checker): base in U l+,
-- fibre in U l, only idJ used
sigmaH (A : U l+) (F : A -> U l) (a0 : A) (hA : (a : A) -> Id A a0 a) (b0 : F a0)
    (hB : Centred (F a0) b0) : (u : (a : A) * F a) -> Id ((a : A) * F a) (a0, b0) u = \ u ->
  idJ A a0 (\ a p -> (b : F a) -> Id ((a1 : A) * F a1) (a0, b0) (a, b))
    (\ b -> idJ (F a0) b0 (\ b1 q -> Id ((a1 : A) * F a1) (a0, b0) (a0, b1)) (refl (a0, b0)) b (hB b))
    u.1 (hA u.1) u.2 ;

-- Reindexing a precategory along an equivalence of object types is
-- equality, by univalence.  Specialized to the UNIT domain levels.
level l ;
open Base ; open Prelude[l++] ;
module K = Category[l++,l+] ;
module S = CategorySIP[l++,l+] ;
module UA = Axioms[l++].UnivalenceLemmas[ua @l++] ;

-- Equivalence induction into the universe needed for category structures.
eqind-high (A : U l+)
  (P : (B : U l+) -> Prelude[l+].Equiv A B -> U l+++)
  (d : P A (Prelude[l+].idEquiv A))
  (B : U l+) (e : Prelude[l+].Equiv A B) : P B e =
  Prelude[l+++].subst
    (Prelude[l+].Equiv A B) (P B)
    (Axioms[l+].idtoeqv A B
      (Axioms[l+].UnivalenceLemmas[ua @l+].ua A B e))
    e
    ((ua @l+ A B).sec-eq e)
    (idJ (U l+) A
      (\ X q -> P X (Axioms[l+].idtoeqv A X q))
      d B
      (Axioms[l+].UnivalenceLemmas[ua @l+].ua A B e)) ;

pullback (A B : U l++) (f : A -> B)
  (s : S.Structure[B]) : S.Structure[A] =
  new S.Structure[A,
    hom := \ x y -> s.hom (f x) (f y),
    hom-set := \ x y -> s.hom-set (f x) (f y),
    idn := \ x -> s.idn (f x),
    comp := \ x y z g h -> s.comp (f x) (f y) (f z) g h,
    unit-l := \ x y h -> s.unit-l (f x) (f y) h,
    unit-r := \ x y h -> s.unit-r (f x) (f y) h,
    assoc := \ w x y z f0 g h ->
      s.assoc (f w) (f x) (f y) (f z) f0 g h] ;

module Reindex (A : U l++) {
  Motive (B : U l++) (e : Equiv A B) : U l+++ =
    (s : S.Structure[B]) ->
      Id K.Precategory
        (S.to-pre A (pullback A B e.1 s))
        (S.to-pre B s) ;
  base : Motive A (idEquiv A) =
    split { Structure h hs i c ul ur a ->
      refl (new K.Precategory[A,h,hs,i,c,ul,ur,a]) } ;
  equality (B : U l++) (e : Equiv A B)
    (s : S.Structure[B]) :
    Id K.Precategory
      (S.to-pre A (pullback A B e.1 s))
      (S.to-pre B s) =
    UA.eqind A Motive base B e s ;
} ;

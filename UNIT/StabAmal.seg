-- Finiteness of Stab(C), layer 5: self-amalgamation of a decoded code
-- over a listed subobject (abstract catemb over a CEF).
--
-- For a subset T of the generators of K: X2 = Decode K x {L,R}, ordered
-- lexicographically (normal form first, then tag); w tags everything L,
-- w' tags L exactly the points whose generator is in T.  Both are
-- cartesian embeddings, they agree on Decode K|T, and a point of their
-- pull-back has its generator in T (its two tags agree), which gives the
-- map t from the pull-back to Decode K|T with t;sub = p1.
level l ;
open Base ; open Prelude[l+] ; open ScottOrder[l] ;
module W = Dilator[l] ;
module DP = DilPtyx[l] ;
module PF = PtyxFinite[l] ;
module CE = CatEmb[l] ;
module SF = StabFun[l] ;
module SP = StabPb[l] ;
module CF = CatEmbFin[l] ;
module SC = StabCode[l] ;
module FO = FinOrd[l] ;
module SSb = StabSub[l] ;
module PL = Prelude[l] ;
module TC = TruncationCombinators[l] ;

--------------------------------------------------------------------
-- lexicographic product of a linear order with Bool

cmpB : W.Bool -> W.Bool -> W.O3 = split {
  false -> split { false -> eq ; true -> lt } ;
  true -> split { false -> gt ; true -> eq } } ;
o3-ne (a b : W.O3) (h : Id W.Bool (PF.eqO a b) false) (e : Id W.O3 a b) : W.Empty =
  W.absurdB W.Empty (PL.trans W.Bool false (PF.eqO a b) true (PL.sym W.Bool (PF.eqO a b) false h)
    (PL.subst W.O3 (\ x -> Id W.Bool (PF.eqO a x) true) a b e (PF.eqO-refl a))) ;
cmpB-eq : (a b : W.Bool) -> Id W.O3 (cmpB a b) eq -> Id W.Bool a b = split {
  false -> split { false -> \ h -> refl false ; true -> \ h -> CF.efq (Id W.Bool false true) (o3-ne lt eq (refl false) h) } ;
  true -> split { false -> \ h -> CF.efq (Id W.Bool true false) (o3-ne gt eq (refl false) h) ; true -> \ h -> refl true } } ;
cmpB-refl : (a : W.Bool) -> Id W.O3 (cmpB a a) eq = split { false -> refl eq ; true -> refl eq } ;
cmpB-flip : (a b : W.Bool) -> Id W.O3 (cmpB b a) (W.flip (cmpB a b)) = split {
  false -> split { false -> refl eq ; true -> refl gt } ;
  true -> split { false -> refl lt ; true -> refl eq } } ;
cmpB-trans : (a b c : W.Bool) -> Id W.O3 (cmpB a b) lt -> Id W.O3 (cmpB b c) lt -> Id W.O3 (cmpB a c) lt = split {
  false -> split {
    false -> \ c h1 h2 -> CF.efq (Id W.O3 (cmpB false c) lt) (o3-ne eq lt (refl false) h1) ;
    true -> split { false -> \ h1 h2 -> CF.efq (Id W.O3 eq lt) (o3-ne gt lt (refl false) h2) ;
                    true -> \ h1 h2 -> CF.efq (Id W.O3 lt lt) (o3-ne eq lt (refl false) h2) } } ;
  true -> split {
    false -> \ c h1 h2 -> CF.efq (Id W.O3 (cmpB true c) lt) (o3-ne gt lt (refl false) h1) ;
    true -> \ c h1 h2 -> CF.efq (Id W.O3 (cmpB true c) lt) (o3-ne eq lt (refl false) h1) } } ;
lex-eq : (a b : W.O3) -> Id W.O3 (W.lexO3 a b) eq -> Id W.O3 a eq * Id W.O3 b eq = split {
  lt -> \ b h -> CF.efq (Id W.O3 lt eq * Id W.O3 b eq) (o3-ne lt eq (refl false) h) ;
  eq -> \ b h -> (refl eq,h) ;
  gt -> \ b h -> CF.efq (Id W.O3 gt eq * Id W.O3 b eq) (o3-ne gt eq (refl false) h) } ;
lex-flip : (a b : W.O3) -> Id W.O3 (W.lexO3 (W.flip a) (W.flip b)) (W.flip (W.lexO3 a b)) = split {
  lt -> \ b -> refl gt ; eq -> \ b -> refl (W.flip b) ; gt -> \ b -> refl lt } ;
lex-eqR : (a : W.O3) -> Id W.O3 (W.lexO3 a eq) a = split { lt -> refl lt ; eq -> refl eq ; gt -> refl gt } ;

module LexB (L : DP.LO) {
  Car : U l = L.car * W.Bool ;
  cmp (p q : Car) : W.O3 = W.lexO3 (L.cmp p.1 q.1) (cmpB p.2 q.2) ;
  ceq (p q : Car) (h : Id W.O3 (cmp p q) eq) : Id Car p q =
    W.prodEq L.car W.Bool p q (L.ceq p.1 q.1 (lex-eq (L.cmp p.1 q.1) (cmpB p.2 q.2) h).1) (cmpB-eq p.2 q.2 (lex-eq (L.cmp p.1 q.1) (cmpB p.2 q.2) h).2) ;
  crefl (p : Car) : Id W.O3 (cmp p p) eq =
    W.ap2 W.O3 W.O3 W.O3 W.lexO3 (L.cmp p.1 p.1) eq (cmpB p.2 p.2) eq (L.crefl p.1) (cmpB-refl p.2) ;
  cflip (p q : Car) : Id W.O3 (cmp q p) (W.flip (cmp p q)) =
    PL.trans W.O3 (cmp q p) (W.lexO3 (W.flip (L.cmp p.1 q.1)) (W.flip (cmpB p.2 q.2))) (W.flip (cmp p q))
      (W.ap2 W.O3 W.O3 W.O3 W.lexO3 (L.cmp q.1 p.1) (W.flip (L.cmp p.1 q.1)) (cmpB q.2 p.2) (W.flip (cmpB p.2 q.2))
        (L.cflip p.1 q.1) (cmpB-flip p.2 q.2))
      (lex-flip (L.cmp p.1 q.1) (cmpB p.2 q.2)) ;
  -- transitivity, by cases on the first comparisons
  Goal (p r : Car) : U l = Id W.O3 (cmp p r) lt ;
  ltL (p r : Car) (h : Id W.O3 (L.cmp p.1 r.1) lt) : Goal p r =
    PL.ap W.O3 W.O3 (\ o -> W.lexO3 o (cmpB p.2 r.2)) (L.cmp p.1 r.1) lt h ;
  tr (p q r : Car) : (o1 : W.O3) -> Id W.O3 (L.cmp p.1 q.1) o1 -> (o2 : W.O3) -> Id W.O3 (L.cmp q.1 r.1) o2 ->
      Id W.O3 (W.lexO3 o1 (cmpB p.2 q.2)) lt -> Id W.O3 (W.lexO3 o2 (cmpB q.2 r.2)) lt -> Goal p r = split {
    lt -> \ e1 -> split {
      lt -> \ e2 h1 h2 -> ltL p r (L.ctrans p.1 q.1 r.1 e1 e2) ;
      eq -> \ e2 h1 h2 -> ltL p r (PL.subst L.car (\ x -> Id W.O3 (L.cmp p.1 x) lt) q.1 r.1 (L.ceq q.1 r.1 e2) e1) ;
      gt -> \ e2 h1 h2 -> CF.efq (Goal p r) (o3-ne gt lt (refl false) h2) } ;
    eq -> \ e1 -> split {
      lt -> \ e2 h1 h2 -> ltL p r (PL.subst L.car (\ x -> Id W.O3 (L.cmp x r.1) lt) q.1 p.1 (PL.sym L.car p.1 q.1 (L.ceq p.1 q.1 e1)) e2) ;
      eq -> \ e2 h1 h2 ->
        PL.trans W.O3 (cmp p r) (W.lexO3 eq (cmpB p.2 r.2)) lt
          (PL.ap W.O3 W.O3 (\ o -> W.lexO3 o (cmpB p.2 r.2)) (L.cmp p.1 r.1) eq
            (PL.subst L.car (\ x -> Id W.O3 (L.cmp x r.1) eq) q.1 p.1 (PL.sym L.car p.1 q.1 (L.ceq p.1 q.1 e1)) e2))
          (cmpB-trans p.2 q.2 r.2 h1 h2) ;
      gt -> \ e2 h1 h2 -> CF.efq (Goal p r) (o3-ne gt lt (refl false) h2) } ;
    gt -> \ e1 o2 e2 h1 h2 -> CF.efq (Goal p r) (o3-ne gt lt (refl false) h1) } ;
  ctrans (p q r : Car) (h1 : Id W.O3 (cmp p q) lt) (h2 : Id W.O3 (cmp q r) lt) : Goal p r =
    tr p q r (L.cmp p.1 q.1) (refl (L.cmp p.1 q.1)) (L.cmp q.1 r.1) (refl (L.cmp q.1 r.1)) h1 h2 ;
  lo : DP.LO = new DP.LO[car := Car, cmp := cmp, ceq := ceq, crefl := crefl, cflip := cflip, ctrans := ctrans] ;
} ;

nb : W.Bool -> W.Bool = split { false -> true ; true -> false } ;
nb-false : (b : W.Bool) -> Id W.Bool false (nb b) -> Id W.Bool b true = split {
  false -> \ h -> W.absurdB (Id W.Bool false true) h ; true -> \ h -> refl true } ;

--------------------------------------------------------------------
-- the amalgamation

module Amal (F : CF.CEF) (K : SC.Code[F]) (j : W.N) {
  T : W.Wd = FO.bin K.m j ;
  module R = SSb.Restr[F,K,T,FO.len-bin K.m j] ;
  module DK = R.DK ;
  module DT = R.DT ;
  module O = SF.Over[F.C] ;
  G2 (A : F.C.Obj) : DP.LO = LexB[DK.Gt A].lo ;
  arr2 (A B : F.C.Obj) (h : F.C.Mor A B) : DP.Map (G2 A) (G2 B) =
    (\ p -> (DK.PP.post A B h p.1,p.2),
     \ p q -> PL.ap W.O3 W.O3 (\ o -> W.lexO3 o (cmpB p.2 q.2)) (DK.cmp B (DK.PP.post A B h p.1) (DK.PP.post A B h q.1)) (DK.cmp A p.1 q.1)
       ((DK.arr A B h).2 p.1 q.1)) ;
  module Stab2 (A B B' : F.C.Obj) (f : F.C.Mor B A) (f' : F.C.Mor B' A) (p : DK.Pt A * W.Bool)
    (r : SF.Im (G2 B) (G2 A) (arr2 B A f) p) (r' : SF.Im (G2 B') (G2 A) (arr2 B' A f') p) {
    P : F.C.Obj = F.C.pb A B B' f f' ;
    im1 : SF.Im (DK.Gt B) (DK.Gt A) (DK.arr B A f) p.1 =
      (r.1.1,PL.ap (DK.Pt A * W.Bool) (DK.Pt A) (\ x -> x.1) (DK.PP.post B A f r.1.1,r.1.2) p r.2) ;
    im2 : SF.Im (DK.Gt B') (DK.Gt A) (DK.arr B' A f') p.1 =
      (r'.1.1,PL.ap (DK.Pt A * W.Bool) (DK.Pt A) (\ x -> x.1) (DK.PP.post B' A f' r'.1.1,r'.1.2) p r'.2) ;
    st : SF.Im (DK.Gt P) (DK.Gt A) (DK.arr P A (F.C.comp P B A (F.C.p1 A B B' f f') f)) p.1 = DK.stab A B B' f f' p.1 im1 im2 ;
    result : SF.Im (G2 P) (G2 A) (arr2 P A (F.C.comp P B A (F.C.p1 A B B' f f') f)) p =
      ((st.1,p.2),PL.ap (DK.Pt A) (DK.Pt A * W.Bool) (\ x -> (x,p.2)) (DK.PP.post P A (F.C.comp P B A (F.C.p1 A B B' f f') f) st.1) p.1 st.2) ;
  } ;
  X2 : SF.SF[F.C] = new SF.SF[F.C, G := G2, arr := arr2,
    arr-id := \ A p -> PL.ap (DK.Pt A) (DK.Pt A * W.Bool) (\ x -> (x,p.2)) (DK.PP.post A A (F.C.idm A) p.1) p.1 (DK.arr-id A p.1),
    arr-comp := \ A B D f g0 p -> PL.ap (DK.Pt D) (DK.Pt D * W.Bool) (\ x -> (x,p.2))
      (DK.PP.post B D g0 (DK.PP.post A B f p.1)) (DK.PP.post A D (F.C.comp A B D f g0) p.1) (DK.arr-comp A B D f g0 p.1),
    cont := \ A p -> TC.map ((c : F.C.Fin) * ((i : F.C.Mor (F.C.fin c) A) * SF.Im (DK.Gt (F.C.fin c)) (DK.Gt A) (DK.arr (F.C.fin c) A i) p.1))
      ((c : F.C.Fin) * ((i : F.C.Mor (F.C.fin c) A) * SF.Im (G2 (F.C.fin c)) (G2 A) (arr2 (F.C.fin c) A i) p))
      (\ w -> (w.1,(w.2.1,((w.2.2.1,p.2),PL.ap (DK.Pt A) (DK.Pt A * W.Bool) (\ x -> (x,p.2)) (DK.PP.post (F.C.fin w.1) A w.2.1 w.2.2.1) p.1 w.2.2.2))))
      (DK.cont A p.1),
    stab := \ A B B' f f' p r r' -> Stab2[A,B,B',f,f',p,r,r'].result] ;
  -- the two embeddings
  tg (A : F.C.Obj) (p : DK.Pt A) : W.Bool = nb (W.at T p.1) ;
  keep (A : F.C.Obj) (p q : DK.Pt A) (b b' : W.Bool) (hb : Id W.O3 (DK.cmp A p q) eq -> Id W.Bool b b') :
      (o : W.O3) -> Id W.O3 (DK.cmp A p q) o -> Id W.O3 (W.lexO3 o (cmpB b b')) o = split {
    lt -> \ e -> refl lt ;
    eq -> \ e -> PL.subst W.Bool (\ x -> Id W.O3 (cmpB b x) eq) b b' (hb e) (cmpB-refl b) ;
    gt -> \ e -> refl gt } ;
  keep' (A : F.C.Obj) (p q : DK.Pt A) (b b' : W.Bool) (hb : Id W.O3 (DK.cmp A p q) eq -> Id W.Bool b b') :
      Id W.O3 (W.lexO3 (DK.cmp A p q) (cmpB b b')) (DK.cmp A p q) =
    keep A p q b b' hb (DK.cmp A p q) (refl (DK.cmp A p q)) ;
  mw (A : F.C.Obj) : DP.Map (DK.Gt A) (G2 A) = (\ p -> (p,false),\ p q -> lex-eqR (DK.cmp A p q)) ;
  mw' (A : F.C.Obj) : DP.Map (DK.Gt A) (G2 A) =
    (\ p -> (p,tg A p),\ p q -> keep' A p q (tg A p) (tg A q) (\ e -> PL.ap (DK.Pt A) W.Bool (tg A) p q (DK.ceq A p q e))) ;
  w : O.Mor DK.obj X2 =
    (\ c -> mw (F.C.fin c),
     (\ c d k p -> refl (DK.PP.post (F.C.fin c) (F.C.fin d) k p,false),
      \ c d k y r -> (r.1.1,PL.ap (DK.Pt (F.C.fin d) * W.Bool) (DK.Pt (F.C.fin d)) (\ x -> x.1) (DK.PP.post (F.C.fin c) (F.C.fin d) k r.1.1,r.1.2) (y,false) r.2))) ;
  w' : O.Mor DK.obj X2 =
    (\ c -> mw' (F.C.fin c),
     (\ c d k p -> refl (DK.PP.post (F.C.fin c) (F.C.fin d) k p,tg (F.C.fin c) p),
      \ c d k y r -> (r.1.1,PL.ap (DK.Pt (F.C.fin d) * W.Bool) (DK.Pt (F.C.fin d)) (\ x -> x.1)
        (DK.PP.post (F.C.fin c) (F.C.fin d) k r.1.1,r.1.2) (y,tg (F.C.fin d) y) r.2))) ;
  sq : Id (O.Mor DT.obj X2) (O.compS DT.obj DK.obj X2 R.sub w) (O.compS DT.obj DK.obj X2 R.sub w') =
    O.mor-eq DT.obj X2 (O.compS DT.obj DK.obj X2 R.sub w) (O.compS DT.obj DK.obj X2 R.sub w')
      (\ c p -> PL.ap W.Bool (DK.Pt (F.C.fin c) * W.Bool) (\ b -> (R.lift (F.C.fin c) p,nb b)) true (W.at T (W.sel T p.1))
        (PL.sym W.Bool (W.at T (W.sel T p.1)) true (W.at-sel T p.1 p.2.1))) ;

  -- the pull-back of w and w'
  module PB = SP.Pull[F.C,X2,DK.obj,DK.obj,w,w'] ;
  pre (c : F.C.Fin) (i : W.N) (hi : CF.Lt i R.mT) (n3 : W.N) (e3 : Id W.N (W.sel T i) n3) :
      (hn : CF.Lt n3 K.m) (f3 : F.C.Mor (F.C.fin (K.gen n3)) (F.C.fin c)) ->
      Id (DK.Pt (F.C.fin c)) (R.lift (F.C.fin c) (i,(hi,PL.subst W.N (\ x -> F.C.Mor (F.C.fin (K.gen x)) (F.C.fin c)) n3 (W.sel T i) (PL.sym W.N (W.sel T i) n3 e3) f3)))
        (n3,(hn,f3)) =
    idJ W.N (W.sel T i) (\ n4 e4 -> (hn : CF.Lt n4 K.m) (f3 : F.C.Mor (F.C.fin (K.gen n4)) (F.C.fin c)) ->
        Id (DK.Pt (F.C.fin c)) (R.lift (F.C.fin c) (i,(hi,PL.subst W.N (\ x -> F.C.Mor (F.C.fin (K.gen x)) (F.C.fin c)) n4 (W.sel T i) (PL.sym W.N (W.sel T i) n4 e4) f3)))
          (n4,(hn,f3)))
      (\ hn f3 -> PL.ap (CF.Lt (W.sel T i) K.m) (DK.Pt (F.C.fin c)) (\ u -> (W.sel T i,(u,f3))) (R.ltl i hi) hn (W.HB.uip (W.ltN (W.sel T i) K.m) true (R.ltl i hi) hn))
      n3 e3 ;
  module PtT (c : F.C.Fin) (p : PB.Car (F.C.fin c)) {
    Fc : F.C.Obj = F.C.fin c ;
    ef : Id (DK.Pt Fc * W.Bool) (p.1,false) (p.2.1,tg Fc p.2.1) =
      PL.trans (DK.Pt Fc * W.Bool) (p.1,false) (PB.s Fc p.1) (p.2.1,tg Fc p.2.1)
        (PL.sym (DK.Pt Fc * W.Bool) (PB.s Fc p.1) (p.1,false) (PB.E.fin-eq c p.1))
        (PL.trans (DK.Pt Fc * W.Bool) (PB.s Fc p.1) (PB.s' Fc p.2.1) (p.2.1,tg Fc p.2.1) p.2.2 (PB.E'.fin-eq c p.2.1)) ;
    ey : Id (DK.Pt Fc) p.1 p.2.1 = PL.ap (DK.Pt Fc * W.Bool) (DK.Pt Fc) (\ x -> x.1) (p.1,false) (p.2.1,tg Fc p.2.1) ef ;
    inT : Id W.Bool (W.at T p.1.1) true =
      PL.subst (DK.Pt Fc) (\ x -> Id W.Bool (W.at T x.1) true) p.2.1 p.1 (PL.sym (DK.Pt Fc) p.1 p.2.1 ey)
        (nb-false (W.at T p.2.1.1) (PL.ap (DK.Pt Fc * W.Bool) W.Bool (\ x -> x.2) (p.1,false) (p.2.1,tg Fc p.2.1) ef)) ;
    i : W.N = W.rank T p.1.1 ;
    hi : CF.Lt i R.mT = W.rank-lt T p.1.1 inT ;
    es : Id W.N (W.sel T i) p.1.1 = W.sel-rank T p.1.1 inT ;
    pt : DT.Pt Fc = (i,(hi,PL.subst W.N (\ x -> F.C.Mor (F.C.fin (K.gen x)) Fc) p.1.1 (W.sel T i) (PL.sym W.N (W.sel T i) p.1.1 es) p.1.2.2)) ;
    el : Id (DK.Pt Fc) (R.lift Fc pt) p.1 = pre c i hi p.1.1 es p.1.2.1 p.1.2.2 ;
  } ;
  tmap (c : F.C.Fin) : DP.Map (PB.G (F.C.fin c)) (DT.Gt (F.C.fin c)) =
    (\ p -> PtT[c,p].pt,
     \ p q -> PL.trans W.O3 (DT.cmp (F.C.fin c) PtT[c,p].pt PtT[c,q].pt) (DK.cmp (F.C.fin c) (R.lift (F.C.fin c) PtT[c,p].pt) (R.lift (F.C.fin c) PtT[c,q].pt))
         (DK.cmp (F.C.fin c) p.1 q.1)
       (PL.sym W.O3 (DK.cmp (F.C.fin c) (R.lift (F.C.fin c) PtT[c,p].pt) (R.lift (F.C.fin c) PtT[c,q].pt)) (DT.cmp (F.C.fin c) PtT[c,p].pt PtT[c,q].pt)
         ((R.mmap c).2 PtT[c,p].pt PtT[c,q].pt))
       (W.ap2 (DK.Pt (F.C.fin c)) (DK.Pt (F.C.fin c)) W.O3 (DK.cmp (F.C.fin c)) (R.lift (F.C.fin c) PtT[c,p].pt) p.1 (R.lift (F.C.fin c) PtT[c,q].pt) q.1
         PtT[c,p].el PtT[c,q].el)) ;
  tnat : O.Nat PB.obj DT.obj tmap = \ c d k p ->
    R.LI[F.C.fin d,DT.PP.post (F.C.fin c) (F.C.fin d) k PtT[c,p].pt,PtT[d,(PB.arr (F.C.fin c) (F.C.fin d) k).1 p].pt,
      PL.trans (DK.Pt (F.C.fin d)) (DK.PP.post (F.C.fin c) (F.C.fin d) k (R.lift (F.C.fin c) PtT[c,p].pt)) (DK.PP.post (F.C.fin c) (F.C.fin d) k p.1)
          (R.lift (F.C.fin d) PtT[d,(PB.arr (F.C.fin c) (F.C.fin d) k).1 p].pt)
        (PL.ap (DK.Pt (F.C.fin c)) (DK.Pt (F.C.fin d)) (DK.PP.post (F.C.fin c) (F.C.fin d) k) (R.lift (F.C.fin c) PtT[c,p].pt) p.1 PtT[c,p].el)
        (PL.sym (DK.Pt (F.C.fin d)) (R.lift (F.C.fin d) PtT[d,(PB.arr (F.C.fin c) (F.C.fin d) k).1 p].pt) (DK.PP.post (F.C.fin c) (F.C.fin d) k p.1)
          PtT[d,(PB.arr (F.C.fin c) (F.C.fin d) k).1 p].el)].result ;
  module TCart (c d : F.C.Fin) (k : F.C.Mor (F.C.fin c) (F.C.fin d)) (y : PB.Car (F.C.fin d))
    (r : SF.Im (DT.Gt (F.C.fin c)) (DT.Gt (F.C.fin d)) (DT.arr (F.C.fin c) (F.C.fin d) k) PtT[d,y].pt) {
    Fc : F.C.Obj = F.C.fin c ;
    z : DK.Pt Fc = R.lift Fc r.1 ;
    ez : Id (DK.Pt Fc * W.Bool) (PB.s Fc z) (PB.s' Fc z) =
      PL.trans (DK.Pt Fc * W.Bool) (PB.s Fc z) (z,false) (PB.s' Fc z) (PB.E.fin-eq c z)
        (PL.trans (DK.Pt Fc * W.Bool) (z,false) (z,tg Fc z) (PB.s' Fc z)
          (PL.ap W.Bool (DK.Pt Fc * W.Bool) (\ b -> (z,nb b)) true (W.at T (W.sel T r.1.1)) (PL.sym W.Bool (W.at T (W.sel T r.1.1)) true (W.at-sel T r.1.1 r.1.2.1)))
          (PL.sym (DK.Pt Fc * W.Bool) (PB.s' Fc z) (z,tg Fc z) (PB.E'.fin-eq c z))) ;
    q : PB.Car Fc = (z,(z,ez)) ;
    result : SF.Im (PB.G Fc) (PB.G (F.C.fin d)) (PB.arr Fc (F.C.fin d) k) y =
      (q,PB.peq (F.C.fin d) ((PB.arr Fc (F.C.fin d) k).1 q) y
        (PL.trans (DK.Pt (F.C.fin d)) (DK.PP.post Fc (F.C.fin d) k z) (R.lift (F.C.fin d) PtT[d,y].pt) y.1
          (PL.ap (DT.Pt (F.C.fin d)) (DK.Pt (F.C.fin d)) (R.lift (F.C.fin d)) (DT.PP.post Fc (F.C.fin d) k r.1) PtT[d,y].pt r.2)
          PtT[d,y].el)) ;
  } ;
  t : O.Mor PB.obj DT.obj = (tmap,(tnat,\ c d k y r -> TCart[c,d,k,y,r].result)) ;
  tp : Id (O.Mor PB.obj DK.obj) (O.compS PB.obj DT.obj DK.obj t R.sub) PB.pr1 =
    O.mor-eq PB.obj DK.obj (O.compS PB.obj DT.obj DK.obj t R.sub) PB.pr1 (\ c p -> PtT[c,p].el) ;
} ;

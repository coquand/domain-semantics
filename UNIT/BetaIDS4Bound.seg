-- PLAN-ID1: the boundary test for atomic cuts.  A concrete accessible input
-- family whose root is a cut on I^{top_Y}(t) (the stage label read by the
-- atom IS top_Y, where the strict below-top test changes branch), both
-- premises closing on a true arithmetic atom.  It satisfies the public
-- input condition (the cut is represented as Phi-bar, not below top), so
-- the pointwise theorem, homogeneity and the diagonal law apply to it.
--   k Y = (0 + Y) + (1 + 0), sigma = id, km f = (id + f) + id;
--   R Y [] = cut on xF true 0 1 in the environment (0, top_Y), (0, 0);
--   R Y (a :: zs) = ax 0;   G Y = [atF b0 0], b0 = ev 1 0 [].
level l ;
open Base ; open Prelude[l+] ; open ScottOrder[l] ;
module W = Dilator[l] ;
module DP = DilPtyx[l] ;
module CF = CatEmbFin[l] ;
module PL = Prelude[l] ;
module LT = LabTree[l] ;
module LC = LOCat[l] ;
module PS = PtyxSum[l] ;
module LW = LOWF[l] ;
module BP = BetaProof[l] ;
module BI = BetaID[l] ;
module BO = BetaIDCfOps[l] ;
module BA = BetaAcc[l] ;
module BT0 = BetaIDTr[l] ;
module S4 = BetaIDS4[l] ;

eqBoR : (b : W.Bool) -> Id W.Bool (BP.eqBo b b) true = split { false -> refl true ; true -> refl true } ;

module Ex (ev : (A : DP.LO) -> W.N -> LT.LL A -> W.Bool) (phi : BI.Form) (evN : S4.EvN ev)
  (hPos : Id W.Bool (BO.posX phi zero) true) {
  module I = BI.ID[ev,phi] ;
  module O = S4.Obj[ev,phi,evN] ;
  module SS = S4.SSteps[ev,phi,evN] ;
  Fp (Y : DP.LO) : DP.LO = BA.E0 ;
  T : DP.LO = S4.Sm LT.one BA.E0 ;
  K (Y : DP.LO) : DP.LO = O.P BA.E0 Fp Y ;
  kmK (X Y : DP.LO) (f : DP.Map X Y) : DP.Map (K X) (K Y) =
    PS.SumMap[S4.Sm BA.E0 X,T,S4.Sm BA.E0 Y,T,O.smapC BA.E0 X Y f,LC.idMap T].map ;
  topK (Y : DP.LO) : (K Y).car = O.tp BA.E0 Fp Y ;
  b0 : W.Bool = ev LT.one zero nilL ;
  atom (A : DP.LO) : I.Clo A = (atF b0 zero,nilL) ;
  GK (Y : DP.LO) : I.Seq (K Y) = consL (atom (K Y)) nilL ;
  -- the cut formula I^{s}(t), s = position 0, t = position 1
  f0 : BI.Form = xF true zero (suc zero) ;
  envK (Y : DP.LO) : LT.LL (K Y) = consL (zero,inr (topK Y)) (consL (zero,inl tt) nilL) ;
  RK (Y : DP.LO) : I.Rl (K Y) = split { nilL -> cutR f0 (envK Y) ; consL a zs -> axR zero } ;
  -- the arithmetic atom is an axiom at every order (EvN)
  axK (Y : DP.LO) : Id W.Bool (BP.eqBo (ev (K Y) zero nilL) b0) true =
    PL.trans W.Bool (BP.eqBo (ev (K Y) zero nilL) b0) (BP.eqBo b0 b0) true
      (PL.ap W.Bool W.Bool (\ b -> BP.eqBo b b0) (ev (K Y) zero nilL) b0 (evN (K Y) LT.one zero nilL nilL (refl nilL))) (eqBoR b0) ;
  loT (Y : DP.LO) (a : I.Lb (K Y)) : (ys : LT.LL (K Y)) ->
      Id W.Bool (I.inTree (K Y) (topK Y) (consL a ys) (RK Y) (GK Y)) true ->
      Id W.Bool (I.appl (K Y) (I.seqAt (K Y) (consL a ys) (RK Y) (GK Y)) (RK Y (consL a ys))) true = split {
    nilL -> \ h -> axK Y ;
    consL a' ys' -> \ h -> W.absurdB (Id W.Bool (I.appl (K Y) (I.seqAt (K Y) (consL a (consL a' ys')) (RK Y) (GK Y)) (axR zero)) true)
      (W.andB-r (I.br (K Y) (topK Y) (cutR f0 (envK Y)) a) false h) } ;
  loK (Y : DP.LO) : I.LocOK (K Y) (topK Y) (RK Y) (GK Y) = split {
    nilL -> \ h -> refl true ;
    consL a ys -> \ h -> loT Y a ys h } ;
  -- THE BOUNDARY: the cut is represented as Phi-bar, and is not below top
  topRB (Y : DP.LO) : S4.RepBar ev phi (K Y) (topK Y) (inr (topK Y)) =
    PL.ap W.O3 W.Bool W.isLt ((K Y).cmp (topK Y) (topK Y)) eq ((K Y).crefl (topK Y)) ;
  notLow (Y : DP.LO) (h : O.StLow (K Y) (topK Y) f0 (envK Y)) : W.Empty = O.lowRep (K Y) (topK Y) (inr (topK Y)) h (topRB Y) ;
  kdK (Y : DP.LO) : (zs : LT.LL (K Y)) -> Id W.Bool (I.inTree (K Y) (topK Y) zs (RK Y) (GK Y)) true -> O.KindOK (K Y) (topK Y) (RK Y zs) = split {
    nilL -> \ h -> inr (topRB Y) ;
    consL a zs -> \ h -> tt } ;
  nrK (X Y : DP.LO) (f : DP.Map X Y) : (zs : LT.LL (K X)) ->
      Id (I.Rule (K Y)) (RK Y (LT.mapL (K X) (K Y) (kmK X Y f) zs))
        (BT0.Mp[ev,phi,K X,K Y,kmK X Y f,S4.evMap ev evN (K X) (K Y) (kmK X Y f),topK X].mR (RK X zs)) = split {
    nilL -> refl (cutR f0 (envK Y)) ;
    consL a zs -> refl (axR zero) } ;
  o : O.IObj = new O.IObj[k := K, km := kmK, Cst := BA.E0, Fp := Fp,
    sg := \ Y -> LC.idMap (K Y), sgi := \ Y -> LC.idMap (K Y),
    sec := \ Y p -> refl p, ret := \ Y q -> refl q,
    natS := \ X Y f w -> refl (inl ((O.smapC BA.E0 X Y f).1 w)),
    ntop := \ X Y f -> refl (topK Y),
    wC := BA.wfE0, wF := \ Y w -> BA.wfE0,
    G := GK, R := RK,
    ng := \ X Y f -> refl (GK Y),
    nr := nrK,
    lo := loK, kd := kdK] ;
  -- accessibility: every predecessor has an axiom at its root, so has no predecessor
  brAbs (A : DP.LO) (tp : A.car) (R : I.Rl A) (G : I.Seq A) (a : I.Lb A) (h : Id (I.Rule A) (R nilL) (axR zero))
      (nd : Id W.Bool (I.inTree A tp (consL a nilL) R G) true) : W.Empty =
    W.absurdB W.Empty (PL.trans W.Bool false (I.inTree A tp (consL a nilL) R G) true
      (PL.ap (I.Rule A) W.Bool (\ r -> W.andB (I.br A tp r a) true) (axR zero) (R nilL) (PL.sym (I.Rule A) (R nilL) (axR zero) h)) nd) ;
  emptyIf (x : O.IObj) (hx : (Y : DP.LO) -> Id (I.Rule (x.k Y)) (x.R Y nilL) (axR zero)) : (s : SS.Step x) -> W.Empty = split {
    inl st -> brAbs (x.k BA.E0) (O.topO x BA.E0) (x.R BA.E0) (x.G BA.E0) (st.1 BA.E0) (hx BA.E0) (st.2.2 BA.E0) ;
    inr st -> brAbs (x.k (S4.Sm st.1 BA.E0)) (O.topO x (S4.Sm st.1 BA.E0)) (x.R (S4.Sm st.1 BA.E0)) (x.G (S4.Sm st.1 BA.E0))
      (st.2.2.1 BA.E0) (hx (S4.Sm st.1 BA.E0)) (st.2.2.2.2 BA.E0) } ;
  leafAx : (s : SS.Step o) (Y : DP.LO) -> Id (I.Rule ((SS.shiftO o s).k Y)) ((SS.shiftO o s).R Y nilL) (axR zero) = split {
    inl st -> \ Y -> refl (axR zero) ;
    inr st -> \ Y -> refl (axR zero) } ;
  ac : SS.AccI o = SS.AO.acc o (\ s -> SS.AO.acc (SS.shiftO o s) (\ s' -> S4.efq1 (SS.AccI (SS.shiftO (SS.shiftO o s) s')) (emptyIf (SS.shiftO o s) (leafAx s) s'))) ;
  -- the km identity law holds
  kmL (Z : DP.LO) : (w : (S4.Sm BA.E0 Z).car) -> Id (K Z).car (inl ((O.smapC BA.E0 Z Z (LC.idMap Z)).1 w)) (inl w) = split {
    inl x -> CF.efq (Id (K Z).car (inl ((O.smapC BA.E0 Z Z (LC.idMap Z)).1 (inl x))) (inl (inl x))) x ;
    inr z -> refl (inl (inr z)) } ;
  hk : (Z : DP.LO) (p : (K Z).car) -> Id (K Z).car ((kmK Z Z (LC.idMap Z)).1 p) p = \ Z -> split {
    inl w -> kmL Z w ; inr t -> refl (inr t) } ;
  -- THE THEOREMS AT THE BOUNDARY
  module H = BetaIDS4HomFin[l].Hom[ev,phi,evN,hPos] ;
  module Fn = BetaIDS4Diag[l].Fin[ev,phi,evN,hPos] ;
  out (Y : DP.LO) (wY : LW.WF Y) : S4.OutM[ev,phi,K Y,topK Y].Out (GK Y) = S4.Thm[ev,phi,evN,hPos].thm o ac Y wY ;
  hom (Y Y' : DP.LO) (wY : LW.WF Y) (wY' : LW.WF Y') (f : DP.Map Y Y') :
      BetaIDS4HomThm[l].Stmt[ev,phi,evN,hPos].HomOut (K Y) (K Y') (topK Y) (topK Y')
        (BetaIDS4HomThm[l].Stmt[ev,phi,evN,hPos].baseF o o (H.tauId o) Y Y' f)
        (BetaIDS4HomThm[l].Stmt[ev,phi,evN,hPos].baseTop o o (LC.idMap BA.E0) (H.tauId o) (H.relId o) Y Y' f)
        (GK Y) (GK Y') (out Y wY) (out Y' wY') =
    H.homSame o ac ac Y Y' wY wY' f ;
  diag (Y : DP.LO) (wY : LW.WF Y) (z : (out Y wY).1.car) :
      Id (out Y wY).1.car ((H.hom o o (LC.idMap BA.E0) (H.tauId o) (H.relId o) ac ac Y Y wY wY (LC.idMap Y)).1.1 z) z =
    Fn.diagId o ac (LC.idMap BA.E0) (H.tauId o) (H.relId o) Y wY (LC.idMap Y) (\ Z p -> hk Z p)
      (\ w -> refl w) (\ Z p -> refl p) (\ y -> refl y) z ;
} ;

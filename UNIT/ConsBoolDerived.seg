-- ConsBoolDerived.seg: GENERATED by PRA/translate_cons.py, do not edit.
-- The Cons lemmas of Consistency.seg after `opaque Cons`, with Cons
-- replaced by CB (ConsBool.seg) and its interface by the twins.

level l ;
open Base ; open Prelude[l] ; open Lib[l] ; open Types[l] ; open Consistency[l] ; open ConsBool[l] ;

cbt-down (x y : Ty) (h : Le x y) (c : CB x) : CB y = cb-down-s x y (le-les x y h) c ;

cbt-clash (r : Ty) (c : CB r) (f g : Ty) (hu : Sel r univ) (hp : Sel r (pi f g)) : Empty =
  cl-up CB r (cb-fix-to r c) f g hu hp ;

cbt-psel (r s t : Ty) (c : CB r) (q : PSel r s t) : CB s * CB t =
  cl-ps CB r (cb-fix-to r c) s t q ;

cbt-asel (r d t : Ty) (c : CB r) (q : ASel r d t) (cd : CB d) : CB t =
  cl-as CB r (cb-fix-to r c) d t q cd ;

cbt-meet-l (x y : Ty) (c : CB (meet x y)) : CB x = cbt-down (meet x y) x (le-meet-l x y) c ;

cbt-pi (a b : Ty) (ca : CB a) (cb : CB b) : CB (pi a b) =
  cb-fix-from (pi a b)
    (\ f g hu hp -> sel-all PiShape (pi a b) univ hu tt,
     (\ d t hu q x -> efq (sel-all PiShape (pi a b) univ hu tt),
     (\ f g d t hp q x -> om-les-omonly t (asel-noarr (pi a b) d t q tt),
     (\ s t q -> (cb-down-s a s (psel-parts (pi a b) s t q).1 ca,
                  cb-down-s b t (psel-parts (pi a b) s t q).2 cb),
      \ d t q x -> cb-down-s om t (om-les-omonly t (asel-noarr (pi a b) d t q tt)) cb-om)))) ;

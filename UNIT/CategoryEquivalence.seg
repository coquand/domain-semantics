-- A categorical equivalence as two functors and two natural isomorphisms.
-- Both categories are univalent; triangle identities are not required for
-- the usual quasi-inverse notion of equivalence.
level k l ;
open Base ;
module K = Category[k,l] ;

record Functor (C D : K.Precategory) {
  object : C.ob -> D.ob ;
  arrow (x y : C.ob) : C.hom x y -> D.hom (object x) (object y) ;
  identity (x : C.ob) : Id (D.hom (object x) (object x))
    (arrow x x (C.idn x)) (D.idn (object x)) ;
  composition (x y z : C.ob) (f : C.hom x y) (g : C.hom y z) :
    Id (D.hom (object x) (object z))
      (arrow x z (C.comp x y z g f))
      (D.comp (object x) (object y) (object z)
        (arrow y z g) (arrow x y f)) ;
} ;

record Equivalence (C D : K.Category) {
  forward : Functor[C.pre,D.pre] ;
  backward : Functor[D.pre,C.pre] ;
  unit-source (x : C.pre.ob) :
    C.pre.Iso x (backward.object (forward.object x)) ;
  source-natural (x y : C.pre.ob) (f : C.pre.hom x y) :
    Id (C.pre.hom x (backward.object (forward.object y)))
      (C.pre.comp x
        (backward.object (forward.object x))
        (backward.object (forward.object y))
        (backward.arrow (forward.object x) (forward.object y)
          (forward.arrow x y f))
        (unit-source x).1)
      (C.pre.comp x y (backward.object (forward.object y))
        (unit-source y).1 f) ;
  unit-target (x : D.pre.ob) :
    D.pre.Iso x (forward.object (backward.object x)) ;
  target-natural (x y : D.pre.ob) (f : D.pre.hom x y) :
    Id (D.pre.hom x (forward.object (backward.object y)))
      (D.pre.comp x
        (forward.object (backward.object x))
        (forward.object (backward.object y))
        (forward.arrow (backward.object x) (backward.object y)
          (backward.arrow x y f))
        (unit-target x).1)
      (D.pre.comp x y (forward.object (backward.object y))
        (unit-target y).1 f) ;
} ;

-- The same data for precategories; no univalence is required for
-- transporting universal properties.
record PreEquivalence (C D : K.Precategory) {
  forward : Functor[C,D] ;
  backward : Functor[D,C] ;
  unit-source (x : C.ob) :
    C.Iso x (backward.object (forward.object x)) ;
  source-natural (x y : C.ob) (f : C.hom x y) :
    Id (C.hom x (backward.object (forward.object y)))
      (C.comp x (backward.object (forward.object x))
        (backward.object (forward.object y))
        (backward.arrow (forward.object x) (forward.object y)
          (forward.arrow x y f)) (unit-source x).1)
      (C.comp x y (backward.object (forward.object y))
        (unit-source y).1 f) ;
  unit-target (x : D.ob) :
    D.Iso x (forward.object (backward.object x)) ;
  target-natural (x y : D.ob) (f : D.hom x y) :
    Id (D.hom x (forward.object (backward.object y)))
      (D.comp x (forward.object (backward.object x))
        (forward.object (backward.object y))
        (forward.arrow (backward.object x) (backward.object y)
          (backward.arrow x y f)) (unit-target x).1)
      (D.comp x y (forward.object (backward.object y))
        (unit-target y).1 f) ;
} ;

reverse (C D : K.Precategory)
  (e : PreEquivalence[C,D]) : PreEquivalence[D,C] =
  new PreEquivalence[D,C,
    forward := e.backward,
    backward := e.forward,
    unit-source := e.unit-target,
    source-natural := e.target-natural,
    unit-target := e.unit-source,
    target-natural := e.source-natural] ;

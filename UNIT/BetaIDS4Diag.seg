-- PLAN-ID1, diagonal identity law for S4 homogeneity: the first
-- projection of BetaIDS4HomFin.Hom.hom fixes every element of the
-- computed extension when o' = o, ac' = ac, Y' = Y, wY' = wY and
-- c, tau_Z, f are pointwise identities, given the pointwise km identity
-- law (a clean sufficient hypothesis; minimality open).
--
-- Wrap: the accessibility wrapper (the shared Good root equation is
-- eliminated once).  Fin: the node law from BetaIDS4DiagNode (dispatcher),
-- DiagReg (kept rules), DiagRbK3 ((r-bar), kind III), DiagXl ((xl)
-- stages), and THE THEOREM Fin.diagId.
level l ;
open Base ; open Prelude[l+] ; open ScottOrder[l] ;
module P1 = Prelude[l+] ;
module W = Dilator[l] ;
module DP = DilPtyx[l] ;
module PL = Prelude[l] ;
module LT = LabTree[l] ;
module LC = LOCat[l] ;
module LW = LOWF[l] ;
module BI = BetaID[l] ;
module BO = BetaIDCfOps[l] ;
module S4 = BetaIDS4[l] ;
module SH = BetaIDS4Hom[l] ;
module HT = BetaIDS4HomThm[l] ;

module Wrap (ev : (A : DP.LO) -> W.N -> LT.LL A -> W.Bool) (phi : BI.Form) (evN : S4.EvN ev)
  (hPos : Id W.Bool (BO.posX phi zero) true) (nodeH : HT.Stmt[ev,phi,evN,hPos].NodeT) {
  module I = BI.ID[ev,phi] ;
  module O = S4.Obj[ev,phi,evN] ;
  module ST = HT.Stmt[ev,phi,evN,hPos] ;
  module SS = ST.SS ;
  module R = SH.Rel[ev,phi,evN] ;
  module IT = ST.Ind[nodeH] ;
  module A = SS.AO ;
  -- the pointwise hypotheses
  module DD = BetaIDS4DiagBase[l].DB[ev,phi,evN,hPos] ;
  KmId (x : O.IObj) : U l+ = DD.KmId x ;
  CId (x : O.IObj) (c : DP.Map x.Cst x.Cst) : U l = DD.CId x c ;
  TId (x : O.IObj) (tau : (Z : DP.LO) -> DP.Map (x.k Z) (x.k Z)) : U l+ = DD.TId x tau ;
  FId (Y : DP.LO) (f : DP.Map Y Y) : U l = DD.FId Y f ;
  -- the diagonal statement for a tree
  DiagT (t : A.AT) : U l+ = (x : O.IObj) (g : A.Good t x) (c : DP.Map x.Cst x.Cst) (tau : (Z : DP.LO) -> DP.Map (x.k Z) (x.k Z))
    (rl : R.RelIn x x c tau) (Y : DP.LO) (wY : LW.WF Y) (f : DP.Map Y Y) ->
    KmId x -> CId x c -> TId x tau -> FId Y f ->
    (z : (IT.ev0 t x g Y wY).1.car) -> Id (IT.ev0 t x g Y wY).1.car ((IT.goalT t x g x t g c tau rl Y Y wY wY f).1.1 z) z ;
  -- the diagonal statement at a node, for the comparison nodes computes
  NodeDiag (x0 : O.IObj) (fs : (s : SS.Step x0) -> A.AT) (g2 : (s : SS.Step x0) -> A.Good (fs s) (SS.shiftO x0 s)) : U l+ =
    (c : DP.Map x0.Cst x0.Cst) (tau : (Z : DP.LO) -> DP.Map (x0.k Z) (x0.k Z))
    (rl : R.RelIn x0 x0 c tau) (Y : DP.LO) (wY : LW.WF Y) (f : DP.Map Y Y) ->
    KmId x0 -> CId x0 c -> TId x0 tau -> FId Y f ->
    (z : (ST.stp x0 (\ s -> IT.ev0 (fs s) (SS.shiftO x0 s) (g2 s)) Y wY).1.car) ->
    Id (ST.stp x0 (\ s -> IT.ev0 (fs s) (SS.shiftO x0 s) (g2 s)) Y wY).1.car
      ((IT.nodes x0 fs (\ s -> IT.goalT (fs s)) g2 x0 fs g2 c tau rl Y Y wY wY f).1.1 z) z ;
  -- the shared root equation, eliminated once with both occurrences
  module Root (x0 : O.IObj) (fs : (s : SS.Step x0) -> A.AT) (g2 : (s : SS.Step x0) -> A.Good (fs s) (SS.shiftO x0 s))
      (nd : NodeDiag x0 fs g2) {
    M (x : O.IObj) (e : Id O.IObj x0 x) : U l+ = (c : DP.Map x.Cst x.Cst) (tau : (Z : DP.LO) -> DP.Map (x.k Z) (x.k Z))
      (rl : R.RelIn x x c tau) (Y : DP.LO) (wY : LW.WF Y) (f : DP.Map Y Y) ->
      KmId x -> CId x c -> TId x tau -> FId Y f ->
      (z : (P1.subst O.IObj ST.Q x0 x e (ST.stp x0 (\ s -> IT.ev0 (fs s) (SS.shiftO x0 s) (g2 s))) Y wY).1.car) ->
      Id (P1.subst O.IObj ST.Q x0 x e (ST.stp x0 (\ s -> IT.ev0 (fs s) (SS.shiftO x0 s) (g2 s))) Y wY).1.car
        ((IT.srcJ x0 fs (\ s -> IT.goalT (fs s)) g2 x0 fs g2 x e x e c tau rl Y Y wY wY f).1.1 z) z ;
    root (x : O.IObj) (e : Id O.IObj x0 x) : M x e = idJ O.IObj x0 (\ z q -> M z q) nd x e ;
  } ;
  -- the accessibility wrapper: DiagT from NodeDiag at every node
  module Lift (ndAll : (x0 : O.IObj) (fs : (s : SS.Step x0) -> A.AT) (g2 : (s : SS.Step x0) -> A.Good (fs s) (SS.shiftO x0 s)) ->
      ((s : SS.Step x0) -> DiagT (fs s)) -> NodeDiag x0 fs g2) {
    diag : (t : A.AT) -> DiagT t = split {
      node x0 fs | r -> \ x g -> Root[x0,fs,g.2,ndAll x0 fs g.2 r].root x g.1 } ;
    -- the finish-line form for hom
    thm (o : O.IObj) (ac : SS.AccI o) (c : DP.Map o.Cst o.Cst) (tau : (Z : DP.LO) -> DP.Map (o.k Z) (o.k Z))
      (rl : R.RelIn o o c tau) (Y : DP.LO) (wY : LW.WF Y) (f : DP.Map Y Y)
      (hk : KmId o) (hc : CId o c) (ht : TId o tau) (hf : FId Y f) (z : (ST.T.thm o ac Y wY).1.car) :
      Id (ST.T.thm o ac Y wY).1.car ((IT.thm o o c tau rl ac ac Y Y wY wY f).1.1 z) z = diag ac.1 o ac.2 c tau rl Y wY f hk hc ht hf z ;
  } ;
} ;

------------------------------------------------------------------------
-- THE THEOREM
module Fin (ev : (A : DP.LO) -> W.N -> LT.LL A -> W.Bool) (phi : BI.Form) (evN : S4.EvN ev)
  (hPos : Id W.Bool (BO.posX phi zero) true) {
  module O = S4.Obj[ev,phi,evN] ;
  module H = BetaIDS4HomFin[l].Hom[ev,phi,evN,hPos] ;
  module WR = Wrap[ev,phi,evN,hPos,H.nodeH] ;
  module ST = WR.ST ;
  module SS = ST.SS ;
  module A = SS.AO ;
  module R = SH.Rel[ev,phi,evN] ;
  -- the node law at every node, from the diagonal law of the subtrees
  ndAll (x0 : O.IObj) (fs : (s : SS.Step x0) -> A.AT) (g2 : (s : SS.Step x0) -> A.Good (fs s) (SS.shiftO x0 s))
      (r : (s : SS.Step x0) -> WR.DiagT (fs s)) : WR.NodeDiag x0 fs g2 =
    \ c tau rl Y wY f hk hc ht hf z ->
      BetaIDS4DiagNode[l].DNode[ev,phi,evN,hPos,x0,\ s -> WR.IT.ev0 (fs s) (SS.shiftO x0 s) (g2 s),
        \ s s' cs taus rs -> WR.IT.goalT (fs s) (SS.shiftO x0 s) (g2 s) (SS.shiftO x0 s') (fs s') (g2 s') cs taus rs,
        c,tau,rl,Y,wY,f,
        \ i oo0 oo0' e e' -> BetaIDS4HomXl[l].XlRel[ev,phi,evN,hPos,x0,x0,\ s -> WR.IT.ev0 (fs s) (SS.shiftO x0 s) (g2 s),\ s -> WR.IT.ev0 (fs s) (SS.shiftO x0 s) (g2 s),
          \ s s' cs taus rs -> WR.IT.goalT (fs s) (SS.shiftO x0 s) (g2 s) (SS.shiftO x0 s') (fs s') (g2 s') cs taus rs,c,tau,rl,Y,Y,wY,wY,f,i,oo0,oo0',e,e'].spr,
        \ i mu eY h mu' eY' h' -> BetaIDS4HomRb[l].RBarRel[ev,phi,evN,hPos,x0,x0,\ s -> WR.IT.ev0 (fs s) (SS.shiftO x0 s) (g2 s),\ s -> WR.IT.ev0 (fs s) (SS.shiftO x0 s) (g2 s),
          \ s s' cs taus rs -> WR.IT.goalT (fs s) (SS.shiftO x0 s) (g2 s) (SS.shiftO x0 s') (fs s') (g2 s') cs taus rs,c,tau,rl,Y,Y,wY,wY,f,i,mu,eY,h,mu',eY',h'].out,
        BetaIDS4HomK3N[l].K3SelRel[ev,phi,evN,hPos,x0,x0,\ s -> WR.IT.ev0 (fs s) (SS.shiftO x0 s) (g2 s),\ s -> WR.IT.ev0 (fs s) (SS.shiftO x0 s) (g2 s),
          \ s s' cs taus rs -> WR.IT.goalT (fs s) (SS.shiftO x0 s) (g2 s) (SS.shiftO x0 s') (fs s') (g2 s') cs taus rs,c,tau,rl,Y,Y,wY,wY,f].hk3].Laws[
        \ s cs taus rs Y0 wY0 f0 hk0 hc0 ht0 hf0 z0 -> r s (SS.shiftO x0 s) (g2 s) cs taus rs Y0 wY0 f0 hk0 hc0 ht0 hf0 z0,hk,hc,ht,hf,
        \ i oo0 e -> BetaIDS4DiagXl[l].DXl[ev,phi,evN,hPos,x0,\ s -> WR.IT.ev0 (fs s) (SS.shiftO x0 s) (g2 s),
          \ s s' cs taus rs -> WR.IT.goalT (fs s) (SS.shiftO x0 s) (g2 s) (SS.shiftO x0 s') (fs s') (g2 s') cs taus rs,c,tau,rl,Y,wY,f,
          \ s cs taus rs Y0 wY0 f0 hk0 hc0 ht0 hf0 z0 -> r s (SS.shiftO x0 s) (g2 s) cs taus rs Y0 wY0 f0 hk0 hc0 ht0 hf0 z0,hk,hc,ht,hf,i,oo0,e].sprd,
        \ i mu eY h z0 -> BetaIDS4DiagRbK3[l].DRbK3[ev,phi,evN,hPos,x0,\ s -> WR.IT.ev0 (fs s) (SS.shiftO x0 s) (g2 s),
          \ s s' cs taus rs -> WR.IT.goalT (fs s) (SS.shiftO x0 s) (g2 s) (SS.shiftO x0 s') (fs s') (g2 s') cs taus rs,c,tau,rl,Y,wY,f,
          \ s cs taus rs Y0 wY0 f0 hk0 hc0 ht0 hf0 z1 -> r s (SS.shiftO x0 s) (g2 s) cs taus rs Y0 wY0 f0 hk0 hc0 ht0 hf0 z1,hk,hc,ht,hf].Rb[i,mu,eY,h].law z0,
        \ f0 e0 eY hb z0 -> BetaIDS4DiagRbK3[l].DRbK3[ev,phi,evN,hPos,x0,\ s -> WR.IT.ev0 (fs s) (SS.shiftO x0 s) (g2 s),
          \ s s' cs taus rs -> WR.IT.goalT (fs s) (SS.shiftO x0 s) (g2 s) (SS.shiftO x0 s') (fs s') (g2 s') cs taus rs,c,tau,rl,Y,wY,f,
          \ s cs taus rs Y0 wY0 f1 hk0 hc0 ht0 hf0 z1 -> r s (SS.shiftO x0 s) (g2 s) cs taus rs Y0 wY0 f1 hk0 hc0 ht0 hf0 z1,hk,hc,ht,hf].k3D f0 e0 eY hb z0].outD z ;
  -- THE DIAGONAL IDENTITY LAW: the first projection of hom fixes every
  -- point of the computed extension, for the same family, certificate and
  -- order on both sides, pointwise identities c, tau, f, and any supplied
  -- relation rl, given the pointwise km identity law hk.
  diagId (o : O.IObj) (ac : SS.AccI o) (c : DP.Map o.Cst o.Cst) (tau : (Z : DP.LO) -> DP.Map (o.k Z) (o.k Z))
      (rl : R.RelIn o o c tau) (Y : DP.LO) (wY : LW.WF Y) (f : DP.Map Y Y)
      (hk : (Z : DP.LO) (p : (o.k Z).car) -> Id (o.k Z).car ((o.km Z Z (LC.idMap Z)).1 p) p)
      (hc : (w : o.Cst.car) -> Id o.Cst.car (c.1 w) w)
      (ht : (Z : DP.LO) (p : (o.k Z).car) -> Id (o.k Z).car ((tau Z).1 p) p)
      (hf : (y : Y.car) -> Id Y.car (f.1 y) y)
      (z : (ST.T.thm o ac Y wY).1.car) :
      Id (ST.T.thm o ac Y wY).1.car ((H.hom o o c tau rl ac ac Y Y wY wY f).1.1 z) z =
    WR.Lift[ndAll].thm o ac c tau rl Y wY f hk hc ht hf z ;
} ;

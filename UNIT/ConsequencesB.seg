-- ConsequencesB.seg: Pi injectivity (paper Corollary 2.37) from the
-- budgeted adequacy AdequacyB, with every type in the proof of depth
-- <= Kmax = wt(d) + 1 (PRA/LEVELS.md, B4).  As ConsequencesP: the bottom
-- environment, the identity substitution, the instance pi om om : U (of
-- depth 1, at the bound K = 1).

level l ;
open Base ; open Prelude[l] ; open Lib[l] ; open Types[l] ; open Consistency[l] ; open Typing[l] ;
open Syntax[l] ; open SynLemmas[l] ; open Weaken[l] ; open Subst[l] ; open Presup[l] ; open Cross[l] ;
open Filter[l] ; open Sem[l] ; open Sound[l] ; open Reduction[l] ; open RelC[l] ; open LawsC[l] ; open AdeqBase[l] ;
open PrinEnv[l] ; open AdeqPiP[l] ; open ConsequencesP[l] ;
open TypingK[l] ; open SemK[l] ; open SoundK[l] ; open AdeqBaseB[l] ; open AdeqPiB[l] ; open AdequacyB[l] ;

-- the bottom environment fits at every bound (its witnesses are om)
fitsk-bot (K : Nat) : (m : Nat) -> (G : Ctx m) -> FitsK K m G (rho0 m) = split {
  zero -> \ G -> tt ;
  suc m | r -> \ G -> (r G.1, \ t mt -> enlk-om K (prin om) (semK K m G.2 (rho0 m)) t mt) } ;

tpk-pi-om : TpK (suc zero) (el (pi om om) univ) =
  k-pi (pi om om) univ om om tt tt tt (eqv-refl (pi om om)) (eqv-refl univ) (tpk-omU (suc zero))
    (ken-om om (arr om univ) tt tt) cons-om ;

pi-om-inK (m : Nat) (A : Tm m) (B : Tm (suc m)) (rho : Env m) : (semK (suc zero) m (pp m A B) rho).mem (pi om om) =
  inr (new PiWKR[suc zero, semK (suc zero) m A rho, famK (suc zero) m B rho, pi om om, a := om, b := om,
                 le := le-refl (pi om om), bp := tt, ina := (semK (suc zero) m A rho).fom, ents := es-om]) ;

module PiInjB (m : Nat) (G : Ctx m) (A A' : Tm m) (B B' : Tm (suc m)) (d : Der m (jeq G (pp m A B) (pp m A' B') (uu m)))
    (Kmax : Nat) (hK : LeN (add (wt m (jeq G (pp m A B) (pp m A' B') (uu m)) d) (suc zero)) Kmax) {
  open RelCD[m, G] ;
  open LawsCD[m, G] ;
  open AdeqB[m, G] ;
  open AdeqBB[m, G, Kmax] ;

  wG : Der m (jwf G) = wf-of m (jeq G (pp m A B) (pp m A' B') (uu m)) d ;

  Ai : Tm m = Sub.trav m A m (idS m) ;
  Bi : Tm (suc m) = Sub.trav (suc m) B (suc m) (Sub.lift m m (idS m)) ;
  Ai' : Tm m = Sub.trav m A' m (idS m) ;
  Bi' : Tm (suc m) = Sub.trav (suc m) B' (suc m) (Sub.lift m m (idS m)) ;

  rel-idB : RelSB m G (rho0 m) (idS m) (idS m) =
    new RelSBR[m, G, rho0 m, idS m, idS m, ok := id-ok m G wG, ok' := id-ok m G wG,
             eq := \ i -> eq-refl m G (var m i) (Sub.trav m (lookup m G i) m (idS m)) (id-ok m G wG i),
             eq' := \ i -> eq-refl m G (var m i) (Sub.trav m (lookup m G i) m (idS m)) (id-ok m G wG i),
             vr := \ i u c mu mc hc ->
               (tmr-om u mu (Sub.trav m (lookup m G i) m (idS m)) (var m i) (var m i),
                tmr-om u mu (Sub.trav m (lookup m G i) m (idS m)) (var m i) (var m i))] ;

  -- the budgeted adequacy over finite data (k = om everywhere: rho0 = penv om), at pi om om, bound 1
  tm : TmR (pi om om) (uu m) (pp m Ai Bi) (pp m Ai' Bi') =
    (AdeqTB[m, G, wG, Kmax].adequacyB m (jeq G (pp m A B) (pp m A' B') (uu m)) d (suc zero) hK
       (\ i -> om) (fitsk-bot (suc zero) m G) (idS m) (idS m) rel-idB
       (pi om om) univ (pi-om-inK m A B (rho0 m)) (le-refl univ) tpk-pi-om).1 ;

  pc : PiTy Can om om (pp m Ai Bi) (pp m Ai' Bi') =
    ((tyr-unfold (pi om om) (pp m Ai Bi) (pp m Ai' Bi')).1 (tmr-ty (pi om om) (uu m) (pp m Ai Bi) (pp m Ai' Bi') tm)).pc
      om om om om (sel-here (pi om om)) (ps-here om om) ;

  dd : PiD Can om om Ai Bi Ai' Bi' =
    pid-r Can om om Ai Bi pc.A1 Ai' pc.B1 Bi'
      (sym (Tm m) (pp m Ai' Bi') (pp m pc.A1 pc.B1) (reds-from-normal m (pp m Ai' Bi') (pp m pc.A1 pc.B1) pc.red' (normal-pp m Ai' Bi')))
      (pid-l Can om om pc.A0 Ai pc.B0 Bi pc.A1 pc.B1
         (sym (Tm m) (pp m Ai Bi) (pp m pc.A0 pc.B0) (reds-from-normal m (pp m Ai Bi) (pp m pc.A0 pc.B0) pc.red (normal-pp m Ai Bi)))
         pc.d) ;

  dom : Der m (jeq G A A' (uu m)) =
    der-eq-r m G A Ai' A' (uu m) (sub-id m A') (der-eq-l m G Ai A Ai' (uu m) (sub-id m A) dd.cA) ;

  cod : Der (suc m) (jeq (ext m G A) B B' (uu (suc m))) =
    Prelude[l].subst (Tm m) (\ Z -> Der (suc m) (jeq (ext m G Z) B B' (uu (suc m)))) Ai A (sub-id m A)
      (der-eq-r (suc m) (ext m G Ai) B Bi' B' (uu (suc m)) (sub-id-lift m B')
         (der-eq-l (suc m) (ext m G Ai) Bi B Bi' (uu (suc m)) (sub-id-lift m B) dd.cB)) ;
} ;

-- Pi injectivity, every type in the adequacy proof of depth <= wt(d) + 1
pi-injectivityB (m : Nat) (G : Ctx m) (A A' : Tm m) (B B' : Tm (suc m)) (d : Der m (jeq G (pp m A B) (pp m A' B') (uu m))) :
    Der m (jeq G A A' (uu m)) * Der (suc m) (jeq (ext m G A) B B' (uu (suc m))) =
  (PiInjB[m, G, A, A', B, B', d, K0, leN-refl K0].dom, PiInjB[m, G, A, A', B, B', d, K0, leN-refl K0].cod)
  where { K0 : Nat = add (wt m (jeq G (pp m A B) (pp m A' B') (uu m)) d) (suc zero) ; } ;

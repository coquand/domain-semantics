-- The local part of category SIP: same objects, equivalent hom sets,
-- and preservation of identities and composition imply equality.
level l ;
open Base ; open Prelude[l++] ;
module S = CategorySIP[l++,l+] ;
module H = Axioms[l++].FunExtLemmas[fe @l++] ;
module Fam = CategorySIPFamily[l] ;

module On (O : U l++) (s : S.Structure[O]) {
  I : U l++ = O * O ;
  source (i : I) : U l+ = s.hom i.1 i.2 ;
  module F = Fam.On[I,source] ;
  Curried (v : F.Family) : O -> O -> U l+ =
    \ x y -> v (x,y) ;
  Ops (v : F.Family) : U l++ =
    S.Operations[O,Curried v] ;
  IdLaw (v : F.Family) (e : F.FiberEquiv v)
    (t : Ops v) : U l++ =
    (x : O) -> Id (v (x,x))
      ((e (x,x)).1 (s.idn x)) (t.idn x) ;
  CompLaw (v : F.Family) (e : F.FiberEquiv v)
    (t : Ops v) : U l++ =
    (x y z : O) (f : s.hom x y) (g : s.hom y z) ->
      Id (v (x,z))
        ((e (x,z)).1 (s.comp x y z g f))
        (t.comp x y z
          ((e (y,z)).1 g) ((e (x,y)).1 f)) ;
  Motive (v : F.Family) (e : F.FiberEquiv v) : U l+++ =
    (t : Ops v) -> IdLaw v e t -> CompLaw v e t ->
      Id (S.Structure[O]) s
        (S.structure-from O (Curried v,t)) ;

  module BaseCase (t : Ops source)
    (id-law : IdLaw source
      (\ i -> Prelude[l+].idEquiv (source i)) t)
    (comp-law : CompLaw source
      (\ i -> Prelude[l+].idEquiv (source i)) t) {
    identity-eq :
      Id (S.Fixed[O,s.hom].Idn) s.idn t.idn =
      H.funext O (\ x -> s.hom x x)
        s.idn t.idn id-law ;
    C0 (x : O) : U l++ =
      (y z : O) -> s.hom y z -> s.hom x y -> s.hom x z ;
    C1 (x y : O) : U l++ =
      (z : O) -> s.hom y z -> s.hom x y -> s.hom x z ;
    C2 (x y z : O) : U l++ =
      s.hom y z -> s.hom x y -> s.hom x z ;
    C3 (x y z : O) (g : s.hom y z) : U l++ =
      s.hom x y -> s.hom x z ;
    composition-eq :
      Id (S.Fixed[O,s.hom].Comp) s.comp t.comp =
      H.funext O C0 s.comp t.comp (\ x ->
        H.funext O (C1 x) (s.comp x) (t.comp x) (\ y ->
          H.funext O (C2 x y)
            (s.comp x y) (t.comp x y) (\ z ->
            H.funext (s.hom y z) (C3 x y z)
              (s.comp x y z) (t.comp x y z) (\ g ->
              H.funext (s.hom x y) (\ _ -> s.hom x z)
                (s.comp x y z g) (t.comp x y z g)
                (\ f -> comp-law x y z f g))))) ;
    result : Id (S.Structure[O]) s
      (S.structure-from O (Curried source,t)) =
      S.fixed-hom-equal O s t identity-eq composition-eq ;
  } ;
  base : Motive source
    (\ i -> Prelude[l+].idEquiv (source i)) =
    \ t id-law comp-law ->
      BaseCase[t,id-law,comp-law].result ;
  equal (v : F.Family) (e : F.FiberEquiv v)
    (t : Ops v) (id-law : IdLaw v e t)
    (comp-law : CompLaw v e t) :
    Id (S.Structure[O]) s
      (S.structure-from O (Curried v,t)) =
    F.eqind Motive base v e t id-law comp-law ;
} ;

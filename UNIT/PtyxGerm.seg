-- Ptykes from finite data, part A: the value at a dilator as a set of
-- germs (catemb.pdf, linear-order case; PLAN-CATEMB-LO.md step 5, route
-- (a): no decidable supports, a genuine quotient).
--
-- A finite ptyx FP is a functor on finite dilators (FinDil) into LO whose
-- supports are closed under intersection.  For an arbitrary dilator D a
-- germ is a pair (K, z) with z in FP(D|K).  Two germs are compared at a
-- common level L >= K, K' after pushing along D|K -> D|L; this does not
-- depend on L (the pushes are strictly increasing and compose).  The
-- value F^(D) is the quotient of germs by "comparison = eq":
--   F^(D) = (p : Germ -> Bool) * Ex ((g : Germ) * cls g = p),
-- a set by funext (no propositional univalence needed), with the
-- comparison defined by unique choice on representatives.
level l ;
open Base ; open Prelude[l+] ; open ScottOrder[l] ;
module W = Dilator[l] ;
module CD = CatDil[l] ;
module DF = DilFinite[l] ;
module DP = DilPtyx[l] ;
module PF = PtyxFinite[l] ;
module DI = DilImage[l] ;
module PL = Prelude[l] ;
module TC = TruncationCombinators[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;

----------------------------------------------------------------------
-- subdilators of finite dilators are finite

module BoundedMor (A B : CD.Dil) (T : CD.Mor A B) {
  module NT = W.Nat[A.1,A.2.1,A.2.2.1,A.2.2.2.1,A.2.2.2.2.1,A.2.2.2.2.2.1,A.2.2.2.2.2.2,
    B.1,B.2.1,B.2.2.1,B.2.2.2.1,B.2.2.2.2.1,B.2.2.2.2.2.1,B.2.2.2.2.2.2,T.1,T.2.1,T.2.2.1,T.2.2.2] ;
  bnd (K : W.N) (hb : DF.Bounded B K) : DF.Bounded A K = \ m t tp -> hb m (W.sel (T.1 m) t) (NT.trT m t tp) ;
} ;
subFin (A : DF.FinDil) (c : DP.SubSet) : DF.FinDil =
  (DF.On[A.1].Sub[c].dil,(A.2.1,BoundedMor[DF.On[A.1].Sub[c].dil,A.1,DF.On[A.1].Sub[c].inc].bnd A.2.1 A.2.2)) ;

----------------------------------------------------------------------
-- finite ptykes

record FinPtyx {
  F : DF.FinDil -> DP.LO ;
  arr : (A B : DF.FinDil) -> CD.Mor A.1 B.1 -> DP.Map (F A) (F B) ;
  arr-id : (A : DF.FinDil) (y : (F A).car) -> Id (F A).car ((arr A A (CD.idM A.1)).1 y) y ;
  arr-comp : (A B C : DF.FinDil) (S : CD.Mor A.1 B.1) (T : CD.Mor B.1 C.1) (y : (F A).car) ->
    Id (F C).car ((arr B C T).1 ((arr A B S).1 y)) ((arr A C (CD.compM A.1 B.1 C.1 S T)).1 y) ;
  meet : (A : DF.FinDil) (y : (F A).car) (c c' : DP.SubSet) ->
    ((z : (F (subFin A c)).car) * Id (F A).car ((arr (subFin A c) A (DF.On[A.1].Sub[c].inc)).1 z) y) ->
    ((z : (F (subFin A c')).car) * Id (F A).car ((arr (subFin A c') A (DF.On[A.1].Sub[c'].inc)).1 z) y) ->
    ((z : (F (subFin A (DF.On[A.1].meet c c'))).car) *
      Id (F A).car ((arr (subFin A (DF.On[A.1].meet c c')) A (DF.On[A.1].Sub[DF.On[A.1].meet c c'].inc)).1 z) y) ;
} ;

----------------------------------------------------------------------
-- levels

LeN (K L : W.N) : U l = Id W.Bool (W.ltN K (suc L)) true ;
le-trans (K L M : W.N) (h : LeN K L) (h' : LeN L M) : LeN K M = W.ltN-le-lt K L (suc M) h h' ;
leL (K L : W.N) : LeN K (W.plus K L) =
  W.subst W.N (\ k -> Id W.Bool (W.ltN K (suc k)) true) (W.plus L K) (W.plus K L) (W.plus-comm L K) (W.le-plus K L) ;
leR (K L : W.N) : LeN L (W.plus K L) = W.le-plus L K ;
le-refl (K : W.N) : LeN K K = W.ltN-suc K ;
le-irr (K L : W.N) (h h' : LeN K L) : Id (LeN K L) h h' = W.HB.uip (W.ltN K (suc L)) true h h' ;

----------------------------------------------------------------------
-- germs at a dilator

module Germ (FP : FinPtyx) (D : CD.Dil) {
  T (K : W.N) : DF.FinDil = DF.finite D K ;
  Fo (K : W.N) : DP.LO = FP.F (T K) ;
  leS (K L : W.N) (h : LeN K L) : DP.LeS (DF.On[D].lev K) (DF.On[D].lev L) = \ k z hk -> W.ltN-le-lt k K (suc L) hk h ;
  up (K L : W.N) (h : LeN K L) : CD.Mor (T K).1 (T L).1 = DP.Up[D,DF.On[D].lev K,DF.On[D].lev L,leS K L h].mor ;
  up-tri (K L : W.N) (h : LeN K L) :
      Id (CD.Mor (T K).1 D) (CD.compM (T K).1 (T L).1 D (up K L h) (PF.TrInc D L)) (PF.TrInc D K) =
    DP.Up[D,DF.On[D].lev K,DF.On[D].lev L,leS K L h].tri ;

  -- morphisms between truncations over D are unique
  uniq (K L : W.N) (S S' : CD.Mor (T K).1 (T L).1)
    (e : Id (CD.Mor (T K).1 D) (CD.compM (T K).1 (T L).1 D S (PF.TrInc D L)) (PF.TrInc D K))
    (e' : Id (CD.Mor (T K).1 D) (CD.compM (T K).1 (T L).1 D S' (PF.TrInc D L)) (PF.TrInc D K)) :
      Id (CD.Mor (T K).1 (T L).1) S S' =
    DI.mono (T K).1 (T L).1 D (PF.TrInc D L) S S'
      (PL.trans (CD.Mor (T K).1 D) (CD.compM (T K).1 (T L).1 D S (PF.TrInc D L)) (PF.TrInc D K)
        (CD.compM (T K).1 (T L).1 D S' (PF.TrInc D L)) e
        (PL.sym (CD.Mor (T K).1 D) (CD.compM (T K).1 (T L).1 D S' (PF.TrInc D L)) (PF.TrInc D K) e')) ;

  up-comp (K L M : W.N) (h : LeN K L) (h' : LeN L M) :
      Id (CD.Mor (T K).1 (T M).1) (CD.compM (T K).1 (T L).1 (T M).1 (up K L h) (up L M h')) (up K M (le-trans K L M h h')) =
    uniq K M (CD.compM (T K).1 (T L).1 (T M).1 (up K L h) (up L M h')) (up K M (le-trans K L M h h'))
      (PL.trans (CD.Mor (T K).1 D) (CD.compM (T K).1 (T M).1 D (CD.compM (T K).1 (T L).1 (T M).1 (up K L h) (up L M h')) (PF.TrInc D M))
        (CD.compM (T K).1 (T L).1 D (up K L h) (CD.compM (T L).1 (T M).1 D (up L M h') (PF.TrInc D M))) (PF.TrInc D K)
        (CD.assoc (T K).1 (T L).1 (T M).1 D (up K L h) (up L M h') (PF.TrInc D M))
        (PL.trans (CD.Mor (T K).1 D) (CD.compM (T K).1 (T L).1 D (up K L h) (CD.compM (T L).1 (T M).1 D (up L M h') (PF.TrInc D M)))
          (CD.compM (T K).1 (T L).1 D (up K L h) (PF.TrInc D L)) (PF.TrInc D K)
          (PL.ap (CD.Mor (T L).1 D) (CD.Mor (T K).1 D) (CD.compM (T K).1 (T L).1 D (up K L h))
            (CD.compM (T L).1 (T M).1 D (up L M h') (PF.TrInc D M)) (PF.TrInc D L) (up-tri L M h'))
          (up-tri K L h)))
      (up-tri K M (le-trans K L M h h')) ;

  G : U l = (K : W.N) * (Fo K).car ;
  push (g : G) (L : W.N) (h : LeN g.1 L) : (Fo L).car = (FP.arr (T g.1) (T L) (up g.1 L h)).1 g.2 ;
  push-irr (g : G) (L : W.N) (h h' : LeN g.1 L) : Id (Fo L).car (push g L h) (push g L h') =
    PL.ap (LeN g.1 L) (Fo L).car (push g L) h h' (le-irr g.1 L h h') ;
  push-push (g : G) (L M : W.N) (h : LeN g.1 L) (h' : LeN L M) :
      Id (Fo M).car (push (L,push g L h) M h') (push g M (le-trans g.1 L M h h')) =
    PL.trans (Fo M).car (push (L,push g L h) M h')
      ((FP.arr (T g.1) (T M) (CD.compM (T g.1).1 (T L).1 (T M).1 (up g.1 L h) (up L M h'))).1 g.2)
      (push g M (le-trans g.1 L M h h'))
      (FP.arr-comp (T g.1) (T L) (T M) (up g.1 L h) (up L M h') g.2)
      (PL.ap (CD.Mor (T g.1).1 (T M).1) (Fo M).car (\ S -> (FP.arr (T g.1) (T M) S).1 g.2)
        (CD.compM (T g.1).1 (T L).1 (T M).1 (up g.1 L h) (up L M h')) (up g.1 M (le-trans g.1 L M h h'))
        (up-comp g.1 L M h h')) ;

  -- comparison at a common level, independent of the level
  cmpAt (g g' : G) (L : W.N) (h : LeN g.1 L) (h' : LeN g'.1 L) : W.O3 = (Fo L).cmp (push g L h) (push g' L h') ;
  cmpAt-irr (g g' : G) (L : W.N) (h k : LeN g.1 L) (h' k' : LeN g'.1 L) : Id W.O3 (cmpAt g g' L h h') (cmpAt g g' L k k') =
    W.ap2 (Fo L).car (Fo L).car W.O3 (Fo L).cmp (push g L h) (push g L k) (push g' L h') (push g' L k')
      (push-irr g L h k) (push-irr g' L h' k') ;
  cmpAt-up (g g' : G) (L M : W.N) (h : LeN g.1 L) (h' : LeN g'.1 L) (hM : LeN L M) :
      Id W.O3 (cmpAt g g' M (le-trans g.1 L M h hM) (le-trans g'.1 L M h' hM)) (cmpAt g g' L h h') =
    W.trans W.O3 (cmpAt g g' M (le-trans g.1 L M h hM) (le-trans g'.1 L M h' hM))
      ((Fo M).cmp (push (L,push g L h) M hM) (push (L,push g' L h') M hM)) (cmpAt g g' L h h')
      (W.ap2 (Fo M).car (Fo M).car W.O3 (Fo M).cmp
        (push g M (le-trans g.1 L M h hM)) (push (L,push g L h) M hM)
        (push g' M (le-trans g'.1 L M h' hM)) (push (L,push g' L h') M hM)
        (PL.sym (Fo M).car (push (L,push g L h) M hM) (push g M (le-trans g.1 L M h hM)) (push-push g L M h hM))
        (PL.sym (Fo M).car (push (L,push g' L h') M hM) (push g' M (le-trans g'.1 L M h' hM)) (push-push g' L M h' hM)))
      ((FP.arr (T L) (T M) (up L M hM)).2 (push g L h) (push g' L h')) ;
  cmpAt-indep (g g' : G) (L L' : W.N) (h : LeN g.1 L) (h' : LeN g'.1 L) (k : LeN g.1 L') (k' : LeN g'.1 L') :
      Id W.O3 (cmpAt g g' L h h') (cmpAt g g' L' k k') =
    W.trans W.O3 (cmpAt g g' L h h')
      (cmpAt g g' (W.plus L L') (le-trans g.1 L (W.plus L L') h (leL L L')) (le-trans g'.1 L (W.plus L L') h' (leL L L')))
      (cmpAt g g' L' k k')
      (W.sym W.O3 (cmpAt g g' (W.plus L L') (le-trans g.1 L (W.plus L L') h (leL L L')) (le-trans g'.1 L (W.plus L L') h' (leL L L')))
        (cmpAt g g' L h h') (cmpAt-up g g' L (W.plus L L') h h' (leL L L')))
      (W.trans W.O3
        (cmpAt g g' (W.plus L L') (le-trans g.1 L (W.plus L L') h (leL L L')) (le-trans g'.1 L (W.plus L L') h' (leL L L')))
        (cmpAt g g' (W.plus L L') (le-trans g.1 L' (W.plus L L') k (leR L L')) (le-trans g'.1 L' (W.plus L L') k' (leR L L')))
        (cmpAt g g' L' k k')
        (cmpAt-irr g g' (W.plus L L') (le-trans g.1 L (W.plus L L') h (leL L L')) (le-trans g.1 L' (W.plus L L') k (leR L L'))
          (le-trans g'.1 L (W.plus L L') h' (leL L L')) (le-trans g'.1 L' (W.plus L L') k' (leR L L')))
        (cmpAt-up g g' L' (W.plus L L') k k' (leR L L'))) ;

  cmpG (g g' : G) : W.O3 = cmpAt g g' (W.plus g.1 g'.1) (leL g.1 g'.1) (leR g.1 g'.1) ;
  cmpG-at (g g' : G) (L : W.N) (h : LeN g.1 L) (h' : LeN g'.1 L) : Id W.O3 (cmpG g g') (cmpAt g g' L h h') =
    cmpAt-indep g g' (W.plus g.1 g'.1) L (leL g.1 g'.1) (leR g.1 g'.1) h h' ;

  -- the comparison of germs is a linear preorder
  cmpG-refl (g : G) : Id W.O3 (cmpG g g) eq =
    W.trans W.O3 (cmpG g g) (cmpAt g g g.1 (le-refl g.1) (le-refl g.1)) eq
      (cmpG-at g g g.1 (le-refl g.1) (le-refl g.1)) ((Fo g.1).crefl (push g g.1 (le-refl g.1))) ;
  cmpG-flip (g g' : G) : Id W.O3 (cmpG g' g) (W.flip (cmpG g g')) =
    W.trans W.O3 (cmpG g' g) (cmpAt g' g (W.plus g.1 g'.1) (leR g.1 g'.1) (leL g.1 g'.1)) (W.flip (cmpG g g'))
      (cmpG-at g' g (W.plus g.1 g'.1) (leR g.1 g'.1) (leL g.1 g'.1))
      ((Fo (W.plus g.1 g'.1)).cflip (push g (W.plus g.1 g'.1) (leL g.1 g'.1)) (push g' (W.plus g.1 g'.1) (leR g.1 g'.1))) ;
  module Three (g g' g'' : G) {
    L : W.N = W.plus (W.plus g.1 g'.1) g''.1 ;
    h1 : LeN g.1 L = le-trans g.1 (W.plus g.1 g'.1) L (leL g.1 g'.1) (leL (W.plus g.1 g'.1) g''.1) ;
    h2 : LeN g'.1 L = le-trans g'.1 (W.plus g.1 g'.1) L (leR g.1 g'.1) (leL (W.plus g.1 g'.1) g''.1) ;
    h3 : LeN g''.1 L = leR (W.plus g.1 g'.1) g''.1 ;
    p1 : (Fo L).car = push g L h1 ;
    p2 : (Fo L).car = push g' L h2 ;
    p3 : (Fo L).car = push g'' L h3 ;
    e12 : Id W.O3 (cmpG g g') ((Fo L).cmp p1 p2) = cmpG-at g g' L h1 h2 ;
    e23 : Id W.O3 (cmpG g' g'') ((Fo L).cmp p2 p3) = cmpG-at g' g'' L h2 h3 ;
    e13 : Id W.O3 (cmpG g g'') ((Fo L).cmp p1 p3) = cmpG-at g g'' L h1 h3 ;
  } ;
  cmpG-trans (g g' g'' : G) (a : Id W.O3 (cmpG g g') lt) (b : Id W.O3 (cmpG g' g'') lt) : Id W.O3 (cmpG g g'') lt =
    W.trans W.O3 (cmpG g g'') ((Fo Three[g,g',g''].L).cmp Three[g,g',g''].p1 Three[g,g',g''].p3) lt Three[g,g',g''].e13
      ((Fo Three[g,g',g''].L).ctrans Three[g,g',g''].p1 Three[g,g',g''].p2 Three[g,g',g''].p3
        (W.trans W.O3 ((Fo Three[g,g',g''].L).cmp Three[g,g',g''].p1 Three[g,g',g''].p2) (cmpG g g') lt
          (W.sym W.O3 (cmpG g g') ((Fo Three[g,g',g''].L).cmp Three[g,g',g''].p1 Three[g,g',g''].p2) Three[g,g',g''].e12) a)
        (W.trans W.O3 ((Fo Three[g,g',g''].L).cmp Three[g,g',g''].p2 Three[g,g',g''].p3) (cmpG g' g'') lt
          (W.sym W.O3 (cmpG g' g'') ((Fo Three[g,g',g''].L).cmp Three[g,g',g''].p2 Three[g,g',g''].p3) Three[g,g',g''].e23) b)) ;
  -- equivalent germs compare in the same way
  cmpG-eqv (g g' g'' : G) (e : Id W.O3 (cmpG g g') eq) : Id W.O3 (cmpG g g'') (cmpG g' g'') =
    W.trans W.O3 (cmpG g g'') ((Fo Three[g,g',g''].L).cmp Three[g,g',g''].p1 Three[g,g',g''].p3) (cmpG g' g'')
      Three[g,g',g''].e13
      (W.trans W.O3 ((Fo Three[g,g',g''].L).cmp Three[g,g',g''].p1 Three[g,g',g''].p3)
        ((Fo Three[g,g',g''].L).cmp Three[g,g',g''].p2 Three[g,g',g''].p3) (cmpG g' g'')
        (W.ap (Fo Three[g,g',g''].L).car W.O3 (\ u -> (Fo Three[g,g',g''].L).cmp u Three[g,g',g''].p3)
          Three[g,g',g''].p1 Three[g,g',g''].p2
          ((Fo Three[g,g',g''].L).ceq Three[g,g',g''].p1 Three[g,g',g''].p2
            (W.trans W.O3 ((Fo Three[g,g',g''].L).cmp Three[g,g',g''].p1 Three[g,g',g''].p2) (cmpG g g') eq
              (W.sym W.O3 (cmpG g g') ((Fo Three[g,g',g''].L).cmp Three[g,g',g''].p1 Three[g,g',g''].p2) Three[g,g',g''].e12) e)))
        (W.sym W.O3 (cmpG g' g'') ((Fo Three[g,g',g''].L).cmp Three[g,g',g''].p2 Three[g,g',g''].p3) Three[g,g',g''].e23)) ;
  cmpG-eqv-r (g g' g'' : G) (e : Id W.O3 (cmpG g g') eq) : Id W.O3 (cmpG g'' g) (cmpG g'' g') =
    W.trans W.O3 (cmpG g'' g) (W.flip (cmpG g g'')) (cmpG g'' g') (cmpG-flip g g'')
      (W.trans W.O3 (W.flip (cmpG g g'')) (W.flip (cmpG g' g'')) (cmpG g'' g')
        (W.ap W.O3 W.O3 W.flip (cmpG g g'') (cmpG g' g'') (cmpG-eqv g g' g'' e))
        (W.sym W.O3 (cmpG g'' g') (W.flip (cmpG g' g'')) (cmpG-flip g' g''))) ;

  ----------------------------------------------------------------------
  -- the quotient

  cls (g : G) (g' : G) : W.Bool = PF.eqB (cmpG g g') ;
  Rep (p : G -> W.Bool) : U l = (g : G) * Id (G -> W.Bool) (cls g) p ;
  Car : U l = (p : G -> W.Bool) * Ex (Rep p) ;
  cl (g : G) : Car = (cls g,inc (Rep (cls g)) (g,refl (cls g))) ;

  cls-eq (g g' : G) (e : Id W.O3 (cmpG g g') eq) : Id (G -> W.Bool) (cls g) (cls g') =
    FE.funext G (\ _ -> W.Bool) (cls g) (cls g') (\ h -> W.ap W.O3 W.Bool PF.eqB (cmpG g h) (cmpG g' h) (cmpG-eqv g g' h e)) ;
  cls-inv (g g' : G) (e : Id (G -> W.Bool) (cls g) (cls g')) : Id W.O3 (cmpG g g') eq =
    PF.eqB-sound (cmpG g g')
      (W.trans W.Bool (cls g g') (cls g' g') true
        (PL.ap (G -> W.Bool) W.Bool (\ f -> f g') (cls g) (cls g') e)
        (W.ap W.O3 W.Bool PF.eqB (cmpG g' g') eq (cmpG-refl g'))) ;

  bool-set : PL.isSet W.Bool = \ a b -> W.HB.uip a b ;
  car-eq (x y : Car) (e : Id (G -> W.Bool) x.1 y.1) : Id Car x y =
    PL.Sigma-eq (G -> W.Bool) (\ p -> Ex (Rep p)) x.1 y.1 x.2 y.2 e (prop (Rep y.1)) ;
  car-set : PL.isSet Car =
    PL.isSet-Sigma (G -> W.Bool) (\ p -> Ex (Rep p)) (FE.isSet-Pi G (\ _ -> W.Bool) (\ _ -> bool-set))
      (\ p -> PL.prop-to-set (Ex (Rep p)) (prop (Rep p))) ;
  cl-rep (x : Car) (r : Rep x.1) : Id Car (cl r.1) x = car-eq (cl r.1) x r.2 ;

  -- two representatives of the same class are equivalent
  rep-eq (p : G -> W.Bool) (r s : Rep p) : Id W.O3 (cmpG r.1 s.1) eq =
    cls-inv r.1 s.1 (PL.trans (G -> W.Bool) (cls r.1) p (cls s.1) r.2 (PL.sym (G -> W.Bool) (cls s.1) p s.2)) ;
  reps (x y : Car) (r s : Rep x.1) (r' s' : Rep y.1) : Id W.O3 (cmpG r.1 r'.1) (cmpG s.1 s'.1) =
    W.trans W.O3 (cmpG r.1 r'.1) (cmpG s.1 r'.1) (cmpG s.1 s'.1)
      (cmpG-eqv r.1 s.1 r'.1 (rep-eq x.1 r s))
      (cmpG-eqv-r r'.1 s'.1 s.1 (rep-eq y.1 r' s')) ;

  -- the comparison on the quotient, by unique choice
  Cand (x y : Car) (o : W.O3) : U l = (r : Rep x.1) * ((r' : Rep y.1) * Id W.O3 (cmpG r.1 r'.1) o) ;
  C (x y : Car) : U l = (o : W.O3) * Ex (Cand x y o) ;
  C-prop (x y : Car) : PL.isProp (C x y) = \ c c' ->
    PL.Sigma-eq W.O3 (\ o -> Ex (Cand x y o)) c.1 c'.1 c.2 c'.2
      (TC.rec (Cand x y c.1) @l (Id W.O3 c.1 c'.1) (PF.o3-set c.1 c'.1)
        (\ u -> TC.rec (Cand x y c'.1) @l (Id W.O3 c.1 c'.1) (PF.o3-set c.1 c'.1)
          (\ v -> W.trans W.O3 c.1 (cmpG u.1.1 u.2.1.1) c'.1 (W.sym W.O3 (cmpG u.1.1 u.2.1.1) c.1 u.2.2)
            (W.trans W.O3 (cmpG u.1.1 u.2.1.1) (cmpG v.1.1 v.2.1.1) c'.1 (reps x y u.1 v.1 u.2.1 v.2.1) v.2.2))
          c'.2)
        c.2)
      (prop (Cand x y c'.1)) ;
  pick (x y : Car) (r : Rep x.1) (r' : Rep y.1) : C x y =
    (cmpG r.1 r'.1,inc (Cand x y (cmpG r.1 r'.1)) (r,(r',refl (cmpG r.1 r'.1)))) ;
  get (x y : Car) : C x y =
    TC.rec (Rep x.1) @l (C x y) (C-prop x y)
      (\ r -> TC.rec (Rep y.1) @l (C x y) (C-prop x y) (\ r' -> pick x y r r') y.2) x.2 ;
  cmpC (x y : Car) : W.O3 = (get x y).1 ;
  spec (x y : Car) (r : Rep x.1) (r' : Rep y.1) : Id W.O3 (cmpC x y) (cmpG r.1 r'.1) =
    PL.ap (C x y) W.O3 (\ c -> c.1) (get x y) (pick x y r r') (C-prop x y (get x y) (pick x y r r')) ;

  -- linear order laws
  crefl (x : Car) : Id W.O3 (cmpC x x) eq =
    TC.rec (Rep x.1) @l (Id W.O3 (cmpC x x) eq) (PF.o3-set (cmpC x x) eq)
      (\ r -> W.trans W.O3 (cmpC x x) (cmpG r.1 r.1) eq (spec x x r r) (cmpG-refl r.1)) x.2 ;
  cflip (x y : Car) : Id W.O3 (cmpC y x) (W.flip (cmpC x y)) =
    TC.rec (Rep x.1) @l (Id W.O3 (cmpC y x) (W.flip (cmpC x y))) (PF.o3-set (cmpC y x) (W.flip (cmpC x y)))
      (\ r -> TC.rec (Rep y.1) @l (Id W.O3 (cmpC y x) (W.flip (cmpC x y))) (PF.o3-set (cmpC y x) (W.flip (cmpC x y)))
        (\ r' -> W.trans W.O3 (cmpC y x) (cmpG r'.1 r.1) (W.flip (cmpC x y)) (spec y x r' r)
          (W.trans W.O3 (cmpG r'.1 r.1) (W.flip (cmpG r.1 r'.1)) (W.flip (cmpC x y)) (cmpG-flip r.1 r'.1)
            (W.ap W.O3 W.O3 W.flip (cmpG r.1 r'.1) (cmpC x y) (W.sym W.O3 (cmpC x y) (cmpG r.1 r'.1) (spec x y r r')))))
        y.2) x.2 ;
  ctrans (x y z : Car) (a : Id W.O3 (cmpC x y) lt) (b : Id W.O3 (cmpC y z) lt) : Id W.O3 (cmpC x z) lt =
    TC.rec (Rep x.1) @l (Id W.O3 (cmpC x z) lt) (PF.o3-set (cmpC x z) lt)
      (\ r -> TC.rec (Rep y.1) @l (Id W.O3 (cmpC x z) lt) (PF.o3-set (cmpC x z) lt)
        (\ r' -> TC.rec (Rep z.1) @l (Id W.O3 (cmpC x z) lt) (PF.o3-set (cmpC x z) lt)
          (\ r'' -> W.trans W.O3 (cmpC x z) (cmpG r.1 r''.1) lt (spec x z r r'')
            (cmpG-trans r.1 r'.1 r''.1
              (W.trans W.O3 (cmpG r.1 r'.1) (cmpC x y) lt (W.sym W.O3 (cmpC x y) (cmpG r.1 r'.1) (spec x y r r')) a)
              (W.trans W.O3 (cmpG r'.1 r''.1) (cmpC y z) lt (W.sym W.O3 (cmpC y z) (cmpG r'.1 r''.1) (spec y z r' r'')) b)))
          z.2) y.2) x.2 ;
  ceq (x y : Car) (e : Id W.O3 (cmpC x y) eq) : Id Car x y =
    TC.rec (Rep x.1) @l (Id Car x y) (car-set x y)
      (\ r -> TC.rec (Rep y.1) @l (Id Car x y) (car-set x y)
        (\ r' -> car-eq x y
          (PL.trans (G -> W.Bool) x.1 (cls r.1) y.1 (PL.sym (G -> W.Bool) (cls r.1) x.1 r.2)
            (PL.trans (G -> W.Bool) (cls r.1) (cls r'.1) y.1
              (cls-eq r.1 r'.1 (W.trans W.O3 (cmpG r.1 r'.1) (cmpC x y) eq (W.sym W.O3 (cmpC x y) (cmpG r.1 r'.1) (spec x y r r')) e))
              r'.2)))
        y.2) x.2 ;
  lo : DP.LO = new DP.LO[car := Car, cmp := cmpC, ceq := ceq, crefl := crefl, cflip := cflip, ctrans := ctrans] ;

  -- the comparison of classes is that of germs
  cmp-cl (g g' : G) : Id W.O3 (cmpC (cl g) (cl g')) (cmpG g g') =
    spec (cl g) (cl g') (g,refl (cls g)) (g',refl (cls g')) ;
  -- every point is merely the class of a germ
  surj (x : Car) : Ex ((g : G) * Id Car (cl g) x) =
    TC.map (Rep x.1) ((g : G) * Id Car (cl g) x) (\ r -> (r.1,cl-rep x r)) x.2 ;
  -- the inclusion of FP(D|K)
  iota (K : W.N) : DP.Map (Fo K) lo =
    (\ z -> cl (K,z),\ z z' ->
      W.trans W.O3 (cmpC (cl (K,z)) (cl (K,z'))) (cmpG (K,z) (K,z')) ((Fo K).cmp z z')
        (cmp-cl (K,z) (K,z'))
        (W.trans W.O3 (cmpG (K,z) (K,z')) (cmpAt (K,z) (K,z') K (le-refl K) (le-refl K)) ((Fo K).cmp z z')
          (cmpG-at (K,z) (K,z') K (le-refl K) (le-refl K))
          ((FP.arr (T K) (T K) (up K K (le-refl K))).2 z z'))) ;
} ;

-- P-copy of AdequacyFin.seg: Fits replaced by FitsP (principal environments). Generated; see PRA/LEVELS.md.
-- AdequacyFin.seg: the adequacy eliminator of vendor/Adequacy.seg, with the
-- app and beta cases of AdeqAppFin.  Every environment extension in the
-- proof is now by a principal filter prin v of a compact v: the cases of
-- AdeqPi/AdeqLam/AdeqFun already extend only by principal filters
-- (AdeqFun: extE rho (prin i.1)), and AdeqAppFin replaces the extension by
-- the ideal sem a rho.  See PRA/LEVELS.md.

level l ;
open Base ; open Prelude[l] ; open Lib[l] ; open Types[l] ; open Consistency[l] ; open Typing[l] ;
open Syntax[l] ; open SynLemmas[l] ; open Weaken[l] ; open Subst[l] ; open Presup[l] ; open Cross[l] ;
open Filter[l] ; open Sem[l] ; open Sound[l] ; open Reduction[l] ; open RelC[l] ; open LawsC[l] ; open AdeqBase[l] ; open PrinEnv[l] ;
open AdeqPiP[l] ; open AdeqLamP[l] ; open AdeqAppP[l] ; open AdeqFunP[l] ; open AdeqAppFinP[l] ;

module AdeqTP (n : Nat) (D : Ctx n) (wD : Der n (jwf D)) {
  open AdeqPP[n, D, wD] ;
  open AdeqLP[n, D, wD] ;
  open AdeqAP[n, D, wD] ;
  open AdeqAFP[n, D, wD] ;
  open AdeqFP[n, D, wD] ;

  AdJ (m : Nat) : Jf m -> U l+ = split {
    jwf G -> Top ;
    jty G M A -> Ad m G M M A ;
    jeq G M M' A -> Ad m G M M' A } ;

  adequacy-fin : (m : Nat) -> (J : Jf m) -> Der m J -> AdJ m J = split {
    wf-emp -> tt ;
    wf-ext m G A h -> tt ;
    ty-var m G i h -> ad-var m G i ;
    ty-conv m G M A B h1 h2 h3 | r1 r2 r3 ->
      ad-conv m G M M A B r1 r2 (\ rho fi -> soundness-eq m G A B (uu m) h2 rho fi.1) ;
    ty-U m G h -> ad-U m G ;
    ty-Pi m G A B h1 h2 | r1 r2 ->
      ad-pi m G A A B B h1 h1 (eq-refl m G A (uu m) h1) h2 (eq-refl (suc m) (ext m G A) B (uu (suc m)) h2) r1 r1 r2 r2 r2 ;
    ty-Lam m G A B M h1 h2 h3 | r1 r2 r3 -> ad-lam m G A B M h1 h2 h3 r1 r2 r3 ;
    ty-App m G A B f a h1 h2 h3 h4 | r1 r2 r3 r4 -> ad-app-fin m G A B f f a a h1 h3 (eq-refl m G a A h4) r3 r4 r2 ;
    eq-refl m G M A h | r -> r ;
    eq-sym m G M N A h | r -> ad-sym m G M N A r (\ rho fi -> soundness-eq m G M N A h rho fi.1) ;
    eq-trans m G M N P A h1 h2 | r1 r2 -> ad-trans m G M N P A r1 r2 (\ rho fi -> soundness-eq m G M N A h1 rho fi.1) ;
    eq-conv m G M N A B h1 h2 h3 | r1 r2 r3 ->
      ad-conv m G M N A B r1 r2 (\ rho fi -> soundness-eq m G A B (uu m) h2 rho fi.1) ;
    eq-beta m G A B M a h1 h2 h3 h4 | r1 r2 r3 r4 -> ad-beta-fin m G A B M a h1 h2 h3 h4 r3 r4 ;
    eq-Pi m G A A' B B' h1 h2 h3 h4 h5 | r1 r2 r3 r4 r5 ->
      ad-pi m G A A' B B' h1 (eq-pre m (jeq G A A' (uu m)) h4).2 h4 h3 h5 r1 r4 r2 r3 r5 ;
    eq-funext m G A B f g h1 h2 h3 h4 | r1 r2 r3 r4 -> ad-funext m G A B f g h1 r1 r2 r3 ;
    eq-app-fun m G A B f f' a h1 h2 h3 h4 | r1 r2 r3 r4 ->
      ad-app-fin m G A B f f' a a h1 (eq-pre m (jeq G f f' (pp m A B)) h3).1 (eq-refl m G a A h4) r3 r4 r2 ;
    eq-app-arg m G A B f a a' h1 h2 h3 h4 | r1 r2 r3 r4 -> ad-app-fin m G A B f f a a' h1 h3 h4 r3 r4 r2 } ;
} ;
